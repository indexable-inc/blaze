;; A spawned thread that writes standard output, itself or through any function it calls.
;;
;; agents/annoyances/vac-3.json: a thread printed to `io::stdout()` while the command's own
;; thread held the stdout lock for its report, so the thread's line waited, unseen, until the
;; command ended. `blaze::stdout_lock_in_loop` reads loops only and `std_use` flags every
;; `stdout`; neither follows a closure passed to `std::thread::spawn` through its callees.
;; This rule does, recursively through `callee`, with `std::thread::spawn` and
;; `std::io::stdout` matched by resolution.
;;
;; Rule 73: the type is the end (one `Out` owned by the command's thread, handed to nothing
;; that is `Send`); the rule finds the threads to change before that type lands.

(rule (calls f g) (syntax c "CALL_EXPR") (callee c g) (enclosing-fn c f))
(rule (calls f g) (syntax c "METHOD_CALL_EXPR") (callee c g) (enclosing-fn c f))
(rule (reaches f g) (calls f g))
(rule (reaches f g) (calls f h) (reaches h g))

(rule (writes f) (expr c "std::io::stdout()") (enclosing-fn c f))
(rule (writes-below f) (writes f))
(rule (writes-below f) (reaches f g) (writes g))

;; The closure's own body: a `stdout()` written in it, or a call in it that reaches one.
(rule (stdout-in-spawned-thread s via)
  (expr s "std::thread::spawn($body)")
  (expr via "std::io::stdout()")
  (ancestor body via))
(rule (stdout-in-spawned-thread s via)
  (expr s "std::thread::spawn($body)")
  (syntax via "CALL_EXPR")
  (ancestor body via)
  (callee via g)
  (writes-below g))

(lint stdout-in-spawned-thread warning "this thread writes standard output (through `$via`) while the command may hold its lock")
