# One derivation per cargo unit, each running rustc directly (tools/nix/unit_build.py).
# Input is one of tools/nix/units/<project>.json, generated by tools/nix/unit_graph.py from `cargo build
# --unit-graph`, one graph per nix system (platform-specific dependencies differ per target); we
# pick the evaluating system's.
#
# Why this caches well: a unit's derivation inputs are its own sources, its profile and features,
# and the store paths of the units it depends on. Nothing else. Editing blaze's own sources changes
# only the blaze unit; every registry crate and every front-end crate keeps its store
# path and is a cache hit on any machine that has built or substituted it.
#
# Native builds only: host units (platform null in the graph) and target units are the same machine,
# so build scripts and proc-macros are ordinary host units.
{ pkgs, rust, guiLibs, json, repo, gitSha ? "" }:
let
  inherit (pkgs) lib;
  system = pkgs.stdenv.hostPlatform.system;
  all = builtins.fromJSON (builtins.readFile json);
  graph = all.systems.${system} or (throw "${json} has no unit graph for ${system}: add its triple to TARGETS in tools/nix/unit_graph.py and rerun it");
  # The file keys each unit by a name of its own, so that adding one moves no other (#353); below,
  # a unit is its position in the sorted keys and names its dependencies by position.
  keys = builtins.attrNames graph.units;
  position = builtins.listToAttrs (lib.imap0 (i: k: lib.nameValuePair k i) keys);
  data = all // {
    units = map
      (k: graph.units.${k} // { deps = map (d: { i = position.${d.unit}; inherit (d) name; }) graph.units.${k}.deps; })
      keys;
    roots = map (k: position.${k}) graph.roots;
  };

  # The file keeps the parsed Cargo.lock and Cargo.toml it was made from, not their hashes, so that
  # two pull requests that change the lock in different places merge without a conflict here.
  stale = n: copy: builtins.fromTOML (builtins.readFile (repo + "/${all.dir}/${n}")) != copy;
  checked =
    if !(all ? lock && all ? manifest) || stale "Cargo.lock" all.lock || stale "Cargo.toml" all.manifest
    then throw "${json} is stale against ${all.dir}/Cargo.lock or Cargo.toml: run tools/nix/unit_graph.py"
    else data;

  # The manifest directory of a workspace-local package, cut down to what the crate reads so that
  # editing anything else in the repo does not change the unit.
  # crates/blaze-cargo include_str!s harness/toolchain and library/{DIGEST,UPSTREAM}.
  pathSource = p:
    let
      d = p.source.dir;
      library = lib.optionals (d == "crates/blaze-cargo")
        (map (f: repo + "/library/${f}") [ "DIGEST" "UPSTREAM" ]);
    in
    "${lib.fileset.toSource {
      root = repo;
      fileset = lib.fileset.unions ([ (repo + "/${d}") (repo + "/harness/toolchain") ] ++ library);
    }}/${d}";

  pkgSrc = lib.mapAttrs
    (key: p:
      if p.source.kind == "registry" then
        let
          crate = pkgs.fetchurl {
            name = "${p.name}-${p.version}.crate";
            url = "https://static.crates.io/crates/${p.name}/${p.name}-${p.version}.crate";
            sha256 = p.source.checksum;
          };
        in
        pkgs.runCommandLocal "${p.name}-${p.version}-src" { } ''
          mkdir $out
          tar xzf ${crate} --strip-components=1 -C $out
        ''
      else
        pathSource p)
    checked.packages;

  n = builtins.length checked.units;
  idx = lib.range 0 (n - 1);
  U = i: builtins.elemAt checked.units i;
  crateName = i: builtins.replaceStrings [ "-" ] [ "_" ] (U i).target;
  dylib = pkgs.stdenv.hostPlatform.extensions.sharedLibrary;

  # Stable symbol-hash seed: pkg, features, profile and the seeds of all dependencies. No store paths.
  metas = map
    (i:
      let u = U i; in
      builtins.substring 0 16 (builtins.hashString "sha256" (builtins.toJSON {
        inherit (u) pkg target kind crate_type mode edition src features profile;
        deps = map (d: { n = d.name; m = builtins.elemAt metas d.i; }) u.deps;
      })))
    idx;

  isRun = i: (U i).mode == "run-custom-build";
  libDeps = i: lib.filter (d: !isRun d.i) (U i).deps;
  runDep = i: lib.findFirst (d: isRun d.i) null (U i).deps;

  # All lib-ish units reachable from i, not including i.
  closure = i: map (x: x.key) (builtins.genericClosure {
    startSet = map (d: { key = d.i; }) (libDeps i);
    operator = x: map (d: { key = d.i; }) (libDeps x.key);
  });

  env = i:
    let
      u = U i;
      p = checked.packages.${u.pkg};
      v = lib.splitString "." (builtins.head (lib.splitString "-" (builtins.head (lib.splitString "+" p.version))));
      pre = lib.concatStringsSep "-" (builtins.tail (lib.splitString "-" (builtins.head (lib.splitString "+" p.version))));
    in
    {
      CARGO = "${rust}/bin/cargo";
      CARGO_PKG_NAME = p.name;
      CARGO_PKG_VERSION = p.version;
      CARGO_PKG_VERSION_MAJOR = builtins.elemAt v 0;
      CARGO_PKG_VERSION_MINOR = builtins.elemAt v 1;
      CARGO_PKG_VERSION_PATCH = builtins.elemAt v 2;
      CARGO_PKG_VERSION_PRE = pre;
      CARGO_PKG_AUTHORS = p.authors;
      CARGO_PKG_DESCRIPTION = p.description;
      CARGO_PKG_HOMEPAGE = p.homepage;
      CARGO_PKG_REPOSITORY = p.repository;
      CARGO_PKG_LICENSE = p.license;
      CARGO_PKG_LICENSE_FILE = p.license_file;
      CARGO_PKG_RUST_VERSION = p.rust_version;
      CARGO_PKG_README = p.readme;
      CARGO_CRATE_NAME = crateName i;
    }
    // lib.optionalAttrs (u.kind == "bin") { CARGO_BIN_NAME = u.target; }
    // lib.optionalAttrs (builtins.elem i checked.roots || u.pkg == (U (builtins.head checked.roots)).pkg) { CARGO_PRIMARY_PACKAGE = "1"; }
    // lib.optionalAttrs (p.links != null) { CARGO_MANIFEST_LINKS = p.links; }
    # `blaze-engine --version` and the daemon's log name the commit, as the flake's `daemon` does
    # (blaze-engine's build script reads it).
    // lib.optionalAttrs (p.name == "blaze-engine" && gitSha != "") { BLAZE_GIT_SHA = gitSha; };

  mk = i:
    let
      u = U i;
      p = checked.packages.${u.pkg};
      src = pkgSrc.${u.pkg};
      isBuildScript = u.kind == "custom-build";
      base = "${p.name}-${p.version}";
      common = {
        inherit (u) features profile;
        rustc = "${rust}/bin/rustc";
        manifest_dir = "${src}";
        env = env i // { CARGO_MANIFEST_DIR = "${src}"; };
      };
      spec =
        if isRun i then
          let
            # Its own build script's compile unit; the other deps are the run units of dependencies'
            # scripts (`links`), which cargo lists in no fixed order.
            compileDep = (lib.findFirst (d: (U d.i).kind == "custom-build" && (U d.i).mode == "build" && (U d.i).pkg == u.pkg) null u.deps).i;
            # Cargo hands DEP_<links>_<key> from direct deps' build scripts to this package's script.
            libUnit = lib.findFirst (j: (U j).pkg == u.pkg && (U j).mode == "build" && (U j).kind != "custom-build") null idx;
            depScripts = lib.optionals (libUnit != null)
              (lib.concatMap
                (d:
                  let rd = runDep d.i; links = checked.packages.${(U d.i).pkg}.links; in
                  lib.optional (rd != null && links != null) { inherit links; path = "${drv rd.i}"; })
                (libDeps libUnit));
          in
          common // {
            kind = "run";
            pkg = u.pkg;
            script = "${drv compileDep}/bin/${crateName compileDep}";
            dep_scripts = depScripts;
          }
        else
          let
            ownRun = runDep i;
            cl = closure i;
            ext = d:
              let t = U d.i; in
              {
                name = d.name;
                path = "${drv d.i}/lib/lib${crateName d.i}-${builtins.elemAt metas d.i}"
                  + (if t.crate_type == "proc-macro" then dylib else ".rlib");
              };
          in
          common // {
            kind = "compile";
            crate_name = crateName i;
            bin_name = if isBuildScript then crateName i else u.target;
            edition = u.edition;
            crate_type = u.crate_type;
            src = "${src}/${u.src}";
            metadata = builtins.elemAt metas i;
            cap_lints = !(builtins.elem i checked.roots);
            externs = map ext (libDeps i);
            dep_dirs = map (j: "${drv j}/lib") cl;
            own_script = if ownRun == null then null else "${drv ownRun.i}";
            link_scripts = lib.concatMap (j: let r = runDep j; in lib.optional (r != null) "${drv r.i}") cl;
            remap = [ [ "${src}" "/crate/${base}" ] ];
          };
    in
    pkgs.stdenv.mkDerivation ({
      name = "unit-${base}" + (if isRun i then "-bs-run" else if isBuildScript then "-bs" else "");
      passAsFile = [ "spec" ];
      spec = builtins.toJSON spec;
      nativeBuildInputs = [ rust pkgs.python3 ];
      buildInputs = lib.optionals (u.kind == "bin") guiLibs;
      buildCommand = ''
        python3 -I ${builder} "$specPath"
      '';
    });

  builder = builtins.path { path = ./unit_build.py; name = "unit_build.py"; };
  drvs = map mk idx;
  drv = i: builtins.elemAt drvs i;
in
{
  inherit drvs;
  total = n;
  roots = map drv checked.roots;
  # Every binary of the graph's roots in one bin/.
  bins = pkgs.symlinkJoin {
    name = "blaze-units-bins";
    paths = map (i: drv i) (lib.filter (i: (U i).kind == "bin") checked.roots);
  };
}
