// The site's pages. Each page is an entity under `site`; its path is its URL (site.index is /).
// RFCs live in rfcs/, the charter in charter.flecs, /bench in bench.flecs, /install and /usage in their own files,
// the course's lessons in learn/.
// The sidebar's sections are in nav.flecs; a page joins one with Nav, Icon and (InGroup, nav.<section>).
site {
  OrderedChildren
  // https://ix.dev/blaze/ (the worker answers there; blaze.ix.dev and blaze.ix.dev redirect to it).
  Served: {"https://ix.dev", "/blaze"}
  // The pixel-fire wordmark (docs/brand/fire/gen.py), copied to static/brand/.
  Brand: {"/brand/blaze-dark.webp", "/brand/blaze-light.webp", 688, 368, "/brand/blaze-dark-still.webp", "/brand/blaze-light-still.webp"}

  // The home page is the course: the logo, one line on what blaze is, the install line, then the map of lessons
  // (learn.flecs and learn/), with the speed numbers and the credits below. What blaze is for is taught by the
  // lessons rather than listed here.
  index : Page {
    Hero
    Title: {"blaze"}
    Nav: {"Course", 0}
    Icon: {"path"}
    (InGroup, nav.learn)
    Intro: {"[warm, welcoming] Hey, welcome. [short pause] This is blaze: a Rust build that keeps cargo's commands and rebuilds an edit in milliseconds. The best way in is the short course right on this page."}
    Outro: {"[warm] So, the short version: the same commands as cargo, one line to install, and five short lessons whenever you'd like to see how it works. Thanks for listening."}
    Tab: {"blaze: learn how Rust builds in milliseconds"}
    Description: {"A Rust build with cargo's commands that rebuilds an edit in milliseconds, and a short course on how it works: five lessons, one idea per screen, with questions as you go."}

    Lede lede("Rebuild Rust in milliseconds, with the same commands as cargo.") {
      Say: {"[curious] Here's the idea. You type the same commands as cargo, with blaze in front, and an edit is rebuilt in milliseconds."}
    }
    Command install("curl -fsSL https://ix.dev/blaze | sh") {
      Silent
    }
    Dim then("Then `blaze run` in any Rust project. [Install](/install) has the other ways in and what you need; [Usage](/usage) has the day to day.") {
      Say: {"[warm] Installing is the one line at the top: it fetches blaze, and the Rust it builds with. Then type blaze run in any Rust project. The install and usage pages have the rest."}
    }

    Section course(title: "How blaze works") {
      Say: {"[warm] The heart of this page is a short course. Five lessons, a few minutes each, one idea per screen, and a question now and then to check it landed. You don't need to know anything about compilers; a little Rust is enough. [pause] It starts with what a build does and why an edit can still take a while. Then how blaze redoes only the functions that changed. Then proc macros, and why blaze can keep what they write. Then hermetic builds. And last, sharing that work with your team. [calm] Your progress stays in your browser, and the button at the top takes you to wherever you left off."}
      P line("Five short lessons, a few minutes each: one idea per screen, and a question now and then to check it landed. No compiler knowledge needed; a little Rust is enough.")
      Course map {
        (Lessons, site.learn)
      }
      Dim kept("Your progress stays in this browser. Nothing is sent anywhere.")
    }

    Section speed(title: "How fast") {
      Say: {"[curious] So how fast is it? [breath] Take a workspace of two hundred crates, edit one function, and build. [matter-of-fact] In the main crate, cargo takes about one point eight seconds. blaze, four tenths. [pause] In a crate everything depends on, the painful case, cargo takes over six seconds. [excited] blaze, six tenths. [calm] That was measured once, by hand. The benchmark history page has every run on real projects, next to plain cargo."}
      Dim setup("Edit one function, then build. A generated 200-crate workspace on Linux x86-64 with 8 CPUs, median of three, measured once by hand.")
      Table numbers {
        Tr head { Th a("Edit"); Th b("cargo"); Th c("blaze") }
        Tr main_crate { Td a("Function in the main crate"); Td b("1.76 s"); Td c("0.42 s") }
        Tr deep_crate { Td a("Function in a crate everything depends on"); Td b("6.33 s"); Td c("0.60 s") }
      }
      Dim history("[Benchmark history](/bench): every run on real projects, next to plain cargo on the same machine.")
    }

    Section credits(title: "Credits") {
      Say: {"[warm, grateful] And credit where it's due. blaze includes code from rust-analyzer, Cranelift, LLVM and inkwell, salsa, object, Rust, and DioxusLabs' rustd. Thank you to the people who built them; none of them endorses blaze. It's made at ix, for den's native app, and designed in the open: the charter says what it holds to, the RFCs are designs still being argued about, and you can comment on any paragraph. [small laugh] And this site? It's Flecs scripts, rendered by a little Rust renderer compiled to wasm."}
      Dim thanks("blaze stands on the shoulders of giants. Thank you to the people who built [rust-analyzer](https://github.com/rust-lang/rust-analyzer), [Cranelift](https://cranelift.dev), [LLVM](https://llvm.org) and [inkwell](https://github.com/TheDan64/inkwell), [salsa](https://github.com/salsa-rs/salsa), [object](https://github.com/gimli-rs/object), [Rust](https://github.com/rust-lang/rust), and [rustd](https://github.com/DioxusLabs/rustd) (DioxusLabs), whose code blaze includes. None of these projects endorses blaze. Made at [ix](https://ix.dev) for den's native app. MIT or Apache-2.0. This site is [Flecs](https://github.com/SanderMertens/flecs) scripts, rendered by a Rust renderer compiled to wasm.")
      Dim open("Designed in the open: the [charter](/charter) says what blaze holds to, and [the RFCs](/rfcs) are designs still being argued about. Sign in with GitHub to comment on any paragraph.")
    }
  }

  updates : Page {
    Narrow
    Quiet
    Title: {"Tell us you use blaze"}
    Nav: {"Updates", 6}
    Icon: {"envelope"}
    (InGroup, nav.reference)
    Description: {"Leave your email and why you want to use blaze."}
    Lede lede("Leave your email and why you want it. It helps us see who uses blaze.")
    SignupForm form
    Dim privacy("We keep your email and answers to see who uses blaze, and may write to you about it. We don't share them.")
  }

  rfcs : Page {
    Title: {"RFCs"}
    Nav: {"RFCs", 4}
    Icon: {"files"}
    (InGroup, nav.reference)
    Description: {"Designs for what blaze adds to Rust, open for comment."}
    Lede lede("Designs for what blaze adds to Rust. Each one is a draft until it is not: sign in with GitHub and comment on any paragraph, or on the RFC as a whole.")
    P charter("Read the [charter](/charter) first: it says what every RFC has to keep.")
    RfcIndex list
    Dim source("Each RFC is a Flecs script in [site/content/rfcs](https://github.com/indexable-inc/blaze/tree/main/site/content/rfcs). To propose one, open a pull request with a new file.")
  }

  "404" : Page {
    Quiet
    Title: {"Not found"}
    P gone("Nothing here. Try the [home page](/) or [the RFCs](/rfcs).")
  }
}
