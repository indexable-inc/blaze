// The site's pages. Each page is an entity under `site`; its path is its URL (site.index is /).
// The whole site is one course. Its front door, /, is the intro: the wordmark dropping in and catching fire, one line
// and the way in. Lesson 1 is /start (what blaze is, installing it, the first build), the course map is /learn
// (learn.flecs), the other lessons are in learn/, the updates in updates.flecs and updates/.
// Reference pages (install details, benchmarks, the charter, RFCs) sit beside it in the sidebar (nav.flecs).
site {
  OrderedChildren
  // https://ix.dev/blaze/ (the worker answers there).
  Served: {"https://ix.dev", "/blaze"}
  // The pixel-fire wordmark (docs/brand/fire/gen.py), copied to static/brand/.
  Brand: {"/brand/blaze-dark.webp", "/brand/blaze-light.webp", 688, 368, "/brand/blaze-dark-still.webp", "/brand/blaze-light-still.webp"}

  // Opened here so the course map can name them; their own files, which run later, fill them in.
  learn {}
  updates {}

  // The front door: the wordmark, live (client/intro.ts), then what blaze is in one line, the proof of it, and the way
  // into the course. No sidebar here, so the last line is the way to the course map and the reference pages.
  // Everything it claims is a measurement or something built and tested, with its source beside it; what the course
  // calls experimental says so here too (a Chip takes its lesson's theme's tag).
  index : Page {
    Hero
    Title: {"blaze"}
    Tab: {"blaze: Rust that rebuilds in milliseconds"}
    Description: {"blaze builds Rust with cargo's commands and rebuilds an edit in milliseconds. Learn it in short lessons: what it is, how to install it, and how it works."}

    Lede is("`blaze build`. Edits rebuild in milliseconds.")

    // The numbers are not written here: the build reads them from docs/benchmarks/history (gen/bench/race.ts), the
    // latest Linux x86-64 run that timed this edit under both. On 2026-11-12 that is linux-x86-64.jsonl's run of
    // 2026-10-22 (commit 2cf189feb6, AWS c7a.48xlarge pinned to 16 cores, median of 5 edits): ripgrep 15.1.0,
    // `body` (edit one function, then build), blaze 0.069 s, cargo 0.787 s. ripgrep because it is the history's
    // first project and sits in the middle of that run: across its nine projects the same edit is 6x to 34x faster
    // under blaze on eight (median 12x), and slower on one, bevy (11.6 s against 3.96 s), which /bench shows.
    // docs/benchmarks.md says every published number is blaze v1's (2026-10-20 to 10-25) and no run of v2 is published
    // yet, so `of` says v1 and the caption carries it with the run's day; the commit is in the figure's title.
    Race race(dir: "docs/benchmarks/history", platform: "Linux x86-64", project: "ripgrep/cranelift", edit: "body", of: "blaze v1", more: "/bench")

    Go start(label: "Start the course", href: "/start")

    Chips built {
      // Build scripts run in blaze's sandbox, no network and no writes outside their own folder: the hermetic lesson's
      // "already run in a sandbox"; crates/blaze-cargo/src/sandbox.rs, and its Linux test
      // `a_confined_sandbox_writes_only_where_it_may_and_reaches_nothing` (sandbox/linux.rs). Proc macros run as
      // wasm32-wasip1 modules under Wasmtime (crates/blaze-macro-eval/src/wasm.rs and wasm/tests.rs; docs/cargo.md,
      // "Every build runs its proc macros as wasm32-wasip1 modules under Wasmtime").
      Chip sandbox(label: "Sandboxed build scripts, proc macros", href: "/learn/hermetic")
      // The effects lint (crates/blaze-lints/src/blaze/effects.rs, effects_tests.rs: `noalloc_refuses_the_global_allocator`
      // and 18 more) and the linear checker (crates/hir-ty-linear, 40 tests:
      // `a_value_left_at_the_end_of_its_scope_is_an_error`). Their designs are still `status: plan`; the lesson is in the
      // experimental band, so the chip says Experimental.
      Chip effects(label: "Effects and linear types", href: "/learn/extensions")
      // lean/theorems.json lists 90 theorems; the `lean` job of .github/workflows/blaze.yaml builds them, refuses
      // `sorry` and checks each one's axioms (harness/v2/lean_gate.py). They prove Lean models of about 13 MIR passes;
      // only two of the Rust passes are tied to their model so far (lean/BlazeValidated/passes.lean), so the chip does
      // not say the compiler's passes are proved. Experimental, by its lesson's band.
      Chip proofs(label: "Lean proofs, checked in CI", href: "/learn/proofs")
      // bstd is crates/blaze-std; its `#[bstd::test]` runs a test under 256 seeds with failed effects and power cuts
      // (src/tests/simtest.rs `the_default_seeds_inject_and_the_counter_passes`, which asserts all three), with a
      // planted-bug control beside it. Experimental, by its lesson's band.
      Chip sim(label: "Simulation tests in bstd", href: "/learn/bstd")
    }

    Dim more("[Course map](/learn) · [Install](/install) · [GitHub](https://github.com/indexable-inc/blaze)")
  }

  // Lesson 1: what blaze is, installing it, the first build and the commands you will type.
  start : Page {
    Narrow
    Lesson: {0, "What blaze is, installing it, and your first build.", "start"}
    (InTheme, themes.basics)
    Title: {"Start here"}
    Description: {"What blaze is, how to install it, and your first build: the first lesson of the course, a few minutes long."}

    Step what("Rust, rebuilt in milliseconds") {
      Lede is("`blaze build` builds Rust. Edits rebuild in milliseconds.")
      Art art(piece: "incremental", label: "A lattice of functions. One changes, and only it and the few that depend on it light up and settle.")
      Dim course("A short course, one idea per screen. Press **Continue** or →.")
    }

    Step why("Why it is fast") {
      Art race(piece: "race", label: "Two lanes over time. cargo: a rustc for each affected crate, each starting by reloading its saved state, then the whole program linked. blaze: one function, then done.")
      P cargo("`rustc` is incremental, but cargo still starts one per affected crate, each reloading its saved state, then links everything again.")
      P blaze("blaze keeps your workspace in memory and redoes only **the functions you changed**.")
    }

    Step install("Install it") {
      Command curl("curl -fsSL https://ix.dev/blaze | sh")
      Dim what("macOS on Apple silicon or Linux. No Rust needed: blaze brings its own. Details: [Install](/install).")
    }

    Step first("Your first build") {
      Code run(lang: "bash", text: "blaze run")
      Art held(piece: "daemon", label: "Your workspace as a block of cells. The first build fills every cell; after that each save changes a single cell.")
      P daemon("The first build loads everything into a background **daemon**. After that, each save rebuilds one piece:")
      Code finished(lang: "", text: `Finished \`dev\` profile [blaze] target(s) in 0.02s`)
    }

    Step daemon_q("Check") {
      Quiz q(prompt: "Why is the second `blaze run` so much faster?") {
        Choice cache("It downloaded a prebuilt copy.", "Nothing is downloaded: your code is compiled on your machine.")
        Choice held("The daemon kept everything in memory and redid only the edit.", "Right: load once, then only what changed.") {
          Right
        }
        Choice skip("It skipped type checking.", "Types are checked on every build.")
      }
    }

    Step commands("The commands") {
      Table cmds {
        Tr build { Td a("`blaze build` `run` `test` `check` `bench`"); Td b("cargo's commands and flags") }
        Tr status { Td a("`blaze status`"); Td b("what the daemon holds") }
        Tr stop { Td a("`blaze stop`"); Td b("save its state and stop") }
      }
      Dim watch("Rebuild on save with any watcher: `watchexec -e rs -- blaze build`.")
    }

    Step next("Next") {
      P path("Next: how blaze gets its speed, then what it adds to Rust: const generic math, effects, its own std, and proofs in Lean.")
      Dim map("All lessons: [the course map](/learn).")
    }
  }

  rfcs : Page {
    Title: {"RFCs"}
    Nav: {"RFCs", 4}
    Icon: {"files"}
    (InGroup, nav.reference)
    Description: {"Designs for what blaze adds to Rust."}
    Lede lede("Designs for what blaze adds to Rust. Read the [charter](/charter) first: it says what every RFC has to keep.")
    RfcIndex list
    Dim source("Each RFC is a Flecs script in [site/content/rfcs](https://github.com/indexable-inc/blaze/tree/main/site/content/rfcs). To propose one, open a pull request with a new file.")
  }

  "404" : Page {
    Title: {"Not found"}
    P gone("Nothing here. [Start the course](/start) or open [the course map](/learn).")
  }
}
