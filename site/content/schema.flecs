// The site's element types. Every page is an entity under `site` and its path is its URL
// (site.rfcs.capabilities is /rfcs/capabilities, site.index is /). A page's children, in order, are
// its content, the way HTML nests: a node's kind is a component (P, Li, Code, Section ...), its links
// are pairs ((Cites, refs.zig_io), (DependsOn, site.charter)), and pages are instances of the
// prefabs at the end (Page, Doc, Rfc).
//
// Text fields take inline markup: `code`, **strong**, *emphasis*, [label](https://...), and [[name]]
// or [label][name] for a reference in refs.flecs. Prose is a "string" on one line; a code block is a
// backtick string, its indent stripped. Strings interpolate, so write \{ and \$ for { and $, and \` in
// a backtick string.
//
// Rendered by the Rust renderer (renderer/core): render.rs says what each type becomes, side.rs the sidebar.
using flecs.meta

// Page metadata, set on the page entity.
struct Title(text: string)              // <title> and the page's <h1>
struct Tab(text: string)                // the <title>, when it is not Title
struct Description(text: string)        // <meta name="description">
struct Number(value: i32)               // an RFC's number
struct Nav(label: string, order: i32)   // a page's row in the sidebar: its label, top to bottom by order in its section
struct Link(label: string, href: string, order: i32) // a sidebar row that goes elsewhere (a child of a section)
// The sidebar (nav.flecs; renderer core side.rs): its sections are the children of `nav`, each with a Group and an
// Icon. A page joins one with Nav, Icon and (InGroup, nav.<section>); its RFCs are its row's kids, and the lessons of
// a Course on it follow its row.
struct Group(title: string, order: i32) // a sidebar section, top to bottom by order
FoldOnPhone {}                          // a sidebar section that starts folded in the phone drawer
struct Icon(name: string)               // a row's or section's icon: a key of renderer/core/src/icons.rs
// The logo, set on `site`: animated pixel-fire WebP, the dark file on a dark page, the light one on a light page.
// The still files are its first frame, which the sidebar shows until the pointer is on it.
struct Brand(dark: string, light: string, width: i32, height: i32, still_dark: string, still_light: string)
// Where the site is served, set on `site`: the origin and the path every page sits under (no trailing slash, or
// empty for the root). A link written /rfcs/x becomes <base>/rfcs/x; canonical and og:url are origin + base + path.
struct Served(origin: string, base: string)

// Blocks. In a Doc, every block has a name: its path under the page is the anchor comments use.
struct Lede(text: string)               // the opening paragraph, larger
struct P(text: string)
struct Dim(text: string)                // a quieter paragraph
struct H3(text: string)
struct Li(text: string)
struct Th(text: string)
struct Td(text: string)
struct Code(lang: string, text: string) // a code block; lang is rust, toml, bash or empty
struct Command(text: string)            // one shell command with a copy button
struct Art(piece: string, label: string) // an animated drawing (client/art.ts draws `piece`); label is its alt text, never read out
struct Img(src: string, alt: string, width: i32, height: i32)

// Containers: their children are their content, in order.
struct Section(title: string)           // <section> with an <h2>
struct Issue(title: string)             // an open question in an RFC, with (Status, Open|Resolved)
struct Goal(title: string, line: string) // one of blaze's goals, folded to its title and one line until opened
Ul {}
Ol {}
Table {}
Tr {}
Section { (With, flecs.core.OrderedChildren) }
Issue { (With, flecs.core.OrderedChildren) }
Goal { (With, flecs.core.OrderedChildren) }
Ul { (With, flecs.core.OrderedChildren) }
Ol { (With, flecs.core.OrderedChildren) }
Table { (With, flecs.core.OrderedChildren) }
Tr { (With, flecs.core.OrderedChildren) }

// The course (the home page's path; renderer core render.rs and course.rs, client/learn.ts). A lesson is a page under
// site.learn (/learn/<slug>) with Lesson; an update is a page under site.updates (/updates/<slug>) with Update. Both are
// made of Steps, one idea per screen. Without JS the steps are stacked and each question shows its answer in a fold;
// client/learn.ts turns the page into one step at a time and keeps the reader's progress in localStorage.
// The path is a graph, not a line: a lesson or update names what to learn first with (Requires, page), and belongs to
// one Theme, a band of the path under its own heading, with (InTheme, themes.<name>).
// A lesson page: its order among the lessons, what it teaches in one line, and its glyph, the drawing on its node (a
// key of gen/glyphs.ts GLYPHS; the build bakes it onto the page, and an unknown name fails the build).
struct Lesson(order: i32, line: string, glyph: string)
// An update: a change to blaze, taught as a short lesson that extends the lessons it requires. `date` is the day the
// release with it came out (YYYY-MM-DD), `version` that release (0.YYYYMMDD.N), `line` what changed in one line,
// `glyph` as a Lesson's. The changelog (UpdateLog, /updates) lists them newest first; a reader's browser marks the
// ones published since their last visit New.
struct Update(date: string, version: string, line: string, glyph: string)
// A band of the course path (learn.flecs, under `themes`): its heading, its one line, its place top to bottom, its
// accent (a class styles/learn.css colours: `theme-<accent>`, empty for the ink) and the short tag the changelog
// shows on its updates (empty for none).
struct Theme(title: string, line: string, order: i32, accent: string, tag: string)
Dashed {}                               // a Theme whose trail is drawn dashed: what it teaches may still change
struct Step(title: string)              // one screen of a lesson: a short paragraph, maybe a diagram, maybe a question
struct Quiz(prompt: string)             // a question: its children are Choices, exactly one of them Right
struct Choice(text: string, why: string) // an answer, and the one line the reader sees once they pick it
Right {}                                // the Choice that is right
struct Figure(piece: string, label: string) // a diagram the reader can touch (client/lib/diagrams.ts draws `piece`); label says what it shows
// A question answered by tapping parts of a diagram: `right` is the names of the parts to pick, comma separated (the
// piece's node ids), `hint` what a wrong pick is told, `why` the explanation once it is right.
struct Tap(prompt: string, piece: string, right: string, hint: string, why: string)
Course {}                               // the course path: the Lesson and Update pages under its (Lessons, page) targets
UpdateLog {}                            // the changelog: every Update on the course, newest first
Step { (With, flecs.core.OrderedChildren) }
Quiz { (With, flecs.core.OrderedChildren) }

// Charts (renderer core chart.rs): drawn by the renderer at build time as inline SVG in the site's ink and type,
// light and dark (--series-N in styles/tokens.css), each with its numbers in a table the reader can open under it.
// Values are in the chart's `unit`, "s", "ms" or "MB", and written as they read best (69 ms, 1.18 s, 3.53 GB). A
// chart's `scale` is "linear" (from zero: amounts that sit close together, 6.5 s beside 6.2 s) or "log" (times that
// differ tenfold or more, 25 ms beside 1.3 s, where a linear axis would leave the small one invisible).
//
// A Subject is something charts compare (blaze, cargo). Its label and colour slot are the same in every chart, so a
// colour always means the same thing; `dashed` draws its lines dashed, for a second measure of the same subject.
struct Subject(label: string, slot: i32, dashed: bool)
Plots { Exclusive }                     // (Plots, subject) on a Value or a Series: whose value it is
Baseline { Exclusive }                  // (Baseline, subject) on a RowChart: each row says how many times faster than it the row's first other value is
// Categories compared at one moment: one Row per category, a Value per subject in it, written out beside the row.
// Linear draws bars from zero, log draws a dot per value on a line from the fastest to the slowest.
struct RowChart(title: string, unit: string, scale: string, note: string)
struct Row(label: string)
struct Value(value: f64, note: string)  // note: something to know about this one value (beside it and in the table)
// Lines over runs: one Series per subject, x is the runs in Runs (evenly spaced, oldest first). With one run there
// is no line yet: the chart shows each subject's value.
struct LineChart(title: string, unit: string, scale: string, note: string)
struct Runs(dates: string, commits: string) // on a LineChart: one ISO date and one commit per run, space separated
// One value per run, space separated, `-` where the run has none. lo and hi, when set, are a band (fastest to slowest).
struct Series(values: string, lo: string, hi: string)
Charts {}                               // small multiples: its charts side by side, two to a row on a wide screen
// One of several panels at a time: a labelled row of buttons (radio buttons, so it works without JS) over its Picks.
// The Pick with Picked starts chosen, else the first.
struct Picker(label: string)
struct Pick(label: string)
Picked {}
RowChart { (With, flecs.core.OrderedChildren) }
Row { (With, flecs.core.OrderedChildren) }
LineChart { (With, flecs.core.OrderedChildren) }
Charts { (With, flecs.core.OrderedChildren) }
Picker { (With, flecs.core.OrderedChildren) }
Pick { (With, flecs.core.OrderedChildren) }

// Things the TS layer builds itself, placed like any block.
RfcIndex {}                             // the list of RFCs (children of site.rfcs)
References {}                           // every reference the page cites, in order of first use
// A container the build fills from the benchmark history in `dir` (a directory of .jsonl files, from the repo root):
// gen/bench/ writes it as a Flecs script of Sections, Pickers and charts under this entity.
struct BenchHistory(dir: string)
BenchHistory { (With, flecs.core.OrderedChildren) }

// A reference: a page elsewhere that a block cites.
struct Ref(href: string, label: string, note: string)

// Relationships.
Status { Exclusive }                    // one status per page or issue
Draft {}                                // an RFC being written; anything in it may change
Discussing {}                           // an RFC ready for comments
Accepted {}
Rejected {}
Open {}                                 // an issue nobody has settled
Resolved {}
Cites {}                                // (Cites, ref): a block leans on that reference
DependsOn {}                            // (DependsOn, page): read that page first
InGroup { Exclusive }                   // (InGroup, nav.<section>): the page's sidebar row is in that section
Lessons {}                              // (Lessons, page) on a Course: the lessons and updates under that page are on its path
Requires {}                             // (Requires, page) on a lesson or update: learn that one first (an edge of the course graph)
InTheme { Exclusive }                   // (InTheme, themes.<name>): the band of the course path a lesson or update is in

// Page kinds.
Discussable {}                          // signed-in readers comment on each block (every other page has one discussion for the whole page)
Quiet {}                                // no discussion at all (the 404)
Narrow {}                               // a 560px column instead of 820px
Wide {}                                 // a wide column, no outline beside it
Hero {}                                 // the page's title is the logo, large (the home page)

prefab Page {
  OrderedChildren
}
prefab Doc : Page {                     // a page people discuss, block by block
  Discussable
}
prefab Rfc : Doc {
  (Status, Draft)
}
