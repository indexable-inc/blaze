// /learn: the course map. Lesson 1 is /start (site.flecs); the rest are under site.learn (learn/*.flecs, at
// /learn/<slug>), each with Lesson {order, line, glyph}, made of Steps, one idea per screen, with questions woven in.
// client/learn.ts plays a lesson one step at a time and keeps the reader's progress in localStorage.
//
// The path is a graph: each lesson and update names what comes first with (Requires, page), and sits in one theme, a
// band of the path with its own heading (renderer core course.rs lays it out).
themes {
  // How blaze builds, and the updates that change it on the stable channel.
  basics {
    Theme: {"How blaze works", "What blaze is, and where its speed comes from.", 1, "", ""}
  }
  // What blaze adds to Rust, and how it is checked.
  beyond {
    Theme: {"Beyond Rust", "What blaze adds to the language, its own standard library, and a compiler being proved correct. Experimental: written, and still settling.", 2, "canary", "Experimental"}
    Dashed
  }
  // Updates to what is only in a canary release (docs/release.md) or behind `experimental = [...]` in a workspace's
  // manifest. Dashed: it may still change.
  canary {
    Theme: {"Canary and experiments", "Newer, and still settling: canary releases and experimental flags.", 3, "canary", "Canary"}
    Dashed
  }
}

site {
  // Opened here so the course map and the lessons can name them; site.flecs and updates.flecs run later.
  start {}
  updates {}

  learn : Page {
    Narrow
    Title: {"The course"}
    Nav: {"Course", 1}
    Icon: {"path"}
    (InGroup, nav.learn)
    Description: {"Every lesson on blaze, from installing it to how it is proved correct: one idea per screen, a few minutes each."}

    Lede lede("Short lessons, a few minutes each: one idea per screen, and a question now and then to check it landed. A little Rust is enough.")
    Course map {
      (Lessons, site)
      (Lessons, site.learn)
      (Lessons, site.updates)
    }
    Dim kept("Your progress stays in this browser. Nothing is sent anywhere.")

    Section credits(title: "Credits") {
      Dim thanks("blaze stands on the shoulders of giants. Thank you to the people who built [rust-analyzer](https://github.com/rust-lang/rust-analyzer), [Cranelift](https://cranelift.dev), [LLVM](https://llvm.org) and [inkwell](https://github.com/TheDan64/inkwell), [salsa](https://github.com/salsa-rs/salsa), [object](https://github.com/gimli-rs/object), [Rust](https://github.com/rust-lang/rust), [Lean](https://lean-lang.org) and [rustd](https://github.com/DioxusLabs/rustd) (DioxusLabs), whose code or work blaze builds on. None of these projects endorses blaze. Made at [ix](https://ix.dev). MIT or Apache-2.0.")
    }

    // Opened here so a lesson can require one whose file runs after its own (files run in path order).
    builds {}
    incremental {}
    macros {}
    hermetic {}
    sharing {}
    const_exprs {}
    extensions {}
    bstd {}
    proofs {}
  }
}
