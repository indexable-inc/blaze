// Lesson: compile-time reflection in blaze (`inline for`, `zip_fields`, and `where for<F in fields(T)> F: Trait`).
// Every example matches passing native tests in `crates/blaze-ladder/tests/front2_field_defaults_run.rs`
// (lowered in `crates/blaze-lower`, solved in `crates/blaze-solve`, type-checked in `crates/blaze-typeck`).
site {
  learn {
    comptime : Page {
      Narrow
      // Order 7, like extensions: the path tie-breaks on the name, so this comes right after const_exprs.
      Lesson: {7, "Write a function once, and let it unroll over any struct's fields at compile time.", "inline"}
      (InTheme, themes.beyond)
      (Requires, site.learn.const_exprs)
      Title: {"Compile-time reflection"}
      Description: {"blaze's compile-time reflection: `inline for` unrolls over a struct, tuple, or record's fields, with `where for<F in fields(T)>` bounds checked once."}

      Step idea("One function, every struct") {
        P why("Today, code that walks a struct's fields is a derive macro: a program that writes more code. blaze lets you write it as a plain generic function with `inline for`.")
        Code codec(lang: "rust", text: `fn encode<T>(v: &T, out: &mut Buf)
        where for<F in fields(T)> F: Encode \{
            inline for (name, field) in v \{
                out.field(name, field);
            }
        }`)
        Dim same("No proc macro, no `IntoIterator`: each iteration unrolls to a direct field access with that field's exact type.")
      }

      Step loop("Values, references, and mutation") {
        Code forms(lang: "rust", text: `// Read field names and values
        inline for (name, field) in &rec \{ inspect(name, field); }

        // Mutate fields in place
        inline for (_name, field) in &mut dst \{ field.reset(); }

        // Walk two values in lockstep (generic Eq, diff, patch)
        inline for (a, b) in zip_fields(lhs, rhs) \{
            if a != b \{ return false; }
        }`)
        P unroll("`inline for` works on structs, tuples, and anonymous records like `\{ a: u32, b: i32 }`, unrolling in declaration order.")
      }

      Step once("Checked once, not per type") {
        Code bound(lang: "rust", text: `impl<T> FieldCodec for T
        where for<F in fields(T)> F: FieldCodec \{
            fn json_len(&self) -> i32 \{
                let mut total = 0;
                inline for (_name, field) in self \{
                    total += field.json_len();
                }
                total
            }
        }`)
        P rule("`where for<F in fields(T)> F: FieldCodec` reads \"every field `F` of `T` implements `FieldCodec`\". Recursive blanket impls work across nested structs and records automatically.")
      }

      Step once_q("Check: where is the error?") {
        Quiz q(prompt: "`encode<T>` requires `where for<F in fields(T)> F: Encode`. `Bad`'s field `n` doesn't implement `Encode`. What does blaze report?") {
          Choice inside("An error inside `encode`'s loop after unrolling for `Bad`.", "The body was already checked against the `for<F in fields(T)>` bound. Nothing fails after unrolling.")
          Choice call("An error at the call `encode(&bad, &mut out)`, because `Bad` doesn't satisfy the field bound.", "Right. The solver checks `for<F in fields(T)>` structurally against each field of `Bad` at the call site.") {
            Right
          }
          Choice none("Nothing: `n` is skipped.", "No field is skipped quietly. Every field must satisfy the bound.")
        }
      }

      Step records("Works with anonymous records too") {
        Code spread(lang: "rust", text: `type Base = \{ a: i32, b: i32 };
        type Extended = \{ ..Base, flag: bool };

        fn sum_fields<T>(v: &T) -> i32
        where for<F in fields(T)> F: FieldCodec \{
            let mut n = 0;
            inline for (_name, f) in v \{ n += f.json_len(); }
            n
        }`)
        P spread_p("Anonymous records compose with `..Base`, support type-level field defaults (`\{ a: u32, b: u32 = 32 }`), and work directly with `inline for` and `for<F in fields(T)>`.")
      }

      Step status("Where it stands") {
        P now("Implemented and tested natively in blaze (`blaze-lower`, `blaze-solve`, `blaze-typeck`, `blaze-ladder`). Crates on standard Rust editions are unaffected.")
        Dim design("Design: [comptime.md](https://github.com/indexable-inc/blaze/blob/main/docs/v2/plan/design/comptime.md).")
      }
    }
  }
}
