{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": [],
    "lib": [
      "es2024"
    ]
  },
  "contentMappers": [
    {
      "package": "flecs-content-mapper",
      "extensions": [
        ".flecs"
      ],
      "options": {
        "scripts": ".",
        "wasm": "../flecs/flecs-doc.wasm",
        "first": ["schema.flecs", "refs.flecs", "nav.flecs"]
      }
    }
  ],
  "include": [
    "**/*.flecs"
  ]
}
