{
  "name": "blaze-site",
  "private": true,
  "type": "module",
  "workspaces": [
    "flecs-mapper"
  ],
  "scripts": {
    "build": "bun gen/build.ts",
    "check": "tsc -p tsconfig.json && tsc -p client/tsconfig.json && tsc -p gen/tsconfig.json && tsc -p content --runExternalCode",
    "dev": "wrangler dev",
    "deploy": "bun gen/build.ts && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@huggingface/transformers": "4.3.2",
    "@types/bun": "^1.4.4",
    "flecs-content-mapper": "workspace:*",
    "highlight.js": "^11.12.0",
    "typescript": "7.1.0-beta",
    "wrangler": "^4"
  }
}
