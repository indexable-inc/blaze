import BlazeDiff.Expr

namespace BlazeDiff.Rewrite

/-- `add-zero`: `a + 0` is `a` (a value that is not -0.0). -/
def add_zero : Prop :=
  ∀ (env : ℕ → ℝ) (a : Expr),
    (Expr.bin .add a (Expr.const (0 : ℝ))).eval env = a.eval env

/-- `mul-zero`: `a * 0` is `0` (a finite value). -/
def mul_zero : Prop :=
  ∀ (env : ℕ → ℝ) (a : Expr),
    (Expr.bin .mul a (Expr.const (0 : ℝ))).eval env = (Expr.const (0 : ℝ)).eval env

/-- `zero-div`: `0 / a` is `0` (finite values, a divisor that is not 0). -/
def zero_div : Prop :=
  ∀ (env : ℕ → ℝ) (a : Expr),
    a.eval env ≠ (0 : ℝ) →
    (Expr.bin .div (Expr.const (0 : ℝ)) a).eval env = (Expr.const (0 : ℝ)).eval env

/-- `sub-self`: `a - a` is `0` (a finite value). -/
def sub_self : Prop :=
  ∀ (env : ℕ → ℝ) (a : Expr),
    (Expr.bin .sub a a).eval env = (Expr.const (0 : ℝ)).eval env

/-- `div-self`: `a / a` is `1` (finite values, a divisor that is not 0). -/
def div_self : Prop :=
  ∀ (env : ℕ → ℝ) (a : Expr),
    a.eval env ≠ (0 : ℝ) →
    (Expr.bin .div a a).eval env = (Expr.const (1 : ℝ)).eval env

/-- `mul-div-cancel`: `a * b / b` is `a` (finite values, a divisor that is not 0). -/
def mul_div_cancel : Prop :=
  ∀ (env : ℕ → ℝ) (a b : Expr),
    b.eval env ≠ (0 : ℝ) →
    (Expr.bin .div (Expr.bin .mul a b) b).eval env = a.eval env

/-- `div-mul-cancel`: `a / b * b` is `a` (finite values, a divisor that is not 0). -/
def div_mul_cancel : Prop :=
  ∀ (env : ℕ → ℝ) (a b : Expr),
    b.eval env ≠ (0 : ℝ) →
    (Expr.bin .mul (Expr.bin .div a b) b).eval env = a.eval env

/-- `assoc-add`: `a + b + c` is `a + (b + c)` (finite values, no rounding). -/
def assoc_add : Prop :=
  ∀ (env : ℕ → ℝ) (a b c : Expr),
    (Expr.bin .add (Expr.bin .add a b) c).eval env = (Expr.bin .add a (Expr.bin .add b c)).eval env

/-- `assoc-add-back`: `a + (b + c)` is `a + b + c` (finite values, no rounding). -/
def assoc_add_back : Prop :=
  ∀ (env : ℕ → ℝ) (a b c : Expr),
    (Expr.bin .add a (Expr.bin .add b c)).eval env = (Expr.bin .add (Expr.bin .add a b) c).eval env

/-- `assoc-mul`: `a * b * c` is `a * (b * c)` (finite values, no rounding). -/
def assoc_mul : Prop :=
  ∀ (env : ℕ → ℝ) (a b c : Expr),
    (Expr.bin .mul (Expr.bin .mul a b) c).eval env = (Expr.bin .mul a (Expr.bin .mul b c)).eval env

/-- `assoc-mul-back`: `a * (b * c)` is `a * b * c` (finite values, no rounding). -/
def assoc_mul_back : Prop :=
  ∀ (env : ℕ → ℝ) (a b c : Expr),
    (Expr.bin .mul a (Expr.bin .mul b c)).eval env = (Expr.bin .mul (Expr.bin .mul a b) c).eval env

/-- `factor`: `a * c + b * c` is `(a + b) * c` (finite values, no rounding). -/
def factor : Prop :=
  ∀ (env : ℕ → ℝ) (a b c : Expr),
    (Expr.bin .add (Expr.bin .mul a c) (Expr.bin .mul b c)).eval env = (Expr.bin .mul (Expr.bin .add a b) c).eval env

/-- `factor-sub`: `a * c - b * c` is `(a - b) * c` (finite values, no rounding). -/
def factor_sub : Prop :=
  ∀ (env : ℕ → ℝ) (a b c : Expr),
    (Expr.bin .sub (Expr.bin .mul a c) (Expr.bin .mul b c)).eval env = (Expr.bin .mul (Expr.bin .sub a b) c).eval env

/-- `common-divisor`: `a / c + b / c` is `(a + b) / c` (finite values, a divisor that is not 0). -/
def common_divisor : Prop :=
  ∀ (env : ℕ → ℝ) (a b c : Expr),
    c.eval env ≠ (0 : ℝ) →
    (Expr.bin .add (Expr.bin .div a c) (Expr.bin .div b c)).eval env = (Expr.bin .div (Expr.bin .add a b) c).eval env

/-- `common-divisor-sub`: `a / c - b / c` is `(a - b) / c` (finite values, a divisor that is not 0). -/
def common_divisor_sub : Prop :=
  ∀ (env : ℕ → ℝ) (a b c : Expr),
    c.eval env ≠ (0 : ℝ) →
    (Expr.bin .sub (Expr.bin .div a c) (Expr.bin .div b c)).eval env = (Expr.bin .div (Expr.bin .sub a b) c).eval env

/-- `mul-of-quotient`: `a * (b / c)` is `a * b / c` (finite values, a divisor that is not 0). -/
def mul_of_quotient : Prop :=
  ∀ (env : ℕ → ℝ) (a b c : Expr),
    c.eval env ≠ (0 : ℝ) →
    (Expr.bin .mul a (Expr.bin .div b c)).eval env = (Expr.bin .div (Expr.bin .mul a b) c).eval env

/-- `quotient-of-quotient`: `a / b / c` is `a / (b * c)` (finite values, a divisor that is not 0). -/
def quotient_of_quotient : Prop :=
  ∀ (env : ℕ → ℝ) (a b c : Expr),
    b.eval env ≠ (0 : ℝ) →
    c.eval env ≠ (0 : ℝ) →
    (Expr.bin .div (Expr.bin .div a b) c).eval env = (Expr.bin .div a (Expr.bin .mul b c)).eval env

/-- `sub-of-quotient`: `a - b / c` is `(a * c - b) / c` (finite values, a divisor that is not 0). -/
def sub_of_quotient : Prop :=
  ∀ (env : ℕ → ℝ) (a b c : Expr),
    c.eval env ≠ (0 : ℝ) →
    (Expr.bin .sub a (Expr.bin .div b c)).eval env = (Expr.bin .div (Expr.bin .sub (Expr.bin .mul a c) b) c).eval env

/-- `mul-reciprocal`: `a * (1 / b)` is `a / b` (finite values, a divisor that is not 0). -/
def mul_reciprocal : Prop :=
  ∀ (env : ℕ → ℝ) (a b : Expr),
    b.eval env ≠ (0 : ℝ) →
    (Expr.bin .mul a (Expr.bin .div (Expr.const (1 : ℝ)) b)).eval env = (Expr.bin .div a b).eval env

/-- `pythagoras`: `sin(a) * sin(a) + cos(a) * cos(a)` is `1` (a finite value). -/
def pythagoras : Prop :=
  ∀ (env : ℕ → ℝ) (a : Expr),
    (Expr.bin .add (Expr.bin .mul (Expr.un .sin a) (Expr.un .sin a)) (Expr.bin .mul (Expr.un .cos a) (Expr.un .cos a))).eval env = (Expr.const (1 : ℝ)).eval env

/-- `ln-exp`: `ln(exp(a))` is `a` (a finite value whose `exp` is finite). -/
def ln_exp : Prop :=
  ∀ (env : ℕ → ℝ) (a : Expr),
    (Expr.un .ln (Expr.un .exp a)).eval env = a.eval env

/-- `exp-sum`: `exp(a) * exp(b)` is `exp(a + b)` (finite values, no rounding). -/
def exp_sum : Prop :=
  ∀ (env : ℕ → ℝ) (a b : Expr),
    (Expr.bin .mul (Expr.un .exp a) (Expr.un .exp b)).eval env = (Expr.un .exp (Expr.bin .add a b)).eval env

/-- `powi-two`: `powi(a, 2)` is `a * a` (finite values, no rounding). -/
def powi_two : Prop :=
  ∀ (env : ℕ → ℝ) (a : Expr),
    (Expr.powi (Blaze.Scalar.lit .I32 2) a).eval env = (Expr.bin .mul a a).eval env

/-- `powi-one`: `powi(a, 1)` is `a` (finite values, no rounding). -/
def powi_one : Prop :=
  ∀ (env : ℕ → ℝ) (a : Expr),
    (Expr.powi (Blaze.Scalar.lit .I32 1) a).eval env = a.eval env

/-- `powi-zero`: `powi(a, 0)` is `1` (a value that is not NaN). -/
def powi_zero : Prop :=
  ∀ (env : ℕ → ℝ) (a : Expr),
    (Expr.powi (Blaze.Scalar.lit .I32 0) a).eval env = (Expr.const (1 : ℝ)).eval env

/-- `fma`: `a * b + c` is `mul_add(a, b, c)` (finite values: the product is no longer rounded before the sum). -/
def fma : Prop :=
  ∀ (env : ℕ → ℝ) (a b c : Expr),
    (Expr.bin .add (Expr.bin .mul a b) c).eval env = (Expr.ter .mulAdd a b c).eval env

/-- `neg-of-difference`: `-(a - b)` is `b - a` (values that differ, or a zero whose sign does not matter). -/
def neg_of_difference : Prop :=
  ∀ (env : ℕ → ℝ) (a b : Expr),
    (Expr.un .neg (Expr.bin .sub a b)).eval env = (Expr.bin .sub b a).eval env

/-- `sqrt-squared`: `sqrt(a) * sqrt(a)` is `a` (a finite value that is not below 0). -/
def sqrt_squared : Prop :=
  ∀ (env : ℕ → ℝ) (a : Expr),
    (0 : ℝ) ≤ a.eval env →
    (Expr.bin .mul (Expr.un .sqrt a) (Expr.un .sqrt a)).eval env = a.eval env

