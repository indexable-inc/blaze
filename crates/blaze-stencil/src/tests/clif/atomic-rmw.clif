; Follows cranelift/filetests/filetests/runtests/atomic-rmw-little.clif and
; atomic-rmw-subword-little.clif, for the stencil set: every `atomic_rmw` op of `i8` to `i64`
; on a stack slot a `store` initialised, returning the old value and the value in memory
; after. An `i8` sits at byte 3 and an `i16` at byte 2 of an 8-byte slot whose other bytes
; are set, and their functions return the whole word as the memory after (the new value in
; its bytes), so a write past the access shows: two results, as every signature here has.
; Upstream's big-endian variants are left out (the stencil set has little-endian accesses
; only), and so is `i128` (the set has no `atomic_rmw` of it).
test interpret
test run
target x86_64
target aarch64

function %rmw_add_i8(i8, i8) -> i8, i64 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i8, v1: i8):
    v2 = iconst.i64 0x1122334455667788
    v3 = stack_addr.i64 ss0
    store v2, v3
    v4 = stack_addr.i64 ss0+3
    store v0, v4
    v5 = atomic_rmw.i8 add v4, v1
    v6 = load.i64 v3
    return v5, v6
}
; run: %rmw_add_i8(1, 2) == [1, 0x1122334403667788]
; run: %rmw_add_i8(-1, 1) == [-1, 0x1122334400667788]
; run: %rmw_add_i8(127, 1) == [127, 0x1122334480667788]
; run: %rmw_add_i8(-17, -16) == [-17, 0x11223344df667788]

function %rmw_sub_i8(i8, i8) -> i8, i64 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i8, v1: i8):
    v2 = iconst.i64 0x1122334455667788
    v3 = stack_addr.i64 ss0
    store v2, v3
    v4 = stack_addr.i64 ss0+3
    store v0, v4
    v5 = atomic_rmw.i8 sub v4, v1
    v6 = load.i64 v3
    return v5, v6
}
; run: %rmw_sub_i8(3, 1) == [3, 0x1122334402667788]
; run: %rmw_sub_i8(0, 1) == [0, 0x11223344ff667788]
; run: %rmw_sub_i8(-128, 1) == [-128, 0x112233447f667788]
; run: %rmw_sub_i8(-17, -16) == [-17, 0x11223344ff667788]

function %rmw_and_i8(i8, i8) -> i8, i64 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i8, v1: i8):
    v2 = iconst.i64 0x1122334455667788
    v3 = stack_addr.i64 ss0
    store v2, v3
    v4 = stack_addr.i64 ss0+3
    store v0, v4
    v5 = atomic_rmw.i8 and v4, v1
    v6 = load.i64 v3
    return v5, v6
}
; run: %rmw_and_i8(-17, -16) == [-17, 0x11223344e0667788]
; run: %rmw_and_i8(-1, 0) == [-1, 0x1122334400667788]
; run: %rmw_and_i8(-1, -17) == [-1, 0x11223344ef667788]

