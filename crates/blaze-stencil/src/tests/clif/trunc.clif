; Follows cranelift/filetests/filetests/runtests/trunc.clif, for the stencil set: scalar `trunc`
; of f32 and f64 (on x86-64's baseline a call of libm's `truncf`/`trunc` in both backends, so
; IEEE's rounding toward zero): halves, the largest value with a fraction, values already
; integral, subnormals, zeros, infinities and NaN. Vector `trunc` is the simd files'.
test interpret
test run
target x86_64
target aarch64

function %trunc_f32(f32) -> f32 {
block0(v0: f32):
    v1 = trunc v0
    return v1
}
; run: %trunc_f32(0x0.0) == 0x0.0
; run: %trunc_f32(-0x0.0) == -0x0.0
; run: %trunc_f32(0x1.0p-1) == 0x0.0
; run: %trunc_f32(-0x1.0p-1) == -0x0.0
; run: %trunc_f32(0x1.8p0) == 0x1.0p0
; run: %trunc_f32(-0x1.8p0) == -0x1.0p0
; run: %trunc_f32(0x1.4p1) == 0x1.0p1
; run: %trunc_f32(-0x1.4p1) == -0x1.0p1
; run: %trunc_f32(0x1.0p0) == 0x1.0p0
; run: %trunc_f32(-0x1.0p0) == -0x1.0p0
; run: %trunc_f32(0x1.000002p0) == 0x1.0p0
; run: %trunc_f32(-0x1.fffffep-1) == -0x0.0
; run: %trunc_f32(0x1.fffffep22) == 0x1.fffffcp22
; run: %trunc_f32(-0x1.fffffep22) == -0x1.fffffcp22
; run: %trunc_f32(0x1.0p23) == 0x1.0p23
; run: %trunc_f32(0x1.000002p23) == 0x1.000002p23
; run: %trunc_f32(-0x1.000002p23) == -0x1.000002p23
; run: %trunc_f32(0x1.fffffep127) == 0x1.fffffep127
; run: %trunc_f32(-0x1.fffffep127) == -0x1.fffffep127
; run: %trunc_f32(0x0.000002p-126) == 0x0.0
; run: %trunc_f32(-0x0.000002p-126) == -0x0.0
; run: %trunc_f32(0x1.0p-126) == 0x0.0
; run: %trunc_f32(+Inf) == +Inf
; run: %trunc_f32(-Inf) == -Inf
; run: %trunc_f32(+NaN) == +NaN
; run: %trunc_f32(-NaN) == +NaN

function %trunc_f64(f64) -> f64 {
block0(v0: f64):
    v1 = trunc v0
    return v1
}
; run: %trunc_f64(0x0.0) == 0x0.0
; run: %trunc_f64(-0x0.0) == -0x0.0
; run: %trunc_f64(0x1.0p-1) == 0x0.0
; run: %trunc_f64(-0x1.0p-1) == -0x0.0
; run: %trunc_f64(0x1.8p0) == 0x1.0p0
; run: %trunc_f64(-0x1.8p0) == -0x1.0p0
; run: %trunc_f64(0x1.4p1) == 0x1.0p1
; run: %trunc_f64(-0x1.4p1) == -0x1.0p1
; run: %trunc_f64(0x1.0p0) == 0x1.0p0
; run: %trunc_f64(-0x1.0p0) == -0x1.0p0
; run: %trunc_f64(0x1.0000000000001p0) == 0x1.0p0
; run: %trunc_f64(-0x1.fffffffffffffp-1) == -0x0.0
; run: %trunc_f64(0x1.fffffffffffffp51) == 0x1.ffffffffffffep51
; run: %trunc_f64(-0x1.fffffffffffffp51) == -0x1.ffffffffffffep51
; run: %trunc_f64(0x1.0p52) == 0x1.0p52
; run: %trunc_f64(0x1.0000000000001p52) == 0x1.0000000000001p52
; run: %trunc_f64(-0x1.0000000000001p52) == -0x1.0000000000001p52
; run: %trunc_f64(0x1.fffffffffffffp1023) == 0x1.fffffffffffffp1023
; run: %trunc_f64(-0x1.fffffffffffffp1023) == -0x1.fffffffffffffp1023
; run: %trunc_f64(0x0.0000000000001p-1022) == 0x0.0
; run: %trunc_f64(-0x0.0000000000001p-1022) == -0x0.0
; run: %trunc_f64(0x1.0p-1022) == 0x0.0
; run: %trunc_f64(+Inf) == +Inf
; run: %trunc_f64(-Inf) == -Inf
; run: %trunc_f64(+NaN) == +NaN
; run: %trunc_f64(-NaN) == +NaN
