; Follows cranelift/filetests/filetests/runtests/extend.clif (and ireduce.clif), for the
; stencil set: `uextend` and `sextend` from each of `i8` to `i32` to each wider type up to
; `i64`, `ireduce` from each of `i16` to `i64` to each narrower one, and each after an
; `iadd` that wraps (so the narrow value's bits above its width are checked to be ignored)
; or before an extend back. Extends to and reductions from `i128` are
; i128-arithmetic.clif's.
test interpret
test run
target x86_64
target aarch64

function %uextend_i8_i16(i8) -> i16 {
block0(v0: i8):
    v1 = uextend.i16 v0
    return v1
}
; run: %uextend_i8_i16(0) == 0
; run: %uextend_i8_i16(1) == 1
; run: %uextend_i8_i16(-1) == 255
; run: %uextend_i8_i16(-128) == 128
; run: %uextend_i8_i16(127) == 127
; run: %uextend_i8_i16(-127) == 129
; run: %uextend_i8_i16(100) == 100
; run: %uextend_i8_i16(-77) == 179

function %uextend_iadd_i8_i16(i8, i8) -> i16 {
block0(v0: i8, v1: i8):
    v2 = iadd v0, v1
    v3 = uextend.i16 v2
    return v3
}
; run: %uextend_iadd_i8_i16(127, 1) == 128
; run: %uextend_iadd_i8_i16(-1, 1) == 0
; run: %uextend_iadd_i8_i16(-1, -1) == 254
; run: %uextend_iadd_i8_i16(-128, -1) == 127
; run: %uextend_iadd_i8_i16(100, -77) == 23
; run: %uextend_iadd_i8_i16(1, 2) == 3

function %sextend_i8_i16(i8) -> i16 {
block0(v0: i8):
    v1 = sextend.i16 v0
    return v1
}
; run: %sextend_i8_i16(0) == 0
; run: %sextend_i8_i16(1) == 1
; run: %sextend_i8_i16(-1) == -1
; run: %sextend_i8_i16(-128) == -128
; run: %sextend_i8_i16(127) == 127
; run: %sextend_i8_i16(-127) == -127
; run: %sextend_i8_i16(100) == 100
; run: %sextend_i8_i16(-77) == -77

function %sextend_iadd_i8_i16(i8, i8) -> i16 {
block0(v0: i8, v1: i8):
    v2 = iadd v0, v1
    v3 = sextend.i16 v2
    return v3
}
; run: %sextend_iadd_i8_i16(127, 1) == -128
; run: %sextend_iadd_i8_i16(-1, 1) == 0
; run: %sextend_iadd_i8_i16(-1, -1) == -2
; run: %sextend_iadd_i8_i16(-128, -1) == 127
; run: %sextend_iadd_i8_i16(100, -77) == 23
; run: %sextend_iadd_i8_i16(1, 2) == 3

