; Follows cranelift/filetests/filetests/runtests/div-checks.clif (and srem.clif, urem.clif,
; sdiv.clif, udiv.clif), for the stencil set: `udiv`, `sdiv`, `urem` and `srem` of `i8` to
; `i64`. Division by zero traps, `sdiv MIN, -1` traps, `srem MIN, -1` is 0, the quotient
; truncates toward zero and the remainder takes the dividend's sign. The `*_by_*` functions
; divide by a constant, which the stencil backend folds into an immediate: a constant 0
; still traps, and -1 is the signed edge. `i128` is left out: the stencil set has no
; division of it (the IR builder calls `__udivti3` and friends).
test interpret
test run
target x86_64
target aarch64

function %udiv_i8(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v2 = udiv v0, v1
    return v2
}
; run: %udiv_i8(7, 2) == 3
; run: %udiv_i8(-7, 2) == 124
; run: %udiv_i8(7, -2) == 0
; run: %udiv_i8(-7, -2) == 0
; run: %udiv_i8(-128, -1) == 0
; run: %udiv_i8(-128, 1) == -128
; run: %udiv_i8(-128, 2) == 64
; run: %udiv_i8(-128, 3) == 42
; run: %udiv_i8(127, -1) == 0
; run: %udiv_i8(127, -128) == 0
; run: %udiv_i8(-1, -1) == 1
; run: %udiv_i8(-1, 2) == 127
; run: %udiv_i8(0, 1) == 0
; run: %udiv_i8(0, -1) == 0
; trap: %udiv_i8(1, 0)
; trap: %udiv_i8(0, 0)
; trap: %udiv_i8(-128, 0)
; trap: %udiv_i8(-1, 0)

function %sdiv_i8(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v2 = sdiv v0, v1
    return v2
}
; run: %sdiv_i8(7, 2) == 3
; run: %sdiv_i8(-7, 2) == -3
; run: %sdiv_i8(7, -2) == -3
; run: %sdiv_i8(-7, -2) == 3
; trap: %sdiv_i8(-128, -1)
; run: %sdiv_i8(-128, 1) == -128
; run: %sdiv_i8(-128, 2) == -64
; run: %sdiv_i8(-128, 3) == -42
; run: %sdiv_i8(127, -1) == -127
; run: %sdiv_i8(127, -128) == 0
; run: %sdiv_i8(-1, -1) == 1
; run: %sdiv_i8(-1, 2) == 0
; run: %sdiv_i8(0, 1) == 0
; run: %sdiv_i8(0, -1) == 0
; trap: %sdiv_i8(1, 0)
; trap: %sdiv_i8(0, 0)
; trap: %sdiv_i8(-128, 0)
; trap: %sdiv_i8(-1, 0)

