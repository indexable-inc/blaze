; run: %urem_i8(0, 1) == 0
; run: %urem_i8(0, -1) == 0
; trap: %urem_i8(1, 0)
; trap: %urem_i8(0, 0)
; trap: %urem_i8(-128, 0)
; trap: %urem_i8(-1, 0)

