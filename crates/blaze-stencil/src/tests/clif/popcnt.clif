; Follows cranelift/filetests/filetests/runtests/popcnt.clif, for the stencil set: `popcnt` of
; `i8` to `i64`. The `i128` form is i128-bitops.clif's, `i8x16`'s simd-arithmetic.clif's.
test interpret
test run
target x86_64
target aarch64

function %popcnt_i8(i8) -> i8 {
block0(v0: i8):
    v1 = popcnt v0
    return v1
}
; run: %popcnt_i8(0) == 0
; run: %popcnt_i8(1) == 1
; run: %popcnt_i8(-1) == 8
; run: %popcnt_i8(-128) == 1
; run: %popcnt_i8(127) == 7
; run: %popcnt_i8(-127) == 2
; run: %popcnt_i8(126) == 6
; run: %popcnt_i8(2) == 1
; run: %popcnt_i8(100) == 3
; run: %popcnt_i8(-77) == 5
; run: %popcnt_i8(8) == 1
; run: %popcnt_i8(16) == 1
; run: %popcnt_i8(64) == 1
; run: %popcnt_i8(15) == 4
; run: %popcnt_i8(-16) == 4
; run: %popcnt_i8(120) == 4

function %popcnt_i16(i16) -> i16 {
block0(v0: i16):
    v1 = popcnt v0
    return v1
}
; run: %popcnt_i16(0) == 0
; run: %popcnt_i16(1) == 1
; run: %popcnt_i16(-1) == 16
; run: %popcnt_i16(0x8000) == 1
; run: %popcnt_i16(0x7fff) == 15
; run: %popcnt_i16(0x8001) == 2
; run: %popcnt_i16(0x7ffe) == 14
; run: %popcnt_i16(2) == 1
; run: %popcnt_i16(0x3039) == 6
; run: %popcnt_i16(0xa460) == 5
; run: %popcnt_i16(128) == 1
; run: %popcnt_i16(256) == 1
; run: %popcnt_i16(0x4000) == 1
; run: %popcnt_i16(255) == 8
; run: %popcnt_i16(-256) == 8
; run: %popcnt_i16(0x5678) == 8

function %popcnt_i32(i32) -> i32 {
block0(v0: i32):
    v1 = popcnt v0
    return v1
}
; run: %popcnt_i32(0) == 0
; run: %popcnt_i32(1) == 1
; run: %popcnt_i32(-1) == 32
; run: %popcnt_i32(0x80000000) == 1
; run: %popcnt_i32(0x7fffffff) == 31
; run: %popcnt_i32(0x80000001) == 2
; run: %popcnt_i32(0x7ffffffe) == 30
; run: %popcnt_i32(2) == 1
; run: %popcnt_i32(0x075bcd15) == 16
; run: %popcnt_i32(0xc521974f) == 16
; run: %popcnt_i32(0x00008000) == 1
; run: %popcnt_i32(0x00010000) == 1
; run: %popcnt_i32(0x40000000) == 1
; run: %popcnt_i32(0x0000ffff) == 16
; run: %popcnt_i32(0xffff0000) == 16
; run: %popcnt_i32(0x12345678) == 13

function %popcnt_i64(i64) -> i64 {
block0(v0: i64):
    v1 = popcnt v0
    return v1
}
; run: %popcnt_i64(0) == 0
; run: %popcnt_i64(1) == 1
; run: %popcnt_i64(-1) == 64
; run: %popcnt_i64(0x8000000000000000) == 1
; run: %popcnt_i64(0x7fffffffffffffff) == 63
; run: %popcnt_i64(0x8000000000000001) == 2
; run: %popcnt_i64(0x7ffffffffffffffe) == 62
; run: %popcnt_i64(2) == 1
; run: %popcnt_i64(0x123456789abcdef0) == 32
; run: %popcnt_i64(0xf0123456789abcdf) == 33
; run: %popcnt_i64(0x0000000080000000) == 1
; run: %popcnt_i64(0x0000000100000000) == 1
; run: %popcnt_i64(0x4000000000000000) == 1
; run: %popcnt_i64(0x00000000ffffffff) == 32
; run: %popcnt_i64(0xffffffff00000000) == 32
; run: %popcnt_i64(0x1234567812345678) == 26
