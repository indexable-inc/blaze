function %slot_8192(i64) -> i64, i64 {
    ss0 = explicit_slot 8192
    ss1 = explicit_slot 8

block0(v0: i64):
    v1 = iconst.i64 1
    v2 = stack_addr.i64 ss1
    store v0, v2
    v3 = stack_addr.i64 ss0
    store v0, v3
    v4 = iadd v0, v1
    v5 = stack_addr.i64 ss0+4096
    store v4, v5
    v6 = iadd v4, v1
    v7 = stack_addr.i64 ss0+8184
    store v6, v7
    v8 = load.i64 v2
    v9 = load.i64 v5
    v10 = load.i64 v7
    v11 = load.i64 v3
    v12 = isub v8, v11
    v13 = iadd v12, v0
    v14 = iconst.i64 32
    v15 = ishl v10, v14
    v16 = bxor v9, v15
    return v13, v16
}
; run: %slot_8192(5) == [5, 0x0000000700000006]
; run: %slot_8192(-1) == [-1, 0x0000000100000000]
; run: %slot_8192(0x7fffffff) == [0x7fffffff, 0x8000000180000000]

