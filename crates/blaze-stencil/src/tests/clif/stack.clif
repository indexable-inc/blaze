function %write_through(i64, i64) {
block0(v0: i64, v1: i64):
    store v1, v0
    v2 = iconst.i64 1
    v3 = iadd v1, v2
    store v3, v0+8
    return
}

function %callee_writes_slot(i64) -> i64, i64 {
    ss0 = explicit_slot 16
    fn0 = %write_through(i64, i64)

block0(v0: i64):
    v1 = stack_addr.i64 ss0
    v2 = iconst.i64 0
    store v2, v1
    store v2, v1+8
    call fn0(v1, v0)
