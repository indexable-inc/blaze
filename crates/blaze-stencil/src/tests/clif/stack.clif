function %many_slots(i64) -> i64 {
    ss0 = explicit_slot 1
    ss1 = explicit_slot 2
    ss2 = explicit_slot 4
    ss3 = explicit_slot 8
    ss4 = explicit_slot 16, align = 16
    ss5 = explicit_slot 32, align = 16
    ss6 = explicit_slot 64, align = 64

block0(v0: i64):
    v1 = stack_addr.i64 ss0
    v2 = stack_addr.i64 ss1
    v3 = stack_addr.i64 ss2
    v4 = stack_addr.i64 ss3
    v5 = stack_addr.i64 ss4
    v6 = stack_addr.i64 ss5
    v7 = stack_addr.i64 ss6
    v8 = ireduce.i8 v0
    store v8, v1
    v9 = ireduce.i16 v0
    store v9, v2
    v10 = ireduce.i32 v0
    store v10, v3
    store v0, v4
    v11 = uextend.i128 v0
    store v11, v5
    v12 = splat.i64x2 v0
    store v12, v6+16
    store v0, v7+32
    v13 = uload8.i64 v1
    v14 = uload16.i64 v2
    v15 = uload32 v3
    v16 = load.i64 v4
    v17 = load.i128 v5
    v18 = ireduce.i64 v17
    v19 = load.i64x2 v6+16
    v20 = extractlane v19, 1
    v21 = load.i64 v7+32
    v22 = iadd v13, v14
    v23 = iadd v22, v15
    v24 = iadd v23, v16
    v25 = iadd v24, v18
    v26 = iadd v25, v20
    v27 = iadd v26, v21
    return v27
}
; run: %many_slots(1) == 7
; run: %many_slots(-1) == 0x00000001000100f9
; run: %many_slots(0x0123456789abcdef) == 0x048d159eb05bd489

