function %slot_32_offsets(i64, i32, i16) -> i64, i64 {
    ss0 = explicit_slot 32

block0(v0: i64, v1: i32, v2: i16):
    v3 = stack_addr.i64 ss0+8
    store v0, v3
    store v1, v3+12
    v4 = stack_addr.i64 ss0+30
    store v2, v4
    v5 = load.i64 v3
    v6 = stack_addr.i64 ss0+20
    v7 = load.i32 v6
    v8 = load.i16 v3+22
    v9 = uextend.i64 v7
    v10 = iconst.i64 16
    v11 = ishl v9, v10
    v12 = uextend.i64 v8
    v13 = bor v11, v12
    return v5, v13
}
