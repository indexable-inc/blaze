; Follows cranelift/filetests/filetests/runtests/stack.clif (and stack-addr-64.clif,
; stack_addr.clif), for the stencil set: explicit slots of 1 to 64 bytes and one of 8192
; (more than a page: the prologue probes it), with alignment 16 and 64; stores and loads
; through `stack_addr` with slot offsets and access offsets, of every type (integers, `i128`,
; floats, the six vector types, an unaligned vector); the narrow loads and stores,
; little-endian (the vector widening loads are `stack-widening.clif`'s); several slots live
; at once; a slot's address passed to a callee that writes through it, and a caller's slot
; surviving a callee with its own; a value stored in one block and read back in another
; after a loop. Upstream's `stack_load`
; and `stack_store` are gone from Cranelift's IR (written here as `stack_addr` and
; `load`/`store`); `dynamic_stack_slot` is left out (the IR builder makes none).
test interpret
test run
target x86_64
target aarch64

function %slot_1_i8(i8) -> i8 {
    ss0 = explicit_slot 1

block0(v0: i8):
    v1 = stack_addr.i64 ss0
    store v0, v1
    v2 = load.i8 v1
    return v2
}
; run: %slot_1_i8(0) == 0
; run: %slot_1_i8(-1) == -1
; run: %slot_1_i8(-128) == -128

