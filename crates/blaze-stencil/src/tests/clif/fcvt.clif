; Follows cranelift/filetests/filetests/runtests/conversion.clif (and fcvt-sat.clif,
; fcvt_to_sint.clif, fcvt_to_uint.clif, fcvt_from_sint.clif, fcvt_from_uint.clif, fdemote.clif,
; fpromote.clif, bitcast.clif), for the stencil set: scalar conversions between f32/f64 and the
; integers. `fcvt_to_sint`/`fcvt_to_uint` to i32 and i64: truncation toward zero, each type's
; boundaries (the largest float below 2^(n-1) or 2^n converts, the next traps; f64 reaches
; past i32's MIN by up to one), -0.9 to unsigned is 0, NaN and both infinities trap; the `_sat`
; forms on the same values (saturating, NaN to 0); `fcvt_from_sint`/`fcvt_from_uint` from i8 to
; i64, with ties to even and u64's MAX rounding up to 2^64 (including a u64 that rounding
; through f64 first would get wrong); `fpromote` and `fdemote` (ties, overflow to Inf, subnormal
; results, NaN); `bitcast` between i32/f32 and i64/f64 both ways. Float to i8 and i16 is in
; fcvt-narrow.clif: Cranelift 0.136's x86-64 backend does not lower it, and one such function
; here would stop this whole file's code on x86-64.
test interpret
test run
target x86_64
target aarch64

function %f32_to_i32(f32) -> i32 {
block0(v0: f32):
    v1 = fcvt_to_sint.i32 v0
    return v1
}
; run: %f32_to_i32(0x0.0) == 0
; run: %f32_to_i32(-0x0.0) == 0
; run: %f32_to_i32(0x1.0p0) == 1
; run: %f32_to_i32(-0x1.0p0) == -1
; run: %f32_to_i32(0x1.8p0) == 1
; run: %f32_to_i32(-0x1.8p0) == -1
; run: %f32_to_i32(0x1.fffffep-1) == 0
; run: %f32_to_i32(-0x1.ccccccp-1) == 0
; run: %f32_to_i32(0x1.4p3) == 10
; run: %f32_to_i32(-0x1.3p3) == -9
; run: %f32_to_i32(0x0.000002p-126) == 0
; run: %f32_to_i32(0x1.fffffep30) == 0x7fffff80
; run: %f32_to_i32(-0x1.0p31) == 0x80000000
; trap: %f32_to_i32(0x1.0p31)
; trap: %f32_to_i32(-0x1.000002p31)
; trap: %f32_to_i32(0x1.fffffep127)
; trap: %f32_to_i32(+Inf)
; trap: %f32_to_i32(-Inf)
; trap: %f32_to_i32(+NaN)
; trap: %f32_to_i32(-NaN)

