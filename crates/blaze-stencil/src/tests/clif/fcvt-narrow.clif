; Follows cranelift/filetests/filetests/runtests/conversion.clif (and fcvt-sat.clif,
; fcvt_to_sint.clif, fcvt_to_uint.clif), for the stencil set: `fcvt_to_sint`/`fcvt_to_uint`
; and their `_sat` forms from f32 and f64 to i8 and i16 (the wider destinations are
; fcvt.clif's): truncation toward zero, each type's boundaries (the largest float below
; 2^(n-1) or 2^n converts, the next traps or saturates; below MIN by less than one converts to
; MIN), -0.9 to unsigned is 0, NaN and both infinities trap or saturate (NaN to 0). Cranelift
; 0.136.2's x86-64 backend does not lower these (its `cvtts?2si` sequences in
; `isa/x64/inst/emit.rs` take 32 and 64-bit destinations only), so on x86-64 hosts this file
; runs in the interpreter and in the stencil compile check only; its code runs on AArch64.
test interpret
test run
target x86_64
target aarch64

function %f32_to_i8(f32) -> i8 {
block0(v0: f32):
    v1 = fcvt_to_sint.i8 v0
    return v1
}
; run: %f32_to_i8(0x0.0) == 0
; run: %f32_to_i8(-0x0.0) == 0
; run: %f32_to_i8(0x1.8p0) == 1
; run: %f32_to_i8(-0x1.8p0) == -1
; run: %f32_to_i8(-0x1.ccccccp-1) == 0
; run: %f32_to_i8(0x1.fcp6) == 127
; run: %f32_to_i8(0x1.fffffep6) == 127
; run: %f32_to_i8(-0x1.0p7) == -128
; run: %f32_to_i8(-0x1.01fffep7) == -128
; trap: %f32_to_i8(0x1.0p7)
; trap: %f32_to_i8(-0x1.02p7)
; trap: %f32_to_i8(0x1.fep7)
; trap: %f32_to_i8(+Inf)
; trap: %f32_to_i8(-Inf)
; trap: %f32_to_i8(+NaN)

