; Follows cranelift/filetests/filetests/runtests/bitops.clif (and bnot.clif, bitselect.clif,
; bmask.clif), for the stencil set: `band`, `bor`, `bxor` (each also with an `iconst`
; second operand, folded into an immediate; for `i64` also ones not of 32 bits
; sign-extended), `bnot` and `bitselect` of `i8` to `i64`, and `bmask` from each of them to
; each. The `i128` forms are i128-bitops.clif's.
test interpret
test run
target x86_64
target aarch64

function %band_i8(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v2 = band v0, v1
    return v2
}
; run: %band_i8(0, 0) == 0
; run: %band_i8(1, 2) == 0
; run: %band_i8(-1, 1) == 1
; run: %band_i8(-1, -1) == -1
; run: %band_i8(127, 1) == 1
; run: %band_i8(-128, -1) == -128
; run: %band_i8(-128, -128) == -128
; run: %band_i8(127, 127) == 127
; run: %band_i8(-128, 127) == 0
; run: %band_i8(126, -127) == 0
; run: %band_i8(100, -77) == 32
; run: %band_i8(-77, 100) == 32
; run: %band_i8(2, -3) == 0
; run: %band_i8(-16, 85) == 80
; run: %band_i8(85, -86) == 0
; run: %band_i8(-16, 15) == 0

function %band_imm_i8(i8) -> i8 {
block0(v0: i8):
    v1 = iconst.i8 240
    v2 = band v0, v1
    return v2
}
; run: %band_imm_i8(0) == 0
; run: %band_imm_i8(1) == 0
; run: %band_imm_i8(-1) == -16
; run: %band_imm_i8(-128) == -128
; run: %band_imm_i8(127) == 112
; run: %band_imm_i8(-127) == -128
; run: %band_imm_i8(126) == 112
; run: %band_imm_i8(100) == 96
; run: %band_imm_i8(-77) == -80
; run: %band_imm_i8(-16) == -16
; run: %band_imm_i8(85) == 80

