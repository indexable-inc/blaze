function %vhigh_bits_icmp_eq_i8x16(i8x16, i8x16) -> i32 {
block0(v0: i8x16, v1: i8x16):
    v2 = icmp eq v0, v1
    v3 = vhigh_bits.i32 v2
    return v3
}
