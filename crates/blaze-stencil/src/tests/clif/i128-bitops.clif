; Follows cranelift/filetests/filetests/runtests/i128-bitops.clif (and i128-bitrev.clif,
; i128-bswap.clif, i128-cls.clif, i128-clz.clif, i128-ctz.clif, i128-popcnt.clif,
; i128-rotate.clif, i128-bmask.clif), for the stencil set: `band`, `bor`, `bxor`, `bnot`,
; `bitselect`, `bitrev`, `bswap`, `cls`, `clz`, `ctz`, `popcnt`, `rotl`, `rotr` and `bmask`
; of `i128`, on values whose halves differ, so a lowering that mixes up the halves shows.
; Upstream's `band_not`, `bor_not` and `bxor_not` are gone from Cranelift's IR (written here
; as `bnot` and the base op).
test interpret
test run
target x86_64
target aarch64

function %band_i128(i128, i128) -> i128 {
block0(v0: i128, v1: i128):
    v2 = band v0, v1
    return v2
}
; run: %band_i128(0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0x00020446088a8ccefecc8a8806440200
; run: %band_i128(0x0123456789abcdeffedcba9876543210, 0xfedcba98765432100123456789abcdef) == 0
; run: %band_i128(-1, 0x00000000000000017fffffffffffffff) == 0x00000000000000017fffffffffffffff
; run: %band_i128(0, 0x0123456789abcdeffedcba9876543210) == 0
; run: %band_i128(0x80000000000000000000000000000000, 1) == 0
; run: %band_i128(0x00000000000000010000000000000000, 0x0000000000000000ffffffffffffffff) == 0

function %bor_i128(i128, i128) -> i128 {
block0(v0: i128, v1: i128):
    v2 = bor v0, v1
    return v2
}
; run: %bor_i128(0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0xf1337577f9bbfdfffffdfbb9f7757331
; run: %bor_i128(0x0123456789abcdeffedcba9876543210, 0xfedcba98765432100123456789abcdef) == -1
; run: %bor_i128(-1, 0x00000000000000017fffffffffffffff) == -1
; run: %bor_i128(0, 0x0123456789abcdeffedcba9876543210) == 0x0123456789abcdeffedcba9876543210
; run: %bor_i128(0x80000000000000000000000000000000, 1) == 0x80000000000000000000000000000001
; run: %bor_i128(0x00000000000000010000000000000000, 0x0000000000000000ffffffffffffffff) == 0x0000000000000001ffffffffffffffff

function %bxor_i128(i128, i128) -> i128 {
block0(v0: i128, v1: i128):
    v2 = bxor v0, v1
    return v2
}
; run: %bxor_i128(0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0xf1317131f131713101317131f1317131
; run: %bxor_i128(0x0123456789abcdeffedcba9876543210, 0xfedcba98765432100123456789abcdef) == -1
; run: %bxor_i128(-1, 0x00000000000000017fffffffffffffff) == 0xfffffffffffffffe8000000000000000
; run: %bxor_i128(0, 0x0123456789abcdeffedcba9876543210) == 0x0123456789abcdeffedcba9876543210
; run: %bxor_i128(0x80000000000000000000000000000000, 1) == 0x80000000000000000000000000000001
; run: %bxor_i128(0x00000000000000010000000000000000, 0x0000000000000000ffffffffffffffff) == 0x0000000000000001ffffffffffffffff

function %bnot_i128(i128) -> i128 {
block0(v0: i128):
    v1 = bnot v0
    return v1
}
; run: %bnot_i128(0) == -1
; run: %bnot_i128(1) == -2
; run: %bnot_i128(-1) == 0
; run: %bnot_i128(0x0000000000000000ffffffffffffffff) == 0xffffffffffffffff0000000000000000
; run: %bnot_i128(0x00000000000000010000000000000000) == 0xfffffffffffffffeffffffffffffffff
; run: %bnot_i128(0x80000000000000000000000000000000) == 0x7fffffffffffffffffffffffffffffff
; run: %bnot_i128(0x7fffffffffffffffffffffffffffffff) == 0x80000000000000000000000000000000
; run: %bnot_i128(0x0123456789abcdeffedcba9876543210) == 0xfedcba98765432100123456789abcdef
; run: %bnot_i128(0xf0123456789abcdeffedcba987654321) == 0x0fedcba98765432100123456789abcde
; run: %bnot_i128(0x00000000000000017fffffffffffffff) == 0xfffffffffffffffe8000000000000000
; run: %bnot_i128(0xfffffffffffffffe8000000000000000) == 0x00000000000000017fffffffffffffff

function %band_not_i128(i128, i128) -> i128 {
block0(v0: i128, v1: i128):
    v2 = bnot v1
    v3 = band v0, v2
    return v3
}
; run: %band_not_i128(0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0x01214121812141210010301070103010
; run: %band_not_i128(0x0123456789abcdeffedcba9876543210, 0xfedcba98765432100123456789abcdef) == 0x0123456789abcdeffedcba9876543210
; run: %band_not_i128(-1, 0x00000000000000017fffffffffffffff) == 0xfffffffffffffffe8000000000000000
; run: %band_not_i128(0, 0x0123456789abcdeffedcba9876543210) == 0
; run: %band_not_i128(0x80000000000000000000000000000000, 1) == 0x80000000000000000000000000000000
; run: %band_not_i128(0x00000000000000010000000000000000, 0x0000000000000000ffffffffffffffff) == 0x00000000000000010000000000000000

function %bitselect_i128(i128, i128, i128) -> i128 {
block0(v0: i128, v1: i128, v2: i128):
    v3 = bitselect v0, v1, v2
    return v3
}
; run: %bitselect_i128(0x0000000000000000ffffffffffffffff, 0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0xf0123456789abcdefedcba9876543210
; run: %bitselect_i128(0xffffffffffffffff0000000000000000, 0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0x0123456789abcdefffedcba987654321
; run: %bitselect_i128(0, 0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0xf0123456789abcdeffedcba987654321
; run: %bitselect_i128(-1, 0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0x0123456789abcdeffedcba9876543210
; run: %bitselect_i128(0x00ff00ff00ff00ff0f0f0f0f0f0f0f0f, 0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0xf023346778abbceffeeccaa886644220

function %bitrev_i128(i128) -> i128 {
block0(v0: i128):
    v1 = bitrev v0
    return v1
}
; run: %bitrev_i128(0) == 0
; run: %bitrev_i128(1) == 0x80000000000000000000000000000000
; run: %bitrev_i128(-1) == -1
; run: %bitrev_i128(0x0000000000000000ffffffffffffffff) == 0xffffffffffffffff0000000000000000
; run: %bitrev_i128(0x00000000000000010000000000000000) == 0x00000000000000008000000000000000
; run: %bitrev_i128(0x80000000000000000000000000000000) == 1
; run: %bitrev_i128(0x7fffffffffffffffffffffffffffffff) == -2
; run: %bitrev_i128(0x0123456789abcdeffedcba9876543210) == 0x084c2a6e195d3b7ff7b3d591e6a2c480
; run: %bitrev_i128(0xf0123456789abcdeffedcba987654321) == 0x84c2a6e195d3b7ff7b3d591e6a2c480f
; run: %bitrev_i128(0x00000000000000017fffffffffffffff) == 0xfffffffffffffffe8000000000000000
; run: %bitrev_i128(0xfffffffffffffffe8000000000000000) == 0x00000000000000017fffffffffffffff

