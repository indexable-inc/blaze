; run: %rotl_i128_i8(0x0123456789abcdeffedcba9876543210, -1) == 0x0091a2b3c4d5e6f7ff6e5d4c3b2a1908
; run: %rotl_i128_i8(0x80000000000000000000000000000001, 1) == 3
; run: %rotl_i128_i8(0x00000000000000010000000000000000, 64) == 1

