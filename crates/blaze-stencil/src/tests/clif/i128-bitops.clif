; run: %bswap_i128(0xf0123456789abcdeffedcba987654321) == 0x21436587a9cbedffdebc9a78563412f0
; run: %bswap_i128(0x00000000000000017fffffffffffffff) == 0xffffffffffffff7f0100000000000000
; run: %bswap_i128(0xfffffffffffffffe8000000000000000) == 0x0000000000000080feffffffffffffff

