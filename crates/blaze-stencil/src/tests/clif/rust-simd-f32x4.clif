function %_mm_shuffle_ps_1b(i64 sret, i64, i64) {
block0(v0: i64, v1: i64, v2: i64):
    v3 = load.f32x4 notrap aligned v1
    v4 = load.f32x4 notrap aligned v2
    v5 = bitcast.i8x16 little v3
    v6 = bitcast.i8x16 little v4
    v7 = shuffle v5, v6, [12 13 14 15 8 9 10 11 20 21 22 23 16 17 18 19]
    v8 = bitcast.f32x4 little v7
    store notrap aligned v8, v0
    return
}

function %binop(f32x4, f32x4, i8) -> f32x4 {
    ss0 = explicit_slot 48, align = 16
    fn0 = %_mm_add_ps(i64 sret, i64, i64)
    fn1 = %_mm_min_ps(i64 sret, i64, i64)
    fn2 = %_mm_max_ps(i64 sret, i64, i64)
    fn3 = %vminq_f32(i64 sret, i64, i64)
    fn4 = %vmaxq_f32(i64 sret, i64, i64)
    fn5 = %vmulq_f32(i64 sret, i64, i64)
    fn6 = %_mm_shuffle_ps_1b(i64 sret, i64, i64)

block0(v0: f32x4, v1: f32x4, v2: i8):
    v3 = stack_addr.i64 ss0
    v4 = stack_addr.i64 ss0+16
    v5 = stack_addr.i64 ss0+32
    store notrap aligned v0, v4
    store notrap aligned v1, v5
    v6 = uextend.i32 v2
    br_table v6, block8, [block1, block2, block3, block4, block5, block6, block7]

block1:
    call fn0(v3, v4, v5)
    jump block9

block2:
    call fn1(v3, v4, v5)
    jump block9

block3:
    call fn2(v3, v4, v5)
    jump block9

block4:
    call fn3(v3, v4, v5)
    jump block9

block5:
    call fn4(v3, v4, v5)
    jump block9

block6:
    call fn5(v3, v4, v5)
    jump block9

block7:
    call fn6(v3, v4, v5)
    jump block9

block8 cold:
    trap user2

block9:
    v7 = load.f32x4 notrap aligned v3
    return v7
}
