; Shaped like what hir-ty-codegen makes for `core::arch` SSE/NEON float lane ops on
; `__m128`/`float32x4_t`, each vector behind a pointer and the result through a
; `StructReturn` pointer as the Rust ABI passes them: `_mm_add_ps` and `_mm_cmplt_ps` as
; the builder's per-lane float ops (four scalar loads, operations and stores; a compare
; widened to an all-ones lane), `_mm_min_ps`/`_mm_max_ps` as its `minps`/`maxps` (`fcmp lt`,
; a little-endian bitcast of the mask, `bitselect`: the second operand wins on a NaN or
; equal zeros), `vminq_f32`/`vmaxq_f32` as `fmin`/`fmax` (NaN wins, -0 < +0),
; `vmulq_f32`, `vnegq_f32`, `vabsq_f32`, `_mm_sqrt_ps`, `_mm_cvtepi32_ps` (round to nearest
; even), `_mm_shuffle_ps` (a byte `shuffle` between bitcasts) and `_mm_movemask_ps`
; (`vhigh_bits`). The wrapper after each takes and returns vectors by value.
test interpret
test run
target x86_64
target aarch64

function %_mm_add_ps(i64 sret, i64, i64) {
block0(v0: i64, v1: i64, v2: i64):
    v3 = load.f32 notrap aligned v1
    v4 = load.f32 notrap aligned v2
    v5 = fadd v3, v4
    store notrap aligned v5, v0
    v6 = load.f32 notrap aligned v1+4
    v7 = load.f32 notrap aligned v2+4
    v8 = fadd v6, v7
    store notrap aligned v8, v0+4
    v9 = load.f32 notrap aligned v1+8
    v10 = load.f32 notrap aligned v2+8
    v11 = fadd v9, v10
    store notrap aligned v11, v0+8
    v12 = load.f32 notrap aligned v1+12
    v13 = load.f32 notrap aligned v2+12
    v14 = fadd v12, v13
    store notrap aligned v14, v0+12
    return
}

function %_mm_cmplt_ps(i64 sret, i64, i64) {
block0(v0: i64, v1: i64, v2: i64):
    v3 = load.f32 notrap aligned v1
    v4 = load.f32 notrap aligned v2
    v5 = fcmp lt v3, v4
    v6 = uextend.i32 v5
    v7 = ineg v6
    store notrap aligned v7, v0
    v8 = load.f32 notrap aligned v1+4
    v9 = load.f32 notrap aligned v2+4
    v10 = fcmp lt v8, v9
    v11 = uextend.i32 v10
    v12 = ineg v11
    store notrap aligned v12, v0+4
    v13 = load.f32 notrap aligned v1+8
    v14 = load.f32 notrap aligned v2+8
    v15 = fcmp lt v13, v14
    v16 = uextend.i32 v15
    v17 = ineg v16
    store notrap aligned v17, v0+8
    v18 = load.f32 notrap aligned v1+12
    v19 = load.f32 notrap aligned v2+12
    v20 = fcmp lt v18, v19
    v21 = uextend.i32 v20
    v22 = ineg v21
    store notrap aligned v22, v0+12
    return
}

function %_mm_min_ps(i64 sret, i64, i64) {
block0(v0: i64, v1: i64, v2: i64):
    v3 = load.f32x4 notrap aligned v1
    v4 = load.f32x4 notrap aligned v2
    v5 = fcmp lt v3, v4
    v6 = bitcast.f32x4 little v5
    v7 = bitselect v6, v3, v4
    store notrap aligned v7, v0
    return
}

function %_mm_max_ps(i64 sret, i64, i64) {
block0(v0: i64, v1: i64, v2: i64):
    v3 = load.f32x4 notrap aligned v1
    v4 = load.f32x4 notrap aligned v2
    v5 = fcmp lt v4, v3
    v6 = bitcast.f32x4 little v5
    v7 = bitselect v6, v3, v4
    store notrap aligned v7, v0
    return
}

