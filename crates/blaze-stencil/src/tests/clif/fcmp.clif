; Follows cranelift/filetests/filetests/runtests/fcmp.clif (and fcmp-eq.clif, fcmp-ne.clif,
; fcmp-lt.clif, fcmp-le.clif, fcmp-gt.clif, fcmp-ge.clif, fcmp-ord.clif, fcmp-uno.clif,
; fcmp-one.clif, fcmp-ueq.clif, fcmp-ult.clif, fcmp-ule.clif, fcmp-ugt.clif, fcmp-uge.clif),
; for the stencil set: all fourteen conditions of scalar `fcmp` on f32 and f64, against NaN on
; either side and on both, -0.0 against +0.0 (equal), infinities, the largest finite values
; and subnormals; then each condition's result used by the `brif` right after it, which both
; backends fuse into a branch on the flags. Vector `fcmp` is the simd files'.
test interpret
test run
target x86_64
target aarch64

function %fcmp_eq_f32(f32, f32) -> i8 {
block0(v0: f32, v1: f32):
    v2 = fcmp eq v0, v1
    return v2
}
; run: %fcmp_eq_f32(0x1.0p0, 0x1.0p1) == 0
; run: %fcmp_eq_f32(0x1.0p1, 0x1.0p0) == 0
; run: %fcmp_eq_f32(0x1.0p0, 0x1.0p0) == 1
; run: %fcmp_eq_f32(-0x1.0p1, -0x1.0p0) == 0
; run: %fcmp_eq_f32(0x0.0, -0x0.0) == 1
; run: %fcmp_eq_f32(-0x0.0, 0x0.0) == 1
; run: %fcmp_eq_f32(+NaN, 0x1.0p0) == 0
; run: %fcmp_eq_f32(-Inf, +NaN) == 0
; run: %fcmp_eq_f32(+NaN, +NaN) == 0
; run: %fcmp_eq_f32(+Inf, +Inf) == 1
; run: %fcmp_eq_f32(-Inf, +Inf) == 0
; run: %fcmp_eq_f32(+Inf, 0x1.fffffep127) == 0
; run: %fcmp_eq_f32(-Inf, -0x1.fffffep127) == 0
; run: %fcmp_eq_f32(0x0.000002p-126, 0x0.0) == 0
; run: %fcmp_eq_f32(-0x0.000002p-126, -0x0.0) == 0
; run: %fcmp_eq_f32(0x0.000002p-126, 0x0.000004p-126) == 0

