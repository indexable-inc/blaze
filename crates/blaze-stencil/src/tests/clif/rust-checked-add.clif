; Shaped like what hir-ty-codegen makes for `u32::checked_add`, `u8::checked_add`,
; `i32::checked_add` and a debug build's overflow-checked `+`, `-` and `+ 1`:
; `uadd_overflow`/`sadd_overflow`/`usub_overflow`, then `brif` on the flag. An
; `Option<u32>` is a scalar pair (discriminant, value) with `None` as (0, 0); the checked
; operators branch to a cold block calling `core::panicking::panic_const::panic_const_*`
; (here a function that traps) and trap after it.
test interpret
test run
target x86_64
target aarch64

function %u32_checked_add(i32, i32) -> i32, i32 {
block0(v0: i32, v1: i32):
    v2, v3 = uadd_overflow v0, v1
    brif v3, block2, block1

block1:
    v4 = iconst.i32 1
    return v4, v2

block2:
    v5 = iconst.i32 0
    return v5, v5
}
; run: %u32_checked_add(1, 2) == [1, 3]
; run: %u32_checked_add(0, 0) == [1, 0]
; run: %u32_checked_add(0xffffffff, 0) == [1, 0xffffffff]
; run: %u32_checked_add(0, 0xffffffff) == [1, 0xffffffff]
; run: %u32_checked_add(0xffffffff, 1) == [0, 0]
; run: %u32_checked_add(1, 0xffffffff) == [0, 0]
; run: %u32_checked_add(0x80000000, 0x80000000) == [0, 0]
; run: %u32_checked_add(0x7fffffff, 0x80000000) == [1, 0xffffffff]
; run: %u32_checked_add(0xfffffffe, 0xffffffff) == [0, 0]
; run: %u32_checked_add(0xffffffff, 0xffffffff) == [0, 0]

function %u8_checked_add(i8, i8) -> i8, i8 {
block0(v0: i8, v1: i8):
    v2, v3 = uadd_overflow v0, v1
    brif v3, block2, block1

block1:
    v4 = iconst.i8 1
    return v4, v2

block2:
    v5 = iconst.i8 0
    return v5, v5
}
; run: %u8_checked_add(2, 3) == [1, 5]
; run: %u8_checked_add(0xc8, 0x37) == [1, 0xff]
; run: %u8_checked_add(0xc8, 0x38) == [0, 0]
; run: %u8_checked_add(0x7f, 0x01) == [1, 0x80]
; run: %u8_checked_add(0x80, 0x80) == [0, 0]
; run: %u8_checked_add(0xff, 0xff) == [0, 0]
; run: %u8_checked_add(0, 0) == [1, 0]

function %i32_checked_add(i32, i32) -> i32, i32 {
block0(v0: i32, v1: i32):
    v2, v3 = sadd_overflow v0, v1
    brif v3, block2, block1

block1:
    v4 = iconst.i32 1
    return v4, v2

block2:
    v5 = iconst.i32 0
    return v5, v5
}
; run: %i32_checked_add(-5, -7) == [1, -12]
; run: %i32_checked_add(-1, 1) == [1, 0]
; run: %i32_checked_add(0x7fffffff, 1) == [0, 0]
; run: %i32_checked_add(0x7fffffff, 0) == [1, 0x7fffffff]
; run: %i32_checked_add(0x80000000, -1) == [0, 0]
; run: %i32_checked_add(0x80000000, 0) == [1, 0x80000000]
; run: %i32_checked_add(0x80000000, 0x7fffffff) == [1, -1]
; run: %i32_checked_add(0x80000000, 0x80000000) == [0, 0]
; run: %i32_checked_add(0x40000000, 0x40000000) == [0, 0]
; run: %i32_checked_add(0x3fffffff, 0x40000000) == [1, 0x7fffffff]
; run: %i32_checked_add(0xc0000000, 0xc0000000) == [1, 0x80000000]
; run: %i32_checked_add(0xc0000000, 0xbfffffff) == [0, 0]

function %panic_const_add_overflow(i64) {
block0(v0: i64):
    trap user1
}

function %panic_const_sub_overflow(i64) {
block0(v0: i64):
    trap user1
}

function %add(i32, i32) -> i32 {
    fn0 = %panic_const_add_overflow(i64)

block0(v0: i32, v1: i32):
    v2, v3 = uadd_overflow v0, v1
    brif v3, block2, block1

block1:
    return v2

block2 cold:
    v4 = iconst.i64 0
    call fn0(v4)
    trap user1
}
; run: %add(40, 2) == 42
; run: %add(0, 0) == 0
; run: %add(0xfffffffe, 1) == 0xffffffff
; run: %add(0x7fffffff, 0x80000000) == 0xffffffff
; trap: %add(0xffffffff, 1)
; trap: %add(0x80000000, 0x80000000)
; trap: %add(0xffffffff, 0xffffffff)

function %sub(i32, i32) -> i32 {
    fn0 = %panic_const_sub_overflow(i64)

block0(v0: i32, v1: i32):
    v2, v3 = usub_overflow v0, v1
    brif v3, block2, block1

block1:
    return v2

block2 cold:
    v4 = iconst.i64 0
    call fn0(v4)
    trap user1
}
; run: %sub(5, 3) == 2
; run: %sub(3, 3) == 0
; run: %sub(0xffffffff, 0xffffffff) == 0
; run: %sub(0xffffffff, 0) == 0xffffffff
; run: %sub(0x80000000, 1) == 0x7fffffff
; trap: %sub(3, 5)
; trap: %sub(0, 1)
; trap: %sub(0x7fffffff, 0x80000000)

function %inc_u64(i64) -> i64 {
    fn0 = %panic_const_add_overflow(i64)

block0(v0: i64):
    v1 = iconst.i64 1
    v2, v3 = uadd_overflow v0, v1
    brif v3, block2, block1

block1:
    return v2

block2 cold:
    v4 = iconst.i64 0
    call fn0(v4)
    trap user1
}
; run: %inc_u64(0) == 1
; run: %inc_u64(0x7fffffffffffffff) == 0x8000000000000000
; run: %inc_u64(0xfffffffffffffffe) == -1
; trap: %inc_u64(-1)
