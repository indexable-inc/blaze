function %umin_rev_i8(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v2 = icmp ugt v0, v1
    v3 = select v2, v1, v0
    return v3
}
; run: %umin_rev_i8(1, 2) == 1
; run: %umin_rev_i8(-1, 1) == 1
; run: %umin_rev_i8(-128, 127) == 127
; run: %umin_rev_i8(0, -1) == 0

function %smin_rev_i32(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = icmp sge v0, v1
    v3 = select v2, v1, v0
    return v3
}
; run: %smin_rev_i32(1, 2) == 1
; run: %smin_rev_i32(2, 1) == 1
; run: %smin_rev_i32(-1, 1) == -1
; run: %smin_rev_i32(3, 3) == 3

function %umax_rev_i16(i16, i16) -> i16 {
block0(v0: i16, v1: i16):
    v2 = icmp ule v0, v1
    v3 = select v2, v1, v0
    return v3
}
; run: %umax_rev_i16(1, 2) == 2
; run: %umax_rev_i16(-1, 1) == -1
; run: %umax_rev_i16(0x7fff, 0x8000) == 0x8000

function %select_eq_i32(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = icmp eq v0, v1
    v3 = select v2, v0, v1
    return v3
}
; run: %select_eq_i32(1, 2) == 2
; run: %select_eq_i32(3, 3) == 3
; run: %select_eq_i32(-1, 0) == 0

function %select_ne_i64(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = icmp ne v0, v1
    v3 = select v2, v0, v1
    return v3
}
; run: %select_ne_i64(1, 2) == 1
; run: %select_ne_i64(3, 3) == 3
; run: %select_ne_i64(0x100000000, 0) == 0x100000000

function %relu_i64(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 0
    v2 = icmp sgt v0, v1
    v3 = select v2, v0, v1
    return v3
}
; run: %relu_i64(5) == 5
; run: %relu_i64(0) == 0
; run: %relu_i64(-5) == 0
; run: %relu_i64(0x8000000000000000) == 0
; run: %relu_i64(0x7fffffffffffffff) == 0x7fffffffffffffff

function %clamp_high_i32(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 100
    v2 = icmp slt v0, v1
    v3 = select v2, v0, v1
    return v3
}
; run: %clamp_high_i32(5) == 5
; run: %clamp_high_i32(100) == 100
; run: %clamp_high_i32(101) == 100
; run: %clamp_high_i32(-1000) == -1000
; run: %clamp_high_i32(0x7fffffff) == 100

function %min_then_max_i16(i16, i16, i16) -> i16 {
block0(v0: i16, v1: i16, v2: i16):
    v3 = icmp slt v0, v1
    v4 = select v3, v0, v1
    v5 = icmp sgt v4, v2
    v6 = select v5, v4, v2
    return v6
}
; run: %min_then_max_i16(5, 10, 0) == 5
; run: %min_then_max_i16(50, 10, 0) == 10
; run: %min_then_max_i16(-5, 10, 0) == 0
; run: %min_then_max_i16(0x8000, 0x7fff, -1) == -1

function %smin_i128(i128, i128) -> i128 {
block0(v0: i128, v1: i128):
    v2 = icmp slt v0, v1
    v3 = select v2, v0, v1
    return v3
}
; run: %smin_i128(1, 2) == 1
; run: %smin_i128(-1, 1) == -1
; run: %smin_i128(0x00000000000000010000000000000000, 0x0000000000000000ffffffffffffffff) == 0x0000000000000000ffffffffffffffff
; run: %smin_i128(0x80000000000000000000000000000000, 0x7fffffffffffffffffffffffffffffff) == 0x80000000000000000000000000000000
