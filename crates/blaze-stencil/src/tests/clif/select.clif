; Follows cranelift/filetests/filetests/runtests/select.clif (and select-spectre-guard.clif,
; and the `smin`/`umax` idioms of smin-umax-select), for the stencil set: `select` and
; `select_spectre_guard` of every value type the set computes with (`i8` to `i128`, `f32`,
; `f64`, the six vector types), with conditions of `i8` to `i64` (any bit set is true: `0x100`
; in an `i16`, the high half of an `i64`); `select` of constants; and `select (icmp cc a b), a,
; b` and `select (icmp cc a b), b, a` of several conditions, the min and max idioms the
; stencil backend fuses into one stencil. `f16` and `f128` selects are left out (the set only
; moves them), and so is an `i128` condition (the set has none).
test interpret
test run
target x86_64
target aarch64

function %select_i8(i8, i8, i8) -> i8 {
block0(v0: i8, v1: i8, v2: i8):
    v3 = select v0, v1, v2
    return v3
}
; run: %select_i8(1, 10, 20) == 10
; run: %select_i8(0, 10, 20) == 20
; run: %select_i8(-1, -128, 127) == -128
; run: %select_i8(-128, 1, 2) == 1
; run: %select_i8(0, -128, 127) == 127

function %select_i16(i8, i16, i16) -> i16 {
block0(v0: i8, v1: i16, v2: i16):
    v3 = select v0, v1, v2
    return v3
}
; run: %select_i16(1, 0x1234, 0xabcd) == 0x1234
; run: %select_i16(0, 0x1234, 0xabcd) == 0xabcd
; run: %select_i16(2, -1, 0) == -1

function %select_i32(i8, i32, i32) -> i32 {
block0(v0: i8, v1: i32, v2: i32):
    v3 = select v0, v1, v2
    return v3
}
; run: %select_i32(1, 0x12345678, 0x9abcdef0) == 0x12345678
; run: %select_i32(0, 0x12345678, 0x9abcdef0) == 0x9abcdef0
; run: %select_i32(0x40, 0x80000000, 0x7fffffff) == 0x80000000

function %select_i64(i8, i64, i64) -> i64 {
block0(v0: i8, v1: i64, v2: i64):
    v3 = select v0, v1, v2
    return v3
}
; run: %select_i64(1, 0x0123456789abcdef, 0xfedcba9876543210) == 0x0123456789abcdef
; run: %select_i64(0, 0x0123456789abcdef, 0xfedcba9876543210) == 0xfedcba9876543210
; run: %select_i64(-1, 0x8000000000000000, 0) == 0x8000000000000000

function %select_i128(i8, i128, i128) -> i128 {
block0(v0: i8, v1: i128, v2: i128):
    v3 = select v0, v1, v2
    return v3
}
; run: %select_i128(1, 0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0x0123456789abcdeffedcba9876543210
; run: %select_i128(0, 0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0xf0123456789abcdeffedcba987654321
; run: %select_i128(4, -1, 0) == -1
; run: %select_i128(0, -1, 0x00000000000000010000000000000000) == 0x00000000000000010000000000000000

function %select_f32(i8, f32, f32) -> f32 {
block0(v0: i8, v1: f32, v2: f32):
    v3 = select v0, v1, v2
    return v3
}
; run: %select_f32(1, 0x1.0p0, -0x1.8p1) == 0x1.0p0
; run: %select_f32(0, 0x1.0p0, -0x1.8p1) == -0x1.8p1
; run: %select_f32(1, -0x0.0, 0x0.0) == -0x0.0
; run: %select_f32(0, -0x0.0, 0x0.0) == 0x0.0
; run: %select_f32(1, +NaN, 0x1.0p0) == +NaN
; run: %select_f32(0, +NaN, +Inf) == +Inf
; run: %select_f32(1, 0x0.000002p-126, -Inf) == 0x0.000002p-126

