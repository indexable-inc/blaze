function %spectre_icmp_bound(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 0
    v3 = icmp ult v0, v1
    v4 = select_spectre_guard v3, v0, v2
    return v4
}
; run: %spectre_icmp_bound(3, 10) == 3
; run: %spectre_icmp_bound(10, 10) == 0
; run: %spectre_icmp_bound(-1, 10) == 0

function %smin_i8(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v2 = icmp slt v0, v1
    v3 = select v2, v0, v1
    return v3
}
; run: %smin_i8(1, 2) == 1
; run: %smin_i8(2, 1) == 1
; run: %smin_i8(-1, 1) == -1
; run: %smin_i8(-128, 127) == -128
; run: %smin_i8(127, -128) == -128
; run: %smin_i8(5, 5) == 5

