function %select_icmp_result(i32, i32, i64, i64) -> i64 {
block0(v0: i32, v1: i32, v2: i64, v3: i64):
    v4 = icmp ult v0, v1
    v5 = select v4, v2, v3
    return v5
}
; run: %select_icmp_result(1, 2, 10, 20) == 10
; run: %select_icmp_result(2, 1, 10, 20) == 20
; run: %select_icmp_result(1, -1, 10, 20) == 10
; run: %select_icmp_result(-1, 1, 10, 20) == 20

function %select_consts(i8) -> i32 {
