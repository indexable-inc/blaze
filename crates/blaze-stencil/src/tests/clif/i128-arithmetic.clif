function %iconcat(i64, i64) -> i128 {
block0(v0: i64, v1: i64):
    v2 = iconcat v0, v1
    return v2
}
; run: %iconcat(1, 2) == 0x00000000000000020000000000000001
; run: %iconcat(-1, 0) == 0x0000000000000000ffffffffffffffff
; run: %iconcat(0, 0x8000000000000000) == 0x80000000000000000000000000000000
; run: %iconcat(0xfedcba9876543210, 0x0123456789abcdef) == 0x0123456789abcdeffedcba9876543210
; run: %iconcat(-1, -1) == -1

function %isplit(i128) -> i64, i64 {
block0(v0: i128):
    v1, v2 = isplit v0
    return v1, v2
}
; run: %isplit(1) == [1, 0]
; run: %isplit(-1) == [-1, -1]
; run: %isplit(0x0123456789abcdeffedcba9876543210) == [0xfedcba9876543210, 0x0123456789abcdef]
; run: %isplit(0x80000000000000000000000000000000) == [0, 0x8000000000000000]
; run: %isplit(0x00000000000000010000000000000000) == [0, 1]

function %split_swap_concat(i128) -> i128 {
block0(v0: i128):
    v1, v2 = isplit v0
    v3 = iconcat v2, v1
    return v3
}
; run: %split_swap_concat(1) == 0x00000000000000010000000000000000
; run: %split_swap_concat(0x0123456789abcdeffedcba9876543210) == 0xfedcba98765432100123456789abcdef
; run: %split_swap_concat(0xf0123456789abcdeffedcba987654321) == 0xffedcba987654321f0123456789abcde
; run: %split_swap_concat(0x80000000000000000000000000000000) == 0x00000000000000008000000000000000

function %add_halves(i128) -> i64 {
block0(v0: i128):
    v1, v2 = isplit v0
    v3 = iadd v1, v2
    return v3
}
