; Follows cranelift/filetests/filetests/runtests/i128-arithmetic.clif (and i128-extend.clif,
; i128-concat-split.clif, i128-ireduce.clif), for the stencil set: `iadd`, `isub`, `imul`,
; `ineg`, `iabs` and the four add and subtract overflow ops of `i128`, with carries and
; borrows across the 64-bit halves (each overflow op in two functions, one returning the
; value and one the flag, as a signature returns at most two integer registers); `iconcat`
; and `isplit`; `uextend` and `sextend` to
; `i128` from each width; `ireduce` from `i128` to each. `udiv`, `sdiv`, `urem` and `srem`
; of `i128` are left out: the stencil set has none (the IR builder calls `__udivti3` and
; friends), and so are `umul_overflow` and `smul_overflow` of it, for the same reason.
test interpret
test run
target x86_64
target aarch64

function %iadd_i128(i128, i128) -> i128 {
block0(v0: i128, v1: i128):
    v2 = iadd v0, v1
    return v2
}
; run: %iadd_i128(1, 2) == 3
; run: %iadd_i128(0x0000000000000000ffffffffffffffff, 1) == 0x00000000000000010000000000000000
; run: %iadd_i128(0x00000000000000010000000000000000, 0x0000000000000000ffffffffffffffff) == 0x0000000000000001ffffffffffffffff
; run: %iadd_i128(-1, 1) == 0
; run: %iadd_i128(0x7fffffffffffffffffffffffffffffff, 1) == 0x80000000000000000000000000000000
; run: %iadd_i128(0x80000000000000000000000000000000, -1) == 0x7fffffffffffffffffffffffffffffff
; run: %iadd_i128(0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0xf13579be02468acefeca8641fdb97531
; run: %iadd_i128(0x00000000000000010000000000000002, 0x00000000000000010000000000000003) == 0x00000000000000020000000000000005
; run: %iadd_i128(-1, -1) == -2
; run: %iadd_i128(0, 0) == 0

function %isub_i128(i128, i128) -> i128 {
block0(v0: i128, v1: i128):
    v2 = isub v0, v1
    return v2
}
; run: %isub_i128(1, 2) == -1
; run: %isub_i128(0x0000000000000000ffffffffffffffff, 1) == 0x0000000000000000fffffffffffffffe
; run: %isub_i128(0x00000000000000010000000000000000, 0x0000000000000000ffffffffffffffff) == 1
; run: %isub_i128(-1, 1) == -2
; run: %isub_i128(0x7fffffffffffffffffffffffffffffff, 1) == 0x7ffffffffffffffffffffffffffffffe
; run: %isub_i128(0x80000000000000000000000000000000, -1) == 0x80000000000000000000000000000001
; run: %isub_i128(0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0x1111111111111110feeeeeeeeeeeeeef
; run: %isub_i128(0x00000000000000010000000000000002, 0x00000000000000010000000000000003) == -1
; run: %isub_i128(-1, -1) == 0
; run: %isub_i128(0, 0) == 0
; run: %isub_i128(0, 1) == -1
; run: %isub_i128(0x00000000000000010000000000000000, 1) == 0x0000000000000000ffffffffffffffff
; run: %isub_i128(0x80000000000000000000000000000000, 1) == 0x7fffffffffffffffffffffffffffffff

function %imul_i128(i128, i128) -> i128 {
block0(v0: i128, v1: i128):
    v2 = imul v0, v1
    return v2
}
; run: %imul_i128(1, 2) == 2
; run: %imul_i128(0x0000000000000000ffffffffffffffff, 1) == 0x0000000000000000ffffffffffffffff
; run: %imul_i128(0x00000000000000010000000000000000, 0x0000000000000000ffffffffffffffff) == 0xffffffffffffffff0000000000000000
; run: %imul_i128(-1, 1) == -1
; run: %imul_i128(0x7fffffffffffffffffffffffffffffff, 1) == 0x7fffffffffffffffffffffffffffffff
; run: %imul_i128(0x80000000000000000000000000000000, -1) == 0x80000000000000000000000000000000
; run: %imul_i128(0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0x6422871b7939f74acdeec6cd7a44a410
; run: %imul_i128(0x00000000000000010000000000000002, 0x00000000000000010000000000000003) == 0x00000000000000050000000000000006
; run: %imul_i128(-1, -1) == 1
; run: %imul_i128(0, 0) == 0
; run: %imul_i128(0x0000000000000000ffffffffffffffff, 0x0000000000000000ffffffffffffffff) == 0xfffffffffffffffe0000000000000001
; run: %imul_i128(0x00000000000000010000000000000000, 0x00000000000000010000000000000000) == 0
; run: %imul_i128(0x00000000000000010000000000000001, 3) == 0x00000000000000030000000000000003
; run: %imul_i128(-1, 5) == -5
; run: %imul_i128(0x80000000000000000000000000000000, -1) == 0x80000000000000000000000000000000

function %ineg_i128(i128) -> i128 {
block0(v0: i128):
    v1 = ineg v0
    return v1
}
; run: %ineg_i128(0) == 0
; run: %ineg_i128(1) == -1
; run: %ineg_i128(-1) == 1
; run: %ineg_i128(0x0000000000000000ffffffffffffffff) == 0xffffffffffffffff0000000000000001
; run: %ineg_i128(0x00000000000000010000000000000000) == 0xffffffffffffffff0000000000000000
; run: %ineg_i128(0xffffffffffffffff0000000000000000) == 0x00000000000000010000000000000000
; run: %ineg_i128(0x80000000000000000000000000000000) == 0x80000000000000000000000000000000
; run: %ineg_i128(0x7fffffffffffffffffffffffffffffff) == 0x80000000000000000000000000000001
; run: %ineg_i128(0x0123456789abcdeffedcba9876543210) == 0xfedcba98765432100123456789abcdf0
; run: %ineg_i128(0xf0123456789abcdeffedcba987654321) == 0x0fedcba98765432100123456789abcdf

function %iabs_i128(i128) -> i128 {
block0(v0: i128):
    v1 = iabs v0
    return v1
}
; run: %iabs_i128(0) == 0
; run: %iabs_i128(1) == 1
; run: %iabs_i128(-1) == 1
; run: %iabs_i128(0x0000000000000000ffffffffffffffff) == 0x0000000000000000ffffffffffffffff
; run: %iabs_i128(0x00000000000000010000000000000000) == 0x00000000000000010000000000000000
; run: %iabs_i128(0xffffffffffffffff0000000000000000) == 0x00000000000000010000000000000000
; run: %iabs_i128(0x80000000000000000000000000000000) == 0x80000000000000000000000000000000
; run: %iabs_i128(0x7fffffffffffffffffffffffffffffff) == 0x7fffffffffffffffffffffffffffffff
; run: %iabs_i128(0x0123456789abcdeffedcba9876543210) == 0x0123456789abcdeffedcba9876543210
; run: %iabs_i128(0xf0123456789abcdeffedcba987654321) == 0x0fedcba98765432100123456789abcdf

function %uadd_overflow_i128_value(i128, i128) -> i128 {
block0(v0: i128, v1: i128):
    v2, v3 = uadd_overflow v0, v1
    return v2
}
; run: %uadd_overflow_i128_value(1, 2) == 3
; run: %uadd_overflow_i128_value(0x0000000000000000ffffffffffffffff, 1) == 0x00000000000000010000000000000000
