; run: %uadd_overflow_i128_value(0x80000000000000000000000000000000, -1) == 0x7fffffffffffffffffffffffffffffff
; run: %uadd_overflow_i128_value(0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0xf13579be02468acefeca8641fdb97531
; run: %uadd_overflow_i128_value(0x00000000000000010000000000000002, 0x00000000000000010000000000000003) == 0x00000000000000020000000000000005
; run: %uadd_overflow_i128_value(-1, -1) == -2
; run: %uadd_overflow_i128_value(0, 0) == 0
; run: %uadd_overflow_i128_value(0, 1) == 1
; run: %uadd_overflow_i128_value(0x00000000000000010000000000000000, 1) == 0x00000000000000010000000000000001
; run: %uadd_overflow_i128_value(0x80000000000000000000000000000000, 1) == 0x80000000000000000000000000000001
; run: %uadd_overflow_i128_value(0x7fffffffffffffffffffffffffffffff, -1) == 0x7ffffffffffffffffffffffffffffffe
; run: %uadd_overflow_i128_value(0x00000000000000010000000000000000, 0x00000000000000020000000000000000) == 0x00000000000000030000000000000000

