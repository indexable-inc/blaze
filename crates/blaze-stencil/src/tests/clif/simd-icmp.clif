function %icmp_eq_i32x4(i32x4, i32x4) -> i32x4 {
block0(v0: i32x4, v1: i32x4):
    v2 = icmp eq v0, v1
    return v2
}
; run: %icmp_eq_i32x4([0 1 -1 0x7fffffff], [0 0 1 0x80000000]) == [-1 0 0 0]
; run: %icmp_eq_i32x4([0x80000000 0x80000000 -1 5], [0x7fffffff 0x80000000 0 6]) == [0 -1 0 0]

