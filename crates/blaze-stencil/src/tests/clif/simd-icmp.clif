function %icmp_eq_i64x2(i64x2, i64x2) -> i64x2 {
block0(v0: i64x2, v1: i64x2):
    v2 = icmp eq v0, v1
    return v2
}
; run: %icmp_eq_i64x2([0 1], [0 0]) == [-1 0]
; run: %icmp_eq_i64x2([-1 0x7fffffffffffffff], [1 0x8000000000000000]) == [0 0]
; run: %icmp_eq_i64x2([0x8000000000000000 0x100000000], [0x7fffffffffffffff 0xffffffff]) == [0 0]
; run: %icmp_eq_i64x2([0xffffffff00000000 0x80000000], [0xffffffff 0x7fffffff]) == [0 0]
; run: %icmp_eq_i64x2([0x100000001 0x8000000000000000], [0x100000000 0x8000000000000000]) == [0 -1]

function %icmp_ne_i64x2(i64x2, i64x2) -> i64x2 {
