; run: %icmp_ne_i64x2([0xffffffff00000000 0x80000000], [0xffffffff 0x7fffffff]) == [-1 -1]
; run: %icmp_ne_i64x2([0x100000001 0x8000000000000000], [0x100000000 0x8000000000000000]) == [-1 0]

