    v2 = icmp ne v0, v1
    return v2
}
; run: %icmp_ne_i64x2([0 1], [0 0]) == [0 -1]
; run: %icmp_ne_i64x2([-1 0x7fffffffffffffff], [1 0x8000000000000000]) == [-1 -1]
