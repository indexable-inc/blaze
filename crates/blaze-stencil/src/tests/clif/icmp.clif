; Follows cranelift/filetests/filetests/runtests/icmp.clif (and icmp-eq.clif, icmp-ne.clif,
; icmp-slt.clif, icmp-sge.clif, icmp-sgt.clif, icmp-sle.clif, icmp-ult.clif, icmp-uge.clif,
; icmp-ugt.clif, icmp-ule.clif), for the stencil set: the ten conditions of `i8` to `i64`
; on the edges, each as a value (`icmp_*`), by a `brif` right after (`br_icmp_*`, which the
; stencil backend fuses into one compare-and-branch), as both at once (`icmp_br_*`, not
; fused: the result has two uses), and each of these but the last with an `iconst` second
; operand (folded into an immediate; for `i64` also one of more than 32 bits). `i128` is
; i128-icmp.clif's.
test interpret
test run
target x86_64
target aarch64

function %icmp_eq_i8(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v2 = icmp eq v0, v1
    return v2
}
; run: %icmp_eq_i8(0, 0) == 1
; run: %icmp_eq_i8(0, 1) == 0
; run: %icmp_eq_i8(1, 0) == 0
; run: %icmp_eq_i8(-1, 0) == 0
; run: %icmp_eq_i8(0, -1) == 0
; run: %icmp_eq_i8(-128, 127) == 0
; run: %icmp_eq_i8(127, -128) == 0
; run: %icmp_eq_i8(-128, -128) == 1
; run: %icmp_eq_i8(127, 127) == 1
; run: %icmp_eq_i8(-1, -1) == 1
; run: %icmp_eq_i8(-128, -127) == 0
; run: %icmp_eq_i8(126, 127) == 0
; run: %icmp_eq_i8(-1, 1) == 0
; run: %icmp_eq_i8(100, -77) == 0

function %br_icmp_eq_i8(i8, i8) -> i32 {
block0(v0: i8, v1: i8):
    v2 = icmp eq v0, v1
    brif v2, block1, block2

block1:
    v3 = iconst.i32 1
    return v3

block2:
    v4 = iconst.i32 2
    return v4
}
; run: %br_icmp_eq_i8(0, 0) == 1
; run: %br_icmp_eq_i8(0, 1) == 2
; run: %br_icmp_eq_i8(1, 0) == 2
; run: %br_icmp_eq_i8(-1, 0) == 2
; run: %br_icmp_eq_i8(0, -1) == 2
; run: %br_icmp_eq_i8(-128, 127) == 2
; run: %br_icmp_eq_i8(127, -128) == 2
; run: %br_icmp_eq_i8(-128, -128) == 1
; run: %br_icmp_eq_i8(127, 127) == 1
; run: %br_icmp_eq_i8(-1, -1) == 1
; run: %br_icmp_eq_i8(-128, -127) == 2
; run: %br_icmp_eq_i8(126, 127) == 2
; run: %br_icmp_eq_i8(-1, 1) == 2
; run: %br_icmp_eq_i8(100, -77) == 2

function %icmp_br_eq_i8(i8, i8) -> i8, i32 {
block0(v0: i8, v1: i8):
    v2 = icmp eq v0, v1
    brif v2, block1, block2

block1:
    v3 = iconst.i32 1
    return v2, v3

block2:
    v4 = iconst.i32 2
    return v2, v4
}
; run: %icmp_br_eq_i8(0, 0) == [1, 1]
; run: %icmp_br_eq_i8(0, 1) == [0, 2]
; run: %icmp_br_eq_i8(1, 0) == [0, 2]
; run: %icmp_br_eq_i8(-1, 0) == [0, 2]
; run: %icmp_br_eq_i8(0, -1) == [0, 2]
; run: %icmp_br_eq_i8(-128, 127) == [0, 2]
; run: %icmp_br_eq_i8(127, -128) == [0, 2]
; run: %icmp_br_eq_i8(-128, -128) == [1, 1]

function %icmp_eq_imm_i8(i8) -> i8 {
block0(v0: i8):
    v1 = iconst.i8 254
    v2 = icmp eq v0, v1
    return v2
}
; run: %icmp_eq_imm_i8(-3) == 0
; run: %icmp_eq_imm_i8(-2) == 1
; run: %icmp_eq_imm_i8(-1) == 0
; run: %icmp_eq_imm_i8(0) == 0
; run: %icmp_eq_imm_i8(-128) == 0
; run: %icmp_eq_imm_i8(127) == 0
; run: %icmp_eq_imm_i8(1) == 0

function %br_icmp_eq_imm_i8(i8) -> i32 {
block0(v0: i8):
    v1 = iconst.i8 254
    v2 = icmp eq v0, v1
    brif v2, block1, block2

block1:
    v3 = iconst.i32 1
    return v3

block2:
    v4 = iconst.i32 2
    return v4
}
; run: %br_icmp_eq_imm_i8(-3) == 2
; run: %br_icmp_eq_imm_i8(-2) == 1
; run: %br_icmp_eq_imm_i8(-1) == 2
; run: %br_icmp_eq_imm_i8(0) == 2
; run: %br_icmp_eq_imm_i8(-128) == 2
; run: %br_icmp_eq_imm_i8(127) == 2
; run: %br_icmp_eq_imm_i8(1) == 2

