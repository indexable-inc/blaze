; Follows cranelift/filetests/filetests/runtests/nearest.clif, for the stencil set: scalar
; `nearest` of f32 and f64 (on x86-64's baseline a call of libm's `nearbyintf`/`nearbyint` in
; both backends, so IEEE's rounding to nearest, half to even): halves both ways, values just
; either side of a half, the largest value with a fraction, values already integral,
; subnormals, zeros, infinities and NaN. Vector `nearest` is the simd files'.
test interpret
test run
target x86_64
target aarch64

function %nearest_f32(f32) -> f32 {
block0(v0: f32):
    v1 = nearest v0
    return v1
}
; run: %nearest_f32(0x0.0) == 0x0.0
; run: %nearest_f32(-0x0.0) == -0x0.0
; run: %nearest_f32(0x1.0p-1) == 0x0.0
; run: %nearest_f32(-0x1.0p-1) == -0x0.0
; run: %nearest_f32(0x1.8p0) == 0x1.0p1
; run: %nearest_f32(-0x1.8p0) == -0x1.0p1
; run: %nearest_f32(0x1.4p1) == 0x1.0p1
; run: %nearest_f32(-0x1.4p1) == -0x1.0p1
; run: %nearest_f32(0x1.cp1) == 0x1.0p2
; run: %nearest_f32(-0x1.cp1) == -0x1.0p2
; run: %nearest_f32(0x1.8p-1) == 0x1.0p0
; run: %nearest_f32(0x1.fffffep-2) == 0x0.0
; run: %nearest_f32(0x1.000002p-1) == 0x1.0p0
; run: %nearest_f32(-0x1.000002p-1) == -0x1.0p0
; run: %nearest_f32(0x1.0p0) == 0x1.0p0
; run: %nearest_f32(0x1.000002p0) == 0x1.0p0
; run: %nearest_f32(0x1.fffffep22) == 0x1.0p23
; run: %nearest_f32(-0x1.fffffep22) == -0x1.0p23
; run: %nearest_f32(0x1.fffffap22) == 0x1.fffff8p22
; run: %nearest_f32(-0x1.fffffap22) == -0x1.fffff8p22
; run: %nearest_f32(0x1.0p23) == 0x1.0p23
; run: %nearest_f32(0x1.000002p23) == 0x1.000002p23
; run: %nearest_f32(-0x1.000002p23) == -0x1.000002p23
; run: %nearest_f32(0x1.fffffep127) == 0x1.fffffep127
; run: %nearest_f32(-0x1.fffffep127) == -0x1.fffffep127
; run: %nearest_f32(0x0.000002p-126) == 0x0.0
; run: %nearest_f32(-0x0.000002p-126) == -0x0.0
; run: %nearest_f32(0x1.0p-126) == 0x0.0
; run: %nearest_f32(+Inf) == +Inf
; run: %nearest_f32(-Inf) == -Inf
; run: %nearest_f32(+NaN) == +NaN
; run: %nearest_f32(-NaN) == +NaN

function %nearest_f64(f64) -> f64 {
block0(v0: f64):
    v1 = nearest v0
    return v1
}
