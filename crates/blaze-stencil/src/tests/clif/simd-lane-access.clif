; Follows cranelift/filetests/filetests/runtests/simd-lane-access.clif (and
; simd-extractlane.clif, simd-insertlane.clif, simd-scalartovector.clif), for the stencil set:
; `extractlane` and `insertlane` of every lane of every 128-bit vector type, one function per
; lane, on lanes with the sign bit set and clear, and `scalar_to_vector` from values and from
; constants. `scalar_to_vector.i8x16` is in simd-extra.clif: x86-64 has no lowering for it.
test interpret
test run
target x86_64
target aarch64

function %extractlane_i8x16_0(i8x16) -> i8 {
block0(v0: i8x16):
    v1 = extractlane v0, 0
    return v1
}
; run: %extractlane_i8x16_0([0xf0 0x01 0xf2 0x03 0xf4 0x05 0xf6 0x07 0xf8 0x09 0xfa 0x0b 0xfc 0x0d 0xfe 0x0f]) == 0xf0

