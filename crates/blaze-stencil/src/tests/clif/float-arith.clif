; Follows cranelift/filetests/filetests/runtests/fadd.clif (and fsub.clif, fmul.clif, fdiv.clif,
; sqrt.clif, fma.clif, fabs.clif, fneg.clif, fcopysign.clif, f32const.clif, f64const.clif), for
; the stencil set: scalar f32 and f64 arithmetic on values whose results are exact or whose
; rounding is proven (ties to even, 1/3), signed zeros, overflow to Inf, subnormal results,
; the invalid operations (Inf - Inf, 0 * Inf, 0 / 0, sqrt of a negative) giving NaN, division
; by both zeros, `fma` where fusing changes the result (on x86-64's baseline a call of libm's
; `fmaf`/`fma` in both backends), the sign ops on NaN payloads read back as bits, and constants
; of edge values read back as bits. Upstream's inexact cases (sqrt(2), 0.1 + 0.2) are left out:
; their expectations would be guesses. Vector arithmetic is the simd files'.
test interpret
test run
target x86_64
target aarch64

function %fadd_f32(f32, f32) -> f32 {
block0(v0: f32, v1: f32):
    v2 = fadd v0, v1
    return v2
}
; run: %fadd_f32(0x1.0p0, 0x1.0p1) == 0x1.8p1
; run: %fadd_f32(-0x1.0p0, 0x1.8p1) == 0x1.0p1
; run: %fadd_f32(0x1.0p0, -0x1.0p0) == 0x0.0
; run: %fadd_f32(-0x0.0, -0x0.0) == -0x0.0
; run: %fadd_f32(0x0.0, -0x0.0) == 0x0.0
; run: %fadd_f32(-0x0.0, 0x0.0) == 0x0.0
; run: %fadd_f32(0x1.0p0, 0x1.0p-24) == 0x1.0p0
; run: %fadd_f32(0x1.0p0, 0x1.8p-24) == 0x1.000002p0
; run: %fadd_f32(0x1.000002p0, 0x1.0p-24) == 0x1.000004p0
; run: %fadd_f32(0x1.fffffep127, 0x1.fffffep127) == +Inf
; run: %fadd_f32(-0x1.fffffep127, -0x1.fffffep127) == -Inf
; run: %fadd_f32(0x0.000002p-126, 0x0.000002p-126) == 0x0.000004p-126
; run: %fadd_f32(0x1.0p-126, -0x0.000002p-126) == 0x0.fffffep-126
; run: %fadd_f32(+Inf, 0x1.0p0) == +Inf
; run: %fadd_f32(+Inf, +Inf) == +Inf
; run: %fadd_f32(+Inf, -Inf) == +NaN
; run: %fadd_f32(+NaN, 0x1.0p0) == +NaN
; run: %fadd_f32(0x1.0p0, +NaN) == +NaN

