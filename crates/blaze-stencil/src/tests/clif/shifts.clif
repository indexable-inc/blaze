; Follows cranelift/filetests/filetests/runtests/shifts.clif (and ishl.clif, ushr.clif,
; sshr.clif), for the stencil set: `ishl`, `ushr` and `sshr` of
; `i8` to `i64` by amounts of every integer type up to `i128`: 0, 1, the width minus one,
; the width, the width plus one, a large amount and two negative ones (amounts are taken
; modulo the width), and by constant amounts (folded into an immediate), one beyond the
; width and one negative. Shifts and rotates of `i128` are i128-shifts.clif's and
; i128-bitops.clif's.
test interpret
test run
target x86_64
target aarch64

function %ishl_i8_i8(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v2 = ishl v0, v1
    return v2
}
; run: %ishl_i8_i8(-93, 0) == -93
; run: %ishl_i8_i8(-93, 1) == 70
; run: %ishl_i8_i8(-93, 7) == -128
; run: %ishl_i8_i8(-93, 8) == -93
; run: %ishl_i8_i8(-93, 9) == 70
; run: %ishl_i8_i8(-93, 125) == 96
; run: %ishl_i8_i8(-93, -1) == -128
; run: %ishl_i8_i8(-93, -11) == 96
; run: %ishl_i8_i8(53, 0) == 53
; run: %ishl_i8_i8(53, 1) == 106
; run: %ishl_i8_i8(53, 7) == -128
; run: %ishl_i8_i8(53, 8) == 53
; run: %ishl_i8_i8(53, 9) == 106
; run: %ishl_i8_i8(53, 125) == -96
; run: %ishl_i8_i8(53, -1) == -128
; run: %ishl_i8_i8(53, -11) == -96
; run: %ishl_i8_i8(0, 1) == 0
; run: %ishl_i8_i8(-1, 1) == -2
; run: %ishl_i8_i8(1, 1) == 2
; run: %ishl_i8_i8(-128, 1) == 0
; run: %ishl_i8_i8(127, 1) == -2

