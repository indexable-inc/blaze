function %_mm_shuffle_epi32_1b(i64 sret, i64) {
block0(v0: i64, v1: i64):
    v2 = load.i32x4 notrap aligned v1
    v3 = bitcast.i8x16 little v2
    v4 = shuffle v3, v3, [12 13 14 15 8 9 10 11 4 5 6 7 0 1 2 3]
    v5 = bitcast.i32x4 little v4
    store notrap aligned v5, v0
    return
}

function %unop(i32x4, i8) -> i32x4 {
    ss0 = explicit_slot 32, align = 16
    fn0 = %_mm_slli_epi32_4(i64 sret, i64)
    fn1 = %_mm_srai_epi32_31(i64 sret, i64)
    fn2 = %_mm_srli_epi32_1(i64 sret, i64)
    fn3 = %_mm_shuffle_epi32_1b(i64 sret, i64)

block0(v0: i32x4, v1: i8):
    v2 = stack_addr.i64 ss0
    v3 = stack_addr.i64 ss0+16
    store notrap aligned v0, v3
    v4 = uextend.i32 v1
    br_table v4, block5, [block1, block2, block3, block4]

block1:
    call fn0(v2, v3)
    jump block5

block2:
    call fn1(v2, v3)
    jump block5

block3:
    call fn2(v2, v3)
    jump block5

block4:
    call fn3(v2, v3)
    jump block5

block5:
    v5 = load.i32x4 notrap aligned v2
    return v5
}
; run: %unop([1 0x10000000 -1 0x0fffffff], 0) == [0x10 0 0xfffffff0 0xfffffff0]
; run: %unop([1 -1 0x80000000 0x7fffffff], 1) == [0 -1 -1 0]
; run: %unop([-1 1 0x80000000 2], 2) == [0x7fffffff 0 0x40000000 1]
; run: %unop([1 2 3 4], 3) == [4 3 2 1]
; run: %unop([0x80000000 0 0 -1], 3) == [-1 0 0 0x80000000]

