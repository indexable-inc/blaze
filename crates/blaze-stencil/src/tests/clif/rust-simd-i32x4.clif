; Shaped like what hir-ty-codegen makes for `core::arch` SSE2/SSE4.1 and NEON integer lane
; ops on `__m128i`/`int32x4_t`: the Rust ABI passes a 16-byte vector behind a pointer and
; returns one through a `StructReturn` pointer, so each intrinsic loads its operands,
; computes and stores the result. `_mm_add_epi32`/`vaddq_s32`, `_mm_sub_epi32`,
; `_mm_mullo_epi32`/`vmulq_s32`, `_mm_cmpgt_epi32`/`vcgtq_s32`, `_mm_cmpeq_epi32`,
; `_mm_andnot_si128`, `_mm_min_epi32`/`vminq_s32`, `_mm_max_epu32`/`vmaxq_u32`, the
; immediate shifts, `_mm_shuffle_epi32` and `_mm_unpacklo_epi32` (a byte `shuffle` between
; little-endian bitcasts), `_mm_packs_epi32` (`snarrow`), `_mm_madd_epi16` (what the
; builder makes of `pmaddwd`: widened products added pairwise), `_mm_movemask_epi8`
; (`vhigh_bits`), `_mm_set1_epi32`, `_mm_extract_epi32` and `_mm_insert_epi32`. The
; wrapper after each takes and returns vectors by value through a stack slot.
test interpret
test run
target x86_64
target aarch64

function %_mm_add_epi32(i64 sret, i64, i64) {
block0(v0: i64, v1: i64, v2: i64):
    v3 = load.i32x4 notrap aligned v1
    v4 = load.i32x4 notrap aligned v2
    v5 = iadd v3, v4
    store notrap aligned v5, v0
    return
}

function %add(i32x4, i32x4) -> i32x4 {
    ss0 = explicit_slot 48, align = 16
    fn0 = %_mm_add_epi32(i64 sret, i64, i64)

block0(v0: i32x4, v1: i32x4):
    v2 = stack_addr.i64 ss0
    v3 = stack_addr.i64 ss0+16
    v4 = stack_addr.i64 ss0+32
    store notrap aligned v0, v3
    store notrap aligned v1, v4
    call fn0(v2, v3, v4)
    v5 = load.i32x4 notrap aligned v2
    return v5
}
; run: %add([1 2 3 4], [10 20 30 40]) == [11 22 33 44]
; run: %add([0x7fffffff -1 0x80000000 0], [1 1 -1 0]) == [0x80000000 0 0x7fffffff 0]

function %_mm_sub_epi32(i64 sret, i64, i64) {
block0(v0: i64, v1: i64, v2: i64):
    v3 = load.i32x4 notrap aligned v1
    v4 = load.i32x4 notrap aligned v2
    v5 = isub v3, v4
    store notrap aligned v5, v0
    return
}

