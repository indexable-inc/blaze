; run: %fmin_f64(-0x0.0, 0x0.0) == -0x0.0
; run: %fmin_f64(0x0.0, -0x0.0) == -0x0.0
; run: %fmin_f64(0x0.0, 0x0.0) == 0x0.0
; run: %fmin_f64(-0x0.0, -0x0.0) == -0x0.0
; run: %fmin_f64(+NaN, 0x1.0p0) == +NaN
; run: %fmin_f64(0x1.0p0, +NaN) == +NaN
; run: %fmin_f64(+NaN, +NaN) == +NaN
; run: %fmin_f64(-Inf, +NaN) == +NaN
; run: %fmin_f64(+NaN, -0x0.0) == +NaN
; run: %fmin_f64(+Inf, -Inf) == -Inf
; run: %fmin_f64(-Inf, +Inf) == -Inf
; run: %fmin_f64(+Inf, 0x1.fffffffffffffp1023) == 0x1.fffffffffffffp1023
; run: %fmin_f64(-Inf, -0x1.fffffffffffffp1023) == -Inf
; run: %fmin_f64(+Inf, +Inf) == +Inf
; run: %fmin_f64(0x0.0000000000001p-1022, 0x0.0) == 0x0.0
; run: %fmin_f64(-0x0.0000000000001p-1022, -0x0.0) == -0x0.0000000000001p-1022
; run: %fmin_f64(0x0.0000000000001p-1022, 0x0.0000000000002p-1022) == 0x0.0000000000001p-1022

