; Follows cranelift/filetests/filetests/runtests/fmin-max-pinned.clif (and fmin.clif, fmax.clif),
; for the stencil set: scalar `fmin` and `fmax` of f32 and f64, Cranelift's (IEEE 754-2019
; `minimum`/`maximum`): NaN on either side gives NaN, -0.0 is below +0.0 in both orders,
; infinities, subnormals and equal values. Upstream's pinned-register settings are left out
; (the header takes no `set` lines); the vector forms are the simd files'.
test interpret
test run
target x86_64
target aarch64

function %fmin_f32(f32, f32) -> f32 {
block0(v0: f32, v1: f32):
    v2 = fmin v0, v1
    return v2
}
; run: %fmin_f32(0x1.0p0, 0x1.0p1) == 0x1.0p0
; run: %fmin_f32(0x1.0p1, 0x1.0p0) == 0x1.0p0
; run: %fmin_f32(-0x1.0p0, 0x1.0p0) == -0x1.0p0
; run: %fmin_f32(0x1.8p0, 0x1.8p0) == 0x1.8p0
; run: %fmin_f32(-0x0.0, 0x0.0) == -0x0.0
; run: %fmin_f32(0x0.0, -0x0.0) == -0x0.0
; run: %fmin_f32(0x0.0, 0x0.0) == 0x0.0
; run: %fmin_f32(-0x0.0, -0x0.0) == -0x0.0
; run: %fmin_f32(+NaN, 0x1.0p0) == +NaN
; run: %fmin_f32(0x1.0p0, +NaN) == +NaN
; run: %fmin_f32(+NaN, +NaN) == +NaN
; run: %fmin_f32(-Inf, +NaN) == +NaN
; run: %fmin_f32(+NaN, -0x0.0) == +NaN
; run: %fmin_f32(+Inf, -Inf) == -Inf
; run: %fmin_f32(-Inf, +Inf) == -Inf
; run: %fmin_f32(+Inf, 0x1.fffffep127) == 0x1.fffffep127
; run: %fmin_f32(-Inf, -0x1.fffffep127) == -Inf
; run: %fmin_f32(+Inf, +Inf) == +Inf
; run: %fmin_f32(0x0.000002p-126, 0x0.0) == 0x0.0
; run: %fmin_f32(-0x0.000002p-126, -0x0.0) == -0x0.000002p-126
; run: %fmin_f32(0x0.000002p-126, 0x0.000004p-126) == 0x0.000002p-126

function %fmax_f32(f32, f32) -> f32 {
block0(v0: f32, v1: f32):
    v2 = fmax v0, v1
    return v2
}
; run: %fmax_f32(0x1.0p0, 0x1.0p1) == 0x1.0p1
; run: %fmax_f32(0x1.0p1, 0x1.0p0) == 0x1.0p1
; run: %fmax_f32(-0x1.0p0, 0x1.0p0) == 0x1.0p0
; run: %fmax_f32(0x1.8p0, 0x1.8p0) == 0x1.8p0
; run: %fmax_f32(-0x0.0, 0x0.0) == 0x0.0
; run: %fmax_f32(0x0.0, -0x0.0) == 0x0.0
; run: %fmax_f32(0x0.0, 0x0.0) == 0x0.0
; run: %fmax_f32(-0x0.0, -0x0.0) == -0x0.0
; run: %fmax_f32(+NaN, 0x1.0p0) == +NaN
; run: %fmax_f32(0x1.0p0, +NaN) == +NaN
; run: %fmax_f32(+NaN, +NaN) == +NaN
; run: %fmax_f32(+Inf, +NaN) == +NaN
; run: %fmax_f32(+NaN, 0x0.0) == +NaN
; run: %fmax_f32(+Inf, -Inf) == +Inf
; run: %fmax_f32(-Inf, +Inf) == +Inf
; run: %fmax_f32(-Inf, -0x1.fffffep127) == -0x1.fffffep127
; run: %fmax_f32(+Inf, 0x1.fffffep127) == +Inf
; run: %fmax_f32(-Inf, -Inf) == -Inf
; run: %fmax_f32(0x0.000002p-126, 0x0.0) == 0x0.000002p-126
; run: %fmax_f32(-0x0.000002p-126, -0x0.0) == -0x0.0
; run: %fmax_f32(0x0.000002p-126, 0x0.000004p-126) == 0x0.000004p-126

function %fmin_f64(f64, f64) -> f64 {
block0(v0: f64, v1: f64):
    v2 = fmin v0, v1
    return v2
}
; run: %fmin_f64(0x1.0p0, 0x1.0p1) == 0x1.0p0
; run: %fmin_f64(0x1.0p1, 0x1.0p0) == 0x1.0p0
; run: %fmin_f64(-0x1.0p0, 0x1.0p0) == -0x1.0p0
