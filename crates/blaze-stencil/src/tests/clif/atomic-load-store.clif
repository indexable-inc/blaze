; Follows cranelift/filetests/filetests/runtests/atomic-load-store.clif, for the stencil set:
; `atomic_load`, `atomic_store` and `fence` of `i8` to `i64` on stack slots, each type's
; value round-tripped, narrow atomics inside a word a plain `store` wrote (so a wider write
; shows), and plain and atomic accesses of the same memory mixed. `i128` is left out: the
; stencil set has no `atomic_load` or `atomic_store` of it.
test interpret
test run
target x86_64
target aarch64

function %atomic_store_load_i8(i8) -> i8 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i8):
    v1 = stack_addr.i64 ss0
    atomic_store v0, v1
    v2 = atomic_load.i8 v1
    return v2
}
; run: %atomic_store_load_i8(0) == 0
; run: %atomic_store_load_i8(1) == 1
; run: %atomic_store_load_i8(-1) == -1
; run: %atomic_store_load_i8(127) == 127
; run: %atomic_store_load_i8(-128) == -128

function %atomic_store_load_i16(i16) -> i16 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i16):
    v1 = stack_addr.i64 ss0
    atomic_store v0, v1
    v2 = atomic_load.i16 v1
    return v2
}
; run: %atomic_store_load_i16(0) == 0
; run: %atomic_store_load_i16(-1) == -1
; run: %atomic_store_load_i16(0x7fff) == 0x7fff
; run: %atomic_store_load_i16(0x8000) == 0x8000
; run: %atomic_store_load_i16(0x1234) == 0x1234

function %atomic_store_load_i32(i32) -> i32 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i32):
    v1 = stack_addr.i64 ss0
    atomic_store v0, v1
    v2 = atomic_load.i32 v1
    return v2
}
; run: %atomic_store_load_i32(0) == 0
; run: %atomic_store_load_i32(-1) == -1
; run: %atomic_store_load_i32(0x7fffffff) == 0x7fffffff
; run: %atomic_store_load_i32(0x80000000) == 0x80000000
; run: %atomic_store_load_i32(0x12345678) == 0x12345678

function %atomic_store_load_i64(i64) -> i64 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i64):
    v1 = stack_addr.i64 ss0
    atomic_store v0, v1
    v2 = atomic_load.i64 v1
    return v2
}
; run: %atomic_store_load_i64(0) == 0
; run: %atomic_store_load_i64(-1) == -1
; run: %atomic_store_load_i64(0x7fffffffffffffff) == 0x7fffffffffffffff
; run: %atomic_store_load_i64(0x8000000000000000) == 0x8000000000000000
; run: %atomic_store_load_i64(0x0123456789abcdef) == 0x0123456789abcdef

function %atomic_load_byte3(i64) -> i8 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i64):
    v1 = stack_addr.i64 ss0
    store v0, v1
    v2 = stack_addr.i64 ss0+3
    v3 = atomic_load.i8 v2
    return v3
}
; run: %atomic_load_byte3(0x0807060504030201) == 4
; run: %atomic_load_byte3(0x00000000ff000000) == -1
; run: %atomic_load_byte3(0xffffffff00ffffff) == 0

function %atomic_load_half1(i64) -> i16 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i64):
    v1 = stack_addr.i64 ss0
    store v0, v1
    v2 = stack_addr.i64 ss0+2
    v3 = atomic_load.i16 v2
    return v3
}
; run: %atomic_load_half1(0x0807060504030201) == 0x0403
; run: %atomic_load_half1(0x00000000ffff0000) == -1
; run: %atomic_load_half1(0xffffffff0000ffff) == 0

function %atomic_load_word1(i64) -> i32 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i64):
    v1 = stack_addr.i64 ss0
    store v0, v1
    v2 = stack_addr.i64 ss0+4
    v3 = atomic_load.i32 v2
    return v3
}
; run: %atomic_load_word1(0x0807060504030201) == 0x08070605
; run: %atomic_load_word1(0xffffffff00000000) == -1
; run: %atomic_load_word1(0x00000000ffffffff) == 0

function %atomic_store_byte5(i64, i8) -> i64 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i64, v1: i8):
    v2 = stack_addr.i64 ss0
    store v0, v2
    v3 = stack_addr.i64 ss0+5
    atomic_store v1, v3
    v4 = load.i64 v2
    return v4
}
; run: %atomic_store_byte5(0, -1) == 0x0000ff0000000000
; run: %atomic_store_byte5(-1, 0) == 0xffff00ffffffffff
; run: %atomic_store_byte5(0x1122334455667788, 0x5a) == 0x11225a4455667788

function %atomic_store_half3(i64, i16) -> i64 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i64, v1: i16):
    v2 = stack_addr.i64 ss0
    store v0, v2
    v3 = stack_addr.i64 ss0+6
    atomic_store v1, v3
    v4 = load.i64 v2
    return v4
}
; run: %atomic_store_half3(0x1111111111111111, 0xabcd) == 0xabcd111111111111
; run: %atomic_store_half3(-1, 0) == 0x0000ffffffffffff
; run: %atomic_store_half3(0, -1) == 0xffff000000000000

function %atomic_store_word1(i64, i32) -> i64 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i64, v1: i32):
    v2 = stack_addr.i64 ss0
    store v0, v2
    v3 = stack_addr.i64 ss0+4
    atomic_store v1, v3
    v4 = load.i64 v2
    return v4
}
; run: %atomic_store_word1(0x1111111111111111, 0xdeadbeef) == 0xdeadbeef11111111
; run: %atomic_store_word1(-1, 0) == 0x00000000ffffffff
; run: %atomic_store_word1(0, -1) == 0xffffffff00000000

function %atomic_store_word0(i64, i32) -> i64 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i64, v1: i32):
    v2 = stack_addr.i64 ss0
    store v0, v2
    atomic_store v1, v2
    v3 = load.i64 v2
    return v3
}
; run: %atomic_store_word0(0x1111111111111111, 0xdeadbeef) == 0x11111111deadbeef
; run: %atomic_store_word0(-1, 0) == 0xffffffff00000000

function %fence_between(i64, i64) -> i64, i64 {
    ss0 = explicit_slot 16, align = 8

block0(v0: i64, v1: i64):
    v2 = stack_addr.i64 ss0
    v3 = stack_addr.i64 ss0+8
    store v0, v2
    fence
    atomic_store v1, v3
    fence
    v4 = atomic_load.i64 v2
    fence
    v5 = load.i64 v3
    return v4, v5
}
; run: %fence_between(1, 2) == [1, 2]
; run: %fence_between(-1, 0x8000000000000000) == [-1, 0x8000000000000000]

function %fence_only(i32) -> i32 {
block0(v0: i32):
    fence
    v1 = iconst.i32 1
    v2 = iadd v0, v1
    fence
    return v2
}
; run: %fence_only(41) == 42
; run: %fence_only(-1) == 0

function %atomic_overwrite_i64(i64, i64) -> i64, i64 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i64, v1: i64):
    v2 = stack_addr.i64 ss0
    atomic_store v0, v2
    v3 = atomic_load.i64 v2
    atomic_store v1, v2
    v4 = atomic_load.i64 v2
    return v3, v4
}
; run: %atomic_overwrite_i64(1, 2) == [1, 2]
; run: %atomic_overwrite_i64(0x0123456789abcdef, -1) == [0x0123456789abcdef, -1]
