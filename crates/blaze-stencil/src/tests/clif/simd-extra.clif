; Follows cranelift/filetests/filetests/runtests/simd-min-max.clif (and simd-icmp-ugt.clif,
; simd-icmp-uge.clif, simd-icmp-ult.clif, simd-icmp-ule.clif, simd-uaddsat-aarch64.clif,
; simd-saddsat-aarch64.clif, simd-usubsat-aarch64.clif, simd-ssubsat-aarch64.clif,
; simd-uunarrow.clif, simd-sqmulroundsat-aarch64.clif, simd-fma.clif, simd-imul.clif,
; simd-scalartovector-aarch64.clif), for the stencil set: the vector ops it has that wasm
; SIMD lacks. `smin`, `umin`, `smax`, `umax` and the unsigned `icmp`s of `i64x2`;
; `sadd_sat`, `ssub_sat`, `uadd_sat`, `usub_sat` of `i32x4` and `i64x2`; `uunarrow` of
; `i16x8`, `i32x4`, `i64x2`; `sqmul_round_sat.i32x4`; `fma` of `f32x4` and `f64x2` (fused:
; one rounding); `imul.i64x2` with lanes past 32 bits; `scalar_to_vector.i8x16`. Cranelift
; 0.136 refuses some of these on x86-64's baseline (SSE2), so on x86-64 hosts the file may
; be run by the interpreter only; AArch64 lowers all of them. Left out: `avg_round.i32x4`, which
; the interpreter adds as one scalar and panics on; and `umulhi`/`smulhi` of `i16x8` (no
; backend lowers them) and `vhigh_bits` of `f32x4`/`f64x2` (AArch64 does not), which would
; stop this file's code on AArch64 too.
test interpret
test run
target x86_64
target aarch64

function %smin_i64x2(i64x2, i64x2) -> i64x2 {
block0(v0: i64x2, v1: i64x2):
    v2 = smin v0, v1
    return v2
}
; run: %smin_i64x2([0 0x8000000000000000], [0x8000000000000000 0]) == [0x8000000000000000 0x8000000000000000]
; run: %smin_i64x2([0x7fffffffffffffff 0xffffffffffffffff], [0xffffffffffffffff 0x7fffffffffffffff]) == [0xffffffffffffffff 0xffffffffffffffff]
; run: %smin_i64x2([1 0xffffffffffffffff], [1 0]) == [1 0xffffffffffffffff]
; run: %smin_i64x2([0x8000000000000000 0x7fffffffffffffff], [0x8000000000000001 0x7ffffffffffffffe]) == [0x8000000000000000 0x7ffffffffffffffe]
; run: %smin_i64x2([0x100000000 0xffffffff], [0xffffffff 0x100000000]) == [0xffffffff 0xffffffff]

