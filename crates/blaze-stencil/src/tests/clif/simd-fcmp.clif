    v2 = fcmp ne v0, v1
    return v2
}
; run: %fcmp_ne_f64x2([0x1.0p0 +NaN], [0x1.0p0 +NaN]) == [0 -1]
; run: %fcmp_ne_f64x2([-0x0.0 0x1.0p0], [0x0.0 0x1.0000000000001p0]) == [0 -1]
; run: %fcmp_ne_f64x2([0x1.0p0 -Inf], [-NaN -Inf]) == [-1 0]
; run: %fcmp_ne_f64x2([+Inf -0x1.0p0], [0x1.fffffffffffffp1023 -0x1.0p1]) == [-1 -1]

