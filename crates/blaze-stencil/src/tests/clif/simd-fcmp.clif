; Follows cranelift/filetests/filetests/runtests/simd-fcmp-eq.clif (and simd-fcmp-ne.clif,
; simd-fcmp-lt.clif, simd-fcmp-le.clif, simd-fcmp-gt.clif, simd-fcmp-ge.clif), for the
; stencil set: the conditions wasm SIMD has, of `f32x4` and `f64x2`, with lane masks as
; results. Every function runs on the same inputs, whose lanes are equal (including `0` and
; `-0`), less, greater and unordered (a NaN on either side). Left out: the unordered
; conditions (`ord`, `uno`, `one`, `ueq`, `ult`, `ule`, `ugt`, `uge`), which wasm lacks.
test interpret
test run
target x86_64
target aarch64

function %fcmp_eq_f32x4(f32x4, f32x4) -> i32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = fcmp eq v0, v1
    return v2
}
; run: %fcmp_eq_f32x4([0x1.0p0 0x0.0 +NaN +Inf], [0x1.0p0 -0x0.0 +NaN +Inf]) == [-1 -1 0 -1]
; run: %fcmp_eq_f32x4([0x1.0p0 0x1.0p0 -Inf 0x1.0p0], [0x1.000002p0 +NaN +Inf -0x1.0p0]) == [0 0 0 0]
; run: %fcmp_eq_f32x4([0x1.0p0 0x0.0 +NaN -Inf], [0x1.000002p0 -0x0.0 0x1.0p0 +Inf]) == [0 -1 0 0]
; run: %fcmp_eq_f32x4([0x1.0p0 0x1.0p0 0x1.0p0 -0x1.0p0], [0x1.0p0 -0x1.0p0 +NaN -0x0.0]) == [-1 0 0 0]

function %fcmp_ne_f32x4(f32x4, f32x4) -> i32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = fcmp ne v0, v1
    return v2
}
; run: %fcmp_ne_f32x4([0x1.0p0 0x0.0 +NaN +Inf], [0x1.0p0 -0x0.0 +NaN +Inf]) == [0 0 -1 0]
; run: %fcmp_ne_f32x4([0x1.0p0 0x1.0p0 -Inf 0x1.0p0], [0x1.000002p0 +NaN +Inf -0x1.0p0]) == [-1 -1 -1 -1]
; run: %fcmp_ne_f32x4([0x1.0p0 0x0.0 +NaN -Inf], [0x1.000002p0 -0x0.0 0x1.0p0 +Inf]) == [-1 0 -1 -1]
; run: %fcmp_ne_f32x4([0x1.0p0 0x1.0p0 0x1.0p0 -0x1.0p0], [0x1.0p0 -0x1.0p0 +NaN -0x0.0]) == [0 -1 -1 -1]

function %fcmp_lt_f32x4(f32x4, f32x4) -> i32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = fcmp lt v0, v1
    return v2
}
; run: %fcmp_lt_f32x4([0x1.0p0 0x0.0 +NaN +Inf], [0x1.0p0 -0x0.0 +NaN +Inf]) == [0 0 0 0]
; run: %fcmp_lt_f32x4([0x1.0p0 0x1.0p0 -Inf 0x1.0p0], [0x1.000002p0 +NaN +Inf -0x1.0p0]) == [-1 0 -1 0]
; run: %fcmp_lt_f32x4([0x1.0p0 0x0.0 +NaN -Inf], [0x1.000002p0 -0x0.0 0x1.0p0 +Inf]) == [-1 0 0 -1]
; run: %fcmp_lt_f32x4([0x1.0p0 0x1.0p0 0x1.0p0 -0x1.0p0], [0x1.0p0 -0x1.0p0 +NaN -0x0.0]) == [0 0 0 -1]

function %fcmp_le_f32x4(f32x4, f32x4) -> i32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = fcmp le v0, v1
    return v2
}
; run: %fcmp_le_f32x4([0x1.0p0 0x0.0 +NaN +Inf], [0x1.0p0 -0x0.0 +NaN +Inf]) == [-1 -1 0 -1]
; run: %fcmp_le_f32x4([0x1.0p0 0x1.0p0 -Inf 0x1.0p0], [0x1.000002p0 +NaN +Inf -0x1.0p0]) == [-1 0 -1 0]
; run: %fcmp_le_f32x4([0x1.0p0 0x0.0 +NaN -Inf], [0x1.000002p0 -0x0.0 0x1.0p0 +Inf]) == [-1 -1 0 -1]
; run: %fcmp_le_f32x4([0x1.0p0 0x1.0p0 0x1.0p0 -0x1.0p0], [0x1.0p0 -0x1.0p0 +NaN -0x0.0]) == [-1 0 0 -1]

function %fcmp_gt_f32x4(f32x4, f32x4) -> i32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = fcmp gt v0, v1
    return v2
}
; run: %fcmp_gt_f32x4([0x1.0p0 0x0.0 +NaN +Inf], [0x1.0p0 -0x0.0 +NaN +Inf]) == [0 0 0 0]
; run: %fcmp_gt_f32x4([0x1.0p0 0x1.0p0 -Inf 0x1.0p0], [0x1.000002p0 +NaN +Inf -0x1.0p0]) == [0 0 0 -1]
; run: %fcmp_gt_f32x4([0x1.0p0 0x0.0 +NaN -Inf], [0x1.000002p0 -0x0.0 0x1.0p0 +Inf]) == [0 0 0 0]
; run: %fcmp_gt_f32x4([0x1.0p0 0x1.0p0 0x1.0p0 -0x1.0p0], [0x1.0p0 -0x1.0p0 +NaN -0x0.0]) == [0 -1 0 0]

function %fcmp_ge_f32x4(f32x4, f32x4) -> i32x4 {
block0(v0: f32x4, v1: f32x4):
    v2 = fcmp ge v0, v1
    return v2
}
; run: %fcmp_ge_f32x4([0x1.0p0 0x0.0 +NaN +Inf], [0x1.0p0 -0x0.0 +NaN +Inf]) == [-1 -1 0 -1]
; run: %fcmp_ge_f32x4([0x1.0p0 0x1.0p0 -Inf 0x1.0p0], [0x1.000002p0 +NaN +Inf -0x1.0p0]) == [0 0 0 -1]
; run: %fcmp_ge_f32x4([0x1.0p0 0x0.0 +NaN -Inf], [0x1.000002p0 -0x0.0 0x1.0p0 +Inf]) == [0 -1 0 0]
; run: %fcmp_ge_f32x4([0x1.0p0 0x1.0p0 0x1.0p0 -0x1.0p0], [0x1.0p0 -0x1.0p0 +NaN -0x0.0]) == [-1 -1 0 0]

function %fcmp_eq_f64x2(f64x2, f64x2) -> i64x2 {
block0(v0: f64x2, v1: f64x2):
    v2 = fcmp eq v0, v1
    return v2
}
; run: %fcmp_eq_f64x2([0x1.0p0 +NaN], [0x1.0p0 +NaN]) == [-1 0]
; run: %fcmp_eq_f64x2([-0x0.0 0x1.0p0], [0x0.0 0x1.0000000000001p0]) == [-1 0]
; run: %fcmp_eq_f64x2([0x1.0p0 -Inf], [-NaN -Inf]) == [0 -1]
; run: %fcmp_eq_f64x2([+Inf -0x1.0p0], [0x1.fffffffffffffp1023 -0x1.0p1]) == [0 0]

