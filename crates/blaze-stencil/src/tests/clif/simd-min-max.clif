; run: %fmax_f32x4([-Inf +Inf 0x1.0p0 -0x1.0p1], [0x1.0p0 0x1.0p0 0x1.000002p0 -0x1.0p0]) == [0x1.0p0 +Inf 0x1.000002p0 -0x1.0p0]
; run: %fmax_f32x4([+NaN -NaN 0x1.0p-149 -0x1.0p-149], [+NaN 0x0.0 0x0.0 0x0.0]) == [+NaN +NaN 0x1.0p-149 0x0.0]

function %fmin_f64x2(f64x2, f64x2) -> f64x2 {
block0(v0: f64x2, v1: f64x2):
    v2 = fmin v0, v1
    return v2
}
; run: %fmin_f64x2([-0x0.0 +NaN], [0x0.0 0x1.0p0]) == [-0x0.0 +NaN]
; run: %fmin_f64x2([0x0.0 -Inf], [-0x0.0 +NaN]) == [-0x0.0 +NaN]
; run: %fmin_f64x2([0x1.0p0 -0x1.0p0], [0x1.8p0 -0x1.8p0]) == [0x1.0p0 -0x1.8p0]

function %fmax_f64x2(f64x2, f64x2) -> f64x2 {
block0(v0: f64x2, v1: f64x2):
    v2 = fmax v0, v1
    return v2
}
; run: %fmax_f64x2([-0x0.0 +NaN], [0x0.0 0x1.0p0]) == [0x0.0 +NaN]
; run: %fmax_f64x2([0x0.0 -Inf], [-0x0.0 +NaN]) == [0x0.0 +NaN]
; run: %fmax_f64x2([0x1.0p0 -0x1.0p0], [0x1.8p0 -0x1.8p0]) == [0x1.8p0 -0x1.0p0]
