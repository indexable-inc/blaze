; Shaped like what hir-ty-codegen makes for the bit intrinsics behind `u64::leading_zeros`,
; `trailing_zeros`, `count_ones`, `rotate_left`/`rotate_right` (by a `u32`, taken modulo
; the width as Cranelift's `rotl`/`rotr` do), `swap_bytes`, `reverse_bits`,
; `is_power_of_two` (`count_ones() == 1`) and `leading_ones` (`(!x).leading_zeros()`),
; plus `u32`/`u16`/`u8` forms: the counts are `i64` results narrowed to the `u32` Rust
; returns, or `i8` ones widened.
test interpret
test run
target x86_64
target aarch64

function %u64_leading_zeros(i64) -> i32 {
block0(v0: i64):
    v1 = clz v0
    v2 = ireduce.i32 v1
    return v2
}
; run: %u64_leading_zeros(0) == 64
; run: %u64_leading_zeros(1) == 63
; run: %u64_leading_zeros(-1) == 0
; run: %u64_leading_zeros(0x8000000000000000) == 0
; run: %u64_leading_zeros(0x00000000ffffffff) == 32
; run: %u64_leading_zeros(0x0000000100000000) == 31
; run: %u64_leading_zeros(0x00ffffffffffffff) == 8

function %u64_leading_ones(i64) -> i32 {
block0(v0: i64):
    v1 = bnot v0
    v2 = clz v1
    v3 = ireduce.i32 v2
    return v3
}
; run: %u64_leading_ones(0) == 0
; run: %u64_leading_ones(-1) == 64
; run: %u64_leading_ones(0xfffffffffffffffe) == 63
; run: %u64_leading_ones(0xff00000000000000) == 8
; run: %u64_leading_ones(0x7fffffffffffffff) == 0

function %u64_trailing_zeros(i64) -> i32 {
block0(v0: i64):
    v1 = ctz v0
    v2 = ireduce.i32 v1
    return v2
}
; run: %u64_trailing_zeros(0) == 64
; run: %u64_trailing_zeros(1) == 0
; run: %u64_trailing_zeros(0x8000000000000000) == 63
; run: %u64_trailing_zeros(0x100000000) == 32
; run: %u64_trailing_zeros(0xfff0) == 4

function %u64_count_ones(i64) -> i32 {
block0(v0: i64):
    v1 = popcnt v0
    v2 = ireduce.i32 v1
    return v2
}
; run: %u64_count_ones(0) == 0
; run: %u64_count_ones(-1) == 64
; run: %u64_count_ones(0x5555555555555555) == 32
; run: %u64_count_ones(0x8000000000000001) == 2

function %u64_is_power_of_two(i64) -> i8 {
block0(v0: i64):
    v1 = popcnt v0
    v2 = iconst.i64 1
    v3 = icmp eq v1, v2
    return v3
}
; run: %u64_is_power_of_two(0) == 0
; run: %u64_is_power_of_two(1) == 1
; run: %u64_is_power_of_two(2) == 1
; run: %u64_is_power_of_two(3) == 0
; run: %u64_is_power_of_two(0x8000000000000000) == 1
; run: %u64_is_power_of_two(-1) == 0

function %u64_rotate_left(i64, i32) -> i64 {
block0(v0: i64, v1: i32):
    v2 = rotl v0, v1
    return v2
}
; run: %u64_rotate_left(0x0123456789abcdef, 0) == 0x0123456789abcdef
; run: %u64_rotate_left(0x0123456789abcdef, 4) == 0x123456789abcdef0
; run: %u64_rotate_left(0x0123456789abcdef, 63) == 0x8091a2b3c4d5e6f7
; run: %u64_rotate_left(0x0123456789abcdef, 64) == 0x0123456789abcdef
; run: %u64_rotate_left(0x0123456789abcdef, 68) == 0x123456789abcdef0
; run: %u64_rotate_left(0x0123456789abcdef, 0xfffffffc) == 0xf0123456789abcde
; run: %u64_rotate_left(0x8000000000000001, 1) == 3

function %u64_rotate_right(i64, i32) -> i64 {
block0(v0: i64, v1: i32):
    v2 = rotr v0, v1
    return v2
}
; run: %u64_rotate_right(0x0123456789abcdef, 0) == 0x0123456789abcdef
; run: %u64_rotate_right(0x0123456789abcdef, 8) == 0xef0123456789abcd
; run: %u64_rotate_right(0x0123456789abcdef, 1) == 0x8091a2b3c4d5e6f7
; run: %u64_rotate_right(0x0123456789abcdef, 72) == 0xef0123456789abcd
; run: %u64_rotate_right(3, 1) == 0x8000000000000001

function %u64_swap_bytes(i64) -> i64 {
block0(v0: i64):
    v1 = bswap v0
    return v1
}
; run: %u64_swap_bytes(0x0123456789abcdef) == 0xefcdab8967452301
; run: %u64_swap_bytes(0) == 0
; run: %u64_swap_bytes(0xff) == 0xff00000000000000
; run: %u64_swap_bytes(-1) == -1

function %u32_swap_bytes(i32) -> i32 {
block0(v0: i32):
    v1 = bswap v0
    return v1
}
; run: %u32_swap_bytes(0x12345678) == 0x78563412
; run: %u32_swap_bytes(0x000000ff) == 0xff000000

function %u16_swap_bytes(i16) -> i16 {
block0(v0: i16):
    v1 = bswap v0
    return v1
}
; run: %u16_swap_bytes(0x1234) == 0x3412
; run: %u16_swap_bytes(0x00ff) == 0xff00

function %u64_reverse_bits(i64) -> i64 {
block0(v0: i64):
    v1 = bitrev v0
    return v1
}
; run: %u64_reverse_bits(1) == 0x8000000000000000
; run: %u64_reverse_bits(0x0123456789abcdef) == 0xf7b3d591e6a2c480
; run: %u64_reverse_bits(0) == 0
; run: %u64_reverse_bits(-1) == -1

function %u32_leading_zeros(i32) -> i32 {
block0(v0: i32):
    v1 = clz v0
    return v1
}
; run: %u32_leading_zeros(0) == 32
; run: %u32_leading_zeros(1) == 31
; run: %u32_leading_zeros(0x80000000) == 0

function %u8_leading_zeros(i8) -> i32 {
block0(v0: i8):
    v1 = clz v0
    v2 = uextend.i32 v1
    return v2
}
; run: %u8_leading_zeros(0) == 8
; run: %u8_leading_zeros(1) == 7
; run: %u8_leading_zeros(0x10) == 3
; run: %u8_leading_zeros(0x80) == 0
