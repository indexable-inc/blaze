; Follows cranelift/filetests/filetests/runtests/i128-shifts.clif, for the stencil set:
; `ishl`, `ushr` and `sshr` of `i128` by amounts of each integer type, 0, 1, 63, 64, 65,
; 127, 128, 129, 200 and negative, which Cranelift takes modulo 128.
test interpret
test run
target x86_64
target aarch64

function %ishl_i128_i8(i128, i8) -> i128 {
block0(v0: i128, v1: i8):
    v2 = ishl v0, v1
    return v2
}
; run: %ishl_i128_i8(0xf0123456789abcdeffedcba987654321, 0) == 0xf0123456789abcdeffedcba987654321
; run: %ishl_i128_i8(0xf0123456789abcdeffedcba987654321, 1) == 0xe02468acf13579bdffdb97530eca8642
; run: %ishl_i128_i8(0xf0123456789abcdeffedcba987654321, 63) == 0x7ff6e5d4c3b2a1908000000000000000
; run: %ishl_i128_i8(0xf0123456789abcdeffedcba987654321, 64) == 0xffedcba9876543210000000000000000
; run: %ishl_i128_i8(0xf0123456789abcdeffedcba987654321, 65) == 0xffdb97530eca86420000000000000000
; run: %ishl_i128_i8(0xf0123456789abcdeffedcba987654321, 127) == 0x80000000000000000000000000000000
; run: %ishl_i128_i8(0xf0123456789abcdeffedcba987654321, -128) == 0xf0123456789abcdeffedcba987654321
; run: %ishl_i128_i8(0xf0123456789abcdeffedcba987654321, -127) == 0xe02468acf13579bdffdb97530eca8642
; run: %ishl_i128_i8(0xf0123456789abcdeffedcba987654321, -56) == 0xedcba987654321000000000000000000
; run: %ishl_i128_i8(0xf0123456789abcdeffedcba987654321, -1) == 0x80000000000000000000000000000000
; run: %ishl_i128_i8(0xf0123456789abcdeffedcba987654321, -64) == 0xffedcba9876543210000000000000000
; run: %ishl_i128_i8(0x0123456789abcdeffedcba9876543210, 1) == 0x02468acf13579bdffdb97530eca86420
; run: %ishl_i128_i8(0x0123456789abcdeffedcba9876543210, 64) == 0xfedcba98765432100000000000000000
; run: %ishl_i128_i8(0x0123456789abcdeffedcba9876543210, 127) == 0

