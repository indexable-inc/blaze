function %brif_i128(i128) -> i8 {
block0(v0: i128):
    brif v0, block1, block2

block1:
    v1 = iconst.i8 1
    return v1

block2:
    v2 = iconst.i8 0
    return v2
}
; run: %brif_i128(0) == 0
; run: %brif_i128(1) == 1
; run: %brif_i128(0x00000000000000010000000000000000) == 1
; run: %brif_i128(0x80000000000000000000000000000000) == 1
; run: %brif_i128(-1) == 1
; run: %brif_i128(0x0000000000000000ffffffffffffffff) == 1
; run: %brif_i128(0xffffffffffffffff0000000000000000) == 1

function %brif_i128_args(i128, i64, i64) -> i64 {
block0(v0: i128, v1: i64, v2: i64):
    brif v0, block1(v1), block1(v2)

block1(v3: i64):
    return v3
}
; run: %brif_i128_args(0, 7, 9) == 9
; run: %brif_i128_args(0x00000000000000010000000000000000, 7, 9) == 7
; run: %brif_i128_args(1, 7, 9) == 7

function %br_icmp_eq_i128(i128, i128) -> i8 {
block0(v0: i128, v1: i128):
    v2 = icmp eq v0, v1
    brif v2, block1, block2

block1:
    v3 = iconst.i8 1
    return v3

block2:
    v4 = iconst.i8 0
    return v4
}
