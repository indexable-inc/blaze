; Follows cranelift/filetests/filetests/runtests/i128-icmp.clif (and i128-br.clif), for the
; stencil set: all ten conditions of `icmp` on `i128`, on values equal in one half and not
; the other, across the sign; `brif` on an `i128` (taken when either half is not zero), and
; `brif` of an `i128` `icmp`, which the stencil backend fuses.
test interpret
test run
target x86_64
target aarch64

function %icmp_eq_i128(i128, i128) -> i8 {
block0(v0: i128, v1: i128):
    v2 = icmp eq v0, v1
    return v2
}
; run: %icmp_eq_i128(0, 0) == 1
; run: %icmp_eq_i128(1, 2) == 0
; run: %icmp_eq_i128(2, 1) == 0
; run: %icmp_eq_i128(0x00000000000000010000000000000000, 1) == 0
; run: %icmp_eq_i128(1, 0x00000000000000010000000000000000) == 0
; run: %icmp_eq_i128(0x00000000000000010000000000000001, 0x00000000000000010000000000000002) == 0
; run: %icmp_eq_i128(0x00000000000000010000000000000002, 0x00000000000000010000000000000001) == 0
; run: %icmp_eq_i128(0x00000000000000010000000000000005, 0x00000000000000020000000000000005) == 0
; run: %icmp_eq_i128(0x00000000000000020000000000000005, 0x00000000000000010000000000000005) == 0
; run: %icmp_eq_i128(-1, 0) == 0
; run: %icmp_eq_i128(0, -1) == 0
; run: %icmp_eq_i128(0x80000000000000000000000000000000, 0x7fffffffffffffffffffffffffffffff) == 0
; run: %icmp_eq_i128(0x7fffffffffffffffffffffffffffffff, 0x80000000000000000000000000000000) == 0
; run: %icmp_eq_i128(-1, -1) == 1
; run: %icmp_eq_i128(0x0000000000000000ffffffffffffffff, 0x00000000000000010000000000000000) == 0
; run: %icmp_eq_i128(0xffffffffffffffff0000000000000000, -1) == 0
; run: %icmp_eq_i128(0x80000000000000000000000000000000, 0x8000000000000000ffffffffffffffff) == 0
; run: %icmp_eq_i128(0x0123456789abcdeffedcba9876543210, 0xf0123456789abcdeffedcba987654321) == 0

