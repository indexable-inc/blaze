    return v1
}
; run: %uwiden_low_i8x16([0 1 127 0x80 0xff 0x81 2 0xfe 64 0xc0 126 1 16 0xf0 85 0xaa]) == [0 1 127 0x80 0xff 0x81 2 0xfe]
; run: %uwiden_low_i8x16([0x80 0xff 127 0 1 2 3 4 0xff 0x80 0 127 0xfe 0x81 1 126]) == [0x80 0xff 127 0 1 2 3 4]

function %uwiden_high_i8x16(i8x16) -> i16x8 {
block0(v0: i8x16):
    v1 = uwiden_high v0
    return v1
}
; run: %uwiden_high_i8x16([0 1 127 0x80 0xff 0x81 2 0xfe 64 0xc0 126 1 16 0xf0 85 0xaa]) == [64 0xc0 126 1 16 0xf0 85 0xaa]
; run: %uwiden_high_i8x16([0x80 0xff 127 0 1 2 3 4 0xff 0x80 0 127 0xfe 0x81 1 126]) == [0xff 0x80 0 127 0xfe 0x81 1 126]

function %swiden_low_i16x8(i16x8) -> i32x4 {
block0(v0: i16x8):
    v1 = swiden_low v0
    return v1
}
; run: %swiden_low_i16x8([0 1 0x7fff 0x8000 0xffff 0x8001 0xff 0xff00]) == [0 1 0x7fff 0xffff8000]
; run: %swiden_low_i16x8([0x8000 0xffff 0x7fff 0x80 0x1234 0xfedc 0 0x7ffe]) == [0xffff8000 0xffffffff 0x7fff 0x80]

function %swiden_high_i16x8(i16x8) -> i32x4 {
block0(v0: i16x8):
    v1 = swiden_high v0
    return v1
}
; run: %swiden_high_i16x8([0 1 0x7fff 0x8000 0xffff 0x8001 0xff 0xff00]) == [0xffffffff 0xffff8001 0xff 0xffffff00]
; run: %swiden_high_i16x8([0x8000 0xffff 0x7fff 0x80 0x1234 0xfedc 0 0x7ffe]) == [0x1234 0xfffffedc 0 0x7ffe]

