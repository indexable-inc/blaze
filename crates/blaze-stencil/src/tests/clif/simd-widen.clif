; Follows cranelift/filetests/filetests/runtests/simd-swidenlow.clif (and simd-swidenhigh.clif,
; simd-uwidenlow.clif, simd-uwidenhigh.clif, simd-iaddpairwise.clif,
; simd-wideningpairwisedotproducts.clif), for the stencil set: `swiden_low`, `swiden_high`,
; `uwiden_low` and `uwiden_high` of `i8x16`, `i16x8` and `i32x4`, on lanes at 0, ±1, MIN, MAX
; and MIN+1; wasm's `extadd_pairwise` (`iadd_pairwise` of the two signed or unsigned widened
; halves of one vector) into `i16x8` and `i32x4`; the IR builder's `pmaddwd`
; (`_mm_madd_epi16`: `iadd_pairwise` of the products of the low and of the high widened
; halves), where MIN times MIN twice wraps to MIN; and `iadd_pairwise` of two unrelated
; vectors of each type.
test interpret
test run
target x86_64
target aarch64

function %swiden_low_i8x16(i8x16) -> i16x8 {
block0(v0: i8x16):
    v1 = swiden_low v0
    return v1
}
; run: %swiden_low_i8x16([0 1 127 0x80 0xff 0x81 2 0xfe 64 0xc0 126 1 16 0xf0 85 0xaa]) == [0 1 127 0xff80 0xffff 0xff81 2 0xfffe]
; run: %swiden_low_i8x16([0x80 0xff 127 0 1 2 3 4 0xff 0x80 0 127 0xfe 0x81 1 126]) == [0xff80 0xffff 127 0 1 2 3 4]

function %swiden_high_i8x16(i8x16) -> i16x8 {
block0(v0: i8x16):
    v1 = swiden_high v0
    return v1
}
; run: %swiden_high_i8x16([0 1 127 0x80 0xff 0x81 2 0xfe 64 0xc0 126 1 16 0xf0 85 0xaa]) == [64 0xffc0 126 1 16 0xfff0 85 0xffaa]
; run: %swiden_high_i8x16([0x80 0xff 127 0 1 2 3 4 0xff 0x80 0 127 0xfe 0x81 1 126]) == [0xffff 0xff80 0 127 0xfffe 0xff81 1 126]

function %uwiden_low_i8x16(i8x16) -> i16x8 {
block0(v0: i8x16):
