function %swizzle_const_bswap32(i8x16) -> i8x16 {
block0(v0: i8x16):
    v1 = vconst.i8x16 [3 2 1 0 7 6 5 4 11 10 9 8 15 14 13 12]
    v2 = swizzle v0, v1
    return v2
}
