function %swizzle_of_vconst(i8x16) -> i8x16 {
block0(v0: i8x16):
    v1 = vconst.i8x16 [0xa0 0xa1 0xa2 0xa3 0xa4 0xa5 0xa6 0xa7 0xa8 0xa9 0xaa 0xab 0xac 0xad 0xae 0xaf]
    v2 = swizzle v1, v0
    return v2
}
