function %swizzle_const_out_of_range(i8x16) -> i8x16 {
block0(v0: i8x16):
    v1 = vconst.i8x16 [0 0x80 1 0xff 2 16 3 127 4 0x90 5 17 6 0xf0 7 0x8f]
    v2 = swizzle v0, v1
    return v2
}
