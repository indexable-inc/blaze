; Follows cranelift/filetests/filetests/runtests/arithmetic.clif (and smulhi.clif, umulhi.clif,
; uadd_overflow.clif, sadd_overflow.clif, usub_overflow.clif, ssub_overflow.clif,
; umul_overflow.clif, smul_overflow.clif, uadd_overflow_trap.clif, smin.clif, umin.clif,
; smax.clif, umax.clif, iabs.clif, ineg.clif), for the stencil set: `i8` to `i64` (the `i128`
; forms are i128-arithmetic.clif's), each binary op also with an `iconst` second operand,
; which the stencil backend folds into an immediate: a sign-extended one for every type and,
; for `i64`, 0x80000000 (not a sign-extended 32-bit one) and 0x123456789 (more than 32
; bits). `udiv`, `sdiv`, `urem` and `srem` only on values that don't trap: the traps, and
; `srem MIN, -1`, are div-checks.clif's. `uadd_overflow_trap` only of `i32` and `i64`, the
; types the stencil set has it for.
test interpret
test run
target x86_64
target aarch64

function %iadd_i8(i8, i8) -> i8 {
block0(v0: i8, v1: i8):
    v2 = iadd v0, v1
    return v2
}
; run: %iadd_i8(0, 0) == 0
; run: %iadd_i8(1, 2) == 3
; run: %iadd_i8(-1, 1) == 0
; run: %iadd_i8(-1, -1) == -2
; run: %iadd_i8(127, 1) == -128
; run: %iadd_i8(-128, -1) == 127
; run: %iadd_i8(-128, -128) == 0
; run: %iadd_i8(127, 127) == -2
; run: %iadd_i8(-128, 127) == -1
; run: %iadd_i8(126, -127) == -1
; run: %iadd_i8(100, -77) == 23
; run: %iadd_i8(-77, 100) == 23
; run: %iadd_i8(2, -3) == -1
; run: %iadd_i8(3, 127) == -126
; run: %iadd_i8(-128, 2) == -126

function %iadd_imm_i8(i8) -> i8 {
block0(v0: i8):
    v1 = iconst.i8 253
    v2 = iadd v0, v1
    return v2
}
; run: %iadd_imm_i8(0) == -3
; run: %iadd_imm_i8(1) == -2
; run: %iadd_imm_i8(-1) == -4
; run: %iadd_imm_i8(-128) == 125
; run: %iadd_imm_i8(127) == 124
; run: %iadd_imm_i8(-127) == 126
; run: %iadd_imm_i8(126) == 123
; run: %iadd_imm_i8(100) == 97
; run: %iadd_imm_i8(-77) == -80

