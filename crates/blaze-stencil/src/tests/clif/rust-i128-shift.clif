; Shaped like what hir-ty-codegen makes for `i128`/`u128` shifts: a debug build's `<<`
; and `>>` assert the amount is below 128 (MIR `Assert(Lt(n, 128))`) and branch to a cold
; block calling `panic_const_shl_overflow`/`panic_const_shr_overflow`; `wrapping_shl`
; masks the amount with 127; `u128::rotate_left` is `rotl.i128` by a `u32`, taken modulo
; 128. Arithmetic shifts fill with the sign bit, logical ones with zeros, across the halves.
test interpret
test run
target x86_64
target aarch64

function %panic_const_shl_overflow(i64) {
block0(v0: i64):
    trap user1
}

function %panic_const_shr_overflow(i64) {
block0(v0: i64):
    trap user1
}

function %shl(i128, i32) -> i128 {
    fn0 = %panic_const_shl_overflow(i64)

block0(v0: i128, v1: i32):
    v2 = iconst.i32 128
    v3 = icmp ult v1, v2
    brif v3, block1, block2

block1:
    v4 = ishl v0, v1
    return v4

block2 cold:
    v5 = iconst.i64 0
    call fn0(v5)
    trap user1
}
; run: %shl(1, 0) == 1
; run: %shl(1, 63) == 0x8000000000000000
; run: %shl(1, 64) == 0x10000000000000000
; run: %shl(1, 65) == 0x20000000000000000
; run: %shl(1, 127) == 0x80000000000000000000000000000000
; run: %shl(3, 127) == 0x80000000000000000000000000000000
; run: %shl(-1, 1) == -2
; run: %shl(-1, 64) == 0xffffffffffffffff0000000000000000
; run: %shl(0xffffffffffffffff, 1) == 0x1fffffffffffffffe
; run: %shl(0x0123456789abcdef0123456789abcdef, 4) == 0x123456789abcdef0123456789abcdef0
; trap: %shl(1, 128)
; trap: %shl(1, 0xffffffff)
; trap: %shl(0, 200)

function %wrapping_shl(i128, i32) -> i128 {
block0(v0: i128, v1: i32):
    v2 = iconst.i32 127
    v3 = band v1, v2
    v4 = ishl v0, v3
    return v4
}
; run: %wrapping_shl(1, 128) == 1
; run: %wrapping_shl(1, 200) == 0x1000000000000000000
; run: %wrapping_shl(3, 0xffffffff) == 0x80000000000000000000000000000000
; run: %wrapping_shl(5, 0) == 5

function %i128_shr(i128, i32) -> i128 {
    fn0 = %panic_const_shr_overflow(i64)

block0(v0: i128, v1: i32):
    v2 = iconst.i32 128
    v3 = icmp ult v1, v2
    brif v3, block1, block2

block1:
    v4 = sshr v0, v1
    return v4

block2 cold:
    v5 = iconst.i64 0
    call fn0(v5)
    trap user1
}
; run: %i128_shr(0x80000000000000000000000000000000, 0) == 0x80000000000000000000000000000000
; run: %i128_shr(0x80000000000000000000000000000000, 1) == 0xc0000000000000000000000000000000
; run: %i128_shr(0x80000000000000000000000000000000, 64) == 0xffffffffffffffff8000000000000000
; run: %i128_shr(0x80000000000000000000000000000000, 127) == -1
; run: %i128_shr(-2, 1) == -1
; run: %i128_shr(0x7fffffffffffffffffffffffffffffff, 126) == 1
; run: %i128_shr(0x7fffffffffffffffffffffffffffffff, 127) == 0
; run: %i128_shr(0x10000000000000000, 64) == 1
; run: %i128_shr(0x10000000000000000, 65) == 0
; trap: %i128_shr(5, 128)

function %u128_shr(i128, i32) -> i128 {
    fn0 = %panic_const_shr_overflow(i64)

block0(v0: i128, v1: i32):
    v2 = iconst.i32 128
    v3 = icmp ult v1, v2
    brif v3, block1, block2

block1:
    v4 = ushr v0, v1
    return v4

block2 cold:
    v5 = iconst.i64 0
    call fn0(v5)
    trap user1
}
; run: %u128_shr(0x80000000000000000000000000000000, 127) == 1
; run: %u128_shr(0x80000000000000000000000000000000, 64) == 0x8000000000000000
; run: %u128_shr(0x80000000000000000000000000000000, 63) == 0x10000000000000000
; run: %u128_shr(-1, 0) == -1
; run: %u128_shr(-1, 1) == 0x7fffffffffffffffffffffffffffffff
; run: %u128_shr(-1, 65) == 0x7fffffffffffffff
; trap: %u128_shr(-1, 128)

function %u128_rotate_left(i128, i32) -> i128 {
block0(v0: i128, v1: i32):
    v2 = rotl v0, v1
    return v2
}
; run: %u128_rotate_left(1, 127) == 0x80000000000000000000000000000000
; run: %u128_rotate_left(0x80000000000000000000000000000000, 1) == 1
; run: %u128_rotate_left(0x00000000000000010000000000000002, 0) == 0x00000000000000010000000000000002
; run: %u128_rotate_left(0x00000000000000010000000000000002, 64) == 0x00000000000000020000000000000001
; run: %u128_rotate_left(0x00000000000000010000000000000002, 128) == 0x00000000000000010000000000000002
; run: %u128_rotate_left(0x00000000000000010000000000000002, 196) == 0x200000000000000010
; run: %u128_rotate_left(0x00000000000000010000000000000002, 4) == 0x00000000000000100000000000000020
