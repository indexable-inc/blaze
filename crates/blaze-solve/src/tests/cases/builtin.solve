# Builtin impl candidates (src/builtin.rs): sizedness, copy/clone, the Fn family, FnPtr, Tuple,
# Pointee, DiscriminantKind, Destruct, Unsize and object candidates. References:
# vendor/rustc_next_trait_solver/src/solve/trait_goals.rs (consider_builtin_*),
# solve/assembly/structural_traits.rs and solve/assembly/mod.rs.
#
# core's impls for primitives and shared references are not builtin (the reference answers
# NoSolution for them and lets the impls in core apply); the prelude has none, so they are
# declared here as core declares them. Arrays get none: a case below shows the builtin rule
# gives nothing for them.

extern impl Copy for u32
extern impl Clone for u32
extern impl Copy for u8
extern impl Clone for u8
extern impl<T: ?Sized> Copy for &T
extern impl<T: ?Sized> Clone for &T
extern struct Wrap<T: ?Sized>(u8, T)
fn foo(u8) -> u16
fn id<T>(T) -> T
unsafe fn danger(u8) -> u8
trait Super
trait Sub: Super

# ---- Sized and MetaSized ----

case sized_str_no = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal str: Sized => no

case sized_slice_no = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal [u8]: Sized => no

case sized_dyn_no = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal dyn Debug: Sized => no

case sized_tuple_unsized_tail_no = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal (u8, [u8]): Sized => no

case sized_tuple_yes = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal (u8, u16): Sized => yes

case sized_unit_yes = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal (): Sized => yes

case sized_adt_unsized_tail_no = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal Wrap<[u8]>: Sized => no

case sized_adt_sized_tail_yes = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal Wrap<u8>: Sized => yes

case sized_adt_str_tail_no = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
struct Tail(u8, str)
goal Tail: Sized => no

case meta_sized_adt_str_tail_yes = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
struct Tail(u8, str)
goal Tail: MetaSized => yes

case sized_ty_var_maybe = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal ?0: Sized => maybe

case sized_int_var_yes = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal ?i0: Sized => yes

case sized_foreign_no = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
foreign Ext
goal Ext: Sized => no

case meta_sized_foreign_no = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
foreign Ext
goal Ext: MetaSized => no

case meta_sized_str_yes = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal str: MetaSized => yes

case meta_sized_dyn_yes = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal dyn Debug: MetaSized => yes

case sized_ref_to_unsized_yes = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal &'static [u8]: Sized => yes

case sized_slice_of_param_no = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
params T
goal [T]: Sized => no

case sized_fn_ptr_yes = structural_traits.rs::instantiate_constituent_tys_for_sizedness_trait
goal fn(u8) -> u16: Sized => yes

# ---- Copy and Clone ----

case copy_prim_by_core_impl = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
# The builtin rule answers NoSolution for u32; the declared core impl proves it.
goal u32: Copy => yes

case copy_tuple_yes = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal (u32, u8): Copy => yes

case copy_tuple_with_string_no = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal (u32, String): Copy => no

case clone_tuple_with_string_yes = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal (u32, String): Clone => yes

case copy_mut_ref_no = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal &'static mut u32: Copy => no

case clone_mut_ref_no = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal &'static mut u32: Clone => no

case copy_shared_ref_yes = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal &'static String: Copy => yes

case copy_fn_def_yes = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal fn#foo: Copy => yes

case clone_fn_def_yes = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal fn#foo: Clone => yes

case copy_fn_ptr_yes = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal fn(u8) -> u8: Copy => yes

case copy_closure_copy_upvars_yes = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal closure#0<fn, fn((u8,)) -> u8, (u32, &'static String)>: Copy => yes

case copy_closure_string_upvar_no = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal closure#0<fn, fn((u8,)) -> u8, (String,)>: Copy => no

case clone_closure_string_upvar_yes = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal closure#0<fn, fn((u8,)) -> u8, (String,)>: Clone => yes

case copy_closure_mut_ref_upvar_no = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal closure#0<fnmut, fn((u8,)) -> u8, (&'static mut u32,)>: Copy => no

case copy_array_no_builtin = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
# Arrays are Copy by an impl in core, which this world does not declare: the builtin rule
# alone gives NoSolution.
goal [u32; 3]: Copy => no

case clone_str_no = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal str: Clone => no

case copy_adt_without_impl_no = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
goal Vec<u8>: Copy => no

case copy_int_var_maybe = structural_traits.rs::instantiate_constituent_tys_for_copy_clone_trait
# Two core impls (u8, u32) may apply to an integer variable.
goal ?i0: Copy => maybe

case clone_ty_var_maybe = trait_goals.rs::consider_builtin_copy_clone_candidate
goal ?0: Clone => maybe

