case closure_fn_kind_fn_yes = structural_traits.rs::extract_tupled_inputs_and_output_from_callable
goal closure#0<fn, fn((u8,)) -> u8, ()>: Fn<(u8,)> => yes

case closure_fn_mut_kind_fn_no = structural_traits.rs::extract_tupled_inputs_and_output_from_callable
goal closure#0<fnmut, fn((u8,)) -> u8, ()>: Fn<(u8,)> => no

case closure_fn_mut_kind_fn_mut_yes = structural_traits.rs::extract_tupled_inputs_and_output_from_callable
goal closure#0<fnmut, fn((u8,)) -> u8, ()>: FnMut<(u8,)> => yes

case closure_fn_once_kind_fn_mut_no = structural_traits.rs::extract_tupled_inputs_and_output_from_callable
goal closure#0<fnonce, fn((u8,)) -> u8, ()>: FnMut<(u8,)> => no

case closure_fn_once_kind_fn_once_yes = structural_traits.rs::extract_tupled_inputs_and_output_from_callable
goal closure#0<fnonce, fn((u8,)) -> u8, ()>: FnOnce<(u8,)> => yes

case closure_unknown_kind_fn_maybe = structural_traits.rs::extract_tupled_inputs_and_output_from_callable
goal closure#0<?K, fn((u8,)) -> u8, ()>: Fn<(u8,)> => maybe

case closure_unknown_kind_fn_once_yes = structural_traits.rs::extract_tupled_inputs_and_output_from_callable
# Every closure implements FnOnce, whatever its kind.
goal closure#0<?K, fn((u8,)) -> u8, ()>: FnOnce<(u8,)> => yes

case not_callable_no = trait_goals.rs::consider_builtin_fn_trait_candidates
goal u32: FnOnce<()> => no

