# Builtin impl candidates (src/builtin.rs): sizedness, copy/clone, the Fn family, FnPtr, Tuple,
# Pointee, DiscriminantKind, Destruct, Unsize and object candidates. References:
# vendor/rustc_next_trait_solver/src/solve/trait_goals.rs (consider_builtin_*),
# solve/assembly/structural_traits.rs and solve/assembly/mod.rs.
#
# core's impls for primitives and shared references are not builtin (the reference answers
# NoSolution for them and lets the impls in core apply); the prelude has none, so they are
# declared here as core declares them. Arrays get none: a case below shows the builtin rule
# gives nothing for them.

extern impl Copy for u32
extern impl Clone for u32
extern impl Copy for u8
extern impl Clone for u8
extern impl<T: ?Sized> Copy for &T
extern impl<T: ?Sized> Clone for &T
extern struct Wrap<T: ?Sized>(u8, T)
fn foo(u8) -> u16
fn id<T>(T) -> T
unsafe fn danger(u8) -> u8
trait Super
trait Sub: Super

