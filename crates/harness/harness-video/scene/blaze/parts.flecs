// The film's parts: the few kinds of words it shows. Prefabs only, each a ui.* prim with the film's type on it.
// Everything is sized as a share of the frame or sits in its middle, so the film reframes (upright, square).
@tree ChildOf
film_part {
  // A layer: the whole frame, its parts in the middle. Gone until a cue shows it.
  prefab Layer : ui.Column {
    Flex: {axis: Column, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Percent, value: 1, min: 0, max: 0}, h: {kind: Percent, value: 1, min: 0, max: 0}}
  }
  // A layer whose parts sit at the bottom (over a Low).
  prefab Under : film_part.Layer {
    Flex: {axis: Column, gap: 0, align: Center, justify: End, wrap: false}
  }
  // The room under a bottom layer's parts, a share of the frame's height.
  prefab Low : ui.Node {
    Size: {w: {kind: Fixed, value: 1, min: 0, max: 0}, h: {kind: Percent, value: 0.17, min: 0, max: 0}}
  }
  // Where a beat's captions stand, one at a time, on top of one another.
  prefab Slot : ui.ZStack {
    Flex: {axis: Z, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Percent, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: 48, min: 0, max: 0}}
  }
  // A caption: a few bold words that pop in and leave.
  prefab Caption : ui.Line, Strong {
    TextStyle: {size: $size_film_caption, line: $line_film_caption, code_line: 0, role: 2, bold: 1, weight: 0}
  }
  // The number a beat is about: big, counting.
  prefab Figure : ui.Line {
    Fill: $tone_film_accent
    TextStyle: {size: $size_film_figure, line: $line_film_figure, code_line: 0, role: 10, bold: 1, weight: 0}
    Tally: {value: 0, decimals: 0, unit: ""}
  }
  // The room under a Figure that lifts it over the picture's middle (a beam, the swarm's heart).
  prefab Raise : ui.Node {
    Size: {w: {kind: Fixed, value: 1, min: 0, max: 0}, h: {kind: Percent, value: 0.2, min: 0, max: 0}}
  }
  // A race's lane: a tenth of the frame high (the kernel's lanes are a tenth apart), its words above its line. The time
  // stands beside the name at the start, clear of the flash at the finish.
  prefab Lane : ui.Row {
    Flex: {axis: Row, gap: 10, align: Start, justify: Start, wrap: false}
    Size: {w: {kind: Percent, value: 0.84, min: 0, max: 0}, h: {kind: Percent, value: 0.1, min: 0, max: 0}}
  }
  prefab Who : ui.Line {
    Fill: $tone_film_other
    TextStyle: {size: $size_film_lane, line: $line_film_lane, code_line: 0, role: 2, bold: 1, weight: 0}
  }
  prefab Took : ui.Line {
    Fill: $tone_film_other
    TextStyle: {size: $size_film_lane, line: $line_film_lane, code_line: 0, role: 10, bold: 1, weight: 0}
    Tally: {value: 0, decimals: 1, unit: ""}
  }
  // The one tiny line: what was measured on, fading.
  prefab Note : ui.Line, Muted {
    TextStyle: {size: $size_film_note, line: $line_film_note, code_line: 0, role: 0, bold: 0, weight: 0}
  }
}
