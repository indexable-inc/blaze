// Shot 5, second half: the four rows where blaze is behind, shown as they are, under a line that says so; then the
// conditions every row of the shot was measured under, in the small print. Same race as race.flecs.
const t = $t_behind

@tree ChildOf
film {
  race {
    turn : film_part.Body {
      Text: {s: "Where blaze is behind today:"}
      Fill: $tone_film_accent
      Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: 34, min: 0, max: 0}}
      cue.Arrive show(at: $t)
    }
    body : film_part.Row {
      cue.Arrive show(at: $t + 0.5, dur: 0.25)
      label : film_part.RowLabel {
        words : film_part.Body { Text: {s: $d_rows_body_label} }
      }
      lanes : film_part.Lanes {
        blaze : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_accent
            cue.Widen grow(at: $t + 0.5 + 0.25, dur: $film_pace * $d_rows_body_blaze_share, from: 0, to: $film_bar * $d_rows_body_blaze_share)
          }
          fig : film_part.Figure {
            Tally: {value: 0, decimals: 1, unit: " {d_rows_body_unit}"}
            cue.Count count(at: $t + 0.5 + 0.25, dur: $film_pace * $d_rows_body_blaze_share, from: 0, to: $d_rows_body_blaze)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 0.5 + 0.25 + $film_pace * $d_rows_body_blaze_share}; Pitch: {hz: 2200}; Gain: {amp: 0.045}; Pan: {pos: 0.25, sweep: 0} }
        }
        relax : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_other
            cue.Widen grow(at: $t + 0.5 + 0.25, dur: $film_pace * $d_rows_body_relax_share, from: 0, to: $film_bar * $d_rows_body_relax_share)
          }
          fig : film_part.Figure {
            Tally: {value: 0, decimals: 1, unit: " {d_rows_body_unit}"}
            cue.Count count(at: $t + 0.5 + 0.25, dur: $film_pace * $d_rows_body_relax_share, from: 0, to: $d_rows_body_relax)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 0.5 + 0.25 + $film_pace * $d_rows_body_relax_share}; Pitch: {hz: 1500}; Gain: {amp: 0.045}; Pan: {pos: 0.45, sweep: 0} }
        }
      }
      // Sound: the row starts on a soft note.
      start : voice.Mallet { Onset: {at: $t + 0.5}; Pitch: {hz: 277.18}; Gain: {amp: 0.04}; Lasts: {dur: 1.0}; Pan: {pos: -0.4, sweep: 0} }
    }
    cold : film_part.Row {
      cue.Arrive show(at: $t + 2.8, dur: 0.25)
      label : film_part.RowLabel {
        words : film_part.Body { Text: {s: $d_rows_cold_label} }
      }
      lanes : film_part.Lanes {
        blaze : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_accent
            cue.Widen grow(at: $t + 2.8 + 0.25, dur: $film_pace * $d_rows_cold_blaze_share, from: 0, to: $film_bar * $d_rows_cold_blaze_share)
          }
          fig : film_part.Figure {
            Tally: {value: 0, decimals: 1, unit: " {d_rows_cold_unit}"}
            cue.Count count(at: $t + 2.8 + 0.25, dur: $film_pace * $d_rows_cold_blaze_share, from: 0, to: $d_rows_cold_blaze)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 2.8 + 0.25 + $film_pace * $d_rows_cold_blaze_share}; Pitch: {hz: 2200}; Gain: {amp: 0.045}; Pan: {pos: 0.25, sweep: 0} }
        }
        relax : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_other
            cue.Widen grow(at: $t + 2.8 + 0.25, dur: $film_pace * $d_rows_cold_relax_share, from: 0, to: $film_bar * $d_rows_cold_relax_share)
          }
          fig : film_part.Figure {
            Tally: {value: 0, decimals: 1, unit: " {d_rows_cold_unit}"}
            cue.Count count(at: $t + 2.8 + 0.25, dur: $film_pace * $d_rows_cold_relax_share, from: 0, to: $d_rows_cold_relax)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 2.8 + 0.25 + $film_pace * $d_rows_cold_relax_share}; Pitch: {hz: 1500}; Gain: {amp: 0.045}; Pan: {pos: 0.45, sweep: 0} }
        }
      }
      // Sound: the row starts on a soft note.
      start : voice.Mallet { Onset: {at: $t + 2.8}; Pitch: {hz: 246.94}; Gain: {amp: 0.04}; Lasts: {dur: 1.0}; Pan: {pos: -0.4, sweep: 0} }
    }
    memory : film_part.Row {
      cue.Arrive show(at: $t + 5.1, dur: 0.25)
      label : film_part.RowLabel {
        words : film_part.Body { Text: {s: $d_rows_memory_label} }
      }
      lanes : film_part.Lanes {
        blaze : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_accent
            cue.Widen grow(at: $t + 5.1 + 0.25, dur: $film_pace * $d_rows_memory_blaze_share, from: 0, to: $film_bar * $d_rows_memory_blaze_share)
          }
          fig : film_part.Figure {
            Tally: {value: 0, decimals: 0, unit: " {d_rows_memory_unit}"}
            cue.Count count(at: $t + 5.1 + 0.25, dur: $film_pace * $d_rows_memory_blaze_share, from: 0, to: $d_rows_memory_blaze)
          }
          note : film_part.Small {
            Text: {s: $d_rows_memory_blaze_what}
            cue.Arrive show(at: $t + 5.1 + 0.25 + $film_pace * $d_rows_memory_blaze_share, dur: 0.2)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 5.1 + 0.25 + $film_pace * $d_rows_memory_blaze_share}; Pitch: {hz: 2200}; Gain: {amp: 0.045}; Pan: {pos: 0.25, sweep: 0} }
        }
        relax : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_other
            cue.Widen grow(at: $t + 5.1 + 0.25, dur: $film_pace * $d_rows_memory_relax_share, from: 0, to: $film_bar * $d_rows_memory_relax_share)
          }
          fig : film_part.Figure {
            Tally: {value: 0, decimals: 0, unit: " {d_rows_memory_unit}"}
            cue.Count count(at: $t + 5.1 + 0.25, dur: $film_pace * $d_rows_memory_relax_share, from: 0, to: $d_rows_memory_relax)
          }
          note : film_part.Small {
            Text: {s: $d_rows_memory_relax_what}
            cue.Arrive show(at: $t + 5.1 + 0.25 + $film_pace * $d_rows_memory_relax_share, dur: 0.2)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 5.1 + 0.25 + $film_pace * $d_rows_memory_relax_share}; Pitch: {hz: 1500}; Gain: {amp: 0.045}; Pan: {pos: 0.45, sweep: 0} }
        }
      }
      // Sound: the row starts on a soft note.
      start : voice.Mallet { Onset: {at: $t + 5.1}; Pitch: {hz: 220.0}; Gain: {amp: 0.04}; Lasts: {dur: 1.0}; Pan: {pos: -0.4, sweep: 0} }
    }
    disk : film_part.Row {
      cue.Arrive show(at: $t + 7.4, dur: 0.25)
      label : film_part.RowLabel {
        words : film_part.Body { Text: {s: $d_rows_disk_label} }
      }
      lanes : film_part.Lanes {
        blaze : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_accent
            cue.Widen grow(at: $t + 7.4 + 0.25, dur: $film_pace * $d_rows_disk_blaze_share, from: 0, to: $film_bar * $d_rows_disk_blaze_share)
          }
          fig : film_part.Figure {
            Tally: {value: 0, decimals: 0, unit: " {d_rows_disk_unit}"}
            cue.Count count(at: $t + 7.4 + 0.25, dur: $film_pace * $d_rows_disk_blaze_share, from: 0, to: $d_rows_disk_blaze)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 7.4 + 0.25 + $film_pace * $d_rows_disk_blaze_share}; Pitch: {hz: 2200}; Gain: {amp: 0.045}; Pan: {pos: 0.25, sweep: 0} }
        }
        relax : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_other
            cue.Widen grow(at: $t + 7.4 + 0.25, dur: $film_pace * $d_rows_disk_relax_share, from: 0, to: $film_bar * $d_rows_disk_relax_share)
          }
          fig : film_part.Mono {
            Text: {s: $d_rows_disk_relax_t}
            cue.Arrive show(at: $t + 7.4 + 0.25 + $film_pace * $d_rows_disk_relax_share, dur: 0.2)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 7.4 + 0.25 + $film_pace * $d_rows_disk_relax_share}; Pitch: {hz: 1500}; Gain: {amp: 0.045}; Pan: {pos: 0.45, sweep: 0} }
        }
      }
      // Sound: the row starts on a soft note.
      start : voice.Mallet { Onset: {at: $t + 7.4}; Pitch: {hz: 196.0}; Gain: {amp: 0.04}; Lasts: {dur: 1.0}; Pan: {pos: -0.4, sweep: 0} }
    }
    room : film_part.Gap {}
    foot : film_part.Small {
      Text: {s: $d_conditions}
      cue.Arrive show(at: $t_race + 0.6)
    }
    foot2 : film_part.Small {
      Text: {s: $d_status}
      cue.Arrive show(at: $t_race + 0.6)
    }
    // Sound: the turn, a step down.
    down : voice.Bass { Onset: {at: $t}; Pitch: {hz: 98}; Gain: {amp: 0.06}; Lasts: {dur: 2.5} }
  }
}
