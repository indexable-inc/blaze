// Shot 5, the head-to-head (film.flecs's storyboard), first half: the three rows where blaze is ahead. Every bar and
// figure is a row of the data file (`rows.*`), with its conditions on screen in the shot's small print (behind.flecs
// ends the shot with it). A row is a race: both bars grow at one speed and each figure counts with its bar, so the one
// that took less time stops first; a row's longer bar is `film_bar` points and takes `film_pace` seconds.
const t = $t_race

@tree ChildOf
film {
  race : film_part.Shot {
    Flex: {axis: Column, gap: 0, align: Start, justify: Center, wrap: false}
    cue.CutIn enter(at: $t)
    cue.CutOut leave(at: $t_end)
    head : film_part.Head {
      Text: {s: "Measured, side by side."}
      cue.Arrive show(at: $t + 0.1)
    }
    legend : ui.Row {
      Flex: {axis: Row, gap: 8, align: Center, justify: Start, wrap: false}
      Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: 30, min: 0, max: 0}}
      cue.Arrive show(at: $t + 0.4)
      mine : film_part.Swatch { Fill: $tone_film_accent }
      blaze : film_part.Small { Text: {s: "blaze"}; Fill: $tone_ink }
      pad : film_part.Swatch { Fill: $tone_clear }
      theirs : film_part.Swatch { Fill: $tone_film_other }
      relax : film_part.Small { Text: {s: $d_relax}; Fill: $tone_ink }
    }
    start : film_part.Row {
      cue.Arrive show(at: $t + 0.9, dur: 0.25)
      label : film_part.RowLabel {
        words : film_part.Body { Text: {s: $d_rows_start_label} }
      }
      lanes : film_part.Lanes {
        blaze : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_accent
            cue.Widen grow(at: $t + 0.9 + 0.25, dur: $film_pace * $d_rows_start_blaze_share, from: 0, to: $film_bar * $d_rows_start_blaze_share)
          }
          fig : film_part.Figure {
            Tally: {value: 0, decimals: 1, unit: " {d_rows_start_unit}"}
            cue.Count count(at: $t + 0.9 + 0.25, dur: $film_pace * $d_rows_start_blaze_share, from: 0, to: $d_rows_start_blaze)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 0.9 + 0.25 + $film_pace * $d_rows_start_blaze_share}; Pitch: {hz: 2200}; Gain: {amp: 0.045}; Pan: {pos: 0.25, sweep: 0} }
        }
        relax : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_other
            cue.Widen grow(at: $t + 0.9 + 0.25, dur: $film_pace * $d_rows_start_relax_share, from: 0, to: $film_bar * $d_rows_start_relax_share)
          }
          fig : film_part.Figure {
            Tally: {value: 0, decimals: 1, unit: " {d_rows_start_unit}"}
            cue.Count count(at: $t + 0.9 + 0.25, dur: $film_pace * $d_rows_start_relax_share, from: 0, to: $d_rows_start_relax)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 0.9 + 0.25 + $film_pace * $d_rows_start_relax_share}; Pitch: {hz: 1500}; Gain: {amp: 0.045}; Pan: {pos: 0.45, sweep: 0} }
        }
      }
      // Sound: the row starts on a soft note.
      start : voice.Mallet { Onset: {at: $t + 0.9}; Pitch: {hz: 220.0}; Gain: {amp: 0.04}; Lasts: {dur: 1.0}; Pan: {pos: -0.4, sweep: 0} }
    }
    noop : film_part.Row {
      cue.Arrive show(at: $t + 3.2, dur: 0.25)
      label : film_part.RowLabel {
        words : film_part.Body { Text: {s: $d_rows_noop_label} }
      }
      lanes : film_part.Lanes {
        blaze : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_accent
            cue.Widen grow(at: $t + 3.2 + 0.25, dur: $film_pace * $d_rows_noop_blaze_share, from: 0, to: $film_bar * $d_rows_noop_blaze_share)
          }
          fig : film_part.Figure {
            Tally: {value: 0, decimals: 1, unit: " {d_rows_noop_unit}"}
            cue.Count count(at: $t + 3.2 + 0.25, dur: $film_pace * $d_rows_noop_blaze_share, from: 0, to: $d_rows_noop_blaze)
          }
          note : film_part.Small {
            Text: {s: "range {d_rows_noop_blaze_range_t}"}
            cue.Arrive show(at: $t + 3.2 + 0.25 + $film_pace * $d_rows_noop_blaze_share, dur: 0.2)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 3.2 + 0.25 + $film_pace * $d_rows_noop_blaze_share}; Pitch: {hz: 2200}; Gain: {amp: 0.045}; Pan: {pos: 0.25, sweep: 0} }
        }
        relax : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_other
            cue.Widen grow(at: $t + 3.2 + 0.25, dur: $film_pace * $d_rows_noop_relax_share, from: 0, to: $film_bar * $d_rows_noop_relax_share)
          }
          fig : film_part.Figure {
            Tally: {value: 0, decimals: 1, unit: " {d_rows_noop_unit}"}
            cue.Count count(at: $t + 3.2 + 0.25, dur: $film_pace * $d_rows_noop_relax_share, from: 0, to: $d_rows_noop_relax)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 3.2 + 0.25 + $film_pace * $d_rows_noop_relax_share}; Pitch: {hz: 1500}; Gain: {amp: 0.045}; Pan: {pos: 0.45, sweep: 0} }
        }
      }
      // Sound: the row starts on a soft note.
      start : voice.Mallet { Onset: {at: $t + 3.2}; Pitch: {hz: 246.94}; Gain: {amp: 0.04}; Lasts: {dur: 1.0}; Pan: {pos: -0.4, sweep: 0} }
    }
    comment : film_part.Row {
      cue.Arrive show(at: $t + 5.5, dur: 0.25)
      label : film_part.RowLabel {
        words : film_part.Body { Text: {s: $d_rows_comment_label} }
      }
      lanes : film_part.Lanes {
        blaze : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_accent
            cue.Widen grow(at: $t + 5.5 + 0.25, dur: $film_pace * $d_rows_comment_blaze_share, from: 0, to: $film_bar * $d_rows_comment_blaze_share)
          }
          fig : film_part.Figure {
            Tally: {value: 0, decimals: 1, unit: " {d_rows_comment_unit}"}
            cue.Count count(at: $t + 5.5 + 0.25, dur: $film_pace * $d_rows_comment_blaze_share, from: 0, to: $d_rows_comment_blaze)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 5.5 + 0.25 + $film_pace * $d_rows_comment_blaze_share}; Pitch: {hz: 2200}; Gain: {amp: 0.045}; Pan: {pos: 0.25, sweep: 0} }
        }
        relax : film_part.Lane {
          bar : film_part.Bar {
            Fill: $tone_film_other
            cue.Widen grow(at: $t + 5.5 + 0.25, dur: $film_pace * $d_rows_comment_relax_share, from: 0, to: $film_bar * $d_rows_comment_relax_share)
          }
          fig : film_part.Figure {
            Tally: {value: 0, decimals: 1, unit: " {d_rows_comment_unit}"}
            cue.Count count(at: $t + 5.5 + 0.25, dur: $film_pace * $d_rows_comment_relax_share, from: 0, to: $d_rows_comment_relax)
          }
          // Sound: a tick where this bar stops.
          stop : voice.Click { Onset: {at: $t + 5.5 + 0.25 + $film_pace * $d_rows_comment_relax_share}; Pitch: {hz: 1500}; Gain: {amp: 0.045}; Pan: {pos: 0.45, sweep: 0} }
        }
      }
      // Sound: the row starts on a soft note.
      start : voice.Mallet { Onset: {at: $t + 5.5}; Pitch: {hz: 277.18}; Gain: {amp: 0.04}; Lasts: {dur: 1.0}; Pan: {pos: -0.4, sweep: 0} }
    }
  }
}
