// Shot 2, the claim and the name: the edit loop is the product; blaze is a compiler built around it.
const t = $t_name

@tree ChildOf
film {
  name : film_part.Centred {
    cue.CutIn enter(at: $t)
    cue.CutOut leave(at: $t_what)
    claim : film_part.Head {
      Text: {s: "The edit loop is the product."}
      Fill: $tone_ink_muted
      cue.Arrive show(at: $t + 0.1)
    }
    word : film_part.Mono {
      Text: {s: "blaze"}
      Fill: $tone_film_accent
      TextStyle: {size: 96, line: 112, code_line: 0, role: 9, bold: 1, weight: 0}
      cue.Arrive show(at: $t + 1.0, dur: 0.3)
      cue.PushIn push(at: $t + 1.0, dur: 2.6, by: 0.04)
    }
    what : film_part.Head {
      Text: {s: "A Rust compiler and build system, built for coding agents."}
      cue.Arrive show(at: $t + 1.7)
      cue.Lift up(at: $t + 1.7)
    }
    // Sound: the cut lands, the name is struck (A), and the line under it answers a fifth up.
    cut : voice.Thud { Onset: {at: $t}; Gain: {amp: 0.18} }
    struck : voice.Mallet { Onset: {at: $t + 1.0}; Pitch: {hz: 220}; Gain: {amp: 0.09}; Lasts: {dur: 2.6} }
    low : voice.Bass { Onset: {at: $t + 1.0}; Pitch: {hz: 110}; Gain: {amp: 0.07}; Lasts: {dur: 2.4} }
    answer : voice.Mallet { Onset: {at: $t + 1.7}; Pitch: {hz: 329.63}; Gain: {amp: 0.05}; Lasts: {dur: 1.8}; Pan: {pos: 0.3, sweep: 0} }
  }
}
