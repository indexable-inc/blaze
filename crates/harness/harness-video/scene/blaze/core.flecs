// Beat 3, the core: the daemon, warm, with the work in orbit round it.
const t = $t_core

@tree ChildOf
film {
  core_shot { Cue: {member: "Backdrop.shot", from: 3, to: 3, at: $t, dur: 0, ease: Linear} }
  core_at { Cue: {member: "Backdrop.at", from: $t, to: $t, at: $t, dur: 0, ease: Linear} }
  core_caps : film_part.Under {
    slot : film_part.Slot {
      warm : film_part.Caption {
        Text: {s: "warm daemon"}
        cue.Arrive show(at: $t + 0.2, dur: 0.1)
        cue.Pop pop(at: $t + 0.2)
        cue.Leave hide(at: $t + 1.6)
      }
      safe : film_part.Caption {
        Text: {s: "sandboxed, byte-identical"}
        cue.Arrive show(at: $t + 1.8, dur: 0.1)
        cue.Pop pop(at: $t + 1.8)
        cue.Leave hide(at: $t + 3.4)
      }
    }
    low : film_part.Low {}
  }
  // Sound: a low swell.
  core_low : voice.Bass { Onset: {at: $t}; Pitch: {hz: 110}; Gain: {amp: 0.11}; Lasts: {dur: 3.4} }
  core_fifth : voice.Mallet { Onset: {at: $t + 1.8}; Pitch: {hz: 329.63}; Gain: {amp: 0.06}; Lasts: {dur: 1.6}; Pan: {pos: 0.3, sweep: 0} }
}
