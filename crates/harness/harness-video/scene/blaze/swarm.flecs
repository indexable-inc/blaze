// Beat 4, the peak: every spark is a share of the cached results blaze re-verified for one edit. Before the day's
// fixes that was all of them; the count falls to what it is now and the sparks go dark with it, leaving the data's own
// share alight (`day.reverified`'s after over its before).
const t = $t_swarm
const fall = $t + 2.2
const fell = $t + 5.0
const ticks = 34

@tree ChildOf
film {
  swarm_shot { Cue: {member: "Backdrop.shot", from: 4, to: 4, at: $t, dur: 0, ease: Linear} }
  swarm_at { Cue: {member: "Backdrop.at", from: $t, to: $t, at: $t, dur: 0, ease: Linear} }
  swarm_b { Cue: {member: "Backdrop.b", from: $d_day_reverified_after_share, to: $d_day_reverified_after_share, at: $t, dur: 0, ease: Linear} }
  swarm_live { Cue: {member: "Backdrop.a", from: 1, to: $d_day_reverified_after_share, at: $fall, dur: $fell - $fall, ease: InOut} }
  swarm_fig : film_part.Layer {
    cue.CutIn enter(at: $t)
    cue.CutOut leave(at: $t_noop)
    fig : film_part.Figure {
      was { Cue: {member: "Tally.value", from: $d_day_reverified_before, to: $d_day_reverified_before, at: $t, dur: 0, ease: Linear} }
      cue.Fall drop(at: $fall, dur: $fell - $fall, from: $d_day_reverified_before, to: $d_day_reverified_after)
    }
  }
  swarm_caps : film_part.Under {
    slot : film_part.Slot {
      what : film_part.Caption {
        Text: {s: $d_day_reverified_label}
        cue.Arrive show(at: $t + 0.2, dur: 0.1)
        cue.Pop pop(at: $t + 0.2)
        cue.Leave hide(at: $t + 2.0)
      }
      day : film_part.Caption {
        Text: {s: $d_day_title}
        Fill: $tone_film_accent
        cue.Arrive show(at: $t + 5.2, dur: 0.1)
        cue.Pop pop(at: $t + 5.2)
        cue.Leave hide(at: $t + 7.3)
      }
    }
    low : film_part.Low {}
  }
  // Sound: a rise under the fall, ticks that come faster as the number drops, and the film's one big hit where it lands.
  swarm_rise : voice.Rise { Onset: {at: $fall}; Lasts: {dur: $fell - $fall}; Pitch: {hz: 880}; Gain: {amp: 0.06}; Pan: {pos: -0.3, sweep: 0.6} }
  swarm_swell : voice.Pad { Onset: {at: $t}; Lasts: {dur: $fell - $t + 2.4}; Pitch: {hz: 220}; Gain: {amp: 0.03} }
  for i in 0..$ticks {
    "swarm_tick_{i}" : voice.Click {
      Onset: {at: $fall + ($fell - $fall) * (1 - (1 - i * 1.0 / $ticks) * (1 - i * 1.0 / $ticks))}
      Pitch: {hz: 1700 + i * 55}
      Gain: {amp: 0.03 + i * 0.0012}
      Pan: {pos: -0.5 + (i % 5) * 0.25, sweep: 0}
    }
  }
  swarm_hit : voice.Thud { Onset: {at: $fell}; Gain: {amp: 0.4} }
  swarm_tone : voice.Mallet { Onset: {at: $fell}; Pitch: {hz: 220}; Gain: {amp: 0.14}; Lasts: {dur: 3.0} }
  swarm_air : voice.Bell { Onset: {at: $fell + 0.02}; Pitch: {hz: 880}; Gain: {amp: 0.05}; Lasts: {dur: 2.4}; Pan: {pos: 0.3, sweep: 0} }
}
