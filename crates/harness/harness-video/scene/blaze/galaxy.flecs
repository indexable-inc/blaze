// Shot 9 (bars 15-18), the peak, on the drop: the galaxy, every function a star, lands on the downbeat and holds a
// bar; the camera dives through the second; on the third's downbeat one star is edited: it flares and only its
// four readers light. The fourth bar pulls back out.
const dive = $m_b16_1
const edit = $m_b17_1
const back = $m_b18_1

@tree ChildOf
film {
  galaxy_shot { Cue: {member: "Backdrop.shot", from: 11, to: 11, at: $t_galaxy, dur: 0, ease: Linear} }
  galaxy_at { Cue: {member: "Backdrop.at", from: $t_galaxy, to: $t_galaxy, at: $t_galaxy, dur: 0, ease: Linear} }
  galaxy_len { Cue: {member: "Backdrop.f", from: $t_hub - $t_galaxy, to: $t_hub - $t_galaxy, at: $t_galaxy, dur: 0, ease: Linear} }
  galaxy_b { Cue: {member: "Backdrop.b", from: $edit - $t_galaxy, to: $edit - $t_galaxy, at: $t_galaxy, dur: 0, ease: Linear} }
  galaxy_far { Cue: {member: "Backdrop.a", from: 1, to: 1, at: $t_galaxy, dur: 0, ease: Linear} }
  galaxy_dive { Cue: {member: "Backdrop.a", from: 1, to: 3.5, at: $dive, dur: $edit - $dive, ease: InOut} }
  galaxy_back { Cue: {member: "Backdrop.a", from: 3.5, to: 1, at: $back, dur: $t_hub - $back, ease: InOut} }
  galaxy_caps : film_part.Under {
    slot : film_part.Slot {
      one : film_part.Caption {
        Text: {s: "one edit"}
        Fill: $tone_film_accent
        cue.Arrive show(at: $edit, dur: 0.08)
        cue.Pop pop(at: $edit)
        cue.Leave hide(at: $m_b18_1 - 0.1)
      }
      twice : film_part.Caption {
        Text: {s: "nothing compiled twice"}
        cue.Arrive show(at: $m_b18_1, dur: 0.08)
        cue.Pop pop(at: $m_b18_1)
        cue.Leave hide(at: $t_hub - 0.1)
      }
    }
    low : film_part.Low {}
  }
  galaxy_hit : voice.Thud { Onset: {at: $edit}; Gain: {amp: 0.3} }
  galaxy_air : voice.Bell { Onset: {at: $edit + 0.02}; Lasts: {dur: 2.4}; Pitch: {hz: 880}; Gain: {amp: 0.05}; Pan: {pos: 0.3, sweep: 0} }
}
