// Shot 11 (bars 21-22), the end card, held over five seconds: on the final statement's downbeat the sea streams in
// and the mark forms and catches fire; the repository comes on the third beat and stays.

@tree ChildOf
film {
  end_shot { Cue: {member: "Backdrop.shot", from: 16, to: 16, at: $t_end, dur: 0, ease: Linear} }
  end_at { Cue: {member: "Backdrop.at", from: $t_end, to: $t_end, at: $t_end, dur: 0, ease: Linear} }
  end_len { Cue: {member: "Backdrop.f", from: $t_out - $t_end, to: $t_out - $t_end, at: $t_end, dur: 0, ease: Linear} }
  end_gather { Cue: {member: "Backdrop.a", from: 0, to: 1, at: $t_end, dur: 3 * $beat, ease: InOut} }
  end_card : film_part.Layer {
    Flex: {axis: Column, gap: 14, align: Center, justify: Center, wrap: false}
    cue.CutIn enter(at: $t_end)
    cue.FadeOut leave(at: $t_out - 0.4, dur: 0.35)
    mark : ui.Node {
      // `glow` 1: an SDR export has no room over white. `exit` 0: it never burns away.
      BlazeMark: {start: $t_end, exit: 0, glow: 1}
      Size: {w: {kind: Fixed, value: 43 * 8, min: 0, max: 0}, h: {kind: Fixed, value: 23 * 8, min: 0, max: 0}}
    }
    url : film_part.Code {
      Text: {s: "github.com/indexable-inc/blaze"}
      Fill: $tone_ink_strong
      cue.Arrive show(at: $m_b21_3, dur: 0.1)
      cue.Pop pop(at: $m_b21_3, by: 0.2)
    }
  }
}
