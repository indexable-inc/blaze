// The end: every point streams to the middle and blaze's mark forms there (live: its letters drop in and the fire
// catches); then the repository, for under three seconds, and out.
const t = $t_end
// The mark is 43 by 23 cells (harness-native-blaze), each this many points.
const cell = 8

@tree ChildOf
film {
  end_shot { Cue: {member: "Backdrop.shot", from: 6, to: 6, at: $t, dur: 0, ease: Linear} }
  end_at { Cue: {member: "Backdrop.at", from: $t, to: $t, at: $t, dur: 0, ease: Linear} }
  end_gather { Cue: {member: "Backdrop.a", from: 0, to: 1, at: $t, dur: 2.0, ease: InOut} }
  end_card : film_part.Layer {
    Flex: {axis: Column, gap: 14, align: Center, justify: Center, wrap: false}
    cue.CutIn enter(at: $t)
    cue.FadeOut leave(at: $t_out - 0.6, dur: 0.5)
    mark : ui.Node {
      // `glow` 1: an SDR export has no room over white. `exit` 0: it never burns away.
      BlazeMark: {start: $t + 0.1, exit: 0, glow: 1}
      Size: {w: {kind: Fixed, value: 43 * $cell, min: 0, max: 0}, h: {kind: Fixed, value: 23 * $cell, min: 0, max: 0}}
    }
    url : film_part.Who {
      Text: {s: "github.com/indexable-inc/blaze"}
      Fill: $tone_ink_strong
      TextStyle: {size: 22, line: 30, code_line: 0, role: 9, bold: 0, weight: 0}
      cue.Arrive show(at: $t + 1.9, dur: 0.2)
      cue.Pop pop(at: $t + 1.9, by: 0.12)
    }
  }
}
