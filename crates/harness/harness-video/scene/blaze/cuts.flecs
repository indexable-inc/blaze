// The cut list, in musical time: when each shot starts, as a bar and beat of the track's grid (`$m_b<bar>_<beat>`,
// from beats.json beside this file: harness-video's src/music.rs). Eleven shots in a minute: an idea gets two bars
// (over five seconds at 88) to arrive, be read, do its one thing and hand on. Every cut is on a bar line
// (`harness-video ... cuts` lists them and fails on one off the grid); inside a shot, things happen on beats
// (`$beat` is a beat's seconds). Another track re-times the film.
//
//   bars 1-2    cage      the first image and claim, held
//   bar  3      unclosed  the interrupt
//   bar  4      name
//   bars 5-12   rings, disk, tree, ripples: two bars each (the score's two statements and its build)
//   bars 13-14  near      the galaxy nears, then stillness (the score's bar of near-silence)
//   bars 15-18  galaxy    the peak, on the drop; the edit on bar 17's downbeat
//   bars 19-20  hub       soon
//   bars 21-22  end       the mark on the final statement, held
export const beat = $m_beat
export const t_cage = $m_b1_1
export const t_unclosed = $m_b3_1
export const t_name = $m_b4_1
export const t_rings = $m_b5_1
export const t_disk = $m_b7_1
export const t_tree = $m_b9_1
export const t_ripples = $m_b11_1
export const t_near = $m_b13_1
export const t_galaxy = $m_drop
export const t_hub = $m_b19_1
export const t_end = $m_b21_1
// The film is a minute, whatever the track's last bar rounds to.
export const t_out = 60.0
