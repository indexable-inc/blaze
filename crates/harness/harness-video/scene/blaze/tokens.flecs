// The film's own tokens (film.flecs includes this). The inks are the app's (harness-native/scene/00-tokens.flecs).

// The one accent: blaze's fire. The shaders have the same orange in linear light (src/backdrop.rs `ACCENT`). A video
// draws only the dark half.
export const tone_film_accent: Fill = {dark: {1.0, 0.584, 0.196, 1}, light: {1.0, 0.584, 0.196, 1}}
export const tone_film_other: Fill = {dark: {0.72, 0.77, 0.86, 1}, light: {0.72, 0.77, 0.86, 1}}
export const film_hot: Rgba = {1.0, 0.584, 0.196, 1}

// Type, in points (2 pixels a point at 1080p; on a phone a caption is about as tall as a system title).
export const size_film_caption = 34
export const line_film_caption = 42
export const size_film_figure = 76
export const line_film_figure = 84
export const size_film_lane = 19
export const line_film_lane = 24
export const size_film_note = 9.5
export const line_film_note = 13

// A race: the slowest lane takes this long; each of the others its own share of it (the data's).
export const film_pace = 3.2
// How long after a beat starts its race or its fall begins.
export const film_lead = 0.35

// The interrupts: the palette turned over. Words on the accent field are the ground's own dark.
export const tone_film_dark: Fill = {dark: {0.035, 0.04, 0.05, 1}, light: {0.035, 0.04, 0.05, 1}}
export const size_film_name = 118
export const line_film_name = 130
export const size_film_shout = 44
export const line_film_shout = 52
export const size_film_code = 22
export const line_film_code = 30
