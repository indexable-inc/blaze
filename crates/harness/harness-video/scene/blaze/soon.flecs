// What blaze will be, said to be so: one tag, "soon", over a fast montage of four landmarks (the hub, compiling on
// first call, a store shared across machines, hundreds of cores). Each is designed or on a branch, not on main.

@tree ChildOf
film {
  soon_tag : film_part.Layer {
    Flex: {axis: Column, gap: 0, align: Center, justify: Start, wrap: false}
    cue.CutIn enter(at: $t_soon)
    cue.CutOut leave(at: $t_quiet)
    high : ui.Node { Size: {w: {kind: Fixed, value: 1, min: 0, max: 0}, h: {kind: Percent, value: 0.12, min: 0, max: 0}} }
    tag : film_part.Tag { Text: {s: "soon"} }
  }
  hub_shot { Cue: {member: "Backdrop.shot", from: 12, to: 12, at: $t_soon, dur: 0, ease: Linear} }
  hub_at { Cue: {member: "Backdrop.at", from: $t_soon, to: $t_soon, at: $t_soon, dur: 0, ease: Linear} }
  hub_len { Cue: {member: "Backdrop.f", from: $t_first - $t_soon, to: $t_first - $t_soon, at: $t_soon, dur: 0, ease: Linear} }
  hub_caps : film_part.Under {
    slot : film_part.Slot {
      says : film_part.Caption {
        Text: {s: "the hub"}
        cue.Arrive show(at: $t_soon, dur: 0.08)
        cue.Pop pop(at: $t_soon)
        cue.Leave hide(at: $t_first - 0.15)
      }
    }
    low : film_part.Low {}
  }
  hub_note : voice.Mallet { Onset: {at: $t_soon}; Lasts: {dur: 1.0}; Pitch: {hz: 440}; Gain: {amp: 0.11} }
  hub_tick : voice.Click { Onset: {at: $t_soon}; Pitch: {hz: 2600}; Gain: {amp: 0.06} }
  first_shot { Cue: {member: "Backdrop.shot", from: 13, to: 13, at: $t_first, dur: 0, ease: Linear} }
  first_at { Cue: {member: "Backdrop.at", from: $t_first, to: $t_first, at: $t_first, dur: 0, ease: Linear} }
  first_len { Cue: {member: "Backdrop.f", from: $t_store - $t_first, to: $t_store - $t_first, at: $t_first, dur: 0, ease: Linear} }
  first_caps : film_part.Under {
    slot : film_part.Slot {
      says : film_part.Caption {
        Text: {s: "first-call compile"}
        cue.Arrive show(at: $t_first, dur: 0.08)
        cue.Pop pop(at: $t_first)
        cue.Leave hide(at: $t_store - 0.15)
      }
    }
    low : film_part.Low {}
  }
  first_note : voice.Mallet { Onset: {at: $t_first}; Lasts: {dur: 1.0}; Pitch: {hz: 493.88}; Gain: {amp: 0.11} }
  first_tick : voice.Click { Onset: {at: $t_first}; Pitch: {hz: 2600}; Gain: {amp: 0.06} }
  store_shot { Cue: {member: "Backdrop.shot", from: 14, to: 14, at: $t_store, dur: 0, ease: Linear} }
  store_at { Cue: {member: "Backdrop.at", from: $t_store, to: $t_store, at: $t_store, dur: 0, ease: Linear} }
  store_len { Cue: {member: "Backdrop.f", from: $t_cores - $t_store, to: $t_cores - $t_store, at: $t_store, dur: 0, ease: Linear} }
  store_caps : film_part.Under {
    slot : film_part.Slot {
      says : film_part.Caption {
        Text: {s: "shared store"}
        cue.Arrive show(at: $t_store, dur: 0.08)
        cue.Pop pop(at: $t_store)
        cue.Leave hide(at: $t_cores - 0.15)
      }
    }
    low : film_part.Low {}
  }
  store_note : voice.Mallet { Onset: {at: $t_store}; Lasts: {dur: 1.0}; Pitch: {hz: 554.37}; Gain: {amp: 0.11} }
  store_tick : voice.Click { Onset: {at: $t_store}; Pitch: {hz: 2600}; Gain: {amp: 0.06} }
  cores_shot { Cue: {member: "Backdrop.shot", from: 15, to: 15, at: $t_cores, dur: 0, ease: Linear} }
  cores_at { Cue: {member: "Backdrop.at", from: $t_cores, to: $t_cores, at: $t_cores, dur: 0, ease: Linear} }
  cores_len { Cue: {member: "Backdrop.f", from: $t_quiet - $t_cores, to: $t_quiet - $t_cores, at: $t_cores, dur: 0, ease: Linear} }
  cores_caps : film_part.Under {
    slot : film_part.Slot {
      says : film_part.Caption {
        Text: {s: "hundreds of cores"}
        cue.Arrive show(at: $t_cores, dur: 0.08)
        cue.Pop pop(at: $t_cores)
        cue.Leave hide(at: $t_quiet - 0.15)
      }
    }
    low : film_part.Low {}
  }
  cores_note : voice.Mallet { Onset: {at: $t_cores}; Lasts: {dur: 1.0}; Pitch: {hz: 659.25}; Gain: {amp: 0.11} }
  cores_tick : voice.Click { Onset: {at: $t_cores}; Pitch: {hz: 2600}; Gain: {amp: 0.06} }
}
