// What blaze is today, a landmark a beat, the camera flying from each through to the next: agents and their core;
// capabilities that only narrow; (interrupt: the linear error, in the compiler's words); a disk that tears under the
// simulation and replays; a proof tree; the effects as a prism; (interrupt: a panic refused); two builds, bit for bit.
// Each is something in the tree: film.flecs names the file that backs it.

@tree ChildOf
film {
  agents_shot { Cue: {member: "Backdrop.shot", from: 3, to: 3, at: $t_agents, dur: 0, ease: Linear} }
  agents_at { Cue: {member: "Backdrop.at", from: $t_agents, to: $t_agents, at: $t_agents, dur: 0, ease: Linear} }
  agents_len { Cue: {member: "Backdrop.f", from: $t_rings - $t_agents, to: $t_rings - $t_agents, at: $t_agents, dur: 0, ease: Linear} }
  agents_caps : film_part.Under {
    slot : film_part.Slot {
      says : film_part.Caption {
        Text: {s: "agents, not keyboards"}
        cue.Arrive show(at: $t_agents, dur: 0.08)
        cue.Pop pop(at: $t_agents)
        cue.Leave hide(at: $t_rings - 0.3)
      }
    }
    low : film_part.Low {}
  }
  agents_in : voice.Whoosh { Onset: {at: $t_agents}; Lasts: {dur: 1.2}; Pitch: {hz: 1800}; Gain: {amp: 0.05}; Pan: {pos: -0.6, sweep: 0.6} }
  rings_shot { Cue: {member: "Backdrop.shot", from: 4, to: 4, at: $t_rings, dur: 0, ease: Linear} }
  rings_at { Cue: {member: "Backdrop.at", from: $t_rings, to: $t_rings, at: $t_rings, dur: 0, ease: Linear} }
  rings_len { Cue: {member: "Backdrop.f", from: $t_linear - $t_rings, to: $t_linear - $t_rings, at: $t_rings, dur: 0, ease: Linear} }
  rings_caps : film_part.Under {
    slot : film_part.Slot {
      none : film_part.Caption {
        Text: {s: "nothing ambient"}
        cue.Arrive show(at: $t_rings, dur: 0.08)
        cue.Pop pop(at: $t_rings)
        cue.Leave hide(at: $t_rings + 2 * $beat - 0.1)
      }
      narrow : film_part.Caption {
        Text: {s: "capabilities only narrow"}
        Fill: $tone_film_accent
        cue.Arrive show(at: $t_rings + 2 * $beat, dur: 0.08)
        cue.Pop pop(at: $t_rings + 2 * $beat)
        cue.Leave hide(at: $t_linear - 0.15)
      }
    }
    low : film_part.Low {}
  }
  rings_0 : voice.Bell { Onset: {at: $t_rings + 0 * 0.5 * $beat}; Lasts: {dur: 1.2}; Pitch: {hz: 440}; Gain: {amp: 0.045}; Pan: {pos: -0.4, sweep: 0} }
  rings_1 : voice.Bell { Onset: {at: $t_rings + 1 * 0.5 * $beat}; Lasts: {dur: 1.2}; Pitch: {hz: 554.37}; Gain: {amp: 0.045}; Pan: {pos: -0.2, sweep: 0} }
  rings_2 : voice.Bell { Onset: {at: $t_rings + 2 * 0.5 * $beat}; Lasts: {dur: 1.2}; Pitch: {hz: 659.25}; Gain: {amp: 0.045}; Pan: {pos: 0.0, sweep: 0} }
  rings_3 : voice.Bell { Onset: {at: $t_rings + 3 * 0.5 * $beat}; Lasts: {dur: 1.2}; Pitch: {hz: 880}; Gain: {amp: 0.045}; Pan: {pos: 0.2, sweep: 0} }
  rings_4 : voice.Bell { Onset: {at: $t_rings + 4 * 0.5 * $beat}; Lasts: {dur: 1.2}; Pitch: {hz: 1108.73}; Gain: {amp: 0.045}; Pan: {pos: 0.4, sweep: 0} }
  linear_shot { Cue: {member: "Backdrop.shot", from: 17, to: 17, at: $t_linear, dur: 0, ease: Linear} }
  linear_at { Cue: {member: "Backdrop.at", from: $t_linear, to: $t_linear, at: $t_linear, dur: 0, ease: Linear} }
  linear_len { Cue: {member: "Backdrop.f", from: $t_disk - $t_linear, to: $t_disk - $t_linear, at: $t_linear, dur: 0, ease: Linear} }
  linear_code : film_part.Layer {
    Flex: {axis: Column, gap: 10, align: Center, justify: Center, wrap: false}
    cue.CutIn enter(at: $t_linear)
    cue.CutOut leave(at: $t_disk)
    said : film_part.Error {
      // The compiler's own words (crates/hir-ty-linear/src/drops.rs `CONSUME`), the start of its first clause.
      Text: {s: "error: a `#[blaze::linear]` value must be consumed"}
      cue.Pop pop(at: $t_linear, by: 0.12)
    }
  }
  linear_hit : voice.Thud { Onset: {at: $t_linear}; Gain: {amp: 0.4} }
  linear_buzz : voice.Bass { Onset: {at: $t_linear}; Lasts: {dur: 0.9}; Pitch: {hz: 82.41}; Gain: {amp: 0.14} }
  disk_shot { Cue: {member: "Backdrop.shot", from: 5, to: 5, at: $t_disk, dur: 0, ease: Linear} }
  disk_at { Cue: {member: "Backdrop.at", from: $t_disk, to: $t_disk, at: $t_disk, dur: 0, ease: Linear} }
  disk_len { Cue: {member: "Backdrop.f", from: $t_tree - $t_disk, to: $t_tree - $t_disk, at: $t_disk, dur: 0, ease: Linear} }
  disk_a { Cue: {member: "Backdrop.a", from: 2 * $beat, to: 2 * $beat, at: $t_disk, dur: 0, ease: Linear} }
  disk_caps : film_part.Under {
    slot : film_part.Slot {
      same : film_part.Caption {
        Text: {s: "same code"}
        cue.Arrive show(at: $t_disk, dur: 0.08)
        cue.Pop pop(at: $t_disk)
        cue.Leave hide(at: $t_disk + 2 * $beat - 0.1)
      }
      fake : film_part.Caption {
        Text: {s: "fake disk"}
        Fill: $tone_film_accent
        cue.Arrive show(at: $t_disk + 2 * $beat, dur: 0.08)
        cue.Pop pop(at: $t_disk + 2 * $beat)
        cue.Leave hide(at: $t_disk + 4 * $beat - 0.1)
      }
      again : film_part.Caption {
        Text: {s: "replays"}
        cue.Arrive show(at: $t_disk + 6 * $beat, dur: 0.08)
        cue.Pop pop(at: $t_disk + 6 * $beat)
        cue.Leave hide(at: $t_tree - 0.15)
      }
    }
    low : film_part.Low {}
  }
  disk_tear : voice.Whoosh { Onset: {at: $t_disk + 2 * $beat - 0.15}; Lasts: {dur: 0.5}; Pitch: {hz: 3400}; Gain: {amp: 0.07}; Pan: {pos: 0.4, sweep: -0.8} }
  disk_back : voice.Rise { Onset: {at: $t_disk + 2 * $beat + 0.8}; Lasts: {dur: 0.5}; Pitch: {hz: 660}; Gain: {amp: 0.05} }
  disk_tear2 : voice.Whoosh { Onset: {at: $t_disk + 4 * $beat + 1.15}; Lasts: {dur: 0.5}; Pitch: {hz: 3400}; Gain: {amp: 0.07}; Pan: {pos: 0.4, sweep: -0.8} }
  tree_shot { Cue: {member: "Backdrop.shot", from: 6, to: 6, at: $t_tree, dur: 0, ease: Linear} }
  tree_at { Cue: {member: "Backdrop.at", from: $t_tree, to: $t_tree, at: $t_tree, dur: 0, ease: Linear} }
  tree_len { Cue: {member: "Backdrop.f", from: $t_prism - $t_tree, to: $t_prism - $t_tree, at: $t_tree, dur: 0, ease: Linear} }
  tree_caps : film_part.Under {
    slot : film_part.Slot {
      says : film_part.Caption {
        Text: {s: "proved"}
        cue.Arrive show(at: $t_tree + $beat, dur: 0.08)
        cue.Pop pop(at: $t_tree + $beat)
        cue.Leave hide(at: $t_prism - 0.2)
      }
    }
    low : film_part.Low {}
  }
  tree_0 : voice.Click { Onset: {at: $t_tree + 0.25}; Pitch: {hz: 1600}; Gain: {amp: 0.06}; Pan: {pos: -0.5, sweep: 0} }
  tree_1 : voice.Click { Onset: {at: $t_tree + 0.57}; Pitch: {hz: 1850}; Gain: {amp: 0.06}; Pan: {pos: -0.3, sweep: 0} }
  tree_2 : voice.Click { Onset: {at: $t_tree + 0.89}; Pitch: {hz: 2100}; Gain: {amp: 0.06}; Pan: {pos: -0.1, sweep: 0} }
  tree_3 : voice.Click { Onset: {at: $t_tree + 1.21}; Pitch: {hz: 2350}; Gain: {amp: 0.06}; Pan: {pos: 0.1, sweep: 0} }
  tree_4 : voice.Click { Onset: {at: $t_tree + 1.53}; Pitch: {hz: 2600}; Gain: {amp: 0.06}; Pan: {pos: 0.3, sweep: 0} }
  tree_5 : voice.Click { Onset: {at: $t_tree + 1.85}; Pitch: {hz: 2850}; Gain: {amp: 0.06}; Pan: {pos: 0.5, sweep: 0} }
  prism_shot { Cue: {member: "Backdrop.shot", from: 7, to: 7, at: $t_prism, dur: 0, ease: Linear} }
  prism_at { Cue: {member: "Backdrop.at", from: $t_prism, to: $t_prism, at: $t_prism, dur: 0, ease: Linear} }
  prism_len { Cue: {member: "Backdrop.f", from: $t_nopanic - $t_prism, to: $t_nopanic - $t_prism, at: $t_prism, dur: 0, ease: Linear} }
  prism_caps : film_part.Under {
    slot : film_part.Slot {
      pure : film_part.Caption {
        Text: {s: "pure"}
        cue.Arrive show(at: $t_prism + $beat, dur: 0.08)
        cue.Pop pop(at: $t_prism + $beat)
        cue.Leave hide(at: $t_prism + 2 * $beat - 0.1)
      }
      nopanic : film_part.Caption {
        Text: {s: "nopanic"}
        cue.Arrive show(at: $t_prism + 2 * $beat, dur: 0.08)
        cue.Pop pop(at: $t_prism + 2 * $beat)
        cue.Leave hide(at: $t_prism + 3 * $beat - 0.1)
      }
      noalloc : film_part.Caption {
        Text: {s: "noalloc"}
        cue.Arrive show(at: $t_prism + 3 * $beat, dur: 0.08)
        cue.Pop pop(at: $t_prism + 3 * $beat)
        cue.Leave hide(at: $t_nopanic - 0.15)
      }
    }
    low : film_part.Low {}
  }
  prism_0 : voice.Mallet { Onset: {at: $t_prism + 1 * $beat}; Lasts: {dur: 0.9}; Pitch: {hz: 440}; Gain: {amp: 0.09}; Pan: {pos: -0.3, sweep: 0} }
  prism_1 : voice.Mallet { Onset: {at: $t_prism + 2 * $beat}; Lasts: {dur: 0.9}; Pitch: {hz: 554.37}; Gain: {amp: 0.09}; Pan: {pos: 0, sweep: 0} }
  prism_2 : voice.Mallet { Onset: {at: $t_prism + 3 * $beat}; Lasts: {dur: 0.9}; Pitch: {hz: 659.25}; Gain: {amp: 0.09}; Pan: {pos: 0.3, sweep: 0} }
  nopanic_shot { Cue: {member: "Backdrop.shot", from: 17, to: 17, at: $t_nopanic, dur: 0, ease: Linear} }
  nopanic_at { Cue: {member: "Backdrop.at", from: $t_nopanic, to: $t_nopanic, at: $t_nopanic, dur: 0, ease: Linear} }
  nopanic_len { Cue: {member: "Backdrop.f", from: $t_mirror - $t_nopanic, to: $t_mirror - $t_nopanic, at: $t_nopanic, dur: 0, ease: Linear} }
  nopanic_code : film_part.Layer {
    Flex: {axis: Column, gap: 10, align: Center, justify: Center, wrap: false}
    cue.CutIn enter(at: $t_nopanic)
    cue.CutOut leave(at: $t_mirror)
    code : film_part.Stamp {
      Text: {s: "#[blaze::nopanic]  v[i]"}
      TextStyle: {size: 30, line: 38, code_line: 0, role: 9, bold: 1, weight: 0}
    }
    said : film_part.Stamp {
      Text: {s: "refused"}
      cue.Arrive show(at: $t_nopanic + $beat, dur: 0.05)
      cue.Pop pop(at: $t_nopanic + $beat, by: 0.5)
    }
  }
  nopanic_hit : voice.Thud { Onset: {at: $t_nopanic}; Gain: {amp: 0.4} }
  nopanic_no : voice.Bass { Onset: {at: $t_nopanic + $beat}; Lasts: {dur: 0.8}; Pitch: {hz: 73.42}; Gain: {amp: 0.16} }
  mirror_shot { Cue: {member: "Backdrop.shot", from: 8, to: 8, at: $t_mirror, dur: 0, ease: Linear} }
  mirror_at { Cue: {member: "Backdrop.at", from: $t_mirror, to: $t_mirror, at: $t_mirror, dur: 0, ease: Linear} }
  mirror_len { Cue: {member: "Backdrop.f", from: $t_ripples - $t_mirror, to: $t_ripples - $t_mirror, at: $t_mirror, dur: 0, ease: Linear} }
  mirror_caps : film_part.Under {
    slot : film_part.Slot {
      says : film_part.Caption {
        Text: {s: "same bytes"}
        cue.Arrive show(at: $t_mirror, dur: 0.08)
        cue.Pop pop(at: $t_mirror)
        cue.Leave hide(at: $t_ripples - 0.2)
      }
    }
    low : film_part.Low {}
  }
  mirror_scan : voice.Whoosh { Onset: {at: $t_mirror + 0.2}; Lasts: {dur: 2.0}; Pitch: {hz: 2400}; Gain: {amp: 0.035}; Pan: {pos: 0, sweep: 0} }
}
