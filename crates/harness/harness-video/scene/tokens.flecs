// The launch video's tokens: the names the prims read (harness-native-ui-prims/scene/prims.flecs: tones, radii, sizes,
// springs, and the Strong, Ink, Muted, Accent, Wash and Plate prefabs a prim says it is), then the video's own. The look is
// the README's: GitHub's dark ground under the fire logo (docs/brand/fire/gen.py's dark theme). Colours are sRGB 0..1,
// straight; a video draws only the dark half, so each Fill's light half repeats it.

// ---- what the prims read ----
export const size_caption = 11
export const size_body = 13
export const radius_control = 6
export const radius_card = 12
export const spring_transition_omega = 20
export const spring_transition_zeta = 0.9
export const spring_matched_omega = 26
export const spring_matched_zeta = 0.84
export const spring_layout_omega = 18
export const spring_layout_zeta = 1

export const tone_ground: Fill = {dark: {0.051, 0.067, 0.090, 1}, light: {0.051, 0.067, 0.090, 1}}
export const tone_ink_1: Fill = {dark: {0.941, 0.965, 0.988, 1}, light: {0.941, 0.965, 0.988, 1}}
export const tone_ink_2: Fill = {dark: {0.941, 0.965, 0.988, 0.86}, light: {0.941, 0.965, 0.988, 0.86}}
export const tone_ink_3: Fill = {dark: {0.941, 0.965, 0.988, 0.52}, light: {0.941, 0.965, 0.988, 0.52}}
export const tone_accent: Fill = {dark: {1.0, 0.561, 0.122, 1}, light: {1.0, 0.561, 0.122, 1}}
export const tone_wash: Fill = {dark: {1, 1, 1, 0.06}, light: {1, 1, 1, 0.06}}
export const tone_wash_hover: Fill = {dark: {1, 1, 1, 0.045}, light: {1, 1, 1, 0.045}}
export const tone_wash_press: Fill = {dark: {1, 1, 1, 0.10}, light: {1, 1, 1, 0.10}}
export const tone_plate: Fill = {dark: {0.086, 0.106, 0.133, 1}, light: {0.086, 0.106, 0.133, 1}}
export const tone_plate_line: Fill = {dark: {1, 1, 1, 0.10}, light: {1, 1, 1, 0.10}}
export const tone_switch_on: Fill = {dark: {1.0, 0.561, 0.122, 1}, light: {1.0, 0.561, 0.122, 1}}

prefab Strong {
  Fill: $tone_ink_1
}
prefab Ink {
  Fill: $tone_ink_2
}
prefab Muted {
  Fill: $tone_ink_3
}
prefab Accent {
  Fill: $tone_accent
}
prefab Wash {
  Fill: $tone_wash
}
prefab Plate {
  Fill: $tone_plate
  Edge: {dark: $tone_plate_line.dark, light: $tone_plate_line.light}
  Shape: {radius: $radius_card, n: 4, border: 1, feather: 0}
}

// ---- the video's own ----
// Type, in points of a 960 by 540 frame drawn at 2x (1920 by 1080). Big: most people watch it on a phone, a 1080p
// frame shrunk to a fifth of its width.
export const size_hero = 52
export const line_hero = 64
export const size_title = 34
export const line_title = 44
export const size_lead = 26
export const line_lead = 34
export const size_row = 22
export const line_row = 28
export const size_code = 22
export const line_code = 30
// The logo is 43 by 23 cells (gen.py --sheet); a cell is this many points, big then small.
export const logo_cell = 9
export const logo_cell_small = 6
// The race: a cargo bar is this long, a blaze bar its share of it; a project's name column, and room past a bar's tip.
export const bar_w = 440
export const bar_h = 14
export const bar_radius = 4
export const name_w = 112
export const tip_room = 70
export const tone_cargo: Fill = {dark: {0.941, 0.965, 0.988, 0.24}, light: {0.941, 0.965, 0.988, 0.24}}
