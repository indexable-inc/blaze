// The launch video's own tokens (launch.flecs includes this). Everything else it names is the app's
// (harness-native/scene/00-tokens.flecs), which every video's scene is loaded on.

// GitHub's dark ground under the fire logo (docs/brand/fire/gen.py's dark theme), and the two inks on it. Colours are
// sRGB 0..1, straight; a video draws only the dark half, so the light half repeats it.
export const tone_launch_ground: Fill = {dark: {0.051, 0.067, 0.09, 1}, light: {0.051, 0.067, 0.09, 1}}
export const tone_launch_ink: Fill = {dark: {0.941, 0.965, 0.988, 0.86}, light: {0.941, 0.965, 0.988, 0.86}}
export const tone_launch_ink_muted: Fill = {dark: {0.941, 0.965, 0.988, 0.52}, light: {0.941, 0.965, 0.988, 0.52}}

// The one line of words, in the code face, as the mark's own home (a terminal) sets it. Big, in points of a 960 by 540
// frame: most people watch it on a phone.
export const size_lead = 22
export const line_lead = 30

// The fire mark: 43 by 23 cells (harness-native-blaze), each this many points.
export const mark_cell = 12

// The fire's hottest colour but one (docs/brand/fire/gen.py's dark theme).
export const fire_3: Rgba = {1.0, 0.831, 0.231, 1}
