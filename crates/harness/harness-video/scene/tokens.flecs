export const tone_ground: Fill = {dark: {0.051, 0.067, 0.090, 1}, light: {0.051, 0.067, 0.090, 1}}
export const tone_ink_1: Fill = {dark: {0.941, 0.965, 0.988, 1}, light: {0.941, 0.965, 0.988, 1}}
export const tone_ink_2: Fill = {dark: {0.941, 0.965, 0.988, 0.86}, light: {0.941, 0.965, 0.988, 0.86}}
export const tone_ink_3: Fill = {dark: {0.941, 0.965, 0.988, 0.52}, light: {0.941, 0.965, 0.988, 0.52}}
export const tone_ink_4: Fill = {dark: {0.941, 0.965, 0.988, 0.32}, light: {0.941, 0.965, 0.988, 0.32}}
export const tone_hint: Fill = {dark: {0.941, 0.965, 0.988, 0.24}, light: {0.941, 0.965, 0.988, 0.24}}
export const tone_accent: Fill = {dark: {1.0, 0.561, 0.122, 1}, light: {1.0, 0.561, 0.122, 1}}
export const tone_wash: Fill = {dark: {1, 1, 1, 0.06}, light: {1, 1, 1, 0.06}}
export const tone_wash_hover: Fill = {dark: {1, 1, 1, 0.045}, light: {1, 1, 1, 0.045}}
export const tone_wash_press: Fill = {dark: {1, 1, 1, 0.10}, light: {1, 1, 1, 0.10}}
export const tone_plate: Fill = {dark: {0.086, 0.106, 0.133, 1}, light: {0.086, 0.106, 0.133, 1}}
export const tone_plate_line: Fill = {dark: {1, 1, 1, 0.10}, light: {1, 1, 1, 0.10}}
export const tone_switch_on: Fill = {dark: {1.0, 0.561, 0.122, 1}, light: {1.0, 0.561, 0.122, 1}}

prefab Strong {
  Fill: $tone_ink_1
}
prefab Ink {
  Fill: $tone_ink_2
}
prefab Muted {
  Fill: $tone_ink_3
}
prefab Accent {
  Fill: $tone_accent
}
prefab Wash {
  Fill: $tone_wash
}
prefab Plate {
  Fill: $tone_plate
  Edge: {dark: $tone_plate_line.dark, light: $tone_plate_line.light}
  Shape: {radius: $radius_card, n: 4, border: 1, feather: 0}
}

// ---- the video's own ----
// Type, in points of a 960 by 540 frame drawn at 2x (1920 by 1080). Big: most people watch it on a phone, a 1080p
// frame shrunk to a fifth of its width.
// The one line of words, in the code face, as the mark's own home (a terminal) sets it.
export const size_lead = 22
export const line_lead = 30

// The fire mark: 43 by 23 cells (harness-native-blaze), each this many points.
export const mark_cell = 12

// The fire's hottest colour but one (docs/brand/fire/gen.py's dark theme).
export const fire_3: Rgba = {1.0, 0.831, 0.231, 1}
export const menu_lift_dy = 6
export const spring_press_omega = 38
export const spring_press_zeta = 0.62
export const tone_icon_rest: Fill = $tone_ink_3
prefab Faint {
  Fill: $tone_ink_4
}
export const icon_press_dim = 0.7
export const line_menu = 16
export const menu_item_pad_r = 10
export const menu_lift_alpha = 0.28
export const menu_max_w = 380
export const menu_sep_pad = 5
export const menu_zeta = 1
export const tone_icon_hover: Fill = $tone_ink_1

// Inline components (harness-native-ui-prims/scene/inline.flecs): the chip under the pointer brightens a step and
// underlines its label, held down a step more (--ink-1 at 11% and 16% over inline code's 6% --s-tint). A GitHub pull
// request's or issue's state picks its icon's ink, as GitHub's Primer draws them (open green, draft and not planned grey,
// merged and completed purple, closed red), and its head commit's checks the mark after it (success green, failure red,
// pending amber).
// A chip at rest has no plate (its icon in its state's ink says what it is), and a link's host after its words is quiet.
export const tone_inline_rest: Fill = {dark: {0.922, 0.918, 0.902, 0}, light: {0.086, 0.086, 0.090, 0}}
export const tone_inline_meta: Fill = $tone_ink_3
export const tone_inline_hover: Fill = {dark: {0.922, 0.918, 0.902, 0.11}, light: {0.086, 0.086, 0.090, 0.10}}
export const tone_inline_pressed: Fill = {dark: {0.922, 0.918, 0.902, 0.16}, light: {0.086, 0.086, 0.090, 0.15}}
export const tone_inline_underline: Fill = {dark: {0.922, 0.918, 0.902, 0.42}, light: {0.086, 0.086, 0.090, 0.40}}
export const tone_gh_open: Fill = {dark: {0.247, 0.725, 0.314, 1}, light: {0.102, 0.498, 0.216, 1}}
export const tone_gh_draft: Fill = {dark: {0.569, 0.596, 0.631, 1}, light: {0.349, 0.388, 0.431, 1}}
export const tone_gh_merged: Fill = {dark: {0.671, 0.490, 0.973, 1}, light: {0.510, 0.314, 0.875, 1}}
export const tone_gh_closed: Fill = {dark: {0.973, 0.318, 0.286, 1}, light: {0.812, 0.133, 0.180, 1}}
export const tone_gh_ci_success: Fill = $tone_gh_open
export const tone_gh_ci_failure: Fill = $tone_gh_closed
export const tone_gh_ci_pending: Fill = {dark: {0.824, 0.600, 0.133, 1}, light: {0.604, 0.404, 0.0, 1}}
