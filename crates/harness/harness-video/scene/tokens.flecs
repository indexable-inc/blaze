// The launch video's tokens: the names the prims read (harness-native-ui-prims/scene/prims.flecs: tones, radii, sizes,
// springs, and the Strong, Ink, Muted, Accent, Wash and Plate prefabs a prim says it is), then the video's own. The look is
// the README's: GitHub's dark ground under the fire logo (docs/brand/fire/gen.py's dark theme). Colours are sRGB 0..1,
// straight; a video draws only the dark half, so each Fill's light half repeats it.

// ---- what the prims read ----
// ui.Block (prims.flecs): a pixel-art block block_size across (16 texels: 1.5 points each), turning to a new face over
// block_turn seconds.
export const block_size = 24
export const block_turn = 0.32
// Menus, bubbles and icon buttons (the video shows none; the prims read them), as harness-native/scene/00-tokens.flecs.
export const menu_radius = 10
export const menu_pad = 5
export const menu_gap = 6
export const menu_min_w = 120
export const menu_lift_blur = 18
export const menu_in_scale = 0.94
export const menu_omega = 34
export const menu_item_h = 22
export const menu_item_radius = 5
export const menu_gutter_l = 6
export const menu_check = 11
export const menu_gutter_gap = 5
export const menu_label_x = $menu_gutter_l + $menu_check + $menu_gutter_gap
export const menu_trail_gap = 20
export const menu_head_h = 20
export const size_menu = 13
export const size_menu_head = 11
export const menu_mark = 13
export const menu_caret_w = 1.5
// ui.Browser's corners (the app's value).
export const radius_gen_media = 8
export const radius_bubble = 12
export const bubble_max_w = 480
export const icon_press_scale = 0.92
export const size_caption = 11
export const size_body = 13
// Chrome: the words on controls around content (a composer's model picker), a step under the body (harness-native's).
export const size_chrome = 11.5
export const line_chrome = 14
export const size_code = 11.5
export const table_row = 24
export const table_gap = 14
export const table_pad = 6
export const size_table = 12.5
export const result_snippet_h = 36
export const textarea_max_h = 132
export const textarea_hint_inset = 4
export const textarea_grow_share = 0.85
export const textarea_caret_margin = 6
export const textarea_glide_omega = 22
export const textarea_glide_zeta = 1
export const plate_selection_radius = 4
export const plate_selection_n = 2
export const copy_secs = 0.3
export const copy_rise = 0.18
export const copy_grow = 0.025
export const copy_sweep = 0.55
export const copy_band = 30
export const copy_tilt = 0.6
export const copy_ink = 0.6
export const copy_add_dark = 1
export const copy_add_light = 1
// ui.Shimmer's sheen (harness-native's sheen_think_* and sheen_still, 00-tokens.flecs): a slow drift of light through
// the words, a pass of sheen_think_period seconds and sheen_think_rest at rest, a band sheen_think_band points either side
// of its middle lifting them sheen_think_strength toward tone_sheen; steady at sheen_still of it under Reduce Motion.
export const sheen_think_period = 2.6
export const sheen_think_rest = 1.1
export const sheen_think_band = 36
export const sheen_think_strength = 0.7
export const sheen_think_ease = 0.6
export const sheen_still = 0.35
export const caret_w = 1.5
export const caret_h = 1.25
export const caret_radius = 0.75
export const caret_glide = 0.2
export const caret_hold = 0.5
export const caret_blink = 1.06
export const caret_fade = 0.09
export const strike_w = 1
export const strike_rise_em = 0.27
export const strike_alpha = 0.7
export const math_inline_scale = 1.1
export const math_display_scale = 1.25
export const math_inline_pad = 2
export const math_display_pad = 10
export const math_stroke_em = 0.0375
export const radius_control = 6
export const radius_card = 12
export const spring_transition_omega = 20
export const spring_transition_zeta = 0.9
export const spring_matched_omega = 26
export const spring_matched_zeta = 0.84
export const spring_layout_omega = 18
export const spring_layout_zeta = 1
export const spring_pose_omega = 22
export const spring_pose_zeta = 1
// ui.Scroller (the app's values, harness-native/scene/00-tokens.flecs); its tones are with the roles below.
export const scroller_thin = 6
export const scroller_wide = 10
export const scroller_inset = 2
export const scroller_min = 24
export const scroller_grab = 16
export const scroller_hold = 0.7
export const scroller_keep = 24
export const scroller_show_omega = 40
export const scroller_show_zeta = 1
export const scroller_hide_omega = 13
export const scroller_hide_zeta = 1
export const scroller_wide_omega = 32
export const scroller_wide_zeta = 1
export const scroller_page_omega = 20
export const scroller_page_zeta = 1

// The theme's roles (harness-native/scene/00-tokens.flecs names and says what each is for), in the video's look: GitHub's
// dark ground, its plates a step or two up, its inks and washes the README's near-white at an alpha, the fire's orange
// as the accent. Only the dark half is drawn, so each light half repeats it.
export const tone_ground: Fill = {dark: {0.051, 0.067, 0.09, 1}, light: {0.051, 0.067, 0.09, 1}}
export const tone_sidebar: Fill = $tone_ground
export const tone_card: Fill = {dark: {0.086, 0.106, 0.133, 1}, light: {0.086, 0.106, 0.133, 1}}
export const tone_raised: Fill = {dark: {0.118, 0.141, 0.173, 1}, light: {0.118, 0.141, 0.173, 1}}
export const tone_well: Fill = {dark: {0.039, 0.051, 0.071, 1}, light: {0.039, 0.051, 0.071, 1}}
export const tone_term_ground: Fill = $tone_ground
export const tone_line: Fill = {dark: {0.941, 0.965, 0.988, 0.1}, light: {0.941, 0.965, 0.988, 0.1}}
export const tone_line_strong: Fill = {dark: {0.941, 0.965, 0.988, 0.16}, light: {0.941, 0.965, 0.988, 0.16}}
export const tone_ink_strong: Fill = {dark: {0.941, 0.965, 0.988, 1}, light: {0.941, 0.965, 0.988, 1}}
export const tone_ink: Fill = {dark: {0.941, 0.965, 0.988, 0.86}, light: {0.941, 0.965, 0.988, 0.86}}
export const tone_ink_muted: Fill = {dark: {0.941, 0.965, 0.988, 0.52}, light: {0.941, 0.965, 0.988, 0.52}}
export const tone_ink_faint: Fill = {dark: {0.941, 0.965, 0.988, 0.32}, light: {0.941, 0.965, 0.988, 0.32}}
export const tone_hover: Fill = {dark: {0.941, 0.965, 0.988, 0.045}, light: {0.941, 0.965, 0.988, 0.045}}
export const tone_wash: Fill = {dark: {0.941, 0.965, 0.988, 0.06}, light: {0.941, 0.965, 0.988, 0.06}}
export const tone_selection: Fill = {dark: {0.941, 0.965, 0.988, 0.07}, light: {0.941, 0.965, 0.988, 0.07}}
export const tone_selection_focus: Fill = {dark: {0.941, 0.965, 0.988, 0.1}, light: {0.941, 0.965, 0.988, 0.1}}
export const tone_press: Fill = {dark: {0.941, 0.965, 0.988, 0.13}, light: {0.941, 0.965, 0.988, 0.13}}
export const tone_scrim: Fill = {dark: {0, 0, 0, 0.36}, light: {0, 0, 0, 0.36}}
export const tone_clear: Fill = {dark: {0, 0, 0, 0}, light: {0, 0, 0, 0}}
export const tone_text_selection: Fill = {dark: {0.941, 0.965, 0.988, 0.22}, light: {0.941, 0.965, 0.988, 0.22}}
export const tone_copy_sheen: Fill = {dark: {1.0, 0.878, 0.741, 0.26}, light: {1.0, 0.878, 0.741, 0.26}}
// The ink a Sheen's band lifts words toward (ui.Shimmer; harness-native's tone_sheen): the warm white of the copy light.
export const tone_sheen: Fill = {dark: {1.0, 0.957, 0.902, 1}, light: {1.0, 0.957, 0.902, 1}}
export const tone_accent: Fill = {dark: {1.0, 0.561, 0.122, 1}, light: {1.0, 0.561, 0.122, 1}}
export const tone_accent_wash: Fill = {dark: {1.0, 0.561, 0.122, 0.24}, light: {1.0, 0.561, 0.122, 0.24}}
export const tone_on_accent: Fill = {dark: {1, 1, 1, 1}, light: {1, 1, 1, 1}}
export const tone_aside: Fill = {dark: {0.196, 0.161, 0.132, 1}, light: {0.196, 0.161, 0.132, 1}}
export const tone_aside_line: Fill = {dark: {1.0, 0.561, 0.122, 0.45}, light: {1.0, 0.561, 0.122, 0.45}}
export const tone_link: Fill = {dark: {0.345, 0.651, 1.0, 1}, light: {0.345, 0.651, 1.0, 1}}
export const tone_code_ink: Fill = {dark: {1.0, 0.451, 0.412, 1}, light: {1.0, 0.451, 0.412, 1}}
export const tone_success: Fill = {dark: {0.247, 0.725, 0.314, 1}, light: {0.247, 0.725, 0.314, 1}}
export const tone_warning: Fill = {dark: {0.824, 0.6, 0.133, 1}, light: {0.824, 0.6, 0.133, 1}}
export const tone_error: Fill = {dark: {0.973, 0.318, 0.286, 1}, light: {0.973, 0.318, 0.286, 1}}
export const tone_success_wash: Fill = {dark: {0.247, 0.725, 0.314, 0.15}, light: {0.247, 0.725, 0.314, 0.15}}
export const tone_warning_wash: Fill = {dark: {0.824, 0.6, 0.133, 0.15}, light: {0.824, 0.6, 0.133, 0.15}}
export const tone_error_wash: Fill = {dark: {0.973, 0.318, 0.286, 0.14}, light: {0.973, 0.318, 0.286, 0.14}}
export const tone_knob: Fill = {dark: {0.95, 0.95, 0.96, 1}, light: {0.95, 0.95, 0.96, 1}}
export const tone_scroller_knob: Fill = {dark: {0.941, 0.965, 0.988, 0.42}, light: {0.941, 0.965, 0.988, 0.42}}
export const tone_scroller_track: Fill = {dark: {0.941, 0.965, 0.988, 0.07}, light: {0.941, 0.965, 0.988, 0.07}}

prefab Strong {
  Fill: $tone_ink_strong
}
prefab Ink {
  Fill: $tone_ink
}
prefab Muted {
  Fill: $tone_ink_muted
}
prefab Faint {
  Fill: $tone_ink_faint
}
prefab Accent {
  Fill: $tone_accent
}
prefab Wash {
  Fill: $tone_wash
}
prefab Plate {
  Fill: $tone_card
  Edge: {dark: $tone_line.dark, light: $tone_line.light}
  Shape: {radius: $radius_card, n: 4, border: 1, feather: 0}
}

// ---- the video's own ----
// Type, in points of a 960 by 540 frame drawn at 2x (1920 by 1080). Big: most people watch it on a phone, a 1080p
// frame shrunk to a fifth of its width.
// The one line of words, in the code face, as the mark's own home (a terminal) sets it.
export const size_lead = 22
export const line_lead = 30

// The fire mark: 43 by 23 cells (harness-native-blaze), each this many points.
export const mark_cell = 12

// The fire's hottest colour but one (docs/brand/fire/gen.py's dark theme).
export const fire_3: Rgba = {1.0, 0.831, 0.231, 1}
export const menu_lift_dy = 6
export const spring_press_omega = 38
export const spring_press_zeta = 0.62
export const icon_press_dim = 0.7
export const line_menu = 16
export const menu_item_pad_r = 10
export const menu_lift_alpha = 0.28
export const menu_max_w = 380
export const menu_sep_pad = 5
export const menu_zeta = 1

// Inline components (harness-native-ui-prims/scene/inline.flecs) take the roles above; a GitHub pull
// request's or issue's state picks its icon's ink, as GitHub's Primer draws them (open green, draft and not planned grey,
// merged and completed purple, closed red), and its head commit's checks the mark after it (success green, failure red,
// pending amber).
export const tone_gh_open: Fill = {dark: {0.247, 0.725, 0.314, 1}, light: {0.102, 0.498, 0.216, 1}}
export const tone_gh_draft: Fill = {dark: {0.569, 0.596, 0.631, 1}, light: {0.349, 0.388, 0.431, 1}}
export const tone_gh_merged: Fill = {dark: {0.671, 0.490, 0.973, 1}, light: {0.510, 0.314, 0.875, 1}}
export const tone_gh_closed: Fill = {dark: {0.973, 0.318, 0.286, 1}, light: {0.812, 0.133, 0.180, 1}}
export const tone_gh_ci_success: Fill = $tone_gh_open
export const tone_gh_ci_failure: Fill = $tone_gh_closed
export const tone_gh_ci_pending: Fill = {dark: {0.824, 0.600, 0.133, 1}, light: {0.604, 0.404, 0.0, 1}}
