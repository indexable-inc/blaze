// blaze's launch video: 10 seconds, 1920 by 1080 at 60 fps with sound, for X/Twitter.
//
//   cd crates/harness && cargo run --release -p harness-video -- harness-video/scene/launch.flecs blaze-launch.mp4
//
// One idea, told by the mark itself (harness-native-blaze, the same mark and soundtrack as indexable-inc/anim):
//   0.35 to 1.5   the letters drop in from the top of the frame, one by one, each landing on a note climbing A B C# E G#
//   1.7           the fire catches from the b to the e, on A major
//   3.0 to 6.7    what it is, in two lines under it
//   7.0 to 10.0   the words go, the letters glow white hot, burn down the fire's colours and crumble into embers; what is
//                 left where they stood is the line that installs it
//
// Motion is data: a `Cue` child moves one member of its node (`Pose.fade`, `Pose.dy`...) between two values over a stretch
// of the clock. The `cue.*` templates below are the few moves this video makes, by name. The mark's own motion and its
// sound come from its `BlazeMark` times.

// ---- the moves ----
@tree ChildOf
cue {
  // Fade in over `dur` from `at`.
  template FadeIn {
    prop at: f32 = 0
    prop dur: f32 = 0.6
    Cue: {member: "Pose.fade", from: 1, to: 0, at: $at, dur: $dur, ease: Out}
  }
  // Fade out over `dur` from `at`.
  template FadeOut {
    prop at: f32 = 0
    prop dur: f32 = 0.45
    Cue: {member: "Pose.fade", from: 0, to: 1, at: $at, dur: $dur, ease: In}
  }
  // Rise `by` points into place over `dur` from `at` (pair it with a FadeIn).
  template Rise {
    prop at: f32 = 0
    prop dur: f32 = 0.9
    prop by: f32 = 10
    Cue: {member: "Pose.dy", from: $by, to: 0, at: $at, dur: $dur, ease: Out}
  }
}

// ---- the parts ----
@tree ChildOf
launch_part {
  // A layer: the whole frame, its parts in a centred column.
  prefab Layer : ui.Column {
    Flex: {axis: Column, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Percent, value: 1, min: 0, max: 0}, h: {kind: Percent, value: 1, min: 0, max: 0}}
  }
  prefab Hero : ui.Words, Strong {
    TextStyle: {size: $size_hero, line: $line_hero, code_line: 0, role: 0, bold: 0, weight: 500}
  }
  prefab Lead : ui.Words, Muted {
    TextStyle: {size: $size_lead, line: $line_lead, code_line: 0, role: 0, bold: 0, weight: 0}
  }
  prefab Code : ui.Words, Strong {
    TextStyle: {size: $size_code, line: $line_code, code_line: 0, role: 9, bold: 0, weight: 0}
  }
  // Fixed room of `h` points between parts.
  prefab Gap : ui.Node {
    Size: {w: {kind: Fixed, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: 0, min: 0, max: 0}}
  }
}

// ---- the video ----
// The mark's timeline: its letters start falling at `drop`, and it burns away from `burn`.
const drop = 0.35
const burn = 7.0

@tree ChildOf
launch : ui.ZStack {
  Video: {width: 960, height: 540, fps: 60, seconds: 10, scale: 2}
  Fill: $tone_ground
  Flex: {axis: Z, gap: 0, align: Center, justify: Center, wrap: false}
  Size: {w: {kind: Fixed, value: 960, min: 0, max: 0}, h: {kind: Fixed, value: 540, min: 0, max: 0}}

  // The mark and what it is. Layout never changes, so the mark stands still while the words come and go under it.
  intro : launch_part.Layer {
    mark : ui.Node {
      BlazeMark: {start: $drop, exit: $burn}
      Size: {w: {kind: Fixed, value: 43 * $mark_cell, min: 0, max: 0}, h: {kind: Fixed, value: 23 * $mark_cell, min: 0, max: 0}}
    }
    gap : launch_part.Gap { Size: {w: {kind: Fixed, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: 30, min: 0, max: 0}} }
    hero : launch_part.Hero {
      Text: {s: "Rebuild Rust in milliseconds."}
      cue.FadeIn show(at: 3.0, dur: 0.8)
      cue.Rise rise(at: 3.0)
      cue.FadeOut leave(at: 6.75)
    }
    gap2 : launch_part.Gap { Size: {w: {kind: Fixed, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: 10, min: 0, max: 0}} }
    lead : launch_part.Lead {
      Text: {s: "Type blaze wherever you'd type cargo."}
      cue.FadeIn show(at: 4.4, dur: 0.8)
      cue.Rise rise(at: 4.4)
      cue.FadeOut leave(at: 6.75)
    }
  }

  // What the fire leaves: the line that installs it, where the mark stood.
  outro : launch_part.Layer {
    cue.FadeIn show(at: 8.7, dur: 0.9)
    cue.Rise rise(at: 8.7, by: 8)
    install : launch_part.Code { Text: {s: "curl -fsSL https://ix.dev/blaze | sh"} }
  }
}
