// blaze's launch video: 10 seconds, 1920 by 1080 at 60 fps with sound, for X/Twitter. The words are the post's; the video
// is the mark alone, and starts and ends on the dark ground, so it loops.
//
//   cd crates/harness && cargo run --release -p harness-video -- harness-video/scene/launch.flecs blaze-launch.mp4
//
// The mark (harness-native-blaze, the same mark and soundtrack as indexable-inc/anim):
//   0.35 to 1.5   the letters drop in from the top of the frame, one by one, each landing on a note climbing A B C# E G#
//   1.7           the fire catches from the b to the e, on A major; the frame starts a slow push in
//   3.8 to 6.8    the letters glow white hot, burn down the fire's colours and crumble into embers
//   5.6           the theme comes home, E A then a low A (burn + 1.8 in the exit's sound): on that A, where the letters
//                 stood, where to find it (its https:// quiet), arriving hot and cooling; it holds under the exit's pad and fades out with it,
//                 to the dark ground the video started on
//
// Motion is data: a `Cue` child moves one member of its node (`Pose.fade`, `Pose.shrink`...) between two values over a
// stretch of the clock. The `cue.*` templates (harness-native-ui-prims/scene/cue.flecs) are the moves, by name. The mark's own motion
// and its sound come from its `BlazeMark` times.

// ---- the look ----
// The video stands on the app's tokens and prims (harness-video loads it into the app's scene); tokens.flecs beside it
// holds the few that are its own.
include tokens

// ---- the parts ----
@tree ChildOf
launch_part {
  // A layer: the whole frame, its parts in a centred column.
  prefab Layer : ui.Column {
    Flex: {axis: Column, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Percent, value: 1, min: 0, max: 0}, h: {kind: Percent, value: 1, min: 0, max: 0}}
  }
  prefab Lead : ui.Words {
    Fill: $tone_launch_ink
    TextStyle: {size: $size_lead, line: $line_lead, code_line: 0, role: 9, bold: 0, weight: 0}
  }
}

// ---- the video ----
// The mark's timeline: its letters start falling at `drop`, and it burns away from `burn`.
const drop = 0.35
const burn = 3.8
// How bright the hottest fire burns, in SDR whites: the HDR10 peak over its white (1000 / 203 nits).
const glow = 4.93
// The low A the exit's sound comes home on.
const home = $burn + 1.8

@tree ChildOf
launch : ui.ZStack {
  Video: {width: 960, height: 540, fps: 60, seconds: 10, scale: 8}
  Fill: $tone_launch_ground
  Flex: {axis: Z, gap: 0, align: Center, justify: Center, wrap: false}
  Size: {w: {kind: Fixed, value: 960, min: 0, max: 0}, h: {kind: Fixed, value: 540, min: 0, max: 0}}

  stage : launch_part.Layer {
    mark : ui.Node {
      BlazeMark: {start: $drop, exit: $burn, glow: $glow}
      Size: {w: {kind: Fixed, value: 43 * $mark_cell, min: 0, max: 0}, h: {kind: Fixed, value: 23 * $mark_cell, min: 0, max: 0}}
      cue.PushIn push(at: 1.6, dur: 3.6, by: 0.05)
    }
  }

  // Where to find it, where the mark stood: the scheme fades in quietly, then the address arrives a glyph at a time,
  // each hot and cooling.
  outro : launch_part.Layer {
    url : ui.Row {
      Flex: {axis: Row, gap: 0, align: Center, justify: Center, wrap: false}
      scheme : launch_part.Lead {
        Text: {s: "https://"}
        Fill: $tone_launch_ink_muted
        cue.FadeIn arrive(at: $home - 0.3, dur: 0.6)
      }
      name : launch_part.Lead {
        Text: {s: "ix.dev/blaze"}
        GlyphsIn: {at: $home, per: 0.045, dur: 0.5, by: 0, ease: Out, cool: 1.1, hot: $fire_3}
      }
      cue.FadeOut leave(at: 8.5, dur: 1.4)
    }
  }
}
