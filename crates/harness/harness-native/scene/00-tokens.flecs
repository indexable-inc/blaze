export const tone_stats_hot: Fill = {dark: {1.0, 0.45, 0.43, 1}, light: {1.0, 0.45, 0.43, 1}}

// The selection (harness-native-render's select.rs, den's plate_selection): one plate under the glyphs wherever text is
// selected (a chat's transcript and input, a table's copied row, the terminal), ink-1 at 22% (18% on the light page),
// corners of radius 4 on a superellipse of n 2; its rows join into one shape (a corner a touching row covers stays
// square). Ghostty's selection-background, where the theme sets one, retints it. Cmd+C pulses it (den's FlashLook): the
// shape grows by copy_grow and back on the copy spring (kicked to peak at 1, settling to rest so the frame goes idle), a
// light of copy_light sweeps across each row over copy_sweep seconds, the rows joining copy_stagger seconds apart, each
// taking copy_row_in to come in.
export const plate_selection: Fill = {dark: {1, 1, 1, 0.22}, light: {0, 0, 0, 0.18}}
export const plate_selection_radius = 4
export const plate_selection_n = 2
export const copy_omega = 18
export const copy_zeta = 1
export const copy_grow = 0.025
export const copy_light = 0.12
export const copy_sweep = 0.3
export const copy_stagger = 0.04
export const copy_row_in = 0.11
// Inline code's chip (MarkdownText).
export const tone_code_chip: Fill = {dark: {1, 1, 1, 0.08}, light: {0, 0, 0, 0.06}}
export const textarea_max_h = 132
// How far a text area's placeholder starts after its caret (which stands at the words' start), as a macOS field's does.
export const textarea_hint_inset = 4
// ui.Table: a row's height, the room between columns, a row's inset and its words' size; ui.Result: a snippet's two lines.
export const table_row = 24
export const table_gap = 14
export const table_pad = 6
export const size_table = 12.5
export const result_snippet_h = 36

// The chat pane (hn.ChatPane, scene/widgets/chat.flecs, src/app/chat.rs): a column of the transcript as wide as reads
// well, the user's words on a soft plate, code on a card, tool calls as quiet one-line rows, the input at the foot.
// chat_w is the reading column (the words, the bubble's trailing edge, the input): centred, chat_pad clear of the pane's
// edges either side when the pane is narrower.
export const chat_w = 672
export const chat_pad = 24
// How far the transcript thins out where it scrolls under the composer (and under the pane's top): soft, never a cut line.
export const chat_fade_len = 28
// Vertical rhythm, top to bottom: chat_gap_block between two blocks of a reply (half above a block, half below), the
