export const chat_pick_level_b = 4
export const chat_pick_swipe_step = 22
export const chat_pick_commit_secs = 0.35
export const chat_pick_word_secs = 1.2
// What the chat pane shows around the composer's words besides the transcript (the foot's insets, the card's insets,
