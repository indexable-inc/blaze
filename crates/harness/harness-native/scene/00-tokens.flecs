prefab Strong {
  Fill: $tone_ink_1
}
prefab Ink {
  Fill: $tone_ink_2
}
prefab Muted {
  Fill: $tone_ink_3
}
prefab Faint {
  Fill: $tone_ink_4
}
prefab Accent {
  Fill: $tone_accent
}
prefab Wash {
  Fill: $tone_wash
}
prefab Plate {
  Fill: $tone_plate
  Edge: {dark: $tone_plate_line.dark, light: $tone_plate_line.light}
  Shape: {radius: $radius_card, n: 4, border: 1, feather: 0}
}

