// harness-native's tokens: the names den's primitives (harness-native-ui-prims, prims.flecs) read, and the app's own.
// After den-native's 00-tokens.flecs (github.com/andrewgazelka/den), cut to what harness draws, in a native macOS look:
// the window and sidebar are clear over an NSVisualEffectView (material .sidebar), so the sidebar's inks are vibrant
// labels (white at an alpha in the dark appearance, black at an alpha in the light one, as AppKit's label colours are)
// rather than fixed greys; the main card is an opaque plate in the terminal's ground. Colours are sRGB 0..1, `{r, g, b,
// a}`, straight (not premultiplied); every Fill and Edge has a dark and a light.

// Type: macOS sidebar sizes in Inter. Rows 13, runs 12, section labels 11, a run's command in the code face 11.5.
export const size_caption = 11
export const size_body = 13
export const size_row = 13
export const size_run = 12
export const size_label = 11
export const size_code = 11.5
// Weights (CSS numbers): a session's name medium, a section label semibold.
export const weight_row = 500
export const weight_label = 600

// Rows: a session 24 tall, a run 20, the fold 20 (packed: the tree has no gap between rows); children indented 16 a level; icons 14 in a 16 box.
export const row_h = 24
export const run_h = 20
export const more_h = 20
export const indent_step = 16
export const icon_box = 16
export const chevron_box = 12
// A tree row's disclosure slot: the chevron's hit target, left of the row's icon. In the sidebar it hangs in the gutter
// left of the icon (never pushing the row's content right).
export const disclose_w = 18
// The sidebar's side margin: the tree pads itself by it (so a depth-0 chevron hangs in it, inside the tree's clip), and
// the section label and the Archive row sit in from it. label_inset is side_inset + row_pad: the section label's left
// edge, where depth-0 icons start.
export const side_inset = 10
export const label_inset = 18
// The seam between the sidebar and the main card: a soft shadow off the card's left edge.
export const seam_blur = 14
export const seam_alpha = 0
export const row_gap = 8
export const row_pad = 8

// A status dot, and a failure's badge (its exit code).
export const dot_size = 6
export const dot_radius = 3
export const badge_h = 15
export const badge_radius = 4
export const badge_pad = 5
export const size_badge = 10
export const line_badge = 12

// Springs (omega rad/s, zeta): a running dot's breath (slow, critically damped, dimming to breath_floor), a disclosure
// chevron's quarter turn, the selection pill sliding between rows, the sidebar folding (cmd+S) and the hover wash.
export const breath_omega = 3.2
export const breath_zeta = 1
export const breath_floor = 0.3
export const turn_omega = 30
export const turn_zeta = 0.78
export const pill_omega = 32
export const pill_zeta = 0.86
// From rest, a selection move of more than this many rows lands at once (mid-slide it always slides on).
export const pill_jump_rows = 3
export const sidebar_omega = 24
// The tree's scroll: the glide to the selected row, the margin it leaves inside an edge, the edge fade.
export const tree_glide_omega = 22
export const tree_fold_omega = 26
export const tree_fold_zeta = 1
export const tree_glide_zeta = 1
export const tree_reveal_margin = 8
export const tree_fade_len = 22
export const sidebar_zeta = 1
// Dragging the sidebar's edge (den's feel, src/resize.rs): its width stays between side_min and side_max; dragged left
// past half of side_min by side_latch more it latches closed (folding away on the sidebar spring), and dragged back
// out past half of side_min by side_latch it latches open again, so it never flickers at the boundary. Past side_max
// it stretches at most side_give, half of it side_soft points past, and the whole window rubber-bands right by that
// much, springing back on the window_back spring when let go. Touching side_max pulses once, again only after a
// side_rearm retreat. A press within side_grab of the edge grabs it; folded, a press within side_reach of the window's
// left edge does (wider, clear of AppKit's own window-resize band). side_keep is the least the main card keeps beside
// it, lowering side_max in a narrow window.
export const side_min = 180
export const side_max = 300
export const side_latch = 8
export const side_give = 24
export const side_soft = 48
export const side_rearm = 8
export const side_grab = 5
export const side_reach = 10
export const side_keep = 320
export const window_back_omega = 24
export const window_back_zeta = 1
// Overlay scrollers (prims.flecs ui.Scroller, on every ui.Scroll; macOS's overlay NSScroller): the knob scroller_thin
// across at rest and scroller_wide over its track while the pointer is within scroller_grab of the edge, scroller_inset
// off the edge, never shorter than scroller_min (but shortened under a rubber band). It shows as the content scrolls,
// stays scroller_hold seconds after it stops, then fades; it comes in on the show spring, goes on the hide spring, widens
// on the wide spring. A press on the track pages toward it on the page spring, keeping scroller_keep points in view.
export const scroller_thin = 6
export const scroller_wide = 10
export const scroller_inset = 2
export const scroller_min = 24
export const scroller_grab = 16
export const scroller_hold = 0.7
export const scroller_keep = 24
export const scroller_show_omega = 40
export const scroller_show_zeta = 1
export const scroller_hide_omega = 13
export const scroller_hide_zeta = 1
export const scroller_wide_omega = 32
export const scroller_wide_zeta = 1
export const scroller_page_omega = 20
export const scroller_page_zeta = 1
// The traffic lights fading in while the pointer rests in their corner (sidebar folded, Dia's).
export const lights_omega = 26
export const lights_zeta = 1
// The archive row: on hover its box rises archive_lift and grows to archive_scale; an archive bounces it (kicked up
// archive_kick_lift, archive_kick_scale bigger, ringing at archive_omega / archive_zeta) and pulses its count.
export const archive_lift = 1.5
export const archive_scale = 1.08
export const archive_kick_lift = 3
export const archive_kick_scale = 0.12
export const archive_omega = 22
export const archive_zeta = 0.3
export const count_kick_scale = 0.35
export const count_omega = 26
export const count_zeta = 0.35
// The generic motion springs (prims.flecs's ui.spring tokens): a node's insert and removal Transition, a MatchedGeometry
// slide (the selection pill between rows), and an Animate node's Size, Padding and Fill easing.
export const spring_transition_omega = 20
export const spring_transition_zeta = 0.9
export const spring_matched_omega = 26
export const spring_matched_zeta = 0.84
export const spring_layout_omega = 18
export const spring_layout_zeta = 1

// The Archive pane: its title, search line, filter chips, day headings and the right-hand columns (duration, time).
export const size_title = 15
export const field_h = 30
export const chip_h = 24
export const chip_radius = 12
export const section_h = 30
export const arch_took_w = 56
export const arch_time_w = 84
// A finished run with no session leaves the live tree this long after it ended (seconds).
export const archive_after_s = 600
// How long after it ended a top-level session from before the daemon started (a chat restored after a restart) stays in
// the tree before the Archive files it (seconds; a week).
export const archive_past_after_s = 604800

// Overlays over the window: the command palette (cmd+K) and the new-object picker (cmd+N), each a card on a scrim
// (hn.Scrim, hn.OverlayCard in scene/widgets/palette.flecs). They come in on a spring (the scrim fades in, the card
// grows from overlay_scale) and go out the same way, never in a step.
export const overlay_omega = 30
export const overlay_zeta = 0.92
export const overlay_scale = 0.96
export const overlay_radius = 12
export const overlay_pad = 6
export const overlay_lift_blur = 24
export const overlay_lift_alpha = 0.5
export const overlay_lift_dy = 8
// The palette: a wide card near the window's top, its query line, its entries.
export const palette_w = 560
export const palette_top = 96
export const palette_query_h = 38
export const palette_row_h = 32
// The picker: a narrow card a little above the window's middle (picker_rise lifts it), a quiet label over one row a
// kind (its mark in a picker_mark box, its name, its shortcut, the key that picks it in a keycap).
export const picker_w = 300
export const picker_rise = 80
export const picker_head_h = 24
export const picker_row_h = 34
export const picker_mark = 18
export const keycap_min = 18
export const keycap_h = 18
export const keycap_pad = 5
export const keycap_radius = 4
export const size_keycap = 11
export const line_keycap = 13

export const radius_control = 6
export const radius_card = 12
// ui.Bubble: its corners and the most it widens to before its words wrap (about 65 characters of body text).
export const radius_bubble = 12
export const bubble_max_w = 480

// Vibrant labels: primary, secondary, tertiary, quaternary.
export const tone_ink_1: Fill = {dark: {1, 1, 1, 0.88}, light: {0, 0, 0, 0.85}}
export const tone_ink_2: Fill = {dark: {1, 1, 1, 0.74}, light: {0, 0, 0, 0.72}}
export const tone_ink_3: Fill = {dark: {1, 1, 1, 0.52}, light: {0, 0, 0, 0.50}}
export const tone_ink_4: Fill = {dark: {1, 1, 1, 0.32}, light: {0, 0, 0, 0.30}}
export const tone_accent: Fill = {dark: {0.580, 0.600, 1.0, 1}, light: {0.369, 0.384, 0.902, 1}}

export const tone_wash: Fill = {dark: {1, 1, 1, 0.06}, light: {0, 0, 0, 0.05}}
export const tone_wash_hover: Fill = {dark: {1, 1, 1, 0.045}, light: {0, 0, 0, 0.04}}
export const tone_wash_press: Fill = {dark: {1, 1, 1, 0.10}, light: {0, 0, 0, 0.08}}
// An icon button (ui.IconButton) has no plate: its glyph rests in tone_icon_rest and eases to tone_icon_hover under the
// pointer (tone_icon_on while what it opens is open); held, it scales to icon_press_scale and dims to icon_press_dim, and
// springs back on the press spring (a little under-damped, so the release has a touch of give).
export const tone_icon_rest: Fill = $tone_ink_3
export const tone_icon_hover: Fill = $tone_ink_1
export const tone_icon_on: Fill = $tone_accent
export const icon_press_scale = 0.92
export const icon_press_dim = 0.7
export const spring_press_omega = 38
export const spring_press_zeta = 0.62
// An overlay scroller's knob and the faint track it widens over (ui.Scroller): AppKit's, white over a dark ground and
// black over a light one (a scroll on the terminal's ground follows its Scheme).
export const tone_scroller_knob: Fill = {dark: {1, 1, 1, 0.22}, light: {0, 0, 0, 0.20}}
export const tone_scroller_track: Fill = {dark: {1, 1, 1, 0.04}, light: {0, 0, 0, 0.03}}
// The selected row: a soft accent-tinted pill over the vibrancy.
export const tone_select: Fill = {dark: {1, 1, 1, 0.09}, light: {0, 0, 0, 0.075}}
// The sidebar's tint plate over the window vibrancy: the terminal ground (dark) or the light ground, part see-through.
export mut tone_side_tint: Fill = {dark: {0.071, 0.071, 0.078, 1}, light: {0.965, 0.965, 0.970, 1}}
// The one hairline between the sidebar and the main card.
export const tone_seam: Fill = {dark: {1, 1, 1, 0.035}, light: {0, 0, 0, 0.04}}
// Nothing: a node that paints no fill.
export const tone_clear: Fill = {dark: {0, 0, 0, 0}, light: {0, 0, 0, 0}}
// The palette's scrim over the window and its card.
export const tone_scrim: Fill = {dark: {0, 0, 0, 0.32}, light: {0, 0, 0, 0.12}}
export mut tone_card: Fill = {dark: {0.098, 0.098, 0.106, 1}, light: {1, 1, 1, 1}}
// Offscreen shots only (src/shot.rs): a flat stand-in for the sidebar's vibrancy, which a texture cannot sample.
export const tone_shot_ground: Fill = {dark: {0.165, 0.165, 0.180, 1}, light: {0.906, 0.906, 0.918, 1}}
export mut tone_plate: Fill = {dark: {0.071, 0.071, 0.078, 1}, light: {1, 1, 1, 1}}
export const tone_plate_line: Fill = {dark: {1, 1, 1, 0.08}, light: {0, 0, 0, 0.09}}
export const tone_switch_on: Fill = {dark: {0.580, 0.600, 1.0, 1}, light: {0.369, 0.384, 0.902, 1}}
// With a Ghostty theme (src/app/ghostty.rs, read live from the user's Ghostty config) the tokens on the terminal's
// ground are set at runtime from each appearance's theme background and foreground: tone_term_ground (hn.Main),
// tone_term_ink and tone_term_muted (the words on it: the title bar's, the chat's), tone_plate (Plate), tone_card (the
// palette's and the picker's cards) and tone_side_tint (hn.SideClip); every Fill copied from one follows it. The values here are the built-in theme's, kept for an appearance the config does not theme.
// The terminal's ground (the built-in theme's bg, #121214): the main card and the title bar over it, in both appearances.
export mut tone_term_ground: Fill = {dark: {0.071, 0.071, 0.078, 1}, light: {0.071, 0.071, 0.078, 1}}
// Ink over the terminal's ground (the built-in theme's is dark): the title bar's and the chat's words.
export mut tone_term_ink: Fill = {dark: {1, 1, 1, 0.86}, light: {1, 1, 1, 0.86}}
export mut tone_term_muted: Fill = {dark: {1, 1, 1, 0.45}, light: {1, 1, 1, 0.45}}

export const tone_running: Fill = {dark: {0.298, 0.718, 0.510, 1}, light: {0.18, 0.60, 0.38, 1}}
export const tone_exited: Fill = {dark: {1, 1, 1, 0.32}, light: {0, 0, 0, 0.30}}
