// The selection (harness-native-render's select.rs, den's plate_selection): one plate under the glyphs wherever text is
// selected (a chat's transcript and input, a table's copied row, the terminal), den's ink-1 at 22% (18% on the light
// page), corners of radius 4 on a superellipse of n 2; its rows join into one shape (a corner a touching row covers stays
// square). Ghostty's selection-background, where the theme sets one, retints it.
export const plate_selection: Fill = {dark: {0.922, 0.918, 0.902, 0.22}, light: {0.086, 0.086, 0.090, 0.18}}
export const plate_selection_radius = 4
export const plate_selection_n = 2
// Cmd+C pulses it: den's FlashLook (after the site's selshape.ts and the os text field), a timeline of copy_secs rather
// than a spring. The selection's shape and its glyphs grow by copy_grow about the selection's middle on a fast ease-out
// (peaking copy_rise of the way in) and fall back as a cubic; a light of the plate's colour at copy_light (at its
// brightest halfway) crosses each row left to right over the whole pulse, the rows joining copy_stagger seconds apart,
// each taking copy_row_in to come in. At its end the pulse is exactly at rest and the frame goes idle.
export const copy_secs = 0.3
export const copy_rise = 0.18
export const copy_grow = 0.025
export const copy_light = 0.12
export const copy_stagger = 0.04
export const copy_row_in = 0.11
// Inline code's chip (MarkdownText).
export const tone_code_chip: Fill = {dark: {1, 1, 1, 0.08}, light: {0, 0, 0, 0.06}}
export const textarea_max_h = 132
// A growing text area (ui.field.GrowingTextArea): it grows with its words to textarea_grow_share of its pane's height
// (less what the pane shows around it), then scrolls; a caret out of view glides back textarea_caret_margin points inside
// the edges on the textarea_glide spring.
export const textarea_grow_share = 0.85
export const textarea_caret_margin = 6
export const textarea_glide_omega = 22
export const textarea_glide_zeta = 1
// How far a text area's placeholder starts after its caret (which stands at the words' start), as a macOS field's does.
export const textarea_hint_inset = 4
// ui.Table: a row's height, the room between columns, a row's inset and its words' size; ui.Result: a snippet's two lines.
export const table_row = 24
export const table_gap = 14
export const table_pad = 6
export const size_table = 12.5
export const result_snippet_h = 36

