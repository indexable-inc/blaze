// harness-native's tokens: the names den's primitives (harness-native-ui-prims, prims.flecs) read, and the app's own.
// After den-native's 00-tokens.flecs (github.com/andrewgazelka/den), cut to what harness draws. Colours are sRGB 0..1,
// `{r, g, b, a}`, straight (not premultiplied); every Fill and Edge has a dark and a light.

// ---- The rules this look keeps (a terminal's: all function, nothing going on) ----
// 1. Ink only. Four inks on one ground say everything; a kind's mark, a slider, a highlight and a selection are ink
//    or a step of grey, never a hue. The accent is for a link and a focus ring; red is for a real failure.
// 2. Nothing moves on its own, and nothing eases. A hover, a highlight, a menu and a sheet are there at once and gone at
//    once, so no two states ever show together. Work is said in words and a ticking time; the one motion left is the
//    small status glyph's breath in a chat while something runs (it also keeps that time ticking).
// The one exception to 1 and 2, asked for by name: the block on a running step's line (ui.Block): pixel art in its
//    own colours, a game's item icon, that turns to a new face when the step changes and is still between turns.
// 3. A plate only where something floats or is typed into: one hairline, no shadow, no glass, corners of 8. The one
//    translucent surface, asked for by name: the sidebar (tone_sidebar), a tint over the system's blur of what is behind
//    the window. Everything else is opaque.
// 4. Type is the hierarchy: size, weight and ink before any box, rule or icon.
//
// ---- The theme: the one place a colour is chosen ----
// Every surface names one of these roles, never a colour: a widget's `Fill: $tone_card`, Rust's `look::tone(w, "card")`
// (hn.Theme, scene/widgets/theme.flecs, holds one child per role). Dark is near-black with a cool undertone: a ground of
// #0A0B0D, plates a step or two above it, hairlines barely over the ground, one blue (#4D8EFF) for a link and a focus
// ring, colour only where it means something; code keeps JetBrains' Islands Dark scheme (code_ink below); light is the blaze site's paper
// (site/styles/tokens.css) with the same blue. Another look is another set of these values; nothing else changes. The
// scene test `no_raw_colours` (src/app.rs) fails on a colour literal anywhere but here and the palettes below.
//
// Grounds, darkest to most lifted:
// - ground: the window and the main card under every pane (#0A0B0D / #f2f1ee).
// - sidebar: the sidebar. The main card's ground as a tint (its alpha is the one place the sidebar's translucency is
//   chosen) over the window's vibrancy, the system's blur of what is behind the window (src/window.rs: the
//   NSVisualEffectView under the Metal view), as Finder's and Maps' sidebars are; one `line` hairline (hn.Seam) divides
//   it from the main card. Keep its colour the ground's: with nothing behind the window (an offscreen shot, iOS) the
//   host draws it at alpha 1 (src/app.rs opaque_sidebar), which is then the ground itself.
// - card: a plate that sits on the ground: the composer, the palette's and the picker's cards, a generated Card (#111216).
// - raised: what floats over everything, solid (never glass): menus, popovers, hover cards, a user's bubble (dark #16181C; light --bg-3, so a
//   popover lifts toward the light on the paper ground).
// - well: what is sunk into a surface: a field, a code block, a rename field (#070809).
// - term_ground: the terminal's own ground, under a terminal pane's grid only; the one role the user's Ghostty theme sets
//   (src/app/ghostty.rs), since a terminal's colours are chosen against it. The built-in theme's is the dark ground in both.
export mut tone_ground: Fill = {dark: {0.039, 0.043, 0.051, 1}, light: {0.949, 0.945, 0.933, 1}}
export mut tone_sidebar: Fill = {dark: {0.039, 0.043, 0.051, 0.72}, light: {0.949, 0.945, 0.933, 0.66}}
export mut tone_card: Fill = {dark: {0.067, 0.071, 0.086, 1}, light: {0.965, 0.961, 0.949, 1}}
export mut tone_raised: Fill = {dark: {0.086, 0.094, 0.11, 1}, light: {0.965, 0.961, 0.949, 1}}
export mut tone_well: Fill = {dark: {0.027, 0.031, 0.035, 1}, light: {0.922, 0.918, 0.898, 1}}
export mut tone_term_ground: Fill = {dark: {0.039, 0.043, 0.051, 1}, light: {0.039, 0.043, 0.051, 1}}
// Lines: a hairline (a card's edge, a rule, the sidebar's seam; --line) and the stronger one (a floating plate's edge, a
// control's track or outline; --line-2).
export mut tone_line: Fill = {dark: {0.102, 0.11, 0.129, 1}, light: {0.863, 0.859, 0.835, 1}}
export mut tone_line_strong: Fill = {dark: {0.149, 0.161, 0.188, 1}, light: {0.804, 0.800, 0.776, 1}}
// Inks: strong (titles, headings, a selected row, bold), the body, muted (secondary words, icons at rest), faint (meta,
// markers, a placeholder, what has ended); --ink-1..4.
export mut tone_ink_strong: Fill = {dark: {0.929, 0.937, 0.949, 1}, light: {0.086, 0.086, 0.090, 1}}
export mut tone_ink: Fill = {dark: {0.761, 0.773, 0.8, 1}, light: {0.275, 0.275, 0.290, 1}}
export mut tone_ink_muted: Fill = {dark: {0.545, 0.565, 0.6, 1}, light: {0.420, 0.416, 0.431, 1}}
export mut tone_ink_faint: Fill = {dark: {0.353, 0.373, 0.412, 1}, light: {0.635, 0.631, 0.616, 1}}
// Washes: the strong ink at an alpha, so they read on any ground. Hover (a row's, a button's), wash (a resting plate,
// inline code's: --s-tint), selection (the selected row's pill), selection_focus (a step brighter, never a colour, while its list has
// the keyboard; a menu's highlighted item), press (held). A scrim dims what is under a sheet.
export mut tone_hover: Fill = {dark: {1, 1, 1, 0.04}, light: {0.086, 0.086, 0.090, 0.04}}
export mut tone_wash: Fill = {dark: {1, 1, 1, 0.06}, light: {0.086, 0.086, 0.090, 0.06}}
export mut tone_selection: Fill = {dark: {0.102, 0.114, 0.137, 1}, light: {0.086, 0.086, 0.090, 0.06}}
export mut tone_selection_focus: Fill = {dark: {0.137, 0.149, 0.176, 1}, light: {0.086, 0.086, 0.090, 0.085}}
export mut tone_press: Fill = {dark: {1, 1, 1, 0.1}, light: {0.086, 0.086, 0.090, 0.11}}
export mut tone_scrim: Fill = {dark: {0, 0, 0, 0.36}, light: {0, 0, 0, 0.14}}
export mut tone_clear: Fill = {dark: {0, 0, 0, 0}, light: {0, 0, 0, 0}}
// Selected text's plate (ui.selection; every surface's, the terminal's too): IntelliJ's text selection blue (the strong
// ink at 18% on the paper).
export mut tone_text_selection: Fill = {dark: {0.122, 0.227, 0.42, 0.9}, light: {0.086, 0.086, 0.090, 0.18}}
// The light a copy sweeps over what it took (ui.selection's CopyLook): the accent lifted toward white on the dark page,
// where it adds to the plate, and the accent itself on the paper, where it tints; its alpha is the light at its brightest.
export mut tone_copy_sheen: Fill = {dark: {0.72, 0.82, 1.0, 0.24}, light: {0.22, 0.443, 0.882, 0.16}}
// The ink a Sheen's band lifts words toward (a working row's title, ui.Shimmer): on the dark page past the strong ink, to a
// near-white with a breath of the accent's cool in it, so the band still reads as light over a selected row's strong title;
// on the paper a deep accent ink, since brightening dark words toward the paper would only fade them.
export mut tone_sheen: Fill = {dark: {0.9, 0.95, 1.0, 1}, light: {0.11, 0.30, 0.74, 1}}
// The accent: only what is on or pressable-and-chosen (a switch, a focused control, a load bar); its faint wash (a search
// match, a highlighted cell); the ink on a solid accent or a coloured badge. A link's ink; inline code's (--doc-code-ink).
export mut tone_accent: Fill = {dark: {0.302, 0.557, 1, 1}, light: {0.22, 0.443, 0.882, 1}}
// The level slider's fill and its ends' words (level_*, below), from the theme's inks.
export mut tone_level_fill: Fill = $tone_ink
export mut tone_level_scale: Fill = $tone_ink_faint
export mut tone_accent_wash: Fill = {dark: {0.302, 0.557, 1, 0.16}, light: {0.22, 0.443, 0.882, 0.16}}
export mut tone_on_accent: Fill = {dark: {1, 1, 1, 1}, light: {1, 1, 1, 1}}
// An aside (a chat draft that starts with a space: a question asked of a fork of the conversation, outside it): the
// composer's card while the draft is one, and the answer's card over it, a plate of the card's ground with a little of
// the accent in it, edged in the accent at a low alpha, so the mode reads at a glance and stays quiet. Opaque, so the
// composer's lift does not show through it.
export mut tone_aside: Fill = {dark: {0.063, 0.094, 0.161, 1}, light: {0.904, 0.921, 0.948, 1}}
export mut tone_aside_line: Fill = {dark: {0.302, 0.557, 1, 0.4}, light: {0.22, 0.443, 0.882, 0.35}}
export mut tone_link: Fill = {dark: {0.478, 0.655, 1, 1}, light: {0.149, 0.459, 0.749, 1}}
export mut tone_code_ink: Fill = {dark: {0.808, 0.816, 0.839, 1}, light: {0.031, 0.031, 0.031, 1}}
// States, colour that carries meaning only: success (running, passed; --ok), warning (lost, pending), error (failed,
// killed; --danger), each with a faint wash for a plate behind words in it.
export mut tone_success: Fill = {dark: {0.427, 0.69, 0.514, 1}, light: {0.125, 0.541, 0.235, 1}}
export mut tone_warning: Fill = {dark: {0.835, 0.588, 0.216, 1}, light: {0.761, 0.49, 0.016, 1}}
export mut tone_error: Fill = {dark: {0.961, 0.494, 0.518, 1}, light: {0.788, 0.31, 0.31, 1}}
export mut tone_success_wash: Fill = {dark: {0.427, 0.69, 0.514, 0.12}, light: {0.125, 0.541, 0.235, 0.1}}
export mut tone_warning_wash: Fill = {dark: {0.835, 0.588, 0.216, 0.12}, light: {0.761, 0.49, 0.016, 0.11}}
export mut tone_error_wash: Fill = {dark: {0.961, 0.494, 0.518, 0.12}, light: {0.788, 0.31, 0.31, 0.1}}
// Controls' parts: a switch's or slider's knob (a light disc in both appearances), an overlay scroller's knob and the
// faint track it widens over (ui.Scroller; AppKit's).
export mut tone_knob: Fill = {dark: {0.95, 0.95, 0.96, 1}, light: {1, 1, 1, 1}}
export mut tone_scroller_knob: Fill = {dark: {1, 1, 1, 0.18}, light: {0.086, 0.086, 0.090, 0.20}}
export mut tone_scroller_track: Fill = {dark: {1, 1, 1, 0.03}, light: {0.086, 0.086, 0.090, 0.03}}

// ---- Palettes: colours that name a thing, not a surface ----
// A kind's icon, a brand mark, a file type, a chart series, a GitHub state, code by capture, the colour well's hues and
// F3's overlay. Each is data (which thing this is), so it is not a role; it still lives only in this file.

// Type: macOS sidebar sizes in Inter. Rows 13, runs 12, section labels 11, a run's command in the code face 11.5.
export const size_caption = 11
export const size_body = 13
// Chrome: the words on controls that sit around content rather than being it (the composer's model picker, a bar's
// readouts), clearly a step under the body (size_chat, size_body) so what was typed or said leads; line_chrome is
// their line, which the bar centres them on.
export const size_chrome = 11.5
export const line_chrome = 14
export const size_row = 13
export const size_run = 12
export const size_label = 11
export const size_code = 11.5
// Weights (CSS numbers): a row's name medium (the Archive's, the palette's, the picker's), a section label semibold; a
// sidebar tree row's title a touch over regular (Notion's sidebar reads that weight on its dark ground), medium while
// selected.
export const weight_row = 500
export const weight_tree = 450
export const weight_tree_on = 540
export const weight_label = 600

// The Archive's rows (hn.Arch*): 24 tall, children indented indent_step a level (the tree's step too), icons 14 in a 16
// box, its disclosure slot disclose_w wide with a chevron_box chevron. The sidebar's tree has its own (tree_* below).
export const row_h = 24
export const indent_step = 12
export const icon_box = 16
export const chevron_box = 12
export const disclose_w = 18
// The sidebar's tree, Notion's sidebar: calm one-line rows, a title and a few muted words trailing it, no dots and no
// marks. A session row tree_row_h tall, a run tree_run_h, packed (the air between rows is the pill's inset). Each row
// starts its chevron gutter (tree_gutter wide) tree_pad in from its left edge plus indent_step a level, so a child's
// chevron sits under its parent's mark or title (gutter and step are equal) and the title column never moves; then its title,
// tree_gap, its trailing words; tree_pad_r on the right. The chevron is a thin vector mark tree_chevron across (its ink
// about 7.5 tall), shown in tone_ink_faint where the row has rows under it (folded, it holds what finished). tree_icon is
// the Archive button's glyph box. Folded with work under it, a session's row shows a faint dot (tree_under_dot)
// tree_under_gap before how many.
export const tree_row_h = 28
export const tree_run_h = 22
export const tree_gutter = 12
export const tree_icon = 16
export const tree_under_dot = 8
export const tree_under_gap = 3
export const tree_chevron = 9
// A row's kind at a glance (an agent's mark, a terminal glyph): tree_kind across, tree_kind_gap before its title. A
// row's trailing words are at most tree_trail_max wide, so the title keeps the row.
export const tree_kind = 12
export const tree_kind_gap = 6
export const tree_trail_max = 84
// The tree's indent guides (hn.Hang's slots): a hairline down the middle of each ancestor's chevron gutter, in
// tone_guide (Islands' tree-indent-guide-border), for as many levels as tree_guides; a done mark in a childless row's
// gutter (tree_mark across: a check in tone_success, a cross in tone_error).
export const tree_guide_w = 1
export const tree_guides = 6
export const tree_mark = 11
export mut tone_guide: Fill = {dark: {0.122, 0.133, 0.153, 1}, light: {0.086, 0.086, 0.090, 0.10}}
export const tree_pad = 2
export const tree_pad_r = 8
export const tree_gap = 6
export const line_row = 16
// The selection pill and the hover wash hug the row pill_inset in from its frame (4 points of air between neighbours),
// corners radius_row.
export const pill_inset = 2
export const radius_row = 6
// The work bar (frame.flecs hn.WorkBar): work_bar_h tall, its band work_bar_share of the window long, crossing in
// work_bar_period seconds.
export const work_bar_h = 2
export const work_bar_share = 0.28
export const work_bar_period = 1.6
// ui.Block (prims.flecs): a pixel-art block block_size across (16 texels: 1.5 points each), turning to a new face over
// block_turn seconds.
export const block_size = 24
export const block_turn = 0.32
// ui.Shimmer's default Sheen (prims.flecs; harness-video's captions use the primitive, the app's own views do not: rule
// 2): a pass of sheen_think_period seconds, then sheen_think_rest at rest; the band sheen_think_band points either side
// of its middle, lifting the letters sheen_think_strength of the way to tone_sheen; sheen_think_ease of an ease-in-out;
// steady at sheen_still of it under Reduce Motion.
export const sheen_think_period = 2.6
export const sheen_think_rest = 1.1
export const sheen_think_band = 36
export const sheen_think_strength = 0.7
export const sheen_think_ease = 0.6
export const sheen_still = 0.35
// The group header (the device's name) over the tree, group_h tall, its words label_inset in from the sidebar's edge:
// in line with the depth-0 chevrons.
export const group_h = 28

// The sidebar's side margin: the tree pads itself by it, and the Archive row sits in from it. label_inset is the group
// header's left edge: side_inset + tree_pad + the chevron's inset in its gutter, in line with the depth-0 chevrons.
export const side_inset = 8
export const label_inset = 16
export const row_gap = 8
export const row_pad = 8

// A status dot, and a failure's badge (its exit code).
export const dot_size = 6
export const dot_radius = 3
export const badge_h = 15
export const badge_radius = 4
export const badge_pad = 5
export const size_badge = 10
export const line_badge = 12

// Springs (omega rad/s, zeta): a breath (slow, critically damped; a chat status dims to breath_floor), the sidebar
// folding (cmd+S).
export const breath_omega = 3.2
export const breath_zeta = 1
export const breath_floor = 0.3
export const sidebar_omega = 60
export const sidebar_zeta = 1
// The sidebar tree's one spring family: what moves in it together lands together, critically damped (no overshoot,
// no ring) on tree_omega, fast enough to read as near instant (settled in under a tenth of a second) while still
// showing where a row went. A row folding in or away (a new chat's row growing in, a finished run folding off), the
// selection pill sliding between rows (its position; its size is always its row's), the scroll gliding to the
// selection and a disclosure chevron's quarter turn all ride it; Reduce Motion lands each at once.
export const tree_omega = 64
export const tree_zeta = 1
export const turn_omega = $tree_omega
export const turn_zeta = $tree_zeta
export const pill_omega = $tree_omega
export const pill_zeta = $tree_zeta
export const tree_fold_omega = $tree_omega
export const tree_fold_zeta = $tree_zeta
export const tree_glide_omega = $tree_omega
export const tree_glide_zeta = $tree_zeta
// A folding row's words: they show only once the row has tree_fold_lead of its height, easing in over the rest as
// they settle tree_fold_rise points down into place (and go the same way back, before the row closes).
export const tree_fold_lead = 0.45
export const tree_fold_rise = 4
// From rest, a selection move of more than this many rows lands at once (mid-slide it always slides on): far enough
// that a new chat's row at the foot of a screenful glides, a cmd+9 across a long tree lands.
export const pill_jump_rows = 8
// The tree's scroll: the margin the glide to the selected row leaves inside an edge, the edge fade.
export const tree_reveal_margin = 8
export const tree_fade_len = 22
// Dragging the sidebar's edge (den's feel, src/resize.rs): its width stays between side_min and side_max; dragged left
// past half of side_min by side_latch more it latches closed (folding away on the sidebar spring), and dragged back
// out past half of side_min by side_latch it latches open again, so it never flickers at the boundary. Past side_max
// it stretches at most side_give, half of it side_soft points past, and the whole window rubber-bands right by that
// much, springing back on the window_back spring when let go. Touching side_max pulses once, again only after a
// side_rearm retreat. A press within side_grab of the edge grabs it; folded, a press within side_reach of the window's
// left edge does (wider, clear of AppKit's own window-resize band). side_keep is the least the main card keeps beside
// it, lowering side_max in a narrow window.
export const side_min = 180
export const side_max = 300
export const side_latch = 8
export const side_give = 24
export const side_soft = 48
export const side_rearm = 8
export const side_grab = 5
export const side_reach = 10
export const side_keep = 320
export const window_back_omega = 44
export const window_back_zeta = 1
// Overlay scrollers (prims.flecs ui.Scroller, on every ui.Scroll; macOS's overlay NSScroller): the knob scroller_thin
// across at rest and scroller_wide over its track while the pointer is within scroller_grab of the edge, scroller_inset
// off the edge, never shorter than scroller_min (but shortened under a rubber band). It shows as the content scrolls,
// stays scroller_hold seconds after it stops, then fades; it comes in on the show spring, goes on the hide spring, widens
// on the wide spring. A press on the track pages toward it on the page spring, keeping scroller_keep points in view.
export const scroller_thin = 6
export const scroller_wide = 10
export const scroller_inset = 2
export const scroller_min = 24
export const scroller_grab = 16
export const scroller_hold = 0.7
export const scroller_keep = 24
export const scroller_show_omega = 40
export const scroller_show_zeta = 1
export const scroller_hide_omega = 13
export const scroller_hide_zeta = 1
export const scroller_wide_omega = 32
export const scroller_wide_zeta = 1
export const scroller_page_omega = 44
export const scroller_page_zeta = 1
// The traffic lights fading in while the pointer rests in their corner (sidebar folded, Dia's).
export const lights_omega = 48
export const lights_zeta = 1
// The generic motion springs (prims.flecs's ui.spring tokens): a node's insert and removal Transition, a MatchedGeometry
// slide (the selection pill between rows), and an Animate node's Size, Padding and Fill easing.
export const spring_transition_omega = 56
export const spring_transition_zeta = 1
export const spring_matched_omega = 64
export const spring_matched_zeta = 1
export const spring_layout_omega = 56
export const spring_layout_zeta = 1
// A Posed node's glide to its pose (prims.flecs ui.spring.pose, motion's Posing): den's `smooth` GenSpring.
export const spring_pose_omega = 56
export const spring_pose_zeta = 1

// The Archive pane: its title, search line, filter chips, day headings and the right-hand columns (duration, time).
export const size_title = 15
export const field_h = 30
export const chip_h = 24
export const chip_radius = 12
export const section_h = 30
export const arch_took_w = 56
export const arch_time_w = 84
// A finished child (a run, a stage, a sub-agent) stays among a folded node's rows this long after it ended, its done
// mark in its gutter, then folds away (seconds).
export const tree_linger_s = 5
// A finished run with no session leaves the live tree this long after it ended (seconds).
export const archive_after_s = 600
// How long after it ended a top-level session (a chat that exited, was stopped or lost its daemon) stays in the tree
// before the Archive files it on its own (seconds; an hour). A message to it in the Archive brings it back.
export const archive_done_after_s = 3600

// Overlays over the window: the command palette (cmd+K) and the new-object picker (cmd+N), each a card on a scrim
// (hn.Scrim, hn.OverlayCard in scene/widgets/palette.flecs), there at once and gone at once.
export const overlay_radius = 8
export const overlay_pad = 6

// Menus (prims.flecs ui.Menu and its parts), macOS NSMenu's: a plate menu_radius round that hugs its widest item (at
// least menu_min_w, at most menu_max_w), menu_pad in from its edge, hung menu_gap off what opened it, its shadow
// menu_lift_* (an in-window plate's; a windowed one has the system's); it is there at once. An item is
// menu_item_h tall at size_menu, its highlight a pill menu_item_radius round in tone_selection_focus, on one item only;
// a ticked item's check sits in the leading gutter (menu_gutter_l in, menu_check across, menu_gutter_gap before the
// label), so every label starts at menu_label_x whether ticked or not. Its trailing words (a model's line, a key) are
// muted, at least menu_trail_gap after the label. A section's head is size_menu_head, muted; a separator is a hairline
// menu_sep_pad above and below.
export const menu_radius = 8
export const menu_pad = 5
export const menu_gap = 6
export const menu_min_w = 120
export const menu_max_w = 380
export const menu_lift_blur = 18
export const menu_lift_alpha = 0.28
export const menu_lift_dy = 6
export const menu_item_h = 22
export const menu_item_radius = 5
export const menu_item_pad_r = 10
export const menu_gutter_l = 6
export const menu_check = 11
export const menu_gutter_gap = 5
export const menu_label_x = $menu_gutter_l + $menu_check + $menu_gutter_gap
export const menu_trail_gap = 20
export const menu_head_h = 20
export const menu_sep_pad = 5
// A menu item's meta (prims.flecs ui.MenuItem `meta`: a version, a count) sits menu_meta_gap after its label, muted, at
// size_menu_meta. A section head with its maker's mark (ui.MenuHeadMarked) carries the mark in the check gutter.
export const menu_meta_gap = 5
export const size_menu_meta = 12
// A level slider (level.flecs ui.LevelSlider, harness_native_ui_view::level): a few named stops on a groove level_groove_h
// tall, level_groove_radius round, filled in tone_level_fill up to a knob level_knob across (tone_level_knob, its
// hairline tone_level_knob_edge, a small lift), each stop a dot level_tick across (tone_level_tick) where the knob rests
// on it. The knob glides between stops on the level spring. Its head (the name of what it sets, then the stop's name) is
// level_head_h tall at size_level_head; its scale (what the ends mean) at size_level_scale in tone_level_scale, level_gap
// apart from the track.
export const level_groove_h = 4
export const level_groove_radius = 2
export const level_knob = 14
export const level_tick = 3
export const level_gap = 5
export const level_head_h = 18
export const size_level_head = 12
export const size_level_scale = 10.5
export const line_level_scale = 13
export const level_omega = 52
export const level_zeta = 0.9
export mut tone_level_groove: Fill = {dark: {1, 1, 1, 0.12}, light: {0, 0, 0, 0.09}}
export mut tone_level_tick: Fill = {dark: {1, 1, 1, 0.30}, light: {0, 0, 0, 0.24}}
