// A drawn view's code button: hung in the column's gutter, left of the view, shown while the view is hovered.
export const chat_view_code = 20
export const chat_view_code_hang = $chat_view_code + 2
// The chat is the theme's page: tone_ground under it, cards and the composer in tone_card, code in tone_well, a user's
// bubble tone_raised, words in the four inks, tone_line on cards; the one accent only on what is pressable. Drawn in the
// window's appearance (chat.rs `chat_dark`).
// The send button: quiet (tone_wash, its arrow faint) with nothing to send, then solid in the strong ink with its arrow
// (and the stop's square) in tone_ground.
// Inline code amid the words, as the site sets it: the code face (the one monospace in prose) at chat_code_em of the
// words, in tone_code_ink on tone_wash, chat_code_radius round.
export const chat_code_radius = 5
// Inline components (harness-native-ui-prims/scene/inline.flecs): the chip under the pointer brightens a step
// (tone_wash: a chip at rest has no plate) and underlines its label (tone_ink_faint), held down a step more
// (tone_press). A GitHub pull request's or issue's state picks its icon's ink, as GitHub's Primer draws them (open green, draft and not planned grey,
// merged and completed purple, closed red), and its head commit's checks the mark after it (success green, failure red,
// pending amber).
export mut tone_gh_open: Fill = {dark: {0.247, 0.725, 0.314, 1}, light: {0.102, 0.498, 0.216, 1}}
export mut tone_gh_draft: Fill = {dark: {0.569, 0.596, 0.631, 1}, light: {0.349, 0.388, 0.431, 1}}
export mut tone_gh_merged: Fill = {dark: {0.671, 0.490, 0.973, 1}, light: {0.510, 0.314, 0.875, 1}}
export mut tone_gh_closed: Fill = {dark: {0.973, 0.318, 0.286, 1}, light: {0.812, 0.133, 0.180, 1}}
export mut tone_gh_ci_success: Fill = $tone_gh_open
export mut tone_gh_ci_failure: Fill = $tone_gh_closed
export mut tone_gh_ci_pending: Fill = {dark: {0.824, 0.600, 0.133, 1}, light: {0.604, 0.404, 0.0, 1}}
// A chip's hover card (scene/widgets/peek.flecs hn.ChatPeek, src/app/chat/peek.rs): after the pointer rests on a chip
// inline_peek_dwell seconds, a menu plate (ui.Menu: an overlay over its chip, its lift and motion) inline_peek_w wide,
// inline_peek_pad in, its lines inline_peek_gap apart: a header row (an icon or favicon inline_peek_icon_w square, then
// `owner/repo #n` or the site), the title flush left, then a GitHub item's state and checks, author and lines changed,
// its description's first lines; a page's description and picture (inline_peek_image_h tall, only when it has one) and
// its live view once a browser host has one (inline_peek_page_h); a file's first lines in the code face. It closes
// when the pointer leaves the chip and the card both. The checks' marks are inline_peek_mark_w square; under the
// pointer the checks line opens a list of the checks not passed, a row each inline_peek_check_h tall, its parts
// inline_peek_check_gap apart and inline_peek_check_pad in from its wash's ends (inline_peek_check_radius round).
export const inline_peek_dwell_s = 0.35
export const inline_peek_w = 360
