export const tone_kind_shell: Fill = {dark: {1, 1, 1, 0.52}, light: {0, 0, 0, 0.50}}

// The brand marks' fills (hn.Kind): Claude's orange (#D97757, its brand hex) in both appearances; OpenAI's and Cursor's
// marks are monochrome, in the strong ink, so they turn with the appearance.
export const tone_mark_claude: Fill = {dark: {0.851, 0.467, 0.341, 1}, light: {0.851, 0.467, 0.341, 1}}
export const tone_mark_ink: Fill = {dark: {1, 1, 1, 0.88}, light: {0, 0, 0, 0.85}}

prefab Strong {
  Fill: $tone_ink_1
}
prefab Ink {
  Fill: $tone_ink_2
}
prefab Muted {
  Fill: $tone_ink_3
}
prefab Faint {
  Fill: $tone_ink_4
}
prefab Accent {
  Fill: $tone_accent
}
prefab Wash {
  Fill: $tone_wash
}
prefab Plate {
  Fill: $tone_plate
  Edge: {dark: $tone_plate_line.dark, light: $tone_plate_line.light}
  Shape: {radius: $radius_card, n: 4, border: 1, feather: 0}
}

