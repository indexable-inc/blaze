// Code's colours by tree-sitter capture (harness-native-render/src/highlight.rs, a fenced block's `Highlight`):
// `code_ink.<capture>` colours that capture and the ones under it (`function` colours `function.method` and
// `function.macro`); a capture none names keeps the words' own ink. Dark is JetBrains' Islands Dark editor scheme
// (IslandSchemeDark.xml), light IntelliJ Light's; a Ghostty theme does not change them (only the terminal follows it).
@tree ChildOf
code_ink {
  keyword { Fill: {dark: {0.812, 0.557, 0.427, 1}, light: {0, 0.2, 0.702, 1}} }
  function { Fill: {dark: {0.337, 0.659, 0.961, 1}, light: {0, 0.384, 0.478, 1}} }
  type { Fill: {dark: {0.737, 0.745, 0.769, 1}, light: {0, 0, 0, 1}} }
  constructor { Fill: {dark: {0.337, 0.659, 0.961, 1}, light: {0, 0.384, 0.478, 1}} }
  attribute { Fill: {dark: {0.702, 0.682, 0.376, 1}, light: {0.62, 0.533, 0.051, 1}} }
  string { Fill: {dark: {0.416, 0.671, 0.451, 1}, light: {0.024, 0.49, 0.09, 1}} }
  escape { Fill: {dark: {0.812, 0.557, 0.427, 1}, light: {0, 0.216, 0.651, 1}} }
  number { Fill: {dark: {0.165, 0.675, 0.722, 1}, light: {0.09, 0.314, 0.922, 1}} }
  constant { Fill: {dark: {0.78, 0.49, 0.733, 1}, light: {0.529, 0.063, 0.58, 1}} }
  property { Fill: {dark: {0.78, 0.49, 0.733, 1}, light: {0.529, 0.063, 0.58, 1}} }
  label { Fill: {dark: {0.737, 0.745, 0.769, 1}, light: {0, 0, 0, 1}} }
  operator { Fill: {dark: {0.737, 0.745, 0.769, 1}, light: {0, 0, 0, 1}} }
  comment { Fill: {dark: {0.478, 0.494, 0.522, 1}, light: {0.549, 0.549, 0.549, 1}} }
  variable { builtin { Fill: {dark: {0.812, 0.557, 0.427, 1}, light: {0, 0.2, 0.702, 1}} } }
}

