export const chat_row_estimate = 44
// A tool call's, a run's or a thought's line (hn.ChatLine, one look for all): plain words, and a status icon only where
// one says more than a word (scene/widgets/chat_status.flecs: a thought's sparkle leads, a call's running dot trails),
// chat_line_status across. Its height, its lead-in, and the chevron that shows on hover only (chat_line_chevron across). What sits under a line (its output, its
// table, its steps, a run's calls) starts chat_line_inset in, with a faint guide (tone_chat_guide, chat_guide_w wide)
// at chat_guide_x; a run's calls sit in from its line by chat_nest, so their words start where the content does.
