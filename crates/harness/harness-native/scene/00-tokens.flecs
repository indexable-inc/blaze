export const radius_control = 6
export const radius_card = 8
// ui.Bubble: its corners and the most it widens to before its words wrap (about 65 characters of body text).
export const radius_bubble = 8
export const bubble_max_w = 480

// An icon button (ui.IconButton) has no plate: its glyph rests in tone_ink_muted and eases to tone_ink_strong under the
// pointer (tone_accent while what it opens is open); held, it scales to icon_press_scale and dims to icon_press_dim, and
// springs back on the press spring (a little under-damped, so the release has a touch of give).
export const icon_press_scale = 0.92
export const icon_press_dim = 0.7
export const spring_press_omega = 38
export const spring_press_zeta = 0.62

// A kind's icon and the brand marks (hn.Kind): ink only, so they turn with the appearance; no brand's colour.
export mut tone_kind_claude: Fill = $tone_ink_muted
export mut tone_kind_codex: Fill = $tone_ink_muted
export mut tone_kind_cursor: Fill = $tone_ink_muted

prefab Strong {
  Fill: $tone_ink_strong
}
prefab Ink {
  Fill: $tone_ink
}
prefab Muted {
  Fill: $tone_ink_muted
}
prefab Faint {
  Fill: $tone_ink_faint
}
prefab Accent {
  Fill: $tone_accent
}
prefab Wash {
  Fill: $tone_wash
}
prefab Plate {
  Fill: $tone_card
  Edge: {dark: $tone_line.dark, light: $tone_line.light}
  Shape: {radius: $radius_card, n: 4, border: 1, feather: 0}
}

// F3's debug overlay (hn.Stats, src/app/stats.rs), over the terminal's ground in both appearances: a translucent plate, its
// monospace caption, and its frame-time bars (a frame over the 60 Hz budget in the hot tone).
export const size_stats = 11
export const line_stats = 14
export const radius_stats = 6
export mut tone_stats_plate: Fill = {dark: {0, 0, 0, 0.62}, light: {0, 0, 0, 0.62}}
export mut tone_stats_ink: Fill = {dark: {1, 1, 1, 0.90}, light: {1, 1, 1, 0.90}}
export mut tone_stats_bar: Fill = {dark: {0.427, 0.69, 0.514, 0.85}, light: {0.427, 0.69, 0.514, 0.85}}
export mut tone_stats_hot: Fill = {dark: {0.961, 0.494, 0.518, 1}, light: {0.961, 0.494, 0.518, 1}}

// The selection's shape (harness-native-render's select.rs; its colour is the theme's tone_text_selection): one plate
// under the glyphs wherever text is selected (a chat's transcript and input, a table's copied row, the terminal), corners
// of radius 4 on a superellipse of n 2; its rows join into one shape (a corner a touching row covers stays square).
// Ghostty's selection-background, where the theme sets one, retints it.
export const plate_selection_radius = 4
export const plate_selection_n = 2
// Cmd+C pulses it, a timeline rather than a spring. The grow is den's FlashLook (after the site's selshape.ts and the os
// text field): the shape and its glyphs grow by copy_grow about the selection's middle over copy_secs, on a fast ease-out
// peaking copy_rise of the way in, and fall back as a cubic. With it a light (tone_copy_sheen) sweeps the whole shape left
// to right over copy_sweep on an ease-in-out, coming up and dying away as it goes: a soft band copy_band points either
// side of its middle, leaning back copy_tilt points for every point down so each row below lights a beat after the one
// above. It adds to the plate on the dark page (copy_add_dark 1) and lies over it as a tint on the paper (copy_add_light
// 0), and the glyphs it crosses take copy_ink of its colour where it is brightest. Under Reduce Motion nothing grows or
// moves: the shape and its glyphs brighten by the light and fade back over copy_secs. At its end the pulse is exactly at
// rest and the frame goes idle.
export const copy_secs = 0.16
export const copy_rise = 0.18
export const copy_grow = 0.025
export const copy_sweep = 0.28
export const copy_band = 30
export const copy_tilt = 0.6
export const copy_ink = 0.6
export const copy_add_dark = 1
export const copy_add_light = 0
// The text caret (prims.flecs ui.caret, den's CaretLook): a bar caret_w wide (whole device pixels), caret_h of the
// font's size tall about its line's middle, caret_radius round. A jump farther than its height sweeps from where it was
// over caret_glide seconds on an ease-out cubic, its tail at half the bar's ink; after it last moved it stays solid
// caret_hold seconds, then blinks once every caret_blink seconds (on for the first half), each turn eased over caret_fade
// of the cycle. Its ink is tone_ink_strong. The sweep is off by default (caret_glide 0: the caret snaps); 0.2 turns it on.
export const caret_w = 1.5
export const caret_h = 1.25
export const caret_radius = 0.75
export const caret_glide = 0
export const caret_hold = 0.5
export const caret_blink = 1.06
export const caret_fade = 0.09
// Struck-through words (prims.flecs ui.strike, inline markdown's ~~struck~~): a strike_w point hairline (at least a
// device pixel) whose middle sits strike_rise_em of the words' size over their baseline (half Inter's x-height, 0.546
// em), in the text's own ink at strike_alpha of it.
export const strike_w = 1
export const strike_rise_em = 0.27
export const strike_alpha = 0.7
// LaTeX math (prims.flecs ui.formula; inline markdown's $…$, a chat's displayed formula): set at math_inline_scale of
// its words' size in a line, math_display_scale displayed (Computer Modern's x-height is smaller than Inter's, hence above
// 1), keeping math_inline_pad or math_display_pad points clear above and below in its line; strokes math_stroke_em thick
// (KaTeX's 1.5 px at its 40 px em). den's MathLook.
export const math_inline_scale = 1.1
export const math_display_scale = 1.25
export const math_inline_pad = 2
export const math_display_pad = 10
export const math_stroke_em = 0.0375
// Inline code's chip (MarkdownText).
export const textarea_max_h = 132
// A growing text area (ui.field.GrowingTextArea): it grows with its words to textarea_grow_share of its pane's height
// (less what the pane shows around it), then scrolls; a caret out of view glides back textarea_caret_margin points inside
// the edges on the textarea_glide spring.
export const textarea_grow_share = 0.85
export const textarea_caret_margin = 6
export const textarea_glide_omega = 48
export const textarea_glide_zeta = 1
// How far a text area's placeholder starts after its caret (which stands at the words' start), as a macOS field's does.
export const textarea_hint_inset = 4
// ui.Table: a row's height, the room between columns, a row's inset and its words' size; ui.Result: a snippet's two lines.
export const table_row = 24
export const table_gap = 14
export const table_pad = 6
export const size_table = 12.5
export const result_snippet_h = 36

// The chat pane (hn.ChatPane, scene/widgets/chat.flecs, src/app/chat.rs): a column of the transcript as wide as reads
// well, the user's words on a soft plate, code on a card, tool calls as quiet one-line rows, the input at the foot.
// chat_w is the reading column (the words, the bubble's trailing edge, the input): centred, chat_pad clear of the pane's
// edges either side when the pane is narrower. It is the measure: chat_measure ems of the body text, about 70
// characters of Inter at 35 (iA Writer's), widened for a chat that is half code, so a line still never runs the width of
// a wide window.
export const chat_pad = 24
// How far the transcript thins out where it scrolls under the composer (and under the pane's top): soft, never a cut line.
export const chat_fade_len = 12
// A reply streaming in (theme role chat_stream): the transcript follows its end on a spring (landing at once from rest
// when the end is more than chat_follow_far away); each glyph rises chat_glyph_rise points and fades in over
// chat_glyph_dur seconds from the frame it came; and words show at an even pace about chat_pace_lag seconds behind what
// came, chat_pace_min to chat_pace_max bytes of text (about characters) a second, never more than chat_pace_most
// seconds behind.
export const chat_follow_omega = 40
export const chat_follow_zeta = 1
export const chat_follow_far = 2000
export const chat_glyph_dur = 0.18
export const chat_glyph_rise = 2
export const chat_pace_lag = 0.25
export const chat_pace_min = 30
export const chat_pace_max = 1400
export const chat_pace_most = 2
// Vertical rhythm, top to bottom: chat_gap_block between two blocks of a reply (half above a block, half below; under
// half a line, so a short reply reads as a few small paragraphs of one thought, not a document's), the person's message
// chat_gap_turn below the reply before it and chat_gap_reply above the reply to it (a message sits with its answer).
export const chat_gap_block = 10
export const chat_gap_turn = 28
export const chat_gap_reply = 14
export const chat_block_half = $chat_gap_block / 2
// The person's bubble: its words' inset (even to the eye: the line's own leading adds to the vertical), its line, and the
// least room it leaves at the leading edge.
export const chat_bubble_pad_x = 12
export const chat_bubble_pad_y = 7
export const line_chat_bubble = 20
export const chat_bubble_lead = 48
// Body text: 14 on a 21 line (1.5).
export const size_chat = 14
export const line_chat = 21
// The measure (chat_w, above): wide enough for code and tables beside the words (a line of prose runs about 100
// characters of Inter at its widest).
export const chat_measure = 52
export const chat_w = $size_chat * $chat_measure
// Headings: a scale of about 1.15 over the body, each semibold in the strong ink (tone_ink_strong), set by size and
// weight, never by colour. Each sits closer to what it heads than to what came before: chat_h<n>_above over it,
// chat_h<n>_below under it (less a block's half gap, which the block under it brings).
export const size_chat_h1 = 21
export const line_chat_h1 = 27
export const chat_h1_above = 20
export const chat_h1_below = 4
export const size_chat_h2 = 18
export const line_chat_h2 = 24
export const chat_h2_above = 16
export const chat_h2_below = 2
export const size_chat_h3 = 15.5
export const line_chat_h3 = 22
export const chat_h3_above = 12
export const chat_h3_below = 0
// Lists (hn.ChatItem*): a hanging indent, the marker in a chat_list_mark_w gutter so wrapped lines align with the words,
// not the marker; chat_list_inset in from the column's edge; a nested list chat_list_nest further in (the parent's words'
// edge); chat_item_gap between items, much less than between paragraphs. A bullet is small (size_chat_bullet) and faint
// (tone_ink_faint), a number the body's size in the muted ink with tabular figures.
export const chat_list_mark_w = 18
export const chat_list_inset = 2
export const chat_list_nest_w = $chat_list_mark_w
export const chat_item_gap = 3
export const chat_item_half = $chat_item_gap / 2
export const size_chat_bullet = 10
export const line_chat_code = 17
export const chat_bubble_radius = 8
// The widest a user's bubble gets before its words wrap: about three quarters of the column, as iMessage and ChatGPT do.
export const chat_bubble_max_w = $chat_w * 0.8
// The composer (hn.ChatPane's foot.card): one card holding the words, centred in the reading column (chat_w wide at
// most, as the transcript), chat_foot_pad_t over it; the status bar (foot.status) under it, chat_foot_pad_b over the
// pane's foot. The card is a step lighter than the chat's ground with one hairline round it and no shadow,
// chat_composer_radius round, chat_composer_pad in from its sides; the words sit a further
// chat_composer_text_inset in (so they start where the status bar's model control's words do), chat_composer_pad_t under
// its top and chat_composer_pad_b over its bottom.
export const chat_foot_pad_t = 6
export const chat_foot_pad_b = 8
export const chat_composer_radius = 8
