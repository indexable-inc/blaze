// genui element props and motion (scene/widgets/genui.flecs, "Element props and motion"). A Progress glides to a new
// value on the gen_glide spring; below its max a sheen sweeps along its fill (den ui/progress.rs's shimmer): across in
// gen_sweep_period seconds, gen_sweep_share of the fill long, fading to gen_sweep_low as an end cuts it, in
// tone_press. A Loading or a Skeleton stays unseen for gen_pending_delay seconds, then fades in on the gen_pending
// spring (den's PendingLook), so a wait that ends at once never flickers. A Table's query marks what it found in each
// cell with a tone_accent_wash plate, gen_match_radius round.
export const gen_glide_omega = 18
export const gen_glide_zeta = 1
export const gen_sweep_period = 1.4
export const gen_sweep_share = 0.34
export const gen_sweep_low = 0.25
export const gen_pending_delay = 0.15
export const gen_pending_omega = 14
export const gen_pending_zeta = 1
export const gen_match_radius = 3

// ---- genui universal props ----------------------------------------------------------------------------------------
// The props every element of a cell's UI takes (src/app/chat/genui/common.rs, canvas.rs; hn.GenUniversal in widgets/genui.flecs),
// after den's genui_prims.rs. An element's pose glides on the pose spring (spring_pose_*), except while an `enter` or
// `exit` plays: a spring that settles in its `ms`, omega gen_settle_rate * 1000 / ms, critically damped (gen_settle_zeta).
// A press on an element with onDrag is a drag once it moves gen_drag_slop points. A Canvas shape's or Group's pose and
// turn spring on gen_shape_omega / gen_shape_zeta (den's `smooth` too).
export const gen_settle_rate = 6.6
export const gen_settle_zeta = 1
export const gen_drag_slop = 3
export const gen_shape_omega = 22
export const gen_shape_zeta = 1

// ---- the embedded browser ---------------------------------------------------------------------------------------------
// The harness browser's views (src/app/browser.rs; crates/harness/harness-browser). A chat card (hn.GenBrowser) shows the
// page at gen_browser_aspect (width over height, 16:10) above its title and address, a gen_browser_load hairline in
// tone_accent along the picture's foot while the page loads. The pane (hn.WebPane, cmd+shift+B) sits on the right
// web_pane_w wide, opening and folding on the sidebar's spring; its toolbar is web_toolbar_h tall with the address in a
// web_url_h field, the extensions menu web_menu_w wide, and an extension's popup web_popup_w by web_popup_h. Its left
// edge drags (src/app/web_drag.rs): a press within web_grab of it grabs it, and the width stays between web_pane_min and
// web_pane_max, less in a narrow window so the main card keeps web_keep beside it.
export const gen_browser_aspect = 1.6
export const gen_browser_load = 2
// A Map's card (hn.GenMap; src/app/maps.rs): gen_map_aspect wide over tall (5:3), rounded by radius_gen_media, the
// host's live map (Apple's, src/window/maps.rs) laid over it.
export const gen_map_aspect = 1.6667
export const web_pane_w = 520
export const web_pane_min = 320
export const web_pane_max = 1200
export const web_grab = 5
export const web_keep = 360
export const web_toolbar_h = 40
export const web_url_h = 26
export const web_menu_w = 240
export const web_popup_w = 360
export const web_popup_h = 480
