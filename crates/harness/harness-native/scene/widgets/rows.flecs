// The sidebar's rows as templates (flecs script reactivity): the host sets an instance's props (src/app.rs sync_view,
// harness_native_ui_view::View::props) and flecs re-runs only the parts that read a prop that changed. Every tree row
// implements hn.Row (scene/widgets/row.flecs); each kind adds its own props. Parts the host animates (a chevron's Fold, a row's HoverAmt) keep
// their runtime state across a re-run: a re-run sets components, it does not remake entities.
using flecs.script

@tree ChildOf
hn {
  // A session, a source-list row: its chevron gutter at its depth (hn.Hang), its kind's mark in the kind's colour
  // (hn.Kind), its name on one line (13 regular, medium while selected), and trailing its shortcut on hover and how it
  // stands as a small mark (`status`: a dot while running, a hollow ring once it exited, red when it failed or was killed,
  // amber when lost; `why` its tooltip). `focus`: the selection while the tree has the keyboard, its pill in the accent.
  @tree ChildOf
  template ObjRow : Row {
    prop kind: string = "shell"
    prop status: string = ""
    prop why: string = ""
    prop hint: string = ""
    prop focus: bool = false
    (IsA, hn.TreeRowLook)
    Action: {name: "select:{obj}"}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $tree_row_h, min: 0, max: 0}}
    Padding: {l: indent($depth, $tree_pad, $indent_step) + $tree_gutter, r: $tree_pad_r, t: 0, b: 0}
    hang { hn.Hang: {obj: $obj, depth: $depth, kids: $kids, open: $open} }
    glyph : ui.Symbol {
      Size: {w: {kind: Fixed, value: $tree_icon, min: 0, max: 0}, h: {kind: Fixed, value: $tree_icon, min: 0, max: 0}}
      // The kind's prefab holds its look: a vector Mark (Claude, Codex, Cursor) or a Nerd Font Icon (a shell).
      const k = match $kind { "claude": hn.Kind.claude; "codex": hn.Kind.codex; "cursor": hn.Kind.cursor; "shell": hn.Kind.shell; _: hn.Kind.other }
      Fill: k[Fill]
      if k?[Mark] {
        Mark: k[Mark]
      } else {
        Icon: k[Icon]
      }
    }
    name : ui.Lead {
      Text: {s: $name}
      if $selected {
        Fill: $tone_row_on
        TextStyle: {size: $size_row, line: $line_row, role: 0, bold: 0, weight: $weight_tree_on}
      } else {
        Fill: $tone_row
        TextStyle: {size: $size_row, line: $line_row, role: 0, bold: 0, weight: $weight_tree}
      }
    }
    spacer : ui.Spacer {}
    // Room goes by priority: the hover-only shortcut gives way first, then the name (ui.Lead, -1); the status never does.
    meta : ui.Line, Faint {
      LayoutPriority: {value: -2}
      TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
      Text: {s: $hint}
      HoverShow: {row: 0, keep: false}
    }
    state : hn.Status {
      LayoutPriority: {value: 1}
      Tooltip: {text: $why}
      Fill: match $status { "running": $tone_status_running; "failed": $tone_failed; "lost": $tone_lost; _: $tone_clear }
      if $status == "exited" {
        Edge: {dark: $tone_status_ring.dark, light: $tone_status_ring.light}
      } else {
        Edge: {dark: $tone_clear.dark, light: $tone_clear.light}
      }
      if $status == "" {
        Size: {w: {kind: Fixed, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: $status_size, min: 0, max: 0}}
      } else {
        Size: {w: {kind: Fixed, value: $status_size, min: 0, max: 0}, h: {kind: Fixed, value: $status_size, min: 0, max: 0}}
      }
    }
    if $selected {
      pill : hn.Selection {
        plate {
          if $focus {
            Fill: $tone_select_focus
          } else {
            Fill: $tone_select
          }
        }
      }
    }
  }

  // A shell run (or one of its pipeline stages) under its session, on the session rows' grid: a small dot in the icon
  // column tinted by how it went (`state`: running breathes in the accent, lost, failed, else faint), its command (12
  // regular, secondary), and trailing how long it took (`meta`; on hover, or always when `keep`: a failure, lost, pending,
  // skipped).
  @tree ChildOf
  template RunRow : Row {
    prop state: string = ""
    prop meta: string = ""
    prop keep: bool = false
    prop focus: bool = false
    (IsA, hn.TreeRowLook)
    Action: {name: "select:{obj}"}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $tree_run_h, min: 0, max: 0}}
    Padding: {l: indent($depth, $tree_pad, $indent_step) + $tree_gutter, r: $tree_pad_r, t: 0, b: 0}
    hang { hn.Hang: {obj: $obj, depth: $depth, kids: $kids, open: $open} }
    glyph : ui.Node {
      Size: {w: {kind: Fixed, value: $tree_icon, min: 0, max: 0}, h: {kind: Fixed, value: $tree_icon, min: 0, max: 0}}
      Flex: {axis: Row, gap: 0, align: Center, justify: Center, wrap: false}
      dot : hn.Status {
        Fill: match $state { "running": $tone_accent; "lost": $tone_lost; "failed": $tone_failed; _: $tone_ink_4 }
        if $state == "running" {
          Breath: {spring: {x: 1, v: 0}, up: false}
        }
      }
    }
    name : ui.Lead {
      TextStyle: {size: $size_run, line: 15, role: 0, bold: 0}
      Text: {s: $name}
      if $selected {
        Fill: $tone_row_on
      } else {
        Fill: $tone_ink_3
      }
    }
    spacer : ui.Spacer {}
    // Room goes as on a session row: how long it took gives way first, then the command (ui.Lead, -1).
    meta : ui.Line, Faint {
      LayoutPriority: {value: -2}
      TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
      Text: {s: $meta}
      HoverShow: {row: 0, keep: $keep}
    }
    if $selected {
      pill : hn.Selection {
        plate {
          if $focus {
            Fill: $tone_select_focus
          } else {
            Fill: $tone_select
          }
        }
      }
    }
  }

  // The fold of a session's older runs (`obj` the session): a quiet "Show 5 more" (or "Show fewer"), lined up with the
  // runs' commands.
  @tree ChildOf
  template MoreRow : Row {
    prop hidden: i32 = 0
    prop unfolded: bool = false
    (IsA, hn.TreeRowLook)
    Action: {name: "fold:{obj}"}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $tree_more_h, min: 0, max: 0}}
    Padding: {l: indent($depth, $tree_pad, $indent_step) + $tree_gutter, r: $tree_pad_r, t: 0, b: 0}
    hang { hn.Hang: {obj: $obj, depth: $depth, kids: $kids, open: $open} }
    glyph : ui.Node {
      Size: {w: {kind: Fixed, value: $tree_icon, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
    name : ui.Lead, Faint {
      TextStyle: {size: $size_run, line: 15, role: 0, bold: 0}
      if $unfolded {
        Text: {s: "Show fewer"}
      } else {
        Text: {s: "Show {hidden} more"}
      }
    }
  }

  // The archive row at the sidebar's bottom (`selected`: its glyph in the accent while the Archive, or an object opened
  // from it, is selected): an archive box that rises and grows on the row's hover (its HoverAmt spring) and bounces when an object is
  // archived (its Bump, kicked by the host). Clicked, the Archive pane (hn.ArchivePane) takes the main card.
  @tree ChildOf
  template ArchiveRow : Row {
    (IsA, ui.IconButton)
    Tooltip: {text: "Archive"}
    if $selected {
      Inks: {rest: $tone_icon_on, hover: $tone_icon_on}
    } else {
      Inks: {rest: $tone_icon_rest, hover: $tone_icon_hover}
    }
    icon : ui.Symbol {
      Size: {w: {kind: Fixed, value: $tree_icon, min: 0, max: 0}, h: {kind: Fixed, value: $tree_icon, min: 0, max: 0}}
      Icon: {glyph: ""}
      HoverLift: {lift: $archive_lift, scale: $archive_scale, kick_lift: $archive_kick_lift, kick_scale: $archive_kick_scale, omega: $archive_omega, zeta: $archive_zeta}
      Bump: {spring: {x: 0, v: 0}}
    }
    async {
      while true {
        const e = await on.click(this)
        await hn.act("archive:open", e.alt)
      }
    }
  }
}
