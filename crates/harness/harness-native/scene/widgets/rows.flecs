// The sidebar's rows as templates (flecs script reactivity): the host sets an instance's props (src/app.rs sync_view,
// harness_native_ui_view::View::props) and flecs re-runs only the parts that read a prop that changed. Every tree row
// implements hn.Row (scene/widgets/row.flecs); each kind adds its own props. Parts the host animates (a chevron's Fold, a row's HoverAmt) keep
// their runtime state across a re-run: a re-run sets components, it does not remake entities, nor remove a component an
// arm set before (so where a part's look depends on a prop, every arm sets it).
//
// Notion's sidebar: calm one-line rows, a session's led by its kind's mark (hn.Kind), no status dots. How a row stands is in its title's ink (`look`: "on" while
// selected, "rest" while live, "done" once it ended), a band of light sweeping through its title while it works (a Sheen
// at the pace of what it does: `pace`, `busy`; tokens sheen_* in 00-tokens.flecs), and a few muted words trailing it
// (`meta`), red only when it went wrong (`alarm`). The parts are hn.tree's (scene/widgets/tree.flecs).
using flecs.script

@tree ChildOf
hn {
  // A session: its chevron gutter at its depth (hn.Hang; folded, as every row starts, nothing under it shows but the
  // selection), what it is (`kind`: its agent's mark, hn.Kind, or a shell's terminal glyph), its title on one line (its
  // rename, a sub-agent's spawn name, a chat's first message: never its kind and number, which end its tooltip), how
  // many things are at work under it while it is folded (`under`: a faint dot and count, "" when none or open, so work
  // starting under a row never opens it), and trailing how long ago it started or ended, or how it went wrong (`why` its
  // tooltip). On hover its shortcut
  // (`hint`) takes the trailing words' place. `focus`: the selection while the tree has the keyboard. `edit`: its name is
  // being renamed (cmd+R): the name is the field's words (the host sets their caret and selection), its pill the field.
  // `menu`: its menu is open (a right press on it, src/app/row_menu.rs): ringed in the accent. `pace`: what its agent is
  // doing now (src/app.rs doing_of; "" at rest), the rhythm its title's sheen sweeps at; the words of it lead its tooltip.
  @tree ChildOf
  template ObjRow : Row {
    prop look: string = "rest"
    prop kind: string = "shell"
    prop under: string = ""
    prop mark: string = ""
    prop pace: string = ""
    prop alarm: bool = false
    prop meta: string = ""
    prop why: string = ""
    prop hint: string = ""
    prop focus: bool = false
    prop edit: bool = false
    prop menu: bool = false
    (IsA, hn.TreeRowLook)
    Action: {name: "select:{obj}"}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $tree_row_h, min: 0, max: 0}}
    Padding: {l: indent($depth, $tree_pad, $indent_step) + $tree_gutter, r: $tree_pad_r, t: 0, b: 0}
    hang { hn.Hang: {obj: $obj, depth: $depth, kids: $kids, open: $open, mark: $mark} }
    // What it is, the way the picker and the Archive show it (hn.Kind): Claude's starburst in its orange, OpenAI's
    // blossom for Codex and Cursor's cube in the muted ink, a shell's terminal glyph; faint once it ended, like its title.
    glyph : ui.Symbol {
      Size: {w: {kind: Fixed, value: $tree_kind, min: 0, max: 0}, h: {kind: Fixed, value: $tree_kind, min: 0, max: 0}}
      FixedSize: {h: true, v: true}
      const k = match $kind { "claude": hn.Kind.claude; "codex": hn.Kind.codex; "cursor": hn.Kind.cursor; "shell": hn.Kind.shell; _: hn.Kind.other }
      if k?[Mark] {
        Mark: k[Mark]
      } else {
        Icon: k[Icon]
      }
      if $look == "done" {
        Fill: $tone_ink_faint
      } else {
        if $kind == "claude" {
          Fill: $tone_kind_claude
        } else {
          if $kind == "codex" {
            Fill: $tone_kind_codex
          } else {
            if $kind == "cursor" {
              Fill: $tone_kind_cursor
            } else {
              Fill: $tone_ink_muted
            }
          }
        }
      }
    }
    name : hn.tree.Head {
      Text: {s: $name}
      // What it is doing while it works ("Running a command: cargo test"), where it works and when it started or ended
      // (the trailing words carry only what is new: what it works on, how it failed).
      Tooltip: {text: $why}
      if $look == "on" {
        Fill: $tone_ink_strong
        TextStyle: {size: $size_row, line: $line_row, role: 0, bold: 0, weight: $weight_tree_on}
      } else {
        if $look == "done" {
          Fill: $tone_ink_muted
        } else {
          Fill: $tone_ink
        }
        TextStyle: {size: $size_row, line: $line_row, role: 0, bold: 0, weight: $weight_tree}
      }
      // While it works, a band of light through its letters at the pace of what it does: a slow drift while it thinks,
      // quick crisp passes while a command runs, steady while it edits or writes, medium while it reads or uses a tool,
      // two bands chasing while a sub-agent works. At rest a sheen of strength 0, which lights nothing: the way a re-run
      // stops one (it cannot remove it).
      if $pace == "think" {
        Sheen: {period: $sheen_think_period, rest: $sheen_think_rest, band: $sheen_think_band, strength: $sheen_think_strength, still: $sheen_still, ease: $sheen_think_ease, bands: 1, phase: 0, scatter: true, dark: $tone_sheen.dark, light: $tone_sheen.light}
      } else {
        if $pace == "run" {
          Sheen: {period: $sheen_run_period, rest: $sheen_run_rest, band: $sheen_run_band, strength: $sheen_run_strength, still: $sheen_still, ease: $sheen_run_ease, bands: 1, phase: 0, scatter: true, dark: $tone_sheen.dark, light: $tone_sheen.light}
        } else {
          if $pace == "edit" {
            Sheen: {period: $sheen_edit_period, rest: $sheen_edit_rest, band: $sheen_edit_band, strength: $sheen_edit_strength, still: $sheen_still, ease: $sheen_edit_ease, bands: 1, phase: 0, scatter: true, dark: $tone_sheen.dark, light: $tone_sheen.light}
          } else {
            if $pace == "read" {
              Sheen: {period: $sheen_read_period, rest: $sheen_read_rest, band: $sheen_read_band, strength: $sheen_read_strength, still: $sheen_still, ease: $sheen_read_ease, bands: 1, phase: 0, scatter: true, dark: $tone_sheen.dark, light: $tone_sheen.light}
            } else {
              if $pace == "agent" {
                Sheen: {period: $sheen_agent_period, rest: $sheen_agent_rest, band: $sheen_agent_band, strength: $sheen_agent_strength, still: $sheen_still, ease: $sheen_agent_ease, bands: $sheen_agent_bands, phase: 0, scatter: true, dark: $tone_sheen.dark, light: $tone_sheen.light}
              } else {
                Sheen: {period: 0, rest: 0, band: 0, strength: 0, still: 0, ease: 0, bands: 1, phase: 0, scatter: false, dark: $tone_sheen.dark, light: $tone_sheen.light}
              }
            }
          }
        }
      }
    }
    spacer : ui.Spacer {}
    // Folded with work under it: a faint dot and how many, a command's sheen through the count; a press on the chevron
    // (or Right) opens it. Gone when nothing works under it, or once it is open and they show.
    if $under != "" {
      under : ui.Row {
        Flex: {axis: Row, gap: $tree_under_gap, align: Center, justify: End, wrap: false}
        FixedSize: {h: true, v: false}
        Tooltip: {text: "$under at work under it"}
        dot : ui.Symbol {
          Size: {w: {kind: Fixed, value: $tree_under_dot, min: 0, max: 0}, h: {kind: Fixed, value: $tree_under_dot, min: 0, max: 0}}
          Icon: {glyph: ""}
          Fill: $tone_ink_faint
        }
        count : hn.tree.Trail {
          Text: {s: $under}
          Sheen: {period: $sheen_run_period, rest: $sheen_run_rest, band: $sheen_run_band, strength: $sheen_run_strength, still: $sheen_still, ease: $sheen_run_ease, bands: 1, phase: 0, scatter: true, dark: $tone_sheen.dark, light: $tone_sheen.light}
        }
      }
    }
    meta : hn.tree.Trail {
      Text: {s: $meta}
      Tooltip: {text: $why}
      if $alarm {
        Fill: $tone_error
      } else {
        Fill: $tone_ink_faint
      }
      // Gone while hovered when the shortcut shows in its place.
      if $hint == "" {
        HoverShow: {row: 0, keep: true, away: false}
      } else {
        HoverShow: {row: 0, keep: false, away: true}
      }
    }
    // The shortcut (cmd+1 to 9), on hover only, where the trailing words were: a layer over the row (out of its flow),
    // its words at the row's right inset.
    keys : ui.Row {
      Overlay
      Flex: {axis: Row, gap: 0, align: Center, justify: End, wrap: false}
      Padding: {l: 0, r: $tree_pad_r, t: 0, b: 0}
      hint : hn.tree.Trail {
        Text: {s: $hint}
        HoverShow: {row: 0, keep: false, away: false}
      }
    }
    // While its menu is open (src/app/row_menu.rs): a ring round it, the selection left where it is.
    ring : hn.RowMenuMark {
      plate {
        if $menu {
          Edge: {dark: $tone_accent.dark, light: $tone_accent.light}
        } else {
          Edge: {dark: $tone_clear.dark, light: $tone_clear.light}
        }
      }
    }
    if $selected {
      pill : hn.Selection {
        plate {
          if $edit {
            Fill: $tone_well
          } else {
            if $focus {
              Fill: $tone_selection_focus
            } else {
              Fill: $tone_selection
            }
          }
        }
      }
    }
  }

  // A shell run (or one of its pipeline stages) under its session, on the session rows' grid: its command, shortened
  // (src/app.rs short_cmd) in the quieter run ink, a sheen through it at a command's pace while it runs (`busy`), and
  // trailing how long it took
  // (`meta`; on hover, or always when `keep`: a failure, lost, pending, skipped; red when `alarm`). A folded session
  // shows only its running runs, so a finished one folds away on its own.
  @tree ChildOf
  template RunRow : Row {
    prop look: string = "rest"
    prop mark: string = ""
    prop busy: bool = false
    prop alarm: bool = false
    prop meta: string = ""
    prop keep: bool = false
    prop focus: bool = false
    prop menu: bool = false
    (IsA, hn.TreeRowLook)
    Action: {name: "select:{obj}"}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $tree_run_h, min: 0, max: 0}}
    Padding: {l: indent($depth, $tree_pad, $indent_step) + $tree_gutter, r: $tree_pad_r, t: 0, b: 0}
    hang { hn.Hang: {obj: $obj, depth: $depth, kids: $kids, open: $open, mark: $mark} }
    name : hn.tree.Cmd {
      Text: {s: $name}
      if $look == "on" {
        Fill: $tone_ink_strong
      } else {
        if $look == "done" {
          Fill: $tone_ink_muted
        } else {
          Fill: $tone_ink_muted
        }
      }
      if $busy {
        Sheen: {period: $sheen_run_period, rest: $sheen_run_rest, band: $sheen_run_band, strength: $sheen_run_strength, still: $sheen_still, ease: $sheen_run_ease, bands: 1, phase: 0, scatter: true, dark: $tone_sheen.dark, light: $tone_sheen.light}
      } else {
        Sheen: {period: 0, rest: 0, band: 0, strength: 0, still: 0, ease: 0, bands: 1, phase: 0, scatter: false, dark: $tone_sheen.dark, light: $tone_sheen.light}
      }
    }
    spacer : ui.Spacer {}
    meta : hn.tree.Trail {
      Text: {s: $meta}
      if $alarm {
        Fill: $tone_error
      } else {
        Fill: $tone_ink_faint
      }
      HoverShow: {row: 0, keep: $keep, away: false}
    }
    // While its menu is open (src/app/row_menu.rs): a ring round it, the selection left where it is.
    ring : hn.RowMenuMark {
      plate {
        if $menu {
          Edge: {dark: $tone_accent.dark, light: $tone_accent.light}
        } else {
          Edge: {dark: $tone_clear.dark, light: $tone_clear.light}
        }
      }
    }
    if $selected {
      pill : hn.Selection {
        plate {
          if $focus {
            Fill: $tone_selection_focus
          } else {
            Fill: $tone_selection
          }
        }
      }
    }
  }

  // The archive row at the sidebar's bottom (`selected`: its glyph in the accent while the Archive, or an object opened
  // from it, is selected): an archive box that rises and grows on the row's hover (its HoverAmt spring) and bounces when an object is
  // archived (its Bump, kicked by the host). Clicked, the Archive pane (hn.ArchivePane) takes the main card.
  @tree ChildOf
  template ArchiveRow : Row {
    (IsA, ui.IconButton)
    Tooltip: {text: "Archive"}
    if $selected {
      Inks: {rest: $tone_accent, hover: $tone_accent}
    } else {
      Inks: {rest: $tone_ink_muted, hover: $tone_ink_strong}
    }
    icon : ui.Symbol {
      Size: {w: {kind: Fixed, value: $tree_icon, min: 0, max: 0}, h: {kind: Fixed, value: $tree_icon, min: 0, max: 0}}
      Icon: {glyph: ""}
      HoverLift: {lift: $archive_lift, scale: $archive_scale, kick_lift: $archive_kick_lift, kick_scale: $archive_kick_scale, omega: $archive_omega, zeta: $archive_zeta}
      Bump: {spring: {x: 0, v: 0}}
    }
    async {
      while true {
        const e = await on.click(this)
        await hn.act("archive:open", e.alt)
      }
    }
  }
}
