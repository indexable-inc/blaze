// A chip's hover card (src/app/chat/peek.rs): after the pointer rests on an inline component (a <PR>, an <Issue>, a
// <Link>, a <Path>) for inline_peek_dwell seconds, a plate under it says what it points at; it goes when the pointer
// leaves the chip and the plate both. The plate is a ui.Menu (the shared popover: an overlay placed against what it is
// anchored to, flipped to fit, its lift and motion), anchored to a Placed node the host lays over the chip. Its lines
// are a keyed list the host keeps (harness_native_ui_view::for_each_of), one prefab a kind of line; the host passes
// words and which scene entity's Fill an ink is, never a colour or a size. Every card reads the same way: a header row
// (an icon or the page's favicon, then where the thing is: `owner/repo #n`, the site, the path), the title flush left
// under it, then what there is. A line with nothing to show (no picture, no live view) is not added, so no room is kept.
@tree ChildOf
hn {
  // Where the plate opens against: a node the host lays over the chip's rectangle (Placed: layout keeps the Laid it is
  // given), drawing nothing.
  prefab ChatPeekAnchor : ui.Node {
    Placed
  }

  // The plate: under the chip (above it when there is no room below), inline_peek_w wide, a column of lines.
  prefab ChatPeek : ui.Menu {
    Side: {edge: Bottom, dx: 0, dy: $menu_gap}
    Flex: {axis: Column, gap: $inline_peek_gap, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Fixed, value: $inline_peek_w, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $inline_peek_pad, r: $inline_peek_pad, t: $inline_peek_pad, b: $inline_peek_pad}
  }

  // The header of a page with a favicon: the favicon (a picture the daemon saved, inline_peek_icon_w square, a little
  // rounded), then the site's name, quiet.
  prefab PeekSite : ui.Row {
    Flex: {axis: Row, gap: $inline_peek_gap, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    icon : ui.Node {
      Picture: {handle: ""}
      Clip
      Shape: {radius: $inline_peek_icon_radius, n: 4, border: 0, feather: 0}
      Size: {w: {kind: Fixed, value: $inline_peek_icon_w, min: 0, max: 0}, h: {kind: Fixed, value: $inline_peek_icon_w, min: 0, max: 0}}
    }
    name : ui.Line, Muted {
      TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 0, bold: 0}
    }
  }

  // The header of anything else: its icon (a pull request's in its state's ink: the host copies the Fill of the
  // component's state child, ui.inline.PR.merged; a page without a favicon the globe), then where it is, quiet.
  prefab PeekSiteGlyph : ui.Row {
    Flex: {axis: Row, gap: $inline_peek_gap, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    icon : ui.Symbol {
      Size: {w: {kind: Fixed, value: $inline_peek_icon_w, min: 0, max: 0}, h: {kind: Fixed, value: $inline_peek_icon_w, min: 0, max: 0}}
    }
    name : ui.Line, Muted {
      TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 0, bold: 0}
    }
  }

  // The header of a file or a folder: its kind's drawing (IntelliJ's icon in its own colours, ui.Art), then its path,
  // quiet.
  prefab PeekSiteArt : ui.Row {
    Flex: {axis: Row, gap: $inline_peek_gap, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    icon : ui.Art {
      Size: {w: {kind: Fixed, value: $inline_peek_icon_w, min: 0, max: 0}, h: {kind: Fixed, value: $inline_peek_icon_w, min: 0, max: 0}}
    }
    name : ui.LineMiddle, Muted {
      TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 0, bold: 0}
    }
  }

  // A folder's entries, the Finder's way: a column of hn.PeekEntry rows the host keeps by name, folders first.
  prefab PeekList : ui.Column {
    Flex: {axis: Column, gap: $inline_peek_entry_gap, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
  }

  // One entry: its kind's icon at its name's size, then its name in the body face, one compact line.
  prefab PeekEntry : ui.Row {
    Flex: {axis: Row, gap: $inline_peek_gap, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    icon : ui.Art {
      Size: {w: {kind: Fixed, value: $inline_peek_entry_icon_w, min: 0, max: 0}, h: {kind: Fixed, value: $inline_peek_entry_icon_w, min: 0, max: 0}}
    }
    name : ui.Lead, Ink {
      TextStyle: {size: $size_peek_body, line: $line_peek_entry, role: 0, bold: 0}
    }
  }

  // The title, strong, wrapping, flush left under the header.
  prefab PeekTitle : ui.Words, Strong {
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    TextStyle: {size: $size_peek_title, line: $line_peek_title, role: 0, bold: 1}
  }

  // Its state as GitHub shows it (`top`): a pill in the state's ink with its name (Open, Draft, Merged, Closed), then the
  // head commit's checks, their mark in its ink and what is left of them (`2 of 9 running · 4m`, `1 failed`, `All checks
  // passed`). Under the pointer, `list` opens under it: a row a check not passed (failed, running, queued: the host's
  // keyed rows, hn.PeekCheck*) and one row the passed ones fold into; out from under it, the list is empty again. The
  // whole block is one hit target (its Cursor), so the pointer crossing from the line to the rows keeps it open.
  prefab PeekState : ui.Column {
    Cursor: {shape: Arrow}
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    top : ui.Row {
      Flex: {axis: Row, gap: $inline_peek_gap, align: Center, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      badge : ui.Row {
        Shape: {radius: 100, n: 4, border: 0, feather: 0}
        Flex: {axis: Row, gap: 0, align: Center, justify: Start, wrap: false}
        Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Padding: {l: $inline_peek_badge_pad, r: $inline_peek_badge_pad, t: 1, b: 1}
        label : ui.Line {
          Fill: $tone_on_accent
          TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 0, bold: 1}
        }
      }
      mark : ui.Symbol {
        Size: {w: {kind: Fixed, value: $inline_peek_mark_w, min: 0, max: 0}, h: {kind: Fixed, value: $inline_peek_mark_w, min: 0, max: 0}}
      }
      checks : ui.Lead, Muted {
        TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 0, bold: 0}
      }
    }
    list : ui.Column {
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    }
  }

  // One check not passed, a row of the state's list: its mark (the variants below), its name, the step it is on in the
  // quiet ink (it gives up its room first), and its time at the end in tabular figures (how long it has run or waited,
  // ticking while it does; how long a failed one took). A press opens its log in the harness browser (the host sets its
  // Action, `web:open:<url>`); a wash under the pointer, as a menu's items.
  prefab PeekCheck : ui.Row {
    Pressable
    Action: {name: ""}
    Cursor: {shape: Arrow}
    Fill: $tone_clear
    Shape: {radius: $inline_peek_check_radius, n: 4, border: 0, feather: 0}
    HoverLook: {dark: $tone_hover.dark, light: $tone_hover.light, pad: 0, radius: -1}
    PressLook: {dark: $tone_press.dark, light: $tone_press.light}
    Flex: {axis: Row, gap: $inline_peek_check_gap, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $inline_peek_check_h, min: 0, max: 0}}
    Padding: {l: $inline_peek_check_pad, r: $inline_peek_check_pad, t: 0, b: 0}
    mark : ui.Symbol {
      Size: {w: {kind: Fixed, value: $inline_peek_mark_w, min: 0, max: 0}, h: {kind: Fixed, value: $inline_peek_mark_w, min: 0, max: 0}}
    }
    name : ui.Line, Ink {
      TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 0, bold: 0}
    }
    step : ui.Lead, Muted {
      TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 0, bold: 0}
    }
    gap : ui.Spacer {
      Size: {w: {kind: Grow, value: 1, min: $inline_peek_check_gap, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
    time : ui.Line, Muted {
      FixedSize: {h: true, v: false}
      TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 10, bold: 0}
    }
  }
  // A failed one: the cross and its name in the failing checks' ink (oct-x), its name a step heavier: what failed is
  // what the card is for.
  prefab PeekCheckFailed : hn.PeekCheck {
    name : ui.Line { Fill: $tone_gh_ci_failure; TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 0, bold: 0, weight: 560} }
    mark : ui.Symbol { Icon: {glyph: ""}; Fill: $tone_gh_ci_failure }
  }
  // A running one: the running dot, breathing while it shows, in the pending checks' ink (cod-circle_small_filled).
  prefab PeekCheckRunning : hn.PeekCheck {
    mark : ui.Symbol {
      Icon: {glyph: ""}
      Fill: $tone_gh_ci_pending
      Breath: {spring: {x: 1, v: 0}, up: false, low: $breath_floor}
    }
  }
  // A queued one: a hollow ring, faint (cod-circle_small).
  prefab PeekCheckQueued : hn.PeekCheck {
    mark : ui.Symbol { Icon: {glyph: ""}; Fill: $tone_ink_faint }
  }
  // The passed and skipped ones, folded into one quiet row (`7 passed, 2 skipped`) under the rest; not a link.
  prefab PeekChecksFolded : ui.Row {
    Flex: {axis: Row, gap: $inline_peek_check_gap, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $inline_peek_check_h, min: 0, max: 0}}
    Padding: {l: $inline_peek_check_pad, r: $inline_peek_check_pad, t: 0, b: 0}
    mark : ui.Symbol {
      Icon: {glyph: ""}
      Fill: $tone_ink_faint
      Size: {w: {kind: Fixed, value: $inline_peek_mark_w, min: 0, max: 0}, h: {kind: Fixed, value: $inline_peek_mark_w, min: 0, max: 0}}
    }
    label : ui.Lead, Muted {
      TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 0, bold: 0}
    }
  }

  // A quiet line: who opened it and how many lines it changes; asking, or what failed.
  prefab PeekMeta : ui.Words, Muted {
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 0, bold: 0}
  }

  // A description in markdown (a pull request's): its blocks as the transcript's own rows (src/app/chat.rs blocks and
  // fill_row), so a list reads as a list, code as code, a heading as a heading, as they would in the chat.
  prefab PeekMarkdown : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
  }

  // A description's first lines (a page's), in the body ink.
  prefab PeekBody : ui.Words, Ink {
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    TextStyle: {size: $size_peek_body, line: $line_peek_body, role: 0, bold: 0}
  }

  // A file's lines from the place named, in the code face and coloured by its language (src/app/chat/peek.rs sets
  // `text`'s Highlight), as the transcript's code and the mention preview (chat.flecs ChatMentionCode) draw it: each
  // line whole, never wrapped (a wrapped line starts at the left edge and reads as dedented), cut by this box's edge.
  prefab PeekCode : ui.Column {
    Clip
    Flex: {axis: Column, gap: 0, align: Start, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    text : ui.Words {
      Fill: $tone_ink
      FixedSize: {h: true, v: false}
      Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 9, bold: 0}
    }
  }

  // A page's og:image (the daemon saves it as a file), cut to the plate's width and inline_peek_image_h, rounded; only on
  // a page that has one.
  prefab PeekImage : ui.Node {
    Picture: {handle: ""}
    Clip
    Shape: {radius: $inline_peek_radius, n: 4, border: 0, feather: 0}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $inline_peek_image_h, min: 0, max: 0}}
  }

  // The live view of the page (an embedded browser, CEF): the card's PageView names the URL, and only once a browser
  // host renders it and sets `ready` (harness-native-ui-text-api PageView) is this line added, its frames by `key`;
  // until then the card is the page's OpenGraph data and holds no room for it.
  prefab PeekPage : ui.Node {
    Surface: {key: 0, cover: 1}
    Clip
    Shape: {radius: $inline_peek_radius, n: 4, border: 0, feather: 0}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $inline_peek_page_h, min: 0, max: 0}}
  }
}
