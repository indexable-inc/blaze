// The overlays over the window: the command palette (cmd+K) and the new-object picker (cmd+N). Both are a card on one
// scrim, made and sent away by the same host code (src/app.rs sync_palette, the `Palette` and its `Mode`); the picker's
// rows are templates (scene/widgets/picker.flecs, after this file).

@tree ChildOf
hn {
  // The scrim every overlay stands on: over everything, dimming the window, and a press beside the card closes it. It is
  // there at once and gone at once (no Transition).
  prefab Scrim : ui.Column {
    Layer: {level: Overlay}
    Pressable
    Action: {name: "pal:close"}
    Fill: $tone_scrim
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
    Flex: {axis: Column, gap: 0, align: Center, justify: Start, wrap: false}
  }

  // An overlay's card: a plate on the scrim, one hairline round it, no shadow. Each overlay's card is in tone_card.
  prefab OverlayCard : ui.Column, Plate {
    Hoverable
    Shape: {radius: $overlay_radius, n: 4, border: 1, feather: 0}
    Flex: {axis: Column, gap: 2, align: Stretch, justify: Start, wrap: false}
    Padding: {l: $overlay_pad, r: $overlay_pad, t: $overlay_pad, b: $overlay_pad}
  }

  // The command palette (cmd+K): a card near the top of the window.
  prefab Palette : hn.Scrim {
    Padding: {l: 0, r: 0, t: $palette_top, b: 0}
    card : hn.OverlayCard {
      Fill: $tone_card
      Size: {w: {kind: Fixed, value: $palette_w, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      query : ui.Row {
        Flex: {axis: Row, gap: 8, align: Center, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $palette_query_h, min: 0, max: 0}}
        Padding: {l: 10, r: 10, t: 0, b: 0}
        text : ui.Words, Strong {
          TextStyle: {size: 15, line: 20, role: 0, bold: 0}
        }
      }
      rule : ui.Divider {}
      items : ui.Column {
        Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Padding: {l: 0, r: 0, t: 4, b: 0}
      }
    }
  }

  // One palette entry.
  prefab PalRow : ui.Row {
    Pressable
    Action: {name: ""}
    Fill: $tone_clear
    Shape: {radius: $radius_control, n: 4, border: 0, feather: 0}
    HoverLook: {dark: $tone_hover.dark, light: $tone_hover.light, pad: 0, radius: -1}
    Flex: {axis: Row, gap: 10, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $palette_row_h, min: 0, max: 0}}
    Padding: {l: 10, r: 10, t: 0, b: 0}
    // The entry's kind mark or command glyph (src/app.rs PalGlyph), in a 16 point box.
    glyph : ui.Symbol {
      Size: {w: {kind: Fixed, value: $icon_box, min: 0, max: 0}, h: {kind: Fixed, value: $icon_box, min: 0, max: 0}}
    }
    name : ui.Words, Ink {
      TextStyle: {size: $size_body, line: 16, role: 0, bold: 0}
    }
    spacer : ui.Spacer {}
    hint : ui.Words, Faint {
      TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
    }
  }

  // The new-object picker (cmd+N): a small card a little above the window's middle, a quiet label over one row a kind
  // (hn.PickRow, filled by the host from the act.Spawn actions in scene/20-keys.flecs, in their order).
  prefab Picker : hn.Scrim {
    Flex: {axis: Column, gap: 0, align: Center, justify: Center, wrap: false}
    Padding: {l: 0, r: 0, t: 0, b: $picker_rise}
    card : hn.OverlayCard {
      Fill: $tone_card
      Size: {w: {kind: Fixed, value: $picker_w, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      head : ui.Row {
        Flex: {axis: Row, gap: 0, align: Center, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $picker_head_h, min: 0, max: 0}}
        Padding: {l: 10, r: 10, t: 0, b: 0}
        title : ui.Line, Faint {
          TextStyle: {size: $size_label, line: 14, role: 0, bold: 1, weight: $weight_label}
          Text: {s: "New"}
        }
      }
      items : ui.Column {
        Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      }
    }
  }

  // A picker row's look: a press target the height of a row, a hover wash hugging it.
  prefab PickRowLook : ui.Row {
    Pressable
    Fill: $tone_clear
    Shape: {radius: $radius_control, n: 4, border: 0, feather: 0}
    HoverLook: {dark: $tone_hover.dark, light: $tone_hover.light, pad: 0, radius: -1}
    PressLook: {dark: $tone_press.dark, light: $tone_press.light}
    Flex: {axis: Row, gap: 10, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $picker_row_h, min: 0, max: 0}}
    Padding: {l: 10, r: 8, t: 0, b: 0}
  }

  // The picker's highlight: a pill under the highlighted row, where the highlight is at once (the sidebar's
  // hn.Selection: no slide, so two rows never show part of one pill).
  prefab PickPill : ui.Node {
    Background
    Fill: $tone_selection
    Shape: {radius: $radius_control, n: 4, border: 0, feather: 0}
  }

  // A key as a small cap: the key that picks a picker row.
  prefab Keycap : ui.Row {
    Fill: $tone_wash
    Shape: {radius: $keycap_radius, n: 4, border: 0, feather: 0}
    Flex: {axis: Row, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Fit, value: 0, min: $keycap_min, max: 0}, h: {kind: Fixed, value: $keycap_h, min: 0, max: 0}}
    Padding: {l: $keycap_pad, r: $keycap_pad, t: 0, b: 0}
    label : ui.Line, Muted {
      TextStyle: {size: $size_keycap, line: $line_keycap, role: 0, bold: 0, weight: $weight_row}
    }
  }
}
