// The theme: tones, sizes and springs the host reads by role.

@tree ChildOf
hn {
  // The theme: every tone, size and spring the host reads by role (src/look.rs `role`, `hn.Theme.<role>`), one child
  // each, valued from the tokens (00-tokens.flecs). Another look is another hn.Theme.
  prefab Theme {
    // Status: a dot's or an icon's.
    running { Fill: $tone_running }
    exited { Fill: $tone_exited }
    failed { Fill: $tone_failed }
    failed_wash { Fill: $tone_failed_wash }
    lost { Fill: $tone_lost }
    // Rows: the selected row's pill, nothing, the accent (a running dot), the tertiary and quaternary inks.
    selected { Fill: $tone_select }
    clear { Fill: $tone_clear }
    accent { Fill: $tone_accent }
    strong { Fill: $tone_ink_1 }
    muted { Fill: $tone_ink_3 }
    faint { Fill: $tone_ink_4 }
    // The cute touch: a small warm colour per kind on its icon.
    kind_claude { Fill: $tone_kind_claude }
    kind_codex { Fill: $tone_kind_codex }
    kind_cursor { Fill: $tone_kind_cursor }
    kind_shell { Fill: $tone_kind_shell }
    // Offscreen shots' stand-in for the vibrancy (src/shot.rs).
    shot_ground { Fill: $tone_shot_ground }
    // How long after it ended a finished run with no session leaves the tree for the Archive (seconds, as a width).
    archive_after {
      Size: {w: {kind: Fixed, value: $archive_after_s, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
    // A tree level's indent, and a failure badge's padding while it shows.
    indent {
      Size: {w: {kind: Fixed, value: $indent_step, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
    // A sidebar row's padding before its icon at depth 0, and the disclosure slot hanging left of the icon.
    row_inset {
      Size: {w: {kind: Fixed, value: $row_pad, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
    disclose {
      Size: {w: {kind: Fixed, value: $disclose_w, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
    badge_on {
      Padding: {l: $badge_pad, r: $badge_pad, t: 0, b: 0}
    }
    // Springs: a running dot's breath (dimming to Reveal's alpha0), a chevron's turn, the sidebar's fold (the selection
    // pill's is on hn.Selection).
    breath {
      Motion: {omega: $breath_omega, zeta: $breath_zeta}
      Reveal: {alpha0: $breath_floor, dx: 0, dy: 0, scale0: 1}
    }
    turn { Motion: {omega: $turn_omega, zeta: $turn_zeta} }
    sidebar { Motion: {omega: $sidebar_omega, zeta: $sidebar_zeta} }
    lights { Motion: {omega: $lights_omega, zeta: $lights_zeta} }
    // A tree row folding in or away (its height and opacity).
    tree_fold { Motion: {omega: $tree_fold_omega, zeta: $tree_fold_zeta} }
    // The tree's scroll: the glide that keeps the selected row in view (and how far inside an edge it leaves it), how far
    // an edge with more beyond it fades, and the overlay knob shown while it moves.
    tree_scroll {
      Motion: {omega: $tree_glide_omega, zeta: $tree_glide_zeta}
      Size: {w: {kind: Fixed, value: $tree_reveal_margin, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
    tree_fade {
      Size: {w: {kind: Fixed, value: $tree_fade_len, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
    knob {
      Fill: $tone_knob
      Size: {w: {kind: Fixed, value: $knob_width, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
  }
}
