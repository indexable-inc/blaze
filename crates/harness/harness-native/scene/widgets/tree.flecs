module hn.tree

// The sidebar tree's parts (scene/widgets/rows.flecs builds its rows of them), Notion's sidebar: a title and a few muted
// words trailing it, nothing else. Type and ink from the tokens (00-tokens.flecs: size_row, weight_tree, tone_row_*);
// each row sets only what its state changes (its ink, its weight, its sheen). Prefabs only, leaves only (no children),
// so an instance in a template is the part itself.

// A row's kind at a glance, before its title: tree_kind across, tree_kind_gap after (the host sets an agent's mark or a
// shell's glyph on it, src/app.rs sync_view).
prefab Kind : ui.Symbol {
  Size: {w: {kind: Fixed, value: $tree_kind, min: 0, max: 0}, h: {kind: Fixed, value: $tree_kind, min: 0, max: 0}}
  Padding: {l: 0, r: $tree_kind_gap, t: 0, b: 0}
}

// A command's: the terminal glyph, faint (cod-terminal).
prefab CmdKind : Kind {
  Icon: {glyph: ""}
  Fill: $tone_ink_faint
}

// The sheens a working row's title sweeps with, by the pace of what it does (rows.flecs reads the one its `pace` names,
// `hn.tree.SheenRun[Sheen]`: one reactive input each, where the tokens would be a dozen; flecs allows a script 64). Rest
// is a sheen of strength 0, which lights nothing: the way a re-run stops one (it cannot remove it).
prefab SheenThink {
  Sheen: {period: $sheen_think_period, rest: $sheen_think_rest, band: $sheen_think_band, strength: $sheen_think_strength, still: $sheen_still, ease: $sheen_think_ease, bands: 1, phase: 0, scatter: true, dark: $tone_sheen.dark, light: $tone_sheen.light}
}
prefab SheenRun {
  Sheen: {period: $sheen_run_period, rest: $sheen_run_rest, band: $sheen_run_band, strength: $sheen_run_strength, still: $sheen_still, ease: $sheen_run_ease, bands: 1, phase: 0, scatter: true, dark: $tone_sheen.dark, light: $tone_sheen.light}
}
prefab SheenEdit {
  Sheen: {period: $sheen_edit_period, rest: $sheen_edit_rest, band: $sheen_edit_band, strength: $sheen_edit_strength, still: $sheen_still, ease: $sheen_edit_ease, bands: 1, phase: 0, scatter: true, dark: $tone_sheen.dark, light: $tone_sheen.light}
}
prefab SheenRead {
  Sheen: {period: $sheen_read_period, rest: $sheen_read_rest, band: $sheen_read_band, strength: $sheen_read_strength, still: $sheen_still, ease: $sheen_read_ease, bands: 1, phase: 0, scatter: true, dark: $tone_sheen.dark, light: $tone_sheen.light}
}
prefab SheenAgent {
  Sheen: {period: $sheen_agent_period, rest: $sheen_agent_rest, band: $sheen_agent_band, strength: $sheen_agent_strength, still: $sheen_still, ease: $sheen_agent_ease, bands: $sheen_agent_bands, phase: 0, scatter: true, dark: $tone_sheen.dark, light: $tone_sheen.light}
}
prefab SheenRest {
  Sheen: {period: 0, rest: 0, band: 0, strength: 0, still: 0, ease: 0, bands: 1, phase: 0, scatter: false, dark: $tone_sheen.dark, light: $tone_sheen.light}
}

// A session's title: 13, a touch over regular, one line that gives way first (ui.Lead) when the row runs out of room.
// Renamed in place (cmd+R, src/app/chat/rename.rs), the host sets its TextEdit's caret and selection; at rest nothing.
prefab Head : ui.Lead {
  Fill: $tone_ink
  TextStyle: {size: $size_row, line: $line_row, role: 0, bold: 0, weight: $weight_tree}
  TextEdit: {caret: 0, anchor: 0, mark_lo: 0, mark_hi: 0, focused: false,
    caret_dark: $tone_ink_strong.dark, caret_light: $tone_ink_strong.light}
}

// A run's command under its session: 12, in the quieter run ink, cut with an ellipsis like a title.
prefab Cmd : ui.Lead {
  Fill: $tone_ink_muted
  TextStyle: {size: $size_run, line: 15, role: 0, bold: 0, weight: $weight_tree}
}

// The words trailing a row (how long ago, how long it took, how it went wrong; the shortcut on hover): 11 in the faint
// row ink, never giving way to the title.
prefab Trail : ui.Line {
  Fill: $tone_ink_faint
  LayoutPriority: {value: 1}
  TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
}
