// The window's fixed frame: the window row, the title-bar strip, the sidebar and its tree, the main card and its panes.

@tree ChildOf
hn {
  // The window, clear over the sidebar's vibrancy (src/window.rs): the sidebar full height beside the main card, which
  // runs to the window's top, right and bottom edges. The title-bar strip lies over both (hn.TitleBar).
  prefab Window : ui.Row {
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
    Flex: {axis: Row, gap: 0, align: Stretch, justify: Start, wrap: false}
    Padding: {l: 0, r: 0, t: 0, b: 0}
  }

  // The work bar: a hairline along the window's top edge with a band sweeping along it while the chat in front works
  // (Ghostty's progress bar; src/app.rs step_work_bar places the band by the track's padding). With an estimate
  // (the middle length of the turns already finished, once there are a few) the band is the turn's progress toward
  // it, filling from the left (the bar alone: no words say a time); with none, or once the turn has outrun it, the
  // band sweeps and says only that work is going on. A layer over the window, out of its
  // flow, taking no pointer.
  prefab WorkBar : ui.Column {
    Overlay
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    track : ui.Row {
      Flex: {axis: Row, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $work_bar_h, min: 0, max: 0}}
      Padding: {l: 0, r: 0, t: 0, b: 0}
      band : ui.Node {
        Fill: $tone_ink_muted
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
      }
    }
  }

  // The title-bar strip over the window, Ghostty's: as tall as AppKit's title bar. It shows no title: the traffic lights
  // sit on the sidebar's vibrancy and the main card runs to the window's top; only the back chevron lives here.
  // The host sets its height and left inset (src/app.rs lay_chrome).
  prefab TitleBar : ui.Row {
    Clip
    Flex: {axis: Row, gap: 8, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 16, t: 0, b: 0}
    // Back to the Archive (after an object was opened from it; cmd+[ too). Zero wide while there is nowhere to go back to.
    back : ui.Symbol {
      Pressable
      Action: {name: "nav:back"}
      Fill: $tone_ink_muted
      Size: {w: {kind: Fixed, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: $icon_box, min: 0, max: 0}}
    }
  }

  // The hairline between the sidebar and the main card: the only seam (no shadow; tone_sidebar is the main card's own
  // ground as a tint over the window's blur). It is the sidebar's right edge, inside hn.SideClip, so it folds away
  // with the sidebar (and the browser pane's, inside hn.WebClip).
  prefab Seam : ui.Node {
    Fill: $tone_line
    Size: {w: {kind: Fixed, value: 1, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
  }

  // The sidebar's fold (cmd+S), in the theme's sidebar ground (tone_sidebar: translucent, the one surface the window's
  // vibrancy shows through; its Fill is the whole sidebar's, from the traffic lights to its foot): a clip as wide as the fold's spring leaves the sidebar
  // and its seam, over the two laid out at their full width and slid left by the part folded away (src/app.rs
  // lay_chrome), so its rows never lay out at an in-between width. The host makes its children in order: the sidebar,
  // then its hn.Seam. Folded, the clip is 0 wide and cuts both away, so nothing of the sidebar paints and the main card,
  // whose left edge follows the clip's right edge, meets the window's.
  prefab SideClip : ui.Row {
    Clip
    Fill: $tone_sidebar
    Size: {w: {kind: Fixed, value: 248, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
    Flex: {axis: Row, gap: 0, align: Stretch, justify: Start, wrap: false}
    Padding: {l: 0, r: 0, t: 0, b: 0}
  }

  // The sidebar: the device, then its objects as a tree, clear over the vibrancy. Its top padding is the gap under the
  // title-bar strip; SafeAreaPadding adds the strip (the window's SafeAreaInset, set by the host in lay_chrome).
  // Its left margin is its children's (side_inset): the tree's clip runs to the sidebar's edge so a chevron can hang there.
  prefab Sidebar : ui.Column {
    Size: {w: {kind: Fixed, value: 248, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
    Flex: {axis: Column, gap: 2, align: Stretch, justify: Start, wrap: false}
    Padding: {l: 0, r: $side_inset, t: 4, b: 10}
    SafeAreaPadding: {l: false, r: false, t: true, b: false}
  }

  // The sidebar's tree: one row per object, kept by key (src/view.rs). It takes the sidebar's height left over by the
  // device row and the Archive pinned under it, and clips what does not fit: soft at an edge with more of it beyond
  // (ClipFade, from the ScrollState its physics writes, src/app/sidebar.rs), hard at an edge it ends at.
  prefab Tree : ui.Scroll {
    ClipFade: {len: $tree_fade_len}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Padding: {l: $side_inset, r: 0, t: 0, b: 0}
  }

  // The sidebar's foot (the Archive row), in from its left edge by the margin the tree pads itself with.
  prefab SideFoot : ui.Column {
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Padding: {l: $side_inset, r: 0, t: 0, b: 0}
  }

  // The sidebar's last row: the Archive button, the focused chat's status bar (hn.SideChat) and, at the end, how much of
  // the account's plan is used (`plan`: hn.ChatPlan, src/app/chat/plan.rs; src/app.rs sync_side_status).
  prefab SideStatus : ui.Row {
    Flex: {axis: Row, gap: $tree_gap, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
  }
  // The focused chat's status bar (src/app/chat.rs and chat/pick.rs keep each slot, each only while it has something to
  // say; empty with no chat in front): its model and effort (hn.ChatPick, its menu hanging from it), then at the end its
  // context ring (hn.ChatContext), breathing while its agent works. Here, out of the way, not under the composer.
  prefab SideChat : ui.Row {
    Cursor: {shape: Arrow}
    Flex: {axis: Row, gap: $chat_bar_gap, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    pick : ui.Row {
      Flex: {axis: Row, gap: 0, align: Center, justify: Start, wrap: false}
      Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: $chat_bar_h, min: 0, max: 0}}
    }
    spacer : ui.Spacer {}
    meter : ui.Row {
      Flex: {axis: Row, gap: 0, align: Center, justify: Start, wrap: false}
      Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    }
    // The picker's menu while it is open: out of the row's flow, its plate placed above the control.
    menu : ui.Node {
      Overlay
    }
    // The context meter's popover while the pointer is on the ring or on it (src/app/chat/context.rs).
    pop : ui.Node {
      Overlay
    }
  }
  prefab SidePlan : ui.Row {
    Flex: {axis: Row, gap: 0, align: Center, justify: End, wrap: false}
    Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
  }

  // Over the Archive row: why the link is refused (src/link.rs `Refused`: a daemon that never answered the hello, or
  // speaks another schema), naming its pid and socket and `harness stop`. No room and no words while it is not
  // (src/app.rs sync_view sets its height and text).
  prefab LinkNote : ui.Words {
    Fill: $tone_error
    TextStyle: {size: $size_caption, line: 15, role: 0, bold: 0}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: 0, min: 0, max: 0}}
    Padding: {l: $row_pad, r: $row_pad, t: 0, b: 8}
  }

  // The selected tree row's pill: a Background under the row (src/app.rs), its plate inset `pill_inset` from the row's
  // frame on every side so it hugs the row's content with air between neighbours. It is where the selection is at once:
  // no slide between rows (Finder's and Xcode's lists; a list clicked through all day reads a glide as lag). The row
  // picks the plate's Fill (tone_selection, or tone_selection_focus while the tree has the keyboard).
  prefab Selection : ui.Row {
    Background
    Flex: {axis: Row, gap: 0, align: Stretch, justify: Start, wrap: false}
    Padding: {l: $pill_inset, r: $pill_inset, t: $pill_inset, b: $pill_inset}
    plate : ui.Node {
      Fill: $tone_selection
      Shape: {radius: $radius_row, n: 4, border: 0, feather: 0}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
    }
  }

  // The ring round a tree row while its menu is open (src/app/row_menu.rs), Finder's: a Background on the selection pill's
  // frame, its plate clear inside a hairline, drawn over the pill (Z) when the row is selected too. The row sets the
  // hairline's ink (rows.flecs `menu`: tone_accent while its menu is open, clear else), so the part is always there and
  // nothing is made or removed as menus open and close.
  prefab RowMenuMark : ui.Row {
    Background
    Z: {z: 1}
    Flex: {axis: Row, gap: 0, align: Stretch, justify: Start, wrap: false}
    Padding: {l: $pill_inset, r: $pill_inset, t: $pill_inset, b: $pill_inset}
    plate : ui.Node {
      Fill: $tone_clear
      Edge: {dark: $tone_clear.dark, light: $tone_clear.light}
      Shape: {radius: $radius_row, n: 4, border: 1, feather: 0}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
    }
  }

  // Where a sidebar row's menu opens (src/app/row_menu.rs): a node of the window's out of its flow (Placed: layout keeps
  // the Laid the host gives it, the point the right press was), drawing nothing; the menu hangs from it while open.
  prefab RowMenuAt : ui.Node {
    Placed
    Size: {w: {kind: Fixed, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: 0, min: 0, max: 0}}
  }

  // A sidebar row's menu (src/app/row_menu.rs): ui.Menu's plate with its corner on the point (hn.RowMenuAt), there at once,
  // down from it (up when there is no room below, slid in from the screen's edge), its rows ui.MenuItem and ui.MenuSep.
  prefab RowMenu : ui.Menu {
    Side: {edge: Bottom, dx: 0, dy: 0}
  }

  // The main card: an opaque plate in the theme's ground from the window's top edge to its right and bottom edges (the
  // window's corners round it). Nothing sits over its top (no title); hn.Seam is the line between it and the sidebar. Inside it the panes sit side by side: one
  // per pane node (src/app/panes.rs), each `(Shows, object)` and made from the prefab its object's Kind picks. One today;
  // a split is a second node. Through a cmd+S fold the plate, its panes, their boxes and their words follow the spring:
  // prose re-wraps live at the width it has each frame, the glyphs a new break moves gliding to their places. Only what
  // cannot follow a moving box (a terminal's grid, which resizes its pty once) lays out at the width the fold rests at
  // (LaysAtRest on the pane; the sidebar's clip says which width, src/app.rs lay_chrome), riding its pane's leading edge.
  prefab Main : ui.Row, Plate {
    Fill: $tone_ground
    Edge: {dark: $tone_clear.dark, light: $tone_clear.light}
    Shape: {radius: 0, n: 4, border: 0, feather: 0}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
    Flex: {axis: Row, gap: 0, align: Stretch, justify: Start, wrap: false}
  }

  // A pane: clear on the card's terminal ground, no header (the title bar names what it shows).
  prefab Pane : ui.Column {
    PaneNode
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
  }

  // The terminal primitive: the host draws its grid into this node's rect (src/term.rs) from its own components
  // (TermGrid, TermCursor, TermSelection, TermScroll, MarkedText, TermFocus; src/pane.rs). Its cells are GPU instances,
  // not entities. Its overlay scroller is ui.Scroller's, fed by the host (ScrollFed: src/app/panes.rs sets ScrollExtent and
  // ScrollState from the scrollback's position in rows), shown while history scrolls and never on the alternate screen.
  prefab Terminal : ui.Node, ui.Scroller {
    TermNode
    ScrollFed
    ScrollState: {x: 0, y: 0}
    Fill: $tone_clear
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
  }

  // A session (Claude, Codex, Cursor, a shell): its terminal, the whole pane, on the terminal's own ground (the Ghostty
  // theme's, tone_term_ground), which the grid's default-coloured cells leave showing.
  prefab TermPane : hn.Pane {
    LaysAtRest
    Fill: $tone_term_ground
    term : hn.Terminal {}
  }

  // What the main card shows when nothing is selected (no chats yet): Kip, once the daemon's list is in (panes.rs sets
  // his Kip from hn.KipEmpty), over a quiet note naming the key that starts one.
  prefab EmptyPane : hn.Pane {
    Flex: {axis: Column, gap: 10, align: Center, justify: Center, wrap: false}
    kip : ui.Node {
      Hoverable
    }
    note : ui.Line, Faint {
      TextStyle: {size: $size_body, line: 16, role: 0, bold: 0}
    }
  }
  prefab KipEmpty {
    Kip: {mood: "wave then idle", size: $kip_empty, centre: true, settle: false}
  }

  // A run or a stage (Proc, Stage): its stages as rows (a pipeline's), then its output, stdout and stderr in the order
  // they were written, stderr tinted. The title bar names it (its id and command) and says how it stands; no heading here.
  // Its terminal's ground is the terminal's (tone_term_ground), as a TermPane's is.
  prefab RunPane : hn.Pane {
    LaysAtRest
    Fill: $tone_term_ground
    info : ui.Column {
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Flex: {axis: Column, gap: 3, align: Stretch, justify: Start, wrap: false}
      Padding: {l: 18, r: 18, t: 8, b: 0}
      stages : ui.List {
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      }
    }
    term : hn.Terminal {}
  }

  // A tree row's look, shared by every kind: pressable, a wash on hover and press, one row tall.
  // Its hover wash is inset as the selection's pill is (pill_inset), so the two hug the row alike.
  prefab TreeRowLook : ui.Row {
    Pressable
    Fill: $tone_clear
    Shape: {radius: $radius_row, n: 4, border: 0, feather: 0}
    HoverLook: {dark: $tone_hover.dark, light: $tone_hover.light, pad: 0 - $pill_inset, radius: $radius_row}
    Flex: {axis: Row, gap: $tree_gap, align: Center, justify: Start, wrap: false}
  }
}
