// The chat pane (src/app/chat.rs): a chat session's transcript over its agent's structured events, drawn as a chat, not
// a terminal. The transcript is a ui.LazyList (only the rows in view exist, each as tall as its words); the input a
// ui.field.GrowingTextArea on a soft plate at the foot, a quiet status line under it.

@tree ChildOf
hn {
  // The pane: the transcript scrolling over the card's ground, a column as wide as reads well; the input under it.
  prefab ChatPane : hn.Pane {
    // The chat's own page (tone_chat_ground), over the main card's terminal ground.
    Fill: $tone_chat_ground
    list : ui.Scroll {
      Cursor: {shape: Text}
      ClipFade: {len: $chat_fade_len}
      Flex: {axis: Column, gap: 0, align: Center, justify: Start, wrap: false}
      rows : ui.LazyList {
        LazyStack: {estimate: $chat_row_estimate, overscan: 600}
        Size: {w: {kind: Grow, value: 1, min: 0, max: $chat_w + 2 * $chat_pad}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Padding: {l: $chat_pad, r: $chat_pad, t: 12, b: 20}
      }
    }
    // The foot is opaque, in the card's own ground: the transcript ends at its top (thinning out under it), and nothing
    // drawn behind the pane shows under the input or its status line.
    foot : ui.Column {
      Fill: $tone_chat_ground
      Flex: {axis: Column, gap: $chat_foot_gap, align: Center, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: $chat_pad, r: $chat_pad, t: $chat_foot_pad_t, b: $chat_foot_pad_b}
      input : ui.Row {
        Fill: $tone_chat_input
        Edge: {dark: $tone_chat_input_edge.dark, light: $tone_chat_input_edge.light}
        Shape: {radius: $chat_input_radius, n: 4, border: 1, feather: 0}
        Cursor: {shape: Text}
        Pressable
        Action: {name: "chat:focus"}
        Flex: {axis: Row, gap: 0, align: Start, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: $chat_w}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Padding: {l: $chat_input_pad_x, r: $chat_input_pad_x, t: $chat_input_pad_y, b: $chat_input_pad_y}
        // Grows with its words to most of the pane, then scrolls (src/app/chat.rs steps its FieldScroll).
        area : ui.field.GrowingTextArea {
          GrowLimit: {share: $textarea_grow_share, keep: $chat_input_keep}
        }
      }
      status : ui.Row {
        Flex: {axis: Row, gap: $chat_status_gap, align: Center, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: $chat_w}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Padding: {l: $chat_input_pad_x, r: $chat_input_pad_x, t: 0, b: 0}
        // The model, the effort and the context meter (src/app/chat/pick.rs fills it: hn.ChatPick, hn.ChatPickWord,
        // hn.ChatPickMore, hn.ChatContext, each only while it has something to say).
        pick : ui.Row {
          Flex: {axis: Row, gap: $chat_pick_gap, align: Center, justify: Start, wrap: false}
          Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        }
        spacer : ui.Spacer {}
        // The agent's state as an icon (scene/widgets/chat_status.flecs: working, ended), its words its tooltip; it takes
        // the pointer so the tooltip shows.
        state : ui.Symbol {
          Hoverable
          Cursor: {shape: Arrow}
          Icon: {glyph: ""}
          Fill: $tone_chat_muted
          Size: {w: {kind: Fixed, value: $chat_status_icon, min: 0, max: 0}, h: {kind: Fixed, value: $chat_status_icon, min: 0, max: 0}}
        }
        // The picker's menu while it is open (a ui.Menu): out of the row's flow, its plate placed above what opened it.
        menu : ui.Node {
          Overlay
        }
        // The context meter's popover while the pointer is on the meter or on it (src/app/chat/context.rs).
        pop : ui.Node {
          Overlay
        }
      }
    }
  }

  // Den's model and effort picker under the composer (src/app/chat/pick.rs): the model's name in the ink, the effort's
  // word and a chevron muted, each its own control with no plate, its ink easing to the strong ink under the pointer
  // (pick.rs mixes hn.ChatPickInk's by the hover spring). The name opens the models, the word the efforts, the chevron
  // both; Command-/ opens the models and Shift-Command-/ steps the effort (scene/20-keys.flecs).
  prefab ChatPickBase : ui.Row {
    Pressable
    Action: {name: ""}
    Cursor: {shape: Arrow}
    Fill: $tone_clear
    Flex: {axis: Row, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: $chat_pick_h, min: 0, max: 0}}
  }
  // The model's control leads with its maker's mark (pick.rs `maker`: hn.Kind's claude, codex or cursor mark in its
  // tone), then the name.
  prefab ChatPick : hn.ChatPickBase {
    Tooltip: {text: "Select model  ⌘/"}
    Flex: {axis: Row, gap: $chat_pick_mark_gap, align: Center, justify: Center, wrap: false}
    icon : ui.Icon {
      Size: {w: {kind: Fixed, value: $chat_pick_mark, min: 0, max: 0}, h: {kind: Fixed, value: $chat_pick_mark, min: 0, max: 0}}
    }
    label : ui.Line {
      Fill: $tone_chat_ink
      TextStyle: {size: $size_chat_status, line: $line_chat_status, role: 0, bold: 0}
    }
  }
  prefab ChatPickWord : hn.ChatPickBase {
    Tooltip: {text: "Effort  ⇧⌘/"}
    label : ui.Line {
      Fill: $tone_chat_muted
      TextStyle: {size: $size_chat_status, line: $line_chat_status, role: 0, bold: 0}
    }
  }
  prefab ChatPickMore : hn.ChatPickBase {
    Tooltip: {text: "Model and effort"}
    icon : ui.Symbol {
      Icon: {glyph: ""}
      Fill: $tone_chat_muted
      Size: {w: {kind: Fixed, value: $chat_pick_chevron, min: 0, max: 0}, h: {kind: Fixed, value: $chat_pick_chevron, min: 0, max: 0}}
    }
  }
  // The picker's inks at rest (the name's, the effort's and the chevron's); under the pointer each eases to `name` at
  // full strength.
  prefab ChatPickInk {
    name { Fill: $tone_chat_ink }
    word { Fill: $tone_chat_muted }
  }
  // Its menu is a ui.Menu (prims.flecs) above what opened it: a head over each part when it shows both (the chevron's),
  // the current row ticked, a model's line about it muted at the end; where nothing can be chosen, a ui.MenuNote says
  // why.
  // The context meter (den's): a ring filling as the conversation fills its model's window, and the percentage; muted,
  // then hn.ChatContextTone's warn from 80% and full from 95% (pick.rs). Under the pointer, hn.ChatContextPop
  // (widgets/context.flecs) says what fills it.
  prefab ChatContext : ui.Row {
    Hoverable
    Cursor: {shape: Arrow}
    Flex: {axis: Row, gap: $chat_context_gap, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: $chat_pick_h, min: 0, max: 0}}
    Padding: {l: $chat_context_lead, r: 0, t: 0, b: 0}
    ring : ui.ZStack {
      Size: {w: {kind: Fixed, value: $chat_ring, min: 0, max: 0}, h: {kind: Fixed, value: $chat_ring, min: 0, max: 0}}
      track : ui.Node {
        Overlay
        Fill: $tone_clear
        Stroke: {dark: $tone_chat_faint.dark, light: $tone_chat_faint.light}
        Vector: {d: "M6 1 A5 5 0 1 1 6 11 A5 5 0 1 1 6 1", view_x: 0, view_y: 0, view_w: 12, view_h: 12, stroke_w: $chat_ring_stroke}
      }
      arc : ui.Node {
        Overlay
        Fill: $tone_clear
        Stroke: {dark: $tone_chat_muted.dark, light: $tone_chat_muted.light}
        Vector: {d: "M6 1 A5 5 0 0 1 6.5 1.03", view_x: 0, view_y: 0, view_w: 12, view_h: 12, stroke_w: $chat_ring_stroke}
      }
    }
    pct : ui.Line {
      Fill: $tone_chat_muted
      TextStyle: {size: $size_chat_status, line: $line_chat_status, role: 0, bold: 0}
    }
  }
  prefab ChatContextTone {
    ok { Fill: $tone_chat_muted }
    warn { Fill: $tone_lost }
    full { Fill: $tone_failed }
  }

  // What the person sent: their words in a bubble at the trailing edge, as wide as they are up to $chat_bubble_max_w,
  // wrapping past it (and past the row's room in a narrow pane).
  prefab ChatUser : ui.Row {
    Flex: {axis: Row, gap: 0, align: Start, justify: End, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_bubble_lead, r: 0, t: $chat_gap_turn - $chat_block_half, b: $chat_gap_reply - $chat_block_half}
    bubble : ui.Bubble {
      Fill: $tone_chat_bubble
      Padding: {l: $chat_bubble_pad_x, r: $chat_bubble_pad_x, t: $chat_bubble_pad_y, b: $chat_bubble_pad_y}
      Shape: {radius: $chat_bubble_radius, n: 4, border: 0, feather: 0}
      Size: {w: {kind: Fit, value: 0, min: 0, max: $chat_bubble_max_w}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      text : ui.Words {
        Cursor: {shape: Text}
        Fill: $tone_chat_ink
        TextStyle: {size: $size_chat, line: $line_chat_bubble, role: 0, bold: 0}
      }
    }
  }

  // A paragraph of the agent's words (inline markdown).
  prefab ChatProse : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: $chat_block_half, b: $chat_block_half}
    text : ui.Words {
      Fill: $tone_chat_ink
      MarkdownText: {chip_dark: $tone_chat_code.dark, chip_light: $tone_chat_code.light,
        link_dark: $tone_chat_link.dark, link_light: $tone_chat_link.light}
      TextStyle: {size: $size_chat, line: $line_chat, role: 0, bold: 0}
    }
  }

  // Headings, by level.
  prefab ChatH1 : hn.ChatProse {
    Padding: {l: 0, r: 0, t: 12, b: 4}
    text : ui.Words { TextStyle: {size: $size_chat_h1, line: 26, role: 0, bold: 1} }
  }
  prefab ChatH2 : hn.ChatProse {
    Padding: {l: 0, r: 0, t: 10, b: 2}
    text : ui.Words { TextStyle: {size: $size_chat_h2, line: 23, role: 0, bold: 1} }
  }
  prefab ChatH3 : hn.ChatProse {
    Padding: {l: 0, r: 0, t: 8, b: 2}
    text : ui.Words { TextStyle: {size: $size_chat_h3, line: $line_chat, role: 0, bold: 1} }
  }

  // A list item: its bullet or number in a fixed gutter, then its words; `indent` is its depth.
  prefab ChatItem : ui.Row {
    Flex: {axis: Row, gap: 0, align: Start, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 2, r: 0, t: 1, b: 3}
    indent : ui.Node {
      Size: {w: {kind: Fixed, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
    mark : ui.Words, Muted {
      Size: {w: {kind: Fixed, value: 22, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      TextStyle: {size: $size_chat, line: $line_chat, role: 0, bold: 0}
    }
    text : ui.Words {
      Fill: $tone_chat_ink
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      MarkdownText: {chip_dark: $tone_chat_code.dark, chip_light: $tone_chat_code.light,
        link_dark: $tone_chat_link.dark, link_light: $tone_chat_link.light}
      TextStyle: {size: $size_chat, line: $line_chat, role: 0, bold: 0}
    }
  }

  // A quote: a hairline at its leading edge, its words muted.
  prefab ChatQuote : ui.Row {
    Flex: {axis: Row, gap: 12, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 2, r: 0, t: $chat_block_half, b: $chat_block_half}
    bar : hn.Seam {}
    text : ui.Words {
      Fill: $tone_chat_muted
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      MarkdownText: {chip_dark: $tone_chat_code.dark, chip_light: $tone_chat_code.light,
        link_dark: $tone_chat_link.dark, link_light: $tone_chat_link.light}
      TextStyle: {size: $size_chat, line: $line_chat, role: 0, bold: 0}
    }
  }

  // A fenced code block on a card, in the code face (coloured by its language when blaze has its grammar).
  prefab ChatCode : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 4, b: 8}
    card : ui.Column {
      Fill: $tone_chat_card
      Edge: {dark: $tone_chat_line.dark, light: $tone_chat_line.light}
      Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
      Flex: {axis: Column, gap: 4, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: 12, r: 12, t: 9, b: 10}
      text : ui.Words {
        Fill: $tone_chat_ink
        TextStyle: {size: $size_code, line: $line_chat_code, role: 9, bold: 0}
      }
    }
  }

  // One line for every tool call, run of calls, step and thought (src/app/chat.rs fill_row), Claude Code's calm: its
  // words, its argument in the code face, a quiet detail ("exit 1", "2 failed"), all in the muted ink at the body size,
  // on one line, with no plate or border; an icon only where a status reads clearer as one (scene/widgets/chat_status.flecs:
  // a thought's sparkle, a call's running dot), its word in the line's tooltip. Under the pointer a soft wash and a small
  // chevron after its words (right folded, down open; src/app/chat.rs `line` turns it); pressed, it opens what it folds;
  // how long it took is its tooltip. A failure says so once: its words in the failed tone (a run's, its count).
  // Its words are spaced by the room after each (text draws at its node's leading edge), not the row's gap, so an argument
  // with nothing to say (src/app/chat.rs `line` folds it to nothing) leaves no gap behind.
  prefab ChatLineLook : ui.Row {
    Flex: {axis: Row, gap: 0, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $chat_tool_h, min: 0, max: 0}}
    Padding: {l: $chat_line_pad, r: 8, t: 0, b: 0}
    // A status icon leading its words (a thought's sparkle: scene/widgets/chat_status.flecs), its words the line's
    // tooltip; src/app/chat.rs `status_on` folds it to nothing on a line without one.
    glyph : ui.Symbol {
      Icon: {glyph: ""}
      Fill: $tone_chat_muted
      Size: {w: {kind: Fixed, value: $chat_line_status, min: 0, max: 0}, h: {kind: Fixed, value: $chat_line_status, min: 0, max: 0}}
    }
    words : ui.Line {
      Fill: $tone_chat_muted
      LayoutPriority: {value: 1}
      Padding: {l: 0, r: $chat_line_word_gap, t: 0, b: 0}
      TextStyle: {size: $size_body, line: 16, role: 0, bold: 0}
    }
    arg : ui.Lead {
      Fill: $tone_chat_muted
      Padding: {l: 0, r: $chat_line_word_gap, t: 0, b: 0}
      TextStyle: {size: $size_code, line: 16, role: 9, bold: 0}
    }
    detail : ui.Line {
      Fill: $tone_chat_muted
      LayoutPriority: {value: 2}
      Padding: {l: 0, r: $chat_line_word_gap, t: 0, b: 0}
      TextStyle: {size: $size_body, line: 16, role: 0, bold: 0}
    }
    // A status icon after its words (a call still running, one with no result), its words the line's tooltip; folded to
    // nothing on a line without one, as the glyph is.
    state : ui.Symbol {
      Icon: {glyph: ""}
      Fill: $tone_chat_muted
      Size: {w: {kind: Fixed, value: $chat_line_status, min: 0, max: 0}, h: {kind: Fixed, value: $chat_line_status, min: 0, max: 0}}
    }
    // Shown while its line is hovered (the nearest ancestor with a hover look: a step has none, so never).
    chevron : ui.Symbol {
      Fill: $tone_chat_muted
      HoverShow: {row: 0, keep: false}
      Size: {w: {kind: Fixed, value: $chat_line_chevron, min: 0, max: 0}, h: {kind: Fixed, value: $chat_line_chevron, min: 0, max: 0}}
    }
    spacer : ui.Spacer {}
  }

  // The faint guide down the left of what a line opened (its output, its table, its steps, its words, a run's calls):
  // laid to its row's frame behind it, a hairline at chat_guide_x, so the rows under one line join into one guide.
  prefab ChatGuide : ui.Row {
    Background
    Flex: {axis: Row, gap: 0, align: Stretch, justify: Start, wrap: false}
    Padding: {l: $chat_guide_x, r: 0, t: 0, b: 0}
    line : ui.Node {
      Fill: $tone_chat_guide
      Size: {w: {kind: Fixed, value: $chat_guide_w, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
    }
  }
  // A line row's own guide, clear unless the row is one of an opened run's calls (src/app/chat.rs fills it then).
  prefab ChatGuideOff : hn.ChatGuide {
    line : ui.Node { Fill: $tone_clear }
  }
  // Pressable, it hugs its words and chevron (its wash a highlight on them, never a full-width plate).
  prefab ChatLine : hn.ChatLineLook {
    Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: $chat_tool_h, min: 0, max: 0}}
    AlignSelf: {align: Start}
    Padding: {l: $chat_line_pad, r: $chat_line_pad, t: 0, b: 0}
    Pressable
    Action: {name: ""}
    Cursor: {shape: Arrow}
    Fill: $tone_clear
    Shape: {radius: $radius_control, n: 4, border: 0, feather: 0}
    HoverLook: {dark: $tone_wash_hover.dark, light: $tone_wash_hover.light, pad: 0, radius: -1}
    PressLook: {dark: $tone_wash_press.dark, light: $tone_wash_press.light}
  }

  // A tool call folded to its line (an agent's own tool: its name and main argument; a harness REPL cell: what it did in
  // words, never its code). Folded is how every call starts, a failed one too: its one red line opens on a press.
  prefab ChatTool : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 1, b: 1}
    guide : hn.ChatGuideOff {}
    head : hn.ChatLine {}
  }
  // Failed: its words in the failed tone.
  prefab ChatToolFailed : hn.ChatTool {
    head : hn.ChatLine {
      words : ui.Line { Fill: $tone_failed }
    }
  }

  // An agent's tool call opened: its line, then its input and its result on a card under its words.
  prefab ChatToolOpen : hn.ChatTool {
    Padding: {l: 0, r: 0, t: 1, b: 8}
    body : ui.Column {
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: $chat_line_inset, r: 0, t: 2, b: 0}
      guide : hn.ChatGuide {}
      card : ui.Column {
        Fill: $tone_chat_card
        Edge: {dark: $tone_chat_line.dark, light: $tone_chat_line.light}
        Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
        Flex: {axis: Column, gap: 8, align: Stretch, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Padding: {l: 12, r: 12, t: 9, b: 10}
        input : ui.Words {
          Fill: $tone_chat_muted
          TextStyle: {size: $size_code, line: $line_chat_code, role: 9, bold: 0}
        }
        result : ui.Words {
          Fill: $tone_chat_ink
          TextStyle: {size: $size_code, line: $line_chat_code, role: 9, bold: 0}
        }
      }
    }
  }
  prefab ChatToolOpenFailed : hn.ChatToolOpen {
    head : hn.ChatLine {
      words : ui.Line { Fill: $tone_failed }
    }
  }

  // A harness REPL cell (src/app/chat.rs card_rows) and a run of calls with no words between them ("Read 2 files, ran 1
  // shell command", rows_nested): the same line. A run with failures says how many in its detail, the one red thing on
  // it, and lists each failed call under it as its own red line. A run's calls sit in from it by $chat_nest, on its guide.
  prefab ChatCard : hn.ChatTool {}
  prefab ChatCardFailed : hn.ChatToolFailed {}
  prefab ChatRun : hn.ChatTool {}
  prefab ChatRunFailed : hn.ChatTool {
    head : hn.ChatLine {
      detail : ui.Line { Fill: $tone_failed }
    }
  }
  prefab ChatNest : ui.Node {
    Padding: {l: $chat_nest, r: 0, t: 0, b: 0}
  }

  // One step of an opened cell that took several: the same line, not pressable, under the cell's words.
  prefab ChatStep : hn.ChatLineLook {
    Padding: {l: $chat_line_inset, r: 8, t: 0, b: 0}
    guide : hn.ChatGuide {}
  }
  prefab ChatStepFailed : hn.ChatStep {
    words : ui.Line { Fill: $tone_failed }
  }

  // The chat's look of a ui.Table (harness_native_ui_view::table with look "hn.ChatTable"): the ui.Table* cells in the
  // terminal ground's inks: words and numbers in its ink, nulls, the index and the header muted, links in the accent.
  prefab ChatTableCell : ui.TableCell {
    text : ui.Line { Fill: $tone_chat_ink }
  }
  prefab ChatTableCellMd : ui.TableCellMd {
    text : ui.Line { Fill: $tone_chat_ink }
  }
  prefab ChatTableCellCode : ui.TableCellCode {
    text : ui.Line { Fill: $tone_chat_ink }
  }
  prefab ChatTableCellNum : ui.TableCellNum {
    text : ui.Line { Fill: $tone_chat_ink }
  }
  prefab ChatTableCellDim : ui.TableCellDim {
    text : ui.Line { Fill: $tone_chat_muted }
  }
  prefab ChatTableCellLink : ui.TableCellLink {}
  prefab ChatTableCellMark : ui.TableCellMark {
    text : ui.Line { Fill: $tone_chat_muted }
  }
  prefab ChatTableHead : ui.TableHead {
    text : ui.Line { Fill: $tone_chat_muted }
  }
  prefab ChatTableField : ui.TableField {
    key : ui.Line { Fill: $tone_chat_muted }
    value : ui.Words { Fill: $tone_chat_ink }
  }
  prefab ChatTableFieldMd : ui.TableFieldMd {
    key : ui.Line { Fill: $tone_chat_muted }
    value : ui.Words { Fill: $tone_chat_ink }
  }

  // A markdown table in the agent's words (src/app/chat.rs Row::Table): a ui.Table on a card's plate, its cells inline
  // markdown, aligned as its delimiter line says.
  prefab ChatTable : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 4, b: 8}
    card : ui.Column {
      Clip
      Fill: $tone_chat_card
      Edge: {dark: $tone_chat_line.dark, light: $tone_chat_line.light}
      Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: 4, r: 4, t: 2, b: 4}
      grid : ui.Table {}
    }
  }

  // Search results a cell gave (the kernel tags them `kind: "search"`): a ui.ResultList, not a table.
  prefab ChatResult : ui.Result {
    host : ui.Line { Fill: $tone_chat_muted }
    snippet : ui.Words { Fill: $tone_chat_ink }
  }
  prefab ChatResults : ui.Column {
    Flex: {axis: Column, gap: 3, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_line_inset, r: 0, t: 4, b: 8}
    guide : hn.ChatGuide {}
    list : ui.ResultList {}
    foot : ui.Line, Faint {
      Padding: {l: 0, r: 0, t: 4, b: 0}
      TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
    }
  }

  // A table, record or list a cell gave, as a ui.Table on the card's plate (src/app/chat.rs fill_grid), and a foot saying
  // how many rows there are when not all show.
  prefab ChatGrid : ui.Column {
    Flex: {axis: Column, gap: 3, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_line_inset, r: 0, t: 2, b: 6}
    guide : hn.ChatGuide {}
    card : ui.Column {
      Clip
      Fill: $tone_chat_card
      Edge: {dark: $tone_chat_line.dark, light: $tone_chat_line.light}
      Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: 4, r: 4, t: 2, b: 4}
      grid : ui.Table {}
    }
    foot : ui.Line, Faint {
      Padding: {l: 4, r: 0, t: 0, b: 0}
      TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
    }
  }

  // Text a cell printed or returned (a command's output, a string), in the code face on the card's plate; an error's
  // stack in the failed tone.
  prefab ChatOutput : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_line_inset, r: 0, t: 2, b: 6}
    guide : hn.ChatGuide {}
    card : ui.Column {
      Fill: $tone_chat_card
      Edge: {dark: $tone_chat_line.dark, light: $tone_chat_line.light}
      Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: 10, r: 10, t: 7, b: 8}
      text : ui.Words {
        Fill: $tone_chat_ink
        TextStyle: {size: $size_code, line: $line_chat_code, role: 9, bold: 0}
      }
    }
  }
  prefab ChatOutputError : hn.ChatOutput {
    card : ui.Column {
      text : ui.Words { Fill: $tone_failed }
    }
  }

  // "Show code" under an opened cell: quiet words under its words; pressed, the cell's code (a hn.ChatCode row) shows.
  prefab ChatCodeToggle : ui.Column {
    Flex: {axis: Column, gap: 0, align: Start, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_line_inset - $chat_line_pad, r: 0, t: 0, b: 2}
    guide : hn.ChatGuide {}
    head : ui.Row {
      Pressable
      Action: {name: ""}
      Cursor: {shape: Arrow}
      Fill: $tone_clear
      Shape: {radius: $radius_control, n: 4, border: 0, feather: 0}
      HoverLook: {dark: $tone_wash_hover.dark, light: $tone_wash_hover.light, pad: 0, radius: -1}
      PressLook: {dark: $tone_wash_press.dark, light: $tone_wash_press.light}
      Flex: {axis: Row, gap: 0, align: Center, justify: Start, wrap: false}
      Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: 22, min: 0, max: 0}}
      Padding: {l: $chat_line_pad, r: 6, t: 0, b: 0}
      words : ui.Line {
        Fill: $tone_chat_muted
        TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
      }
    }
  }

  // The agent's reasoning, folded to one line: a sparkle (hn.chat_status.thinking, breathing while it thinks; thought,
  // still once done), its word the tooltip; pressed, it opens to its words.
  prefab ChatThinking : ui.Column {
    Flex: {axis: Column, gap: 2, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 1, b: 1}
    guide : hn.ChatGuideOff {}
    head : hn.ChatLine {}
  }
  prefab ChatThinkingOpen : hn.ChatThinking {
    Padding: {l: 0, r: 0, t: 1, b: 8}
    body : ui.Column {
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: $chat_line_inset, r: 0, t: 0, b: 0}
      guide : hn.ChatGuide {}
      text : ui.Words {
        Fill: $tone_chat_muted
        TextStyle: {size: $size_body, line: 19, role: 0, bold: 0}
      }
    }
  }

  // Something said about the conversation (it was interrupted), quiet and centred; an error in the failed tone.
  prefab ChatNote : ui.Row {
    Flex: {axis: Row, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 6, b: 6}
    text : ui.Words, Faint {
      TextStyle: {size: $size_caption, line: 15, role: 0, bold: 0}
    }
  }
  prefab ChatError : ui.Row {
    Flex: {axis: Row, gap: 0, align: Start, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: $chat_block_half, b: $chat_block_half}
    text : ui.Words {
      Fill: $tone_failed
      TextStyle: {size: $size_body, line: 19, role: 0, bold: 0}
    }
  }
}
