// The chat pane (src/app/chat.rs): a chat session's transcript over its agent's structured events, drawn as a chat, not
// a terminal. The transcript is a ui.LazyList (only the rows in view exist, each as tall as its words); the input a
// ui.TextArea on a soft plate at the foot, a quiet status line under it.

@tree ChildOf
hn {
  // The pane: the transcript scrolling over the card's ground, a column as wide as reads well; the input under it.
  prefab ChatPane : hn.Pane {
    list : ui.Scroll {
      Cursor: {shape: Text}
      ClipFade: {len: $chat_fade_len}
      Flex: {axis: Column, gap: 0, align: Center, justify: Start, wrap: false}
      rows : ui.LazyList {
        LazyStack: {estimate: $chat_row_estimate, overscan: 600}
        Size: {w: {kind: Grow, value: 1, min: 0, max: $chat_w + 2 * $chat_pad}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Padding: {l: $chat_pad, r: $chat_pad, t: 12, b: 20}
      }
    }
    // The foot is opaque, in the card's own ground: the transcript ends at its top (thinning out under it), and nothing
    // drawn behind the pane shows under the input or its status line.
    foot : ui.Column {
      Fill: $tone_term_ground
      Flex: {axis: Column, gap: 6, align: Center, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: $chat_pad, r: $chat_pad, t: 4, b: 12}
      input : ui.Row {
        Fill: $tone_chat_input
        Edge: {dark: $tone_plate_line.dark, light: $tone_plate_line.light}
        Shape: {radius: $chat_input_radius, n: 4, border: 1, feather: 0}
        Cursor: {shape: Text}
        Pressable
        Action: {name: "chat:focus"}
        Flex: {axis: Row, gap: 0, align: Start, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: $chat_w}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Padding: {l: $chat_input_pad_x, r: $chat_input_pad_x, t: $chat_input_pad_y, b: $chat_input_pad_y}
        area : ui.TextArea {}
      }
      status : ui.Row {
        Flex: {axis: Row, gap: 8, align: Center, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: $chat_w}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Padding: {l: $chat_input_pad_x, r: $chat_input_pad_x, t: 0, b: 0}
        model : ui.Line, Faint {
          TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
        }
        spacer : ui.Spacer {}
        state : ui.Line, Faint {
          TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
        }
      }
    }
  }

  // What the person sent: their words in a bubble at the trailing edge, as wide as they are up to $chat_bubble_max_w,
  // wrapping past it (and past the row's room in a narrow pane).
  prefab ChatUser : ui.Row {
    Flex: {axis: Row, gap: 0, align: Start, justify: End, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_bubble_lead, r: 0, t: $chat_gap_turn - $chat_block_half, b: $chat_gap_reply - $chat_block_half}
    bubble : ui.Bubble {
      Fill: $tone_chat_bubble
      Padding: {l: $chat_bubble_pad_x, r: $chat_bubble_pad_x, t: $chat_bubble_pad_y, b: $chat_bubble_pad_y}
      Shape: {radius: $chat_bubble_radius, n: 4, border: 0, feather: 0}
      Size: {w: {kind: Fit, value: 0, min: 0, max: $chat_bubble_max_w}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      text : ui.Words {
        Cursor: {shape: Text}
        Fill: $tone_term_ink
        TextStyle: {size: $size_chat, line: $line_chat_bubble, role: 0, bold: 0}
      }
    }
  }

  // A paragraph of the agent's words (inline markdown).
  prefab ChatProse : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: $chat_block_half, b: $chat_block_half}
    text : ui.Words {
      Fill: $tone_term_ink
      MarkdownText: {chip_dark: $tone_code_chip.dark, chip_light: $tone_code_chip.light,
        link_dark: $tone_accent.dark, link_light: $tone_accent.light}
      TextStyle: {size: $size_chat, line: $line_chat, role: 0, bold: 0}
    }
  }

  // Headings, by level.
  prefab ChatH1 : hn.ChatProse {
    Padding: {l: 0, r: 0, t: 12, b: 4}
    text : ui.Words { TextStyle: {size: $size_chat_h1, line: 26, role: 0, bold: 1} }
  }
  prefab ChatH2 : hn.ChatProse {
    Padding: {l: 0, r: 0, t: 10, b: 2}
    text : ui.Words { TextStyle: {size: $size_chat_h2, line: 23, role: 0, bold: 1} }
  }
  prefab ChatH3 : hn.ChatProse {
    Padding: {l: 0, r: 0, t: 8, b: 2}
    text : ui.Words { TextStyle: {size: $size_chat_h3, line: $line_chat, role: 0, bold: 1} }
  }

  // A list item: its bullet or number in a fixed gutter, then its words; `indent` is its depth.
  prefab ChatItem : ui.Row {
    Flex: {axis: Row, gap: 0, align: Start, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 2, r: 0, t: 1, b: 3}
    indent : ui.Node {
      Size: {w: {kind: Fixed, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
    mark : ui.Words, Muted {
      Size: {w: {kind: Fixed, value: 22, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      TextStyle: {size: $size_chat, line: $line_chat, role: 0, bold: 0}
    }
    text : ui.Words {
      Fill: $tone_term_ink
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      MarkdownText: {chip_dark: $tone_code_chip.dark, chip_light: $tone_code_chip.light,
        link_dark: $tone_accent.dark, link_light: $tone_accent.light}
      TextStyle: {size: $size_chat, line: $line_chat, role: 0, bold: 0}
    }
  }

  // A quote: a hairline at its leading edge, its words muted.
  prefab ChatQuote : ui.Row {
    Flex: {axis: Row, gap: 12, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 2, r: 0, t: $chat_block_half, b: $chat_block_half}
    bar : hn.Seam {}
    text : ui.Words {
      Fill: $tone_term_muted
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      MarkdownText: {chip_dark: $tone_code_chip.dark, chip_light: $tone_code_chip.light,
        link_dark: $tone_accent.dark, link_light: $tone_accent.light}
      TextStyle: {size: $size_chat, line: $line_chat, role: 0, bold: 0}
    }
  }

  // A fenced code block on a card, in the code face (coloured by its language when blaze has its grammar).
  prefab ChatCode : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 4, b: 8}
    card : ui.Column {
      Fill: $tone_chat_card
      Edge: {dark: $tone_plate_line.dark, light: $tone_plate_line.light}
      Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
      Flex: {axis: Column, gap: 4, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: 12, r: 12, t: 9, b: 10}
      text : ui.Words {
        Fill: $tone_term_ink
        TextStyle: {size: $size_code, line: $line_chat_code, role: 9, bold: 0}
      }
    }
  }

  // One line for every tool call, run of calls, step and thought (src/app/chat.rs fill_row), Claude Code's calm: a small
  // icon, its words, its argument in the code face, a quiet detail ("exit 1", "2 failed"), all in the muted ink at one
  // weight, on one line. No chevron and no timing: pressed, it opens what it folds; how long it took is its tooltip. A
  // failure says so once: its words in the failed tone (a run's, its count), never its icon too.
  // Its words are spaced by the room after each (text draws at its node's leading edge), not the row's gap, so an argument
  // with nothing to say (src/app/chat.rs `line` folds it to nothing) leaves no gap behind.
  prefab ChatLineLook : ui.Row {
    Flex: {axis: Row, gap: 0, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $chat_tool_h, min: 0, max: 0}}
    Padding: {l: $chat_line_pad, r: 8, t: 0, b: 0}
    icon : ui.Symbol {
      Fill: $tone_term_muted
      Size: {w: {kind: Fixed, value: $chat_line_icon, min: 0, max: 0}, h: {kind: Fixed, value: $chat_line_icon, min: 0, max: 0}}
    }
    lead : ui.Node {
      Size: {w: {kind: Fixed, value: $chat_line_gap, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
    words : ui.Line {
      Fill: $tone_term_muted
      LayoutPriority: {value: 1}
      Padding: {l: 0, r: $chat_line_word_gap, t: 0, b: 0}
      TextStyle: {size: $size_body, line: 16, role: 0, bold: 0}
    }
    arg : ui.Lead {
      Fill: $tone_term_muted
      Padding: {l: 0, r: $chat_line_word_gap, t: 0, b: 0}
      TextStyle: {size: $size_code, line: 16, role: 9, bold: 0}
    }
    detail : ui.Line {
      Fill: $tone_term_muted
      LayoutPriority: {value: 2}
      TextStyle: {size: $size_body, line: 16, role: 0, bold: 0}
    }
    spacer : ui.Spacer {}
  }
  prefab ChatLine : hn.ChatLineLook {
    Pressable
    Action: {name: ""}
    Cursor: {shape: Arrow}
    Fill: $tone_clear
    Shape: {radius: $radius_control, n: 4, border: 0, feather: 0}
    HoverLook: {dark: $tone_wash_hover.dark, light: $tone_wash_hover.light, pad: 0, radius: -1}
    PressLook: {dark: $tone_wash_press.dark, light: $tone_wash_press.light}
  }

  // A tool call folded to its line (an agent's own tool: its name and main argument; a harness REPL cell: what it did in
  // words, never its code). Folded is how every call starts, a failed one too: its one red line opens on a press.
  prefab ChatTool : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 1, b: 1}
    head : hn.ChatLine {}
  }
  // Failed: its words in the failed tone.
  prefab ChatToolFailed : hn.ChatTool {
    head : hn.ChatLine {
      words : ui.Line { Fill: $tone_failed }
    }
  }

  // An agent's tool call opened: its line, then its input and its result on a card under its words.
  prefab ChatToolOpen : hn.ChatTool {
    Padding: {l: 0, r: 0, t: 1, b: 8}
    body : ui.Column {
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: $chat_line_inset, r: 0, t: 2, b: 0}
      card : ui.Column {
        Fill: $tone_chat_card
        Edge: {dark: $tone_plate_line.dark, light: $tone_plate_line.light}
        Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
        Flex: {axis: Column, gap: 8, align: Stretch, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Padding: {l: 12, r: 12, t: 9, b: 10}
        input : ui.Words {
          Fill: $tone_term_muted
          TextStyle: {size: $size_code, line: $line_chat_code, role: 9, bold: 0}
        }
        result : ui.Words {
          Fill: $tone_term_ink
          TextStyle: {size: $size_code, line: $line_chat_code, role: 9, bold: 0}
        }
      }
    }
  }
  prefab ChatToolOpenFailed : hn.ChatToolOpen {
    head : hn.ChatLine {
      words : ui.Line { Fill: $tone_failed }
    }
  }

  // A harness REPL cell (src/app/chat.rs card_rows) and a run of calls with no words between them ("Read 2 files, ran 1
  // shell command", rows_nested): the same line. A run with failures says how many in its detail, the one red thing on
  // it, and lists each failed call under it as its own red line. A run's calls sit in from it by $chat_nest.
  prefab ChatCard : hn.ChatTool {}
  prefab ChatCardFailed : hn.ChatToolFailed {}
  prefab ChatRun : hn.ChatTool {}
  prefab ChatRunFailed : hn.ChatTool {
    head : hn.ChatLine {
      detail : ui.Line { Fill: $tone_failed }
    }
  }
  prefab ChatNest : ui.Node {
    Padding: {l: $chat_nest, r: 0, t: 0, b: 0}
  }

  // One step of an opened cell that took several: the same line, not pressable, under the cell's words.
  prefab ChatStep : hn.ChatLineLook {
    Padding: {l: $chat_nest + $chat_line_pad, r: 8, t: 0, b: 0}
  }
  prefab ChatStepFailed : hn.ChatStep {
    words : ui.Line { Fill: $tone_failed }
  }

  // The chat's look of a ui.Table (harness_native_ui_view::table with look "hn.ChatTable"): the ui.Table* cells in the
  // terminal ground's inks: words and numbers in its ink, nulls, the index and the header muted, links in the accent.
  prefab ChatTableCell : ui.TableCell {
    text : ui.Line { Fill: $tone_term_ink }
  }
  prefab ChatTableCellMd : ui.TableCellMd {
    text : ui.Line { Fill: $tone_term_ink }
  }
  prefab ChatTableCellCode : ui.TableCellCode {
    text : ui.Line { Fill: $tone_term_ink }
  }
  prefab ChatTableCellNum : ui.TableCellNum {
    text : ui.Line { Fill: $tone_term_ink }
  }
  prefab ChatTableCellDim : ui.TableCellDim {
    text : ui.Line { Fill: $tone_term_muted }
  }
  prefab ChatTableCellLink : ui.TableCellLink {}
  prefab ChatTableCellMark : ui.TableCellMark {
    text : ui.Line { Fill: $tone_term_muted }
  }
  prefab ChatTableHead : ui.TableHead {
    text : ui.Line { Fill: $tone_term_muted }
  }
  prefab ChatTableField : ui.TableField {
    key : ui.Line { Fill: $tone_term_muted }
    value : ui.Words { Fill: $tone_term_ink }
  }
  prefab ChatTableFieldMd : ui.TableFieldMd {
    key : ui.Line { Fill: $tone_term_muted }
    value : ui.Words { Fill: $tone_term_ink }
  }

  // A markdown table in the agent's words (src/app/chat.rs Row::Table): a ui.Table on a card's plate, its cells inline
  // markdown, aligned as its delimiter line says.
  prefab ChatTable : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 4, b: 8}
    card : ui.Column {
      Clip
      Fill: $tone_chat_card
      Edge: {dark: $tone_plate_line.dark, light: $tone_plate_line.light}
      Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: 4, r: 4, t: 2, b: 4}
      grid : ui.Table {}
    }
  }

  // Search results a cell gave (the kernel tags them `kind: "search"`): a ui.ResultList, not a table.
  prefab ChatResult : ui.Result {
    host : ui.Line { Fill: $tone_term_muted }
    snippet : ui.Words { Fill: $tone_term_ink }
  }
  prefab ChatResults : ui.Column {
    Flex: {axis: Column, gap: 3, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_line_inset, r: 0, t: 4, b: 8}
    list : ui.ResultList {}
    foot : ui.Line, Faint {
      Padding: {l: 0, r: 0, t: 4, b: 0}
      TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
    }
  }

  // A table, record or list a cell gave, as a ui.Table on the card's plate (src/app/chat.rs fill_grid), and a foot saying
  // how many rows there are when not all show.
  prefab ChatGrid : ui.Column {
    Flex: {axis: Column, gap: 3, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_line_inset, r: 0, t: 2, b: 6}
    card : ui.Column {
      Clip
      Fill: $tone_chat_card
      Edge: {dark: $tone_plate_line.dark, light: $tone_plate_line.light}
      Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: 4, r: 4, t: 2, b: 4}
      grid : ui.Table {}
    }
    foot : ui.Line, Faint {
      Padding: {l: 4, r: 0, t: 0, b: 0}
      TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
    }
  }

  // Text a cell printed or returned (a command's output, a string), in the code face on the card's plate; an error's
  // stack in the failed tone.
  prefab ChatOutput : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_line_inset, r: 0, t: 2, b: 6}
    card : ui.Column {
      Fill: $tone_chat_card
      Edge: {dark: $tone_plate_line.dark, light: $tone_plate_line.light}
      Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: 10, r: 10, t: 7, b: 8}
      text : ui.Words {
        Fill: $tone_term_ink
        TextStyle: {size: $size_code, line: $line_chat_code, role: 9, bold: 0}
      }
    }
  }
  prefab ChatOutputError : hn.ChatOutput {
    card : ui.Column {
      text : ui.Words { Fill: $tone_failed }
    }
  }

  // "Show code" under an opened cell: quiet words under its words; pressed, the cell's code (a hn.ChatCode row) shows.
  prefab ChatCodeToggle : ui.Column {
    Flex: {axis: Column, gap: 0, align: Start, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_line_inset - $chat_line_pad, r: 0, t: 0, b: 2}
    head : ui.Row {
      Pressable
      Action: {name: ""}
      Cursor: {shape: Arrow}
      Fill: $tone_clear
      Shape: {radius: $radius_control, n: 4, border: 0, feather: 0}
      HoverLook: {dark: $tone_wash_hover.dark, light: $tone_wash_hover.light, pad: 0, radius: -1}
      PressLook: {dark: $tone_wash_press.dark, light: $tone_wash_press.light}
      Flex: {axis: Row, gap: 0, align: Center, justify: Start, wrap: false}
      Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: 22, min: 0, max: 0}}
      Padding: {l: $chat_line_pad, r: 6, t: 0, b: 0}
      words : ui.Line {
        Fill: $tone_term_muted
        TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
      }
    }
  }

  // The agent's reasoning, folded to one line ("Thought" and its first words); pressed, it opens to its words.
  prefab ChatThinking : ui.Column {
    Flex: {axis: Column, gap: 2, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 1, b: 1}
    head : hn.ChatLine {}
  }
  prefab ChatThinkingOpen : hn.ChatThinking {
    Padding: {l: 0, r: 0, t: 1, b: 8}
    text : ui.Words {
      Fill: $tone_term_muted
      Padding: {l: $chat_line_inset, r: 0, t: 0, b: 0}
      TextStyle: {size: $size_body, line: 19, role: 0, bold: 0}
    }
  }

  // Something said about the conversation (it was interrupted), quiet and centred; an error in the failed tone.
  prefab ChatNote : ui.Row {
    Flex: {axis: Row, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 6, b: 6}
    text : ui.Words, Faint {
      TextStyle: {size: $size_caption, line: 15, role: 0, bold: 0}
    }
  }
  prefab ChatError : ui.Row {
    Flex: {axis: Row, gap: 0, align: Start, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: $chat_block_half, b: $chat_block_half}
    text : ui.Words {
      Fill: $tone_failed
      TextStyle: {size: $size_body, line: 19, role: 0, bold: 0}
    }
  }
}
