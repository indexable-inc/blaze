// The chat pane (src/app/chat.rs): a chat session's transcript over its agent's structured events, drawn as a chat, not
// a terminal. The transcript is a ui.LazyList (only the rows in view exist, each as tall as its words); at the foot the
// composer, one card holding only what composes (a ui.field.GrowingTextArea and the pictures pasted into it), and under it
// the chat's status bar (model and effort, context, how much of the plan is used).

@tree ChildOf
hn {
  // The pane: the transcript scrolling over the card's ground, a column as wide as reads well; the input under it.
  prefab ChatPane : hn.Pane {
    // The chat's page: the theme's ground (tone_ground), the main card's own.
    Fill: $tone_ground
    // A chat nothing was sent in yet shows a lit lantern (src/app/chat.rs turns it on); the first message puts it out.
    lantern : ui.Lamp {}
    // Through a cmd+S fold the transcript's column and the composer follow the moving pane, centred in it, and their
    // words re-wrap live at the width they have each frame (the glyphs a new break moves glide there), the row at the
    // top of the view held still (src/app/chat.rs).
    list : ui.Scroll {
      Cursor: {shape: Text}
      ClipFade: {len: $chat_fade_len}
      // The conversation stands on the composer: a short one sits at the foot of the pane, new words coming in from the
      // bottom, and what is older rises and fades out at the top (a game's chat).
      Flex: {axis: Column, gap: 0, align: Center, justify: End, wrap: false}
      rows : ui.LazyList {
        LazyStack: {estimate: $chat_row_estimate, overscan: 600}
        Size: {w: {kind: Grow, value: 1, min: 0, max: $chat_w + 2 * $chat_pad}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Padding: {l: $chat_pad, r: $chat_pad, t: 12, b: 20}
      }
    }
    // A chip's hover card while the pointer rests on it (src/app/chat/peek.rs): the anchor laid over the chip and the
    // card (scene/widgets/peek.flecs), out of the flow, over the transcript.
    peek : ui.Node {
      Overlay
    }
    // The foot is opaque, in the page's own ground: the transcript ends at its top (thinning out under it), and nothing
    // drawn behind the pane shows around the composer.
    foot : ui.Column {
      Fill: $tone_ground
      Flex: {axis: Column, gap: 0, align: Center, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: $chat_pad, r: $chat_pad, t: $chat_foot_pad_t, b: $chat_foot_pad_b}
      // What is running for this chat, over the composer while anything is (src/app/chat.rs fill_chat_activity): its
      // turn's step, its commands, its sub-agents at work, the messages waiting for it; empty, it takes no room.
      activity : ui.Row {
        Flex: {axis: Row, gap: $chat_activity_gap, align: Center, justify: Start, wrap: true}
        Size: {w: {kind: Grow, value: 1, min: 0, max: $chat_w}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      }
      // The hover card of the activity chip under the pointer (hn.ChatActivityPop): out of the flow, over the chip.
      activity_pop : ui.Node {
        Overlay
      }
      // An aside's answer over the composer while it shows (hn.ChatAside, src/app/chat.rs fill_chat_aside); empty, it
      // takes no room.
      aside : ui.Column {
        Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: $chat_w}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      }
      // The person's messages sent while the turn runs that the agent has not taken yet (hn.ChatQueued, src/app/chat.rs
      // fill_chat_queued), right over the composer: they join the transcript as the agent takes them. Empty, no room.
      queued : ui.Column {
        Flex: {axis: Column, gap: $chat_queued_gap, align: Stretch, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: $chat_w}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      }
      // The composer: one card holding the words, as wide as the transcript's column. A press anywhere on it that no
      // control takes gives the words the keys. While its draft starts with a space (an aside) it takes the aside's tint
      // (src/app/chat.rs sets its Fill and Edge from hn.Theme.aside and aside_line).
      card : ui.Column {
        Fill: $tone_card
        Edge: {dark: $tone_line.dark, light: $tone_line.light}
        Shape: {radius: $chat_composer_radius, n: 4, border: 1, feather: 0}
        Cursor: {shape: Text}
        Pressable
        Action: {name: "chat:focus"}
        Flex: {axis: Column, gap: $chat_composer_gap, align: Stretch, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: $chat_w}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Padding: {l: $chat_composer_pad, r: $chat_composer_pad, t: $chat_composer_pad_t, b: $chat_composer_pad_b}
        // The `@` mention menu while the draft ends in an `@` word (src/app/chat/mention.rs): out of the flow, its plate
        // placed above the card.
        mention : ui.Node {
          Overlay
        }
        // The words, under the pictures pasted into the message (hn.ChatAttach each, src/app/chat.rs fill_pictures): each
        // thumbnail brings the space under it, so with none the strip takes no room and the card's spacing is as it was.
        entry : ui.Column {
          Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
          Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
          Padding: {l: $chat_composer_text_inset, r: $chat_composer_text_inset, t: 0, b: 0}
          attach : ui.Row {
            Flex: {axis: Row, gap: $chat_attach_gap, align: Start, justify: Start, wrap: true}
            Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
          }
          // Grows with its words to most of the pane, then scrolls (src/app/chat.rs steps its FieldScroll).
          area : ui.field.GrowingTextArea {
            GrowLimit: {share: $textarea_grow_share, keep: $chat_input_keep}
          }
        }
      }
    }
  }

  // An effort as a level, den's signal-strength meter: one bar for each effort its model takes, rising left to right from
  // chat_effort_floor of the meter's height to all of it, bottoms aligned; those up to the effort lit in the control's ink,
  // the rest faint (pick.rs keeps the bars, hn.ChatEffortBar: its height the tallest, its least the shortest). Plates,
  // not a glyph: crisp at any zoom.
  // It stands chat_effort_lead after the name and chat_pick_gap before the chevron (padding, not the control's gap: with
  // no level to show it takes no room, pick.rs folding the padding too).
  prefab ChatEffort : ui.Row {
    Flex: {axis: Row, gap: $chat_effort_gap, align: End, justify: Start, wrap: false}
    Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: $chat_effort_h, min: 0, max: 0}}
    Padding: {l: $chat_effort_lead - $chat_pick_gap, r: $chat_pick_gap, t: 0, b: 0}
  }
  prefab ChatEffortBar : ui.Node {
    Fill: $tone_ink_faint
    Shape: {radius: $chat_effort_bar_radius, n: 4, border: 0, feather: 0}
    Size: {w: {kind: Fixed, value: $chat_effort_bar_w, min: 0, max: 0}, h: {kind: Fixed, value: $chat_effort_h, min: $chat_effort_h * $chat_effort_floor, max: 0}}
  }
  // Den's model and effort picker, in the chat's status bar (src/app/chat/pick.rs): one quiet control, the model's name, its
  // effort as a level meter (hn.ChatEffort) and a small chevron, muted, on a soft wash under the pointer, its words and
  // lit bars easing to the ink (pick.rs mixes hn.ChatControlInk's by the hover spring). The effort's name is the
  // control's tooltip and the menu's; an effort its model does not list (so no level to light) shows as words after the
  // name instead ("Opus · Medium"). No maker's mark here: the marks lead the menu's groups. A press opens the models and
  // the efforts in one searchable menu above it; Command-/ opens the models and Shift-Command-/ steps the effort
  // (scene/20-keys.flecs).
  prefab ChatPick : ui.Row {
    Pressable
    Action: {name: ""}
    Cursor: {shape: Arrow}
    Tooltip: {text: "Model and effort  ⌘/"}
    Fill: $tone_clear
    Shape: {radius: $chat_pick_radius, n: 4, border: 0, feather: 0}
    HoverLook: {dark: $tone_hover.dark, light: $tone_hover.light, pad: 0, radius: -1}
    PressLook: {dark: $tone_press.dark, light: $tone_press.light}
    Flex: {axis: Row, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: $chat_pick_h, min: 0, max: 0}}
    Padding: {l: $chat_pick_pad_x, r: $chat_pick_pad_x, t: 0, b: 0}
    label : ui.Line {
      Fill: $tone_ink_muted
      Padding: {l: 0, r: $chat_pick_gap, t: 0, b: 0}
      TextStyle: {size: $size_chrome, line: $line_chrome, role: 0, bold: 0}
    }
    effort : hn.ChatEffort {}
    // While the effort moves (a swipe, a drag, a key), its name after the meter (hn.ChatPickWord), until a moment after.
    word : ui.Row {
      Flex: {axis: Row, gap: 0, align: Center, justify: Start, wrap: false}
      Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    }
    chevron : ui.Symbol {
      Icon: {glyph: ""}
      Fill: $tone_ink_faint
      Size: {w: {kind: Fixed, value: $chat_pick_chevron, min: 0, max: 0}, h: {kind: Fixed, value: $chat_pick_chevron, min: 0, max: 0}}
    }
  }
  // The bar's quiet controls' inks (the picker's words and lit bars, the stop's ring and square): at rest, under the
  // pointer (eased between by each control's hover spring), and a level's unlit bars.
  prefab ChatControlInk {
    rest { Fill: $tone_ink_muted }
    hot { Fill: $tone_ink }
    off { Fill: $tone_ink_faint }
  }
  prefab ChatPickWord : ui.Line {
    Fill: $tone_ink_muted
    Padding: {l: 0, r: $chat_pick_gap, t: 0, b: 0}
    TextStyle: {size: $size_chrome, line: $line_chrome, role: 0, bold: 0}
  }
  // Its menu (pick.rs), a ui.Menu above it chat_pick_menu_w wide: the models (hn.ChatPickModels, unless it opened on the
  // effort alone), then the effort (hn.ChatPickEffort, unless it opened on the models alone), a hairline between.
  prefab ChatPickMenu : ui.Menu {
    Size: {w: {kind: Fixed, value: $chat_pick_menu_w, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    models : ui.Column {
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    }
    effort : ui.Column {
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    }
  }
  // The `@` mention menu (chat/mention.rs): ui.Menu's plate above the composer's card, chat_mention_w wide, its rows
  // under `items` (hn.ChatMentionItem, or a ui.MenuNote saying why there are none). Instant: no grow or fade in or out,
  // and it follows what is typed without a spring (ui.Menu less its Transition and Motion).
  // The list (`list.items`) at the leading side, the highlighted place's preview (`preview`) past a hairline.
  prefab ChatMention : ui.MenuPlate {
    Placed
    Windowed
    Layer: {level: Overlay}
    Side: {edge: Top, dx: 0, dy: $menu_gap}
    Flex: {axis: Row, gap: $menu_pad, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    list : ui.Column {
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Fixed, value: $chat_mention_w, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      items : ui.Column {
        Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      }
    }
    seam : hn.Seam {}
    preview : ui.Column {
      Clip
      Flex: {axis: Column, gap: $inline_peek_gap, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Fixed, value: $chat_mention_preview_w, min: 0, max: 0}, h: {kind: Fixed, value: $chat_mention_preview_h, min: 0, max: 0}}
      Padding: {l: $chat_mention_preview_pad, r: $chat_mention_preview_pad, t: $chat_mention_preview_pad, b: $chat_mention_preview_pad}
    }
  }
  // The preview's path, quiet, one line (cut in its middle).
  prefab ChatMentionHead : ui.LineMiddle, Muted {
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 0, bold: 0}
  }
  // A file's first lines in the code face, coloured by its language (chat/mention.rs sets Highlight), never wrapped: the box cuts them.
  prefab ChatMentionCode : ui.Words {
    Fill: $tone_ink
    FixedSize: {h: true, v: false}
    Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    TextStyle: {size: $size_code, line: $line_chat_code, role: 9, bold: 0}
  }
  // A picture, drawn whole at the size chat/mention.rs fits it to, a little rounded.
  prefab ChatMentionImage : ui.Node {
    Picture: {handle: ""}
    Clip
    Shape: {radius: $inline_peek_radius, n: 4, border: 0, feather: 0}
  }
  // A place: its kind's icon (files.rs's drawing) before its name, its folder quiet at the end (`about`, cut first).
  prefab ChatMentionItem : ui.MenuItem {
    lead {
      icon : ui.Art {
        Size: {w: {kind: Fixed, value: $chat_mention_icon, min: 0, max: 0}, h: {kind: Fixed, value: $chat_mention_icon, min: 0, max: 0}}
      }
      after : ui.Node {
        Size: {w: {kind: Fixed, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
      }
    }
  }
  // The models, searchable (search_menu.flecs's filter over `items`): each agent kind's under its head led by its maker's
  // mark (ui.MenuHeadMarked), a row each with its name and its version quiet after it (ui.MenuItem's `meta`), the one
  // the chat runs ticked; where nothing can be chosen a ui.MenuNote says why. Under them, the line about the row the
  // pointer or the keys are on (else the chat's own model), whole, wrapping (hn.ChatPickDetail): never cut mid-word.
  prefab ChatPickModels : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    filter : ui.MenuFilter {}
    rule : ui.MenuSep {}
    items : ui.Column {
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    }
    // Always chat_pick_detail_h tall (two lines of it), whatever the line says or whether there is one: the menu keeps
    // its height as the highlight moves, so nothing in it jumps.
    detail : ui.Column {
      Clip
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $chat_pick_detail_h, min: 0, max: 0}}
    }
  }
  prefab ChatPickDetail : ui.Row {
    Flex: {axis: Row, gap: 0, align: Start, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $menu_label_x, r: $menu_item_pad_r, t: $chat_pick_detail_t, b: $chat_pick_detail_b}
    words : ui.Words {
      Fill: $tone_ink_muted
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      TextStyle: {size: $size_chat_pick_detail, line: $line_chat_pick_detail, role: 0, bold: 0}
    }
  }
  // The effort as a level slider (ui.LevelSlider): its stops the model's efforts, Faster to Smarter. A press or a drag
  // sets it, the arrows step it, a sideways swipe steps it a detent at a time; the menu stays open. A model with no
  // efforts, or one not in the list, says so in a ui.MenuNote instead.
  prefab ChatPickEffort : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $menu_gutter_l, r: $menu_gutter_l, t: $chat_pick_level_t, b: $chat_pick_level_b}
    slider : ui.LevelSlider {}
  }

  // The context meter (den's): a small ring filling as the conversation fills its model's window, in a square that takes
  // the pointer; muted, then hn.ChatContextTone's warn from 80% (the strong ink: brighter, not a colour) and full from 95% (the
  // error ink, the one colour) (pick.rs). Under the pointer,
  // hn.ChatContextPop (widgets/context.flecs) shows how full as a donut of its parts; a press opens it to every part.
  prefab ChatContext : ui.Row {
    Hoverable
    Pressable
    Cursor: {shape: Arrow}
    Flex: {axis: Row, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Fixed, value: $chat_bar_h, min: 0, max: 0}, h: {kind: Fixed, value: $chat_bar_h, min: 0, max: 0}}
    ring : ui.ZStack {
      Size: {w: {kind: Fixed, value: $chat_ring, min: 0, max: 0}, h: {kind: Fixed, value: $chat_ring, min: 0, max: 0}}
      track : ui.Node {
        Overlay
        Fill: $tone_clear
        Stroke: {dark: $tone_ink_faint.dark, light: $tone_ink_faint.light}
        Vector: {d: "M6 1 A5 5 0 1 1 6 11 A5 5 0 1 1 6 1", view_x: 0, view_y: 0, view_w: 12, view_h: 12, stroke_w: $chat_ring_stroke}
      }
      arc : ui.Node {
        Overlay
        Fill: $tone_clear
        Stroke: {dark: $tone_ink_muted.dark, light: $tone_ink_muted.light}
        Vector: {d: "M6 1 A5 5 0 0 1 6.5 1.03", view_x: 0, view_y: 0, view_w: 12, view_h: 12, stroke_w: $chat_ring_stroke}
      }
    }
  }
  prefab ChatContextTone {
    ok { Fill: $tone_ink_muted }
    warn { Fill: $tone_ink_strong }
    full { Fill: $tone_error }
  }

  // How much of the person's plan is used (src/app/chat/plan.rs), after the context meter in the status bar: the window
  // nearest its limit as a small bar filling (`track.fill`, the track the ink faintly, as the ring's) and quiet words
  // ("79% of week"); muted, then hn.ChatContextTone's warn once the agent warns of it and full once it refuses for it.
  // Its tooltip says every window, how much of each is used and when each resets, and that the plan is the account's,
  // not this chat's.
  prefab ChatPlan : ui.Row {
    Hoverable
    Cursor: {shape: Arrow}
    Tooltip: {text: ""}
    Flex: {axis: Row, gap: $chat_plan_gap, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: $chat_bar_h, min: 0, max: 0}}
    Padding: {l: $chat_plan_lead, r: $chat_plan_trail, t: 0, b: 0}
    track : ui.Row {
      Fill: $tone_ink_faint
      Shape: {radius: $chat_plan_meter_radius, n: 4, border: 0, feather: 0}
      Flex: {axis: Row, gap: 0, align: Center, justify: Start, wrap: false}
      Size: {w: {kind: Fixed, value: $chat_plan_meter_w, min: 0, max: 0}, h: {kind: Fixed, value: $chat_plan_meter_h, min: 0, max: 0}}
      fill : ui.Node {
        Fill: $tone_ink_muted
        Shape: {radius: $chat_plan_meter_radius, n: 4, border: 0, feather: 0}
        Size: {w: {kind: Fixed, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: $chat_plan_meter_h, min: 0, max: 0}}
      }
    }
    words : ui.Line {
      Fill: $tone_ink_muted
      TextStyle: {size: $size_chrome, line: $line_chrome, role: 0, bold: 0}
    }
  }

  // While the agent works, a ring at the bar's trailing edge breathing gently in the bar's muted ink (src/app/chat.rs
  // keeps it in `bar.act`): the composer's one sign of work, and not a button: Return sends and Escape stops. With the
  // agent idle the slot is empty, so the window rests and the composer keeps its room.
  prefab ChatWorking : ui.Row {
    Tooltip: {text: "Working  esc to stop"}
    Flex: {axis: Row, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Fixed, value: $chat_working, min: 0, max: 0}, h: {kind: Fixed, value: $chat_working, min: 0, max: 0}}
    ring : ui.Node {
      Overlay
      Fill: $tone_clear
      Stroke: {dark: $tone_ink_muted.dark, light: $tone_ink_muted.light}
      Vector: {d: "M10 1 A9 9 0 1 1 10 19 A9 9 0 1 1 10 1", view_x: 0, view_y: 0, view_w: 20, view_h: 20,
        inset_l: 0, inset_t: 0, inset_r: 0, inset_b: 0, stroke_w: $chat_working_stroke * 20 / $chat_working}
      Breath: {spring: {x: 1, v: 0}, up: false, low: $chat_working_breath}
    }
  }

  // What the person sent: their words in a bubble at the trailing edge, as wide as they are up to $chat_bubble_max_w,
  // wrapping past it (and past the row's room in a narrow pane).
  // A finished turn folds its steps away: under the pointer, a quiet button before the bubble shows them (or hides them
  // again; hn.ChatTurnSteps in `steps`, src/app/chat.rs fill_row), so the steps are a press away, never in the way.
  prefab ChatUser : ui.Row {
    HoverGroup
    Flex: {axis: Row, gap: 0, align: Start, justify: End, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_bubble_lead, r: 0, t: $chat_gap_turn - $chat_block_half, b: $chat_gap_reply - $chat_block_half}
    steps : ui.Row {
      Flex: {axis: Row, gap: 0, align: Center, justify: End, wrap: false}
      Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      // Centred on the bubble's first line.
      Padding: {l: 0, r: $chat_turn_steps_gap, t: $chat_bubble_pad_y + $line_chat_bubble / 2 - $chat_turn_steps / 2, b: 0}
    }
    bubble : ui.Bubble {
      Fill: $tone_raised
      Padding: {l: $chat_bubble_pad_x, r: $chat_bubble_pad_x, t: $chat_bubble_pad_y, b: $chat_bubble_pad_y}
      Shape: {radius: $chat_bubble_radius, n: 4, border: 0, feather: 0}
      Size: {w: {kind: Fit, value: 0, min: 0, max: $chat_bubble_max_w}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      text : ui.Words {
        Cursor: {shape: Text}
        Fill: $tone_ink
        TextStyle: {size: $size_chat, line: $line_chat_bubble, role: 0, bold: 0}
      }
    }
  }

  // An aside's answer (src/app/chat.rs fill_chat_aside): a question asked of a fork of the conversation (Return on a
  // draft that starts with a space), never part of it. A card over the composer in the aside's tint (tone_aside, the
  // composer's own while a draft is one), chat_aside_gap above it: its head the quiet word "Aside", the working ring
  // (hn.ChatAsideWorking, in `head.act`) while it asks and a close button (Escape closes it too); its body the answer's words
  // as the transcript draws them (hn.ChatProse and its kin), or the question in a quiet note while it asks, or the
  // error naming what failed (hn.ChatError). Gone once closed; a new aside takes its place.
  prefab ChatAside : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 0, b: $chat_aside_gap}
    plate : ui.Column {
      Fill: $tone_aside
      Edge: {dark: $tone_aside_line.dark, light: $tone_aside_line.light}
      Shape: {radius: $chat_aside_radius, n: 4, border: 1, feather: 0}
      Cursor: {shape: Arrow}
      Flex: {axis: Column, gap: $chat_aside_head_gap, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: $chat_aside_pad_x, r: $chat_aside_pad_x, t: $chat_aside_pad_t, b: $chat_aside_pad_b}
      head : ui.Row {
        Flex: {axis: Row, gap: $chat_bar_gap, align: Center, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $chat_bar_h, min: 0, max: 0}}
        label : ui.Line {
          Text: {s: "Aside"}
          Fill: $tone_ink_muted
          TextStyle: {size: $size_chrome, line: $line_chrome, role: 0, bold: 0}
        }
        act : ui.Row {
          Flex: {axis: Row, gap: 0, align: Center, justify: Start, wrap: false}
          Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        }
        spacer : ui.Spacer {}
        close : ui.IconButton {
          Action: {name: ""}
          Tooltip: {text: "Close  esc"}
          AlignSelf: {align: Center}
          Size: {w: {kind: Fixed, value: $chat_aside_close, min: 0, max: 0}, h: {kind: Fixed, value: $chat_aside_close, min: 0, max: 0}}
          icon : ui.Symbol {
            Size: {w: {kind: Fixed, value: $chat_aside_icon, min: 0, max: 0}, h: {kind: Fixed, value: $chat_aside_icon, min: 0, max: 0}}
          }
        }
      }
      body : ui.Column {
        Cursor: {shape: Text}
        Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      }
    }
  }

  // An aside's working ring (in its head while it is asked): the composer's, saying what Escape does here.
  prefab ChatAsideWorking : hn.ChatWorking {
    Tooltip: {text: "Asking aside  esc to close"}
  }

  // The words of a message sent with pictures, under them: no turn's gap over it (the pictures took it).
  prefab ChatUserUnder : hn.ChatUser {
    Padding: {l: $chat_bubble_lead, r: 0, t: 0, b: $chat_gap_reply - $chat_block_half}
  }

  // A picture attached to the message being written: its thumbnail (sized by fill_attach to chat_attach_h tall at its
  // aspect), rounded, with a remove button over its top trailing corner on a raised plate so it reads over any picture.
  // The remove button shows only while the pointer is on the picture (HoverGroup on it, HoverShow on the button and its
  // glyph).
  prefab ChatAttach : ui.ZStack {
    HoverGroup
    Cursor: {shape: Arrow}
    Flex: {axis: Z, gap: 0, align: Start, justify: Start, wrap: false}
    Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 0, b: $chat_attach_below}
    pic : ui.Node {
      Picture: {handle: ""}
      Clip
      Shape: {radius: $chat_attach_radius, n: 4, border: 0, feather: 0}
    }
    corner : ui.Row {
      Flex: {axis: Row, gap: 0, align: Start, justify: End, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
      Padding: {l: 0, r: $chat_attach_inset, t: $chat_attach_inset, b: 0}
      remove : ui.IconButton {
        HoverShow: {row: 0, keep: false, away: false}
        Fill: $tone_raised
        Shape: {radius: $chat_attach_remove / 2, n: 2, border: 0, feather: 0}
        Size: {w: {kind: Fixed, value: $chat_attach_remove, min: 0, max: 0}, h: {kind: Fixed, value: $chat_attach_remove, min: 0, max: 0}}
        Tooltip: {text: "Remove picture"}
        icon : ui.Symbol {
          HoverShow: {row: 0, keep: false, away: false}
          Size: {w: {kind: Fixed, value: $chat_attach_icon, min: 0, max: 0}, h: {kind: Fixed, value: $chat_attach_icon, min: 0, max: 0}}
        }
      }
    }
  }
  // A sent message's pictures, over its bubble at the trailing edge (Row::Pictures): the same thumbnails, larger, with
  // no remove button.
  prefab ChatSentPictures : ui.Row {
    Flex: {axis: Row, gap: $chat_attach_gap, align: Start, justify: End, wrap: true}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_bubble_lead, r: 0, t: $chat_gap_turn - $chat_block_half, b: $chat_attach_gap}
  }
  prefab ChatSentPicturesLast : hn.ChatSentPictures {
    Padding: {l: $chat_bubble_lead, r: 0, t: $chat_gap_turn - $chat_block_half, b: $chat_gap_reply - $chat_block_half}
  }
  prefab ChatSentPicture : ui.Node {
    Picture: {handle: ""}
    Clip
    Shape: {radius: $chat_attach_radius, n: 4, border: 0, feather: 0}
  }

  // A pull request or issue said on its own in the agent's words: the component's block form, its card in the flow of
  // the words (src/app/chat.rs Row::RefCard). The same lines as its hover card (chat/peek.rs fill_card: where it is,
  // its title, its state and checks, who and how much, its description's start) on a solid card, chat_ref_w wide at
  // most; in the flow, so solid: glass is only for what floats.
  prefab ChatRefCard : ui.Row {
    Flex: {axis: Row, gap: 0, align: Start, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: $chat_block_half, b: $chat_block_half}
    card : ui.Column {
      Fill: $tone_card
      Edge: {dark: $tone_line.dark, light: $tone_line.light}
      Shape: {radius: $inline_peek_radius, n: 4, border: 1, feather: 0}
      Flex: {axis: Column, gap: $inline_peek_gap, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: $chat_ref_w}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: $inline_peek_pad, r: $inline_peek_pad, t: $inline_peek_pad, b: $inline_peek_pad}
    }
  }

  // One thing running for the chat, over its composer (src/app/chat.rs fill_chat_activity): a glyph and a few words in
  // the chrome's size and the muted ink, on a quiet plate that brightens under the pointer; a command or a sub-agent
  // selects it in the sidebar on a press (its Action), the turn's step and the queue only say. The strip's space under
  // it (chat_activity_below) is set only while it holds items, so an empty strip takes none.
  // Its glyph says how the thing stands (the host copies a hn.chat_status entry onto `icon`: running breathes, waiting
  // is a hollow ring, done a check, failed a cross in the error ink); its words say what it is doing and, while it runs,
  // for how long ("blaze check · 6 min"), ticking. Under the pointer its card (hn.ChatActivityPop) says more.
  prefab ChatActivityItem : ui.Row {
    Hoverable
    Pressable
    Cursor: {shape: Arrow}
    Fill: $tone_clear
    HoverLook: {dark: $tone_hover.dark, light: $tone_hover.light, pad: 0, radius: -1}
    Shape: {radius: $chat_activity_radius, n: 4, border: 0, feather: 0}
    Flex: {axis: Row, gap: $chat_activity_icon_gap, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Fit, value: 0, min: 0, max: $chat_activity_max_w}, h: {kind: Fixed, value: $chat_activity_h, min: 0, max: 0}}
    Padding: {l: $chat_activity_pad, r: $chat_activity_pad, t: 0, b: 0}
    icon : ui.Symbol {
      Fill: $tone_ink_muted
      Size: {w: {kind: Fixed, value: $chat_activity_icon, min: 0, max: 0}, h: {kind: Fixed, value: $chat_activity_icon, min: 0, max: 0}}
    }
    words : ui.Lead {
      Fill: $tone_ink_muted
      TextStyle: {size: $size_chrome, line: $line_chrome, role: 0, bold: 0}
    }
    // How long it has run, after its words, never cut (the words cut first).
    took : ui.Line {
      Fill: $tone_ink_faint
      FixedSize: {h: true, v: false}
      TextStyle: {size: $size_chrome, line: $line_chrome, role: 0, bold: 0}
    }
  }

  // An activity chip's hover card (src/app/chat.rs fill_activity_pop): a ui.Menu (glass, its own window) over the chip,
  // a column of lines the host keeps by key: the head (what it is), a meta line (model and effort, how long), then what
  // it is doing or said last (a few lines), or the steps the turn's cells took so far, one a line.
  prefab ChatActivityPop : ui.Menu {
    Side: {edge: Top, dx: 0, dy: $menu_gap}
    Flex: {axis: Column, gap: $chat_activity_pop_gap, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Fixed, value: $chat_activity_pop_w, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_activity_pop_pad, r: $chat_activity_pop_pad, t: $chat_activity_pop_pad, b: $chat_activity_pop_pad}
  }
  // The running step's item, large, at the card's top: the picture of what it is doing.
  prefab ChatActivityPopItem : ui.Row {
    Flex: {axis: Row, gap: 0, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 0, b: 4}
    block : ui.Block {
      Size: {w: {kind: Fixed, value: $chat_activity_pop_item, min: 0, max: 0}, h: {kind: Fixed, value: $chat_activity_pop_item, min: 0, max: 0}}
    }
  }
  prefab ChatActivityPopHead : ui.Lead, Strong {
    TextStyle: {size: $size_peek_body, line: $line_peek_title, role: 0, bold: 1}
  }
  prefab ChatActivityPopMeta : ui.Words, Muted {
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    TextStyle: {size: $size_peek_meta, line: $line_peek_meta, role: 0, bold: 0}
  }
  prefab ChatActivityPopText : ui.Words, Ink {
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    TextStyle: {size: $size_peek_body, line: $line_peek_meta, role: 0, bold: 0}
  }
  // A block of what it said last: the transcript's inline markdown (hn.ChatProse's MarkdownText: strong words, code,
  // a path's or a pull request's chip), at the card's size.
  prefab ChatActivityPopSaid : ui.Words, Ink {
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    MarkdownText: {chip_dark: $tone_wash.dark, chip_light: $tone_wash.light,
      link_dark: $tone_link.dark, link_light: $tone_link.light,
      code_dark: $tone_code_ink.dark, code_light: $tone_code_ink.light,
      strong_dark: $tone_ink_strong.dark, strong_light: $tone_ink_strong.light, chip_radius: $chat_code_radius}
    TextStyle: {size: $size_peek_body, line: $line_peek_meta, role: 0, bold: 0}
  }
  // One step a cell took, one line: its kind's glyph (hn.StepKind), its verb in the UI's words ("Ran", "Read"), then
  // what it was done to in the code face, a notch smaller and muted (a command, a path: src/app/chat.rs StepWords),
  // which gives up its room first: a path cut in its middle so its file shows, a command at its end.
  prefab ChatActivityPopStep : ui.Row {
    Flex: {axis: Row, gap: $chat_activity_icon_gap, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    icon : ui.Symbol {
      Fill: $tone_ink_muted
      Size: {w: {kind: Fixed, value: $chat_activity_icon, min: 0, max: 0}, h: {kind: Fixed, value: $chat_activity_icon, min: 0, max: 0}}
    }
    words : ui.Line, Ink {
      LayoutPriority: {value: 1}
      TextStyle: {size: $size_peek_body, line: $line_peek_meta, role: 0, bold: 0}
    }
    what : ui.Lead, Muted {
      TextStyle: {size: $size_code, line: $line_peek_meta, role: 9, bold: 0}
    }
  }

  // A message sent while the turn runs, waiting for the agent to take it: the person's bubble at the trailing edge, its
  // ground faded (chat_queued_fade) and its words muted, "Queued" and a clock before it, so it reads as not yet sent on.
  prefab ChatQueued : ui.Row {
    Flex: {axis: Row, gap: $chat_activity_icon_gap, align: Center, justify: End, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_bubble_lead, r: 0, t: 0, b: 0}
    Cursor: {shape: Arrow}
    Tooltip: {text: "Queued: the agent takes it at its next step"}
    icon : ui.Symbol {
      Icon: {glyph: ""}
      Fill: $tone_ink_faint
      Size: {w: {kind: Fixed, value: $chat_activity_icon, min: 0, max: 0}, h: {kind: Fixed, value: $chat_activity_icon, min: 0, max: 0}}
    }
    label : ui.Line {
      Text: {s: "Queued"}
      Fill: $tone_ink_faint
      FixedSize: {h: true, v: false}
      TextStyle: {size: $size_chrome, line: $line_chrome, role: 0, bold: 0}
    }
    bubble : ui.Bubble {
      Fill: $tone_raised
      Pose: {dx: 0, dy: 0, shrink: 0, fade: $chat_queued_fade, cut: 0}
      Padding: {l: $chat_bubble_pad_x, r: $chat_bubble_pad_x, t: $chat_bubble_pad_y, b: $chat_bubble_pad_y}
      Shape: {radius: $chat_bubble_radius, n: 4, border: 0, feather: 0}
      Size: {w: {kind: Fit, value: 0, min: 0, max: $chat_bubble_max_w}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      text : ui.Words {
        Fill: $tone_ink
        TextStyle: {size: $size_chat, line: $line_chat_bubble, role: 0, bold: 0}
      }
    }
  }

  // A finished turn's steps button, before the person's bubble while the pointer is on its row (HoverShow on it and on
  // its glyph: a node's hover fade is its own, not its subtree's): a list glyph; a press shows the turn's steps under it, or folds them again (its Action and Tooltip, from the host).
  prefab ChatTurnSteps : ui.IconButton {
    HoverShow: {row: 0, keep: false, away: false}
    AlignSelf: {align: Center}
    Size: {w: {kind: Fixed, value: $chat_turn_steps, min: 0, max: 0}, h: {kind: Fixed, value: $chat_turn_steps, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 0, b: 0}
    icon : ui.Symbol {
      HoverShow: {row: 0, keep: false, away: false}
      Icon: {glyph: ""}
      Size: {w: {kind: Fixed, value: $chat_turn_steps_icon, min: 0, max: 0}, h: {kind: Fixed, value: $chat_turn_steps_icon, min: 0, max: 0}}
    }
  }

  // A paragraph of the agent's words (inline markdown): the body ink, bold a semibold step in the strong ink, inline code
  // in the code face in the site's coral on its faint plate.
  prefab ChatProse : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: $chat_block_half, b: $chat_block_half}
    text : ui.Words {
      Fill: $tone_ink
      MarkdownText: {chip_dark: $tone_wash.dark, chip_light: $tone_wash.light,
        link_dark: $tone_link.dark, link_light: $tone_link.light,
        code_dark: $tone_code_ink.dark, code_light: $tone_code_ink.light,
        strong_dark: $tone_ink_strong.dark, strong_light: $tone_ink_strong.light, chip_radius: $chat_code_radius}
      TextStyle: {size: $size_chat, line: $line_chat, role: 0, bold: 0}
    }
  }

  // Headings, by level: semibold, a step up the scale each, in the strong ink; more room above than below, so each sits
  // with what it heads.
  prefab ChatH1 : hn.ChatProse {
    Padding: {l: 0, r: 0, t: $chat_h1_above, b: $chat_h1_below}
    text : ui.Words {
      Fill: $tone_ink_strong
      TextStyle: {size: $size_chat_h1, line: $line_chat_h1, role: 0, bold: 1}
    }
  }
  prefab ChatH2 : hn.ChatProse {
    Padding: {l: 0, r: 0, t: $chat_h2_above, b: $chat_h2_below}
    text : ui.Words {
      Fill: $tone_ink_strong
      TextStyle: {size: $size_chat_h2, line: $line_chat_h2, role: 0, bold: 1}
    }
  }
  prefab ChatH3 : hn.ChatProse {
    Padding: {l: 0, r: 0, t: $chat_h3_above, b: $chat_h3_below}
    text : ui.Words {
      Fill: $tone_ink_strong
      TextStyle: {size: $size_chat_h3, line: $line_chat_h3, role: 0, bold: 1}
    }
  }

  // A list item: its marker in a fixed gutter (a hanging indent: wrapped lines align with the words, not the marker),
  // then its words; `indent` is its depth (src/app/chat.rs sets it, hn.Theme.chat_list_nest a level). The row aligns on
  // the first baseline, so a small marker sits on the words' first line. Items are chat_item_gap apart.
  prefab ChatItem : ui.Row {
    Flex: {axis: Row, gap: 0, align: FirstBaseline, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_list_inset, r: 0, t: $chat_item_half, b: $chat_item_half}
    indent : ui.Node {
      AlignSelf: {align: Start}
      Size: {w: {kind: Fixed, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
    // A bullet: small and faint.
    mark : ui.Words {
      Fill: $tone_ink_faint
      Size: {w: {kind: Fixed, value: $chat_list_mark_w, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      TextStyle: {size: $size_chat_bullet, line: $line_chat, role: 0, bold: 0}
    }
    text : ui.Words {
      Fill: $tone_ink
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      MarkdownText: {chip_dark: $tone_wash.dark, chip_light: $tone_wash.light,
        link_dark: $tone_link.dark, link_light: $tone_link.light,
        code_dark: $tone_code_ink.dark, code_light: $tone_code_ink.light,
        strong_dark: $tone_ink_strong.dark, strong_light: $tone_ink_strong.light, chip_radius: $chat_code_radius}
      TextStyle: {size: $size_chat, line: $line_chat, role: 0, bold: 0}
    }
  }
  // An ordered item: its number at the body's size in the muted ink, tabular figures (role 10) so a column of them lines up.
  prefab ChatItemNumber : hn.ChatItem {
    mark : ui.Words {
      Fill: $tone_ink_muted
      TextStyle: {size: $size_chat, line: $line_chat, role: 10, bold: 0}
    }
  }
  // A task item: its box at the body's size in the muted ink.
  prefab ChatItemTask : hn.ChatItem {
    mark : ui.Words {
      Fill: $tone_ink_muted
      TextStyle: {size: $size_chat, line: $line_chat, role: 0, bold: 0}
    }
  }

  // A quote: a hairline at its leading edge, its words muted.
  prefab ChatQuote : ui.Row {
    Flex: {axis: Row, gap: 12, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 2, r: 0, t: $chat_block_half, b: $chat_block_half}
    bar : hn.Seam {}
    text : ui.Words {
      Fill: $tone_ink_muted
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      MarkdownText: {chip_dark: $tone_wash.dark, chip_light: $tone_wash.light,
        link_dark: $tone_link.dark, link_light: $tone_link.light,
        code_dark: $tone_code_ink.dark, code_light: $tone_code_ink.light, chip_radius: $chat_code_radius}
      TextStyle: {size: $size_chat, line: $line_chat, role: 0, bold: 0}
    }
  }

  // A displayed formula ($$…$$ or \[…\] on lines of their own, a ```math fence): its words are the formula alone
  // (src/app/chat.rs sets them as $$…$$, inline markdown typesets it in display style), hugging it, centred in the column.
  prefab ChatMath : ui.Row {
    Flex: {axis: Row, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: $chat_block_half, b: $chat_block_half}
    text : ui.Words {
      Fill: $tone_ink
      Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      MarkdownText: {chip_dark: $tone_wash.dark, chip_light: $tone_wash.light,
        link_dark: $tone_link.dark, link_light: $tone_link.light,
        code_dark: $tone_code_ink.dark, code_light: $tone_code_ink.light,
        strong_dark: $tone_ink_strong.dark, strong_light: $tone_ink_strong.light, chip_radius: $chat_code_radius}
      TextStyle: {size: $size_chat, line: $line_chat, role: 0, bold: 0}
    }
  }

  // A fenced code block on a card, in the code face (coloured by its language when blaze has its grammar).
  prefab ChatCode : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 4, b: 8}
    card : ui.Column {
      Fill: $tone_well
      Edge: {dark: $tone_line.dark, light: $tone_line.light}
      Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
      Flex: {axis: Column, gap: 4, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: 12, r: 12, t: 9, b: 10}
      text : ui.Words {
        Fill: $tone_ink
        TextStyle: {size: $size_code, line: $line_chat_code, role: 9, bold: 0}
      }
    }
  }

  // One line for every tool call, run of calls, step and thought (src/app/chat.rs fill_row), Claude Code's calm: its
  // words, its argument in the code face, a quiet detail ("exit 1", "2 failed"), all in the muted ink at the body size,
  // on one line, with no plate or border; an icon only where a status reads clearer as one (scene/widgets/chat_status.flecs:
  // a thought's ring, a call's running dot), its word in the line's tooltip. Under the pointer a soft wash and a small
  // chevron after its words (right folded, down open; src/app/chat.rs `line` turns it); pressed, it opens what it folds;
  // how long it took is its tooltip. A failure says so once, as a small mark in the failed tone, never its words in red.
  // Its words are spaced by the room after each (text draws at its node's leading edge), not the row's gap, so an argument
  // with nothing to say (src/app/chat.rs `line` folds it to nothing) leaves no gap behind.
  prefab ChatLineLook : ui.Row {
    Flex: {axis: Row, gap: 0, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $chat_tool_h, min: 0, max: 0}}
    Padding: {l: $chat_line_pad, r: 8, t: 0, b: 0}
    // A status icon leading its words (a thought's ring: scene/widgets/chat_status.flecs), its words the line's
    // tooltip; src/app/chat.rs `status_on` folds it to nothing on a line without one.
    glyph : ui.Symbol {
      Icon: {glyph: ""}
      Fill: $tone_ink_muted
      Size: {w: {kind: Fixed, value: $chat_line_status, min: 0, max: 0}, h: {kind: Fixed, value: $chat_line_status, min: 0, max: 0}}
    }
    words : ui.Line {
      Fill: $tone_ink_muted
      LayoutPriority: {value: 1}
      Padding: {l: 0, r: $chat_line_word_gap, t: 0, b: 0}
      TextStyle: {size: $size_body, line: 16, role: 0, bold: 0}
    }
    arg : ui.Lead {
      Fill: $tone_ink_muted
      Padding: {l: 0, r: $chat_line_word_gap, t: 0, b: 0}
      TextStyle: {size: $size_code, line: 16, role: 9, bold: 0}
    }
    detail : ui.Line {
      Fill: $tone_ink_muted
      LayoutPriority: {value: 2}
      Padding: {l: 0, r: $chat_line_word_gap, t: 0, b: 0}
      TextStyle: {size: $size_body, line: 16, role: 0, bold: 0}
    }
    // A status icon after its words (a call still running, one with no result), its words the line's tooltip; folded to
    // nothing on a line without one, as the glyph is.
    state : ui.Symbol {
      Icon: {glyph: ""}
      Fill: $tone_ink_muted
      Size: {w: {kind: Fixed, value: $chat_line_status, min: 0, max: 0}, h: {kind: Fixed, value: $chat_line_status, min: 0, max: 0}}
    }
    // Shown while its line is hovered (the nearest ancestor with a hover look: a step has none, so never).
    chevron : ui.Symbol {
      Fill: $tone_ink_muted
      HoverShow: {row: 0, keep: false}
      Size: {w: {kind: Fixed, value: $chat_line_chevron, min: 0, max: 0}, h: {kind: Fixed, value: $chat_line_chevron, min: 0, max: 0}}
    }
    spacer : ui.Spacer {}
  }

  // The faint guide down the left of what a line opened (its output, its table, its steps, its words, a run's calls):
  // laid to its row's frame behind it, a hairline at chat_guide_x, so the rows under one line join into one guide.
  prefab ChatGuide : ui.Row {
    Background
    Flex: {axis: Row, gap: 0, align: Stretch, justify: Start, wrap: false}
    Padding: {l: $chat_guide_x, r: 0, t: 0, b: 0}
    line : ui.Node {
      Fill: $tone_line
      Size: {w: {kind: Fixed, value: $chat_guide_w, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
    }
  }
  // A line row's own guide, clear unless the row is one of an opened run's calls (src/app/chat.rs fills it then).
  prefab ChatGuideOff : hn.ChatGuide {
    line : ui.Node { Fill: $tone_clear }
  }
  // Pressable, it hugs its words and chevron (its wash a highlight on them, never a full-width plate).
  prefab ChatLine : hn.ChatLineLook {
    Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: $chat_tool_h, min: 0, max: 0}}
    AlignSelf: {align: Start}
    Padding: {l: $chat_line_pad, r: $chat_line_pad, t: 0, b: 0}
    Pressable
    Action: {name: ""}
    Cursor: {shape: Arrow}
    Fill: $tone_clear
    Shape: {radius: $radius_control, n: 4, border: 0, feather: 0}
    HoverLook: {dark: $tone_hover.dark, light: $tone_hover.light, pad: 0, radius: -1}
    PressLook: {dark: $tone_press.dark, light: $tone_press.light}
  }

  // A tool call folded to its line (an agent's own tool: its name and main argument; a harness REPL cell: what it did in
  // words, never its code). Folded is how every call starts, a failed one too, and opens only on a press.
  prefab ChatTool : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 1, b: 1}
    guide : hn.ChatGuideOff {}
    head : hn.ChatLine {}
  }
  // Failed: the same muted words; its detail (a dot, src/app/chat.rs item_rows) in the failed tone, the one coloured mark.
  prefab ChatToolFailed : hn.ChatTool {
    head : hn.ChatLine {
      detail : ui.Line { Fill: $tone_error }
    }
  }

  // An agent's tool call opened: its line, then its input and its result on a card under its words.
  prefab ChatToolOpen : hn.ChatTool {
    Padding: {l: 0, r: 0, t: 1, b: 8}
    body : ui.Column {
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: $chat_line_inset, r: 0, t: 2, b: 0}
      guide : hn.ChatGuide {}
      card : ui.Column {
        Fill: $tone_well
        Edge: {dark: $tone_line.dark, light: $tone_line.light}
        Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
        Flex: {axis: Column, gap: 8, align: Stretch, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Padding: {l: 12, r: 12, t: 9, b: 10}
        input : ui.Words {
          Fill: $tone_ink_muted
          TextStyle: {size: $size_code, line: $line_chat_code, role: 9, bold: 0}
        }
        result : ui.Words {
          Fill: $tone_ink
          TextStyle: {size: $size_code, line: $line_chat_code, role: 9, bold: 0}
        }
      }
    }
  }
  prefab ChatToolOpenFailed : hn.ChatToolOpen {
    head : hn.ChatLine {
      detail : ui.Line { Fill: $tone_error }
    }
  }

  // An agent tool call or reasoning inside an opened run sits in from the run's line by $chat_nest, on its guide. Runs
  // and harness cells are hn.StepLine (widgets/steps.flecs).
  prefab ChatNest : ui.Node {
    Padding: {l: $chat_nest, r: 0, t: 0, b: 0}
  }

  // The chat's look of a ui.Table (harness_native_ui_view::table with look "hn.ChatTable"): the ui.Table* cells in the
  // terminal ground's inks: words and numbers in its ink, nulls, the index and the header muted, links in the accent.
  prefab ChatTableCell : ui.TableCell {
    text : ui.Line { Fill: $tone_ink }
  }
  prefab ChatTableCellMd : ui.TableCellMd {
    text : ui.Line { Fill: $tone_ink }
  }
  prefab ChatTableCellCode : ui.TableCellCode {
    text : ui.Line { Fill: $tone_ink }
  }
  prefab ChatTableCellNum : ui.TableCellNum {
    text : ui.Line { Fill: $tone_ink }
  }
  prefab ChatTableCellDim : ui.TableCellDim {
    text : ui.Line { Fill: $tone_ink_muted }
  }
  prefab ChatTableCellLink : ui.TableCellLink {}
  prefab ChatTableCellMark : ui.TableCellMark {
    text : ui.Line { Fill: $tone_ink_muted }
  }
  prefab ChatTableHead : ui.TableHead {
    text : ui.Line { Fill: $tone_ink_muted }
  }
  prefab ChatTableField : ui.TableField {
    key : ui.Line { Fill: $tone_ink_muted }
    value : ui.Words { Fill: $tone_ink }
  }
  prefab ChatTableFieldMd : ui.TableFieldMd {
    key : ui.Line { Fill: $tone_ink_muted }
    value : ui.Words { Fill: $tone_ink }
  }

  // A markdown table in the agent's words (src/app/chat.rs Row::Table): a ui.Table on a card's plate, its cells inline
  // markdown, aligned as its delimiter line says.
  prefab ChatTable : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 4, b: 8}
    card : ui.Column {
      Clip
      Fill: $tone_well
      Edge: {dark: $tone_line.dark, light: $tone_line.light}
      Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: 4, r: 4, t: 2, b: 4}
      grid : ui.Table {}
    }
  }

  // A table, record or list a cell gave, as a ui.Table on the card's plate (src/app/chat.rs fill_grid), and a foot saying
  // how many rows there are when not all show.
  prefab ChatGrid : ui.Column {
    Flex: {axis: Column, gap: 3, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_line_inset, r: 0, t: 2, b: 6}
    guide : hn.ChatGuide {}
    card : ui.Column {
      Clip
      Fill: $tone_well
      Edge: {dark: $tone_line.dark, light: $tone_line.light}
      Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: 4, r: 4, t: 2, b: 4}
      grid : ui.Table {}
    }
    foot : ui.Line, Faint {
      Padding: {l: 4, r: 0, t: 0, b: 0}
      TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
    }
  }

  // Text a cell printed (a command's output), in the code face on the card's plate.
  prefab ChatOutput : ui.Column {
    Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: $chat_line_inset, r: 0, t: 2, b: 6}
    guide : hn.ChatGuide {}
    card : ui.Column {
      Fill: $tone_well
      Edge: {dark: $tone_line.dark, light: $tone_line.light}
      Shape: {radius: $radius_control, n: 4, border: 1, feather: 0}
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: 10, r: 10, t: 7, b: 8}
      text : ui.Words {
        Fill: $tone_ink
        TextStyle: {size: $size_code, line: $line_chat_code, role: 9, bold: 0}
      }
    }
  }
  // The agent's reasoning, folded to one line: a thin ring (hn.chat_status.thinking, breathing while it thinks; thought,
  // still once done), its word the tooltip; pressed, it opens to its words.
  prefab ChatThinking : ui.Column {
    Flex: {axis: Column, gap: 2, align: Stretch, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 1, b: 1}
    guide : hn.ChatGuideOff {}
    head : hn.ChatLine {}
  }
  prefab ChatThinkingOpen : hn.ChatThinking {
    Padding: {l: 0, r: 0, t: 1, b: 8}
    body : ui.Column {
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Padding: {l: $chat_line_inset, r: 0, t: 0, b: 0}
      guide : hn.ChatGuide {}
      text : ui.Words {
        Fill: $tone_ink_muted
        TextStyle: {size: $size_body, line: 19, role: 0, bold: 0}
      }
    }
  }

  // Something said about the conversation (it was interrupted), quiet and centred; an error in the failed tone.
  prefab ChatNote : ui.Row {
    Flex: {axis: Row, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: 6, b: 6}
    text : ui.Words, Faint {
      TextStyle: {size: $size_caption, line: 15, role: 0, bold: 0}
    }
  }
  prefab ChatError : ui.Row {
    Flex: {axis: Row, gap: 0, align: Start, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    Padding: {l: 0, r: 0, t: $chat_block_half, b: $chat_block_half}
    text : ui.Words {
      Fill: $tone_error
      TextStyle: {size: $size_body, line: 19, role: 0, bold: 0}
    }
  }
}
