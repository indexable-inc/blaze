// The Archive pane (src/app/archive.rs) and its rows.

@tree ChildOf
hn {
  // The Archive (src/app/archive.rs): everything out of the live tree (the title bar names it and counts it). A search line (typed into while
  // the pane has the keyboard), the filter chips, then a scrolling list by day (Today, Yesterday, This week, Older):
  // sessions with their runs folded under them, runs, and at its foot the next page of older runs from the daemon.
  prefab ArchivePane : hn.Pane {
    head : ui.Column {
      Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
      Flex: {axis: Column, gap: 10, align: Stretch, justify: Start, wrap: false}
      Padding: {l: 18, r: 18, t: 14, b: 6}
      search : ui.Row, Wash {
        Shape: {radius: $radius_control, n: 4, border: 0, feather: 0}
        Flex: {axis: Row, gap: 8, align: Center, justify: Start, wrap: false}
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $field_h, min: 0, max: 0}}
        Padding: {l: 10, r: 10, t: 0, b: 0}
        icon : ui.Symbol, Faint {
          Size: {w: {kind: Fixed, value: $icon_box, min: 0, max: 0}, h: {kind: Fixed, value: $icon_box, min: 0, max: 0}}
        }
        text : ui.Lead, Muted {
          TextStyle: {size: $size_body, line: 16, role: 0, bold: 0}
        }
      }
      chips : ui.List {
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
        Flex: {axis: Row, gap: 6, align: Center, justify: Start, wrap: false}
      }
    }
    // Lazy (SwiftUI's LazyVStack in a ScrollView): only the rows in view exist, recycled as they scroll; every row is
    // $row_h tall (headings, items, the note and the foot alike).
    list : ui.Scroll {
      Flex: {axis: Column, gap: 0, align: Stretch, justify: Start, wrap: false}
      Padding: {l: 10, r: 10, t: 0, b: 12}
      rows : ui.LazyColumn {
        Lazy: {count: 0, row: $row_h, overscan: 6}
        Flex: {axis: Column, gap: 1, align: Stretch, justify: Start, wrap: false}
      }
      // The empty state (an hn.ArchNote, or nothing): a Grow child of the scroll takes what the rows leave of its viewport
      // (and nothing once they overflow it), so the note sits in the middle of the list's room, not on a row.
      empty : ui.List {
        Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Grow, value: 1, min: 0, max: 0}}
        Flex: {axis: Column, gap: 0, align: Center, justify: Center, wrap: false}
      }
    }
  }

  prefab KipArchive {
    Kip: {mood: "sleepy", size: $kip_archive, centre: true, settle: false}
  }

  // A filter chip over the Archive's list (All, Sessions, Runs, Failed): lit (the selection's pill tone, strong ink) when on.
  prefab Chip : ui.Row {
    Pressable
    Action: {name: ""}
    Fill: $tone_clear
    Shape: {radius: $chip_radius, n: 4, border: 0, feather: 0}
    HoverLook: {dark: $tone_hover.dark, light: $tone_hover.light, pad: 0, radius: -1}
    PressLook: {dark: $tone_press.dark, light: $tone_press.light}
    Flex: {axis: Row, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: $chip_h, min: 0, max: 0}}
    Padding: {l: 10, r: 10, t: 0, b: 0}
    label : ui.Line, Muted {
      TextStyle: {size: $size_run, line: 15, role: 0, bold: 0, weight: $weight_row}
    }
  }

  // A day's heading in the Archive's list.
  prefab ArchSection : ui.Row {
    Flex: {axis: Row, gap: 0, align: End, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $row_h, min: 0, max: 0}}
    Padding: {l: $row_pad, r: $row_pad, t: 0, b: 5}
    label : ui.Line, Faint {
      TextStyle: {size: $size_label, line: 14, role: 0, bold: 1, weight: $weight_label}
    }
  }

  // An archived session or run: indent, a disclosure (a session with runs under it), its kind's icon (a run's dot tinted by
  // how it went), its name or command on one line, where it ran (a run's session) or how many runs it holds, then its
  // status badge, how long it ran and when, in columns. Pressed, it opens in the main card (back returns here).
  prefab ArchRow : ui.Row {
    Pressable
    Action: {name: ""}
    Fill: $tone_clear
    Shape: {radius: $radius_control, n: 4, border: 0, feather: 0}
    HoverLook: {dark: $tone_hover.dark, light: $tone_hover.light, pad: 0, radius: -1}
    PressLook: {dark: $tone_press.dark, light: $tone_press.light}
    Flex: {axis: Row, gap: $row_gap, align: Center, justify: Start, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $row_h, min: 0, max: 0}}
    Padding: {l: 2, r: $row_pad, t: 0, b: 0}
    indent : ui.Node {
      Size: {w: {kind: Fixed, value: 0, min: 0, max: 0}, h: {kind: Fixed, value: 1, min: 0, max: 0}}
    }
    disclose : hn.Disclosure {}
    glyph : ui.Symbol {
      Size: {w: {kind: Fixed, value: $icon_box, min: 0, max: 0}, h: {kind: Fixed, value: $icon_box, min: 0, max: 0}}
    }
    name : ui.Lead, Ink {
      TextStyle: {size: $size_row, line: 16, role: 0, bold: 0, weight: $weight_row}
    }
    // Room goes by priority: where it ran gives way first, then the name (ui.Lead, -1); the status badge never does.
    under : ui.Lead, Faint {
      LayoutPriority: {value: -2}
      TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
    }
    spacer : ui.Spacer {}
    status : hn.Badge { LayoutPriority: {value: 1} }
    took : ui.Row {
      Flex: {axis: Row, gap: 0, align: Center, justify: End, wrap: false}
      Size: {w: {kind: Fixed, value: $arch_took_w, min: 0, max: 0}, h: {kind: Fixed, value: 16, min: 0, max: 0}}
      text : ui.Line, Faint {
        TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
      }
    }
    time : ui.Row {
      Flex: {axis: Row, gap: 0, align: Center, justify: End, wrap: false}
      Size: {w: {kind: Fixed, value: $arch_time_w, min: 0, max: 0}, h: {kind: Fixed, value: 16, min: 0, max: 0}}
      text : ui.Line, Faint {
        TextStyle: {size: $size_caption, line: 14, role: 0, bold: 0}
      }
    }
  }

  // The Archive list's foot: the next page of older runs (pressed, or on its own once it scrolls into view).
  prefab ArchMore : ui.Row {
    Pressable
    Action: {name: "arch:more"}
    Fill: $tone_clear
    Shape: {radius: $radius_control, n: 4, border: 0, feather: 0}
    HoverLook: {dark: $tone_hover.dark, light: $tone_hover.light, pad: 0, radius: -1}
    Flex: {axis: Row, gap: 0, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Grow, value: 1, min: 0, max: 0}, h: {kind: Fixed, value: $row_h, min: 0, max: 0}}
    label : ui.Line, Muted {
      TextStyle: {size: $size_run, line: 15, role: 0, bold: 0}
    }
  }

  // The Archive's list when nothing is in it (or nothing matches), centred in the room the rows leave (ArchivePane's
  // `empty`).
  // Kip over it (archive.rs sets his Kip from hn.KipArchive): asleep over an empty Archive, puzzling over a filter that
  // matches nothing.
  prefab ArchNote : ui.Column {
    Flex: {axis: Column, gap: 6, align: Center, justify: Center, wrap: false}
    Size: {w: {kind: Fit, value: 0, min: 0, max: 0}, h: {kind: Fit, value: 0, min: 0, max: 0}}
    kip : ui.Node {
      Hoverable
    }
    label : ui.Line, Faint {
      TextStyle: {size: $size_body, line: 16, role: 0, bold: 0}
    }
  }
}
