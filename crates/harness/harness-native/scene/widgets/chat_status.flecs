module hn.chat_status

// The chat's statuses as icons (src/app/chat.rs `status_on` reads them by name and panics on a missing one): each its
// glyph (a codicon from the bundled Symbols Nerd Font), its tone, its words (the tooltip of whatever shows it, so the word
// stays discoverable) and, when it carries a Breath, the running dot's breath (src/look.rs) while it shows. The breath is
// the one motion: it lasts only while the agent works, so with nothing at work the window goes idle. Each is a prefab, so
// no query (the breath's, the tooltip's) ever matches the vocabulary itself, only the nodes chat.rs copies it onto.
// Colour only where it means something (a failure's red); the rest in the chat's muted and faint inks.

// The agent's reasoning: a sparkle, breathing while it still thinks, still once it is done.
prefab thinking {
  Icon: {glyph: ""}
  Fill: $tone_chat_muted
  Tooltip: {text: "Thinking…"}
  Breath: {spring: {x: 1, v: 0}, up: false, low: $breath_floor}
}
prefab thought {
  Icon: {glyph: ""}
  Fill: $tone_chat_muted
  Tooltip: {text: "Thought"}
}

// The composer's status line: the agent at work (a pulse, breathing), or its agent ended (a quiet empty ring).
prefab working {
  Icon: {glyph: ""}
  Fill: $tone_chat_muted
  Tooltip: {text: "Working…  esc to interrupt"}
  Breath: {spring: {x: 1, v: 0}, up: false, low: $breath_floor}
}
prefab ended {
  Icon: {glyph: ""}
  Fill: $tone_chat_faint
  Tooltip: {text: "Ended · a message resumes it"}
}

// A tool call's or a run's line: a call still running (a small breathing dot, the sidebar's running dot), or one that
// ended with no result (a slashed circle, faint).
prefab running {
  Icon: {glyph: ""}
  Fill: $tone_chat_muted
  Tooltip: {text: "Running…"}
  Breath: {spring: {x: 1, v: 0}, up: false, low: $breath_floor}
}
prefab no_result {
  Icon: {glyph: ""}
  Fill: $tone_chat_faint
  Tooltip: {text: "No result"}
}
