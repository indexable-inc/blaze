module hn.chat_status

// The chat's statuses as icons (src/app/chat.rs `status_on` reads them by name and panics on a missing one): each its
// glyph (a codicon from the bundled Symbols Nerd Font) or its drawing (a Vector in its Stroke, crisp at any size), its
// tone, its words (the tooltip of whatever shows it, so the word stays discoverable) and, when it carries a Breath, the
// running dot's breath (src/look.rs) while it shows. The breath is the one motion: it lasts only while the agent works,
// so with nothing at work the window goes idle. Each is a prefab, so no query (the breath's, the tooltip's) ever matches
// the vocabulary itself, only the nodes chat.rs copies it onto. Colour only where it means something (a failure's red);
// the rest in the chat's muted and faint inks.

// The agent's reasoning: a thin ring, the hollow sibling of a running call's dot, breathing on the same breath while it
// still thinks, still once it is done. Its line is the codicons' weight (chat_think_stroke) and it sits a little inside
// its box (radius 4 of 12), so it weighs what the step glyphs beside it do.
prefab thinking {
  Fill: $tone_clear
  Stroke: {dark: $tone_ink_muted.dark, light: $tone_ink_muted.light}
  Vector: {d: "M6 2 A4 4 0 1 1 6 10 A4 4 0 1 1 6 2", view_x: 0, view_y: 0, view_w: 12, view_h: 12, stroke_w: $chat_think_stroke}
  Tooltip: {text: "Thinking…"}
  Breath: {spring: {x: 1, v: 0}, up: false, low: $breath_floor}
}
prefab thought {
  Fill: $tone_clear
  Stroke: {dark: $tone_ink_muted.dark, light: $tone_ink_muted.light}
  Vector: {d: "M6 2 A4 4 0 1 1 6 10 A4 4 0 1 1 6 2", view_x: 0, view_y: 0, view_w: 12, view_h: 12, stroke_w: $chat_think_stroke}
  Tooltip: {text: "Thought"}
}

// A tool call's or a run's line: a call still running (a small breathing dot, the sidebar's running dot), or one that
// ended with no result (a slashed circle, faint).
prefab running {
  Icon: {glyph: ""}
  Fill: $tone_ink_muted
  Tooltip: {text: "Running…"}
  Breath: {spring: {x: 1, v: 0}, up: false, low: $breath_floor}
}
prefab no_result {
  Icon: {glyph: ""}
  Fill: $tone_ink_faint
  Tooltip: {text: "No result"}
}

// An agent's state on its chip over the composer (src/app/chat.rs fill_chat_activity), beside `running` above (at work,
// breathing): up but waiting for the person (a hollow ring, still), finished (a check in the success ink), failed (a
// cross in the error ink).
prefab waiting {
  Icon: {glyph: ""}
  Fill: $tone_ink_muted
  Tooltip: {text: "Waiting for input"}
}
prefab done {
  Icon: {glyph: ""}
  Fill: $tone_success
  Tooltip: {text: "Done"}
}
prefab failed {
  Icon: {glyph: ""}
  Fill: $tone_error
  Tooltip: {text: "Failed"}
}
