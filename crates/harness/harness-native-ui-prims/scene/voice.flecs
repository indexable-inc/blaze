// The voices a sound is made in, as prefabs, for every host (a video's soundtrack, the app's cues). Each carries its
// voice's defaults; an instance sets its Onset and only what differs:
//
//   ding : voice.Bell { Onset: {at: 2.0} Pitch: {hz: 1760} Pan: {pos: 0.4, sweep: 0} }
//
// Components: Sound (the voice), Onset (seconds on the host's clock), Lasts, Pitch, Gain, Pan (-1 the frame's left edge,
// 1 its right, placed binaurally; `sweep` moves it over the sound's length). harness-native-ui-timeline-api says which
// members each voice reads.
@tree ChildOf
voice {
  // Heard from the centre unless an instance says otherwise.
  prefab Base {
    Pan: {pos: 0, sweep: 0}
  }
  // Risset's bell.
  prefab Bell : Base {
    Sound: {voice: Bell}
    Lasts: {dur: 1.6}
    Pitch: {hz: 880}
    Gain: {amp: 0.04}
  }
  // A felt mallet.
  prefab Mallet : Base {
    Sound: {voice: Mallet}
    Lasts: {dur: 1.8}
    Pitch: {hz: 440}
    Gain: {amp: 0.05}
  }
  // A round bass, always centred.
  prefab Bass : Base {
    Sound: {voice: Bass}
    Lasts: {dur: 2}
    Pitch: {hz: 55}
    Gain: {amp: 0.08}
  }
  // A small tick.
  prefab Click : Base {
    Sound: {voice: Click}
    Pitch: {hz: 3000}
    Gain: {amp: 0.06}
  }
  // A low thump, always centred; its Gain is its size.
  prefab Thud : Base {
    Sound: {voice: Thud}
    Gain: {amp: 0.25}
  }
  // Something passing, left to right unless an instance says otherwise.
  prefab Whoosh : Base {
    Sound: {voice: Whoosh}
    Lasts: {dur: 0.6}
    Pitch: {hz: 2000}
    Gain: {amp: 0.03}
    Pan: {pos: -0.5, sweep: 1}
  }
  // The fire.
  prefab Fire : Base {
    Sound: {voice: Fire}
    Lasts: {dur: 3}
  }
}
