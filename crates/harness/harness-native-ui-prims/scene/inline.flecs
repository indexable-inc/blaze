// Inline components: the vocabulary of chips an agent writes in its words, `<Path loc="/Volumes/Projects/blaze">blaze</Path>`
// (harness-native-ui-inline is the tag grammar; this module is what each name means). One entity per name: its icon
// (`glyph`, or the drawing of the file kind of where it points with `file_icon`), the prop that says where a press opens (`target`) and
// the one with a line in it (`line`). A chip is the label in the UI face, medium, after its icon, on `rest`'s plate (clear)
// at rest and `hover`'s under the pointer. A new component is an entity here; nothing in Rust
// lists them. Depends on the primitives (prims.flecs: MarkdownText's chips) and the tokens.
//
// A self-closing tag's words and where it opens can be formats over its props (InlineRef `label`, `href`: `#{n}`), and a
// component can have live state the host keeps (`key`, `feed`; harness-native-render inline.rs): a child per state it
// can be in, each its icon (InlineRef.glyph) and its ink (Fill), with `unknown` for while nothing is known, and with
// `mark` a small mark after its label from `marks` (a pull request's CI). The host keeps what it knows under `live`.
//
// A link is read for what it points at: `url` names the prop a component keeps a web address in (Link's `href`), and a
// link whose address fits another component's `href` format is that component (a link to a GitHub pull request is its
// PR chip, with its state and checks), whether written as <Link>, as [words](address) or bare. A link that stays one
// shows its words, then its host quiet (`meta`), after its page's favicon (the host's live picture; the globe without).
module ui.inline

@tree ChildOf
// What every chip shares: its icon's ink (quiet: the label carries the meaning) and its corners.
look {
  Fill: $tone_ink_muted
  Shape: {radius: $radius_control, n: 4, border: 0, feather: 0}
}
// A chip's plate at rest: clear, so a chip reads as a reference in the words (as GitHub's and Linear's do), its icon in
// its state's ink saying what it is; the plate shows on hover.
rest {
  Fill: $tone_clear
}
// The quiet words after a label: a link's host.
meta {
  Fill: $tone_ink_muted
}
// The chip under the pointer (a wash of the strong ink, its label underlined) and held down (brighter still); the
// pointer is the pointing hand over any chip that opens. Washes, not the list's selection: a chip is not selected.
hover {
  Fill: $tone_wash
}
pressed {
  Fill: $tone_press
}
underline {
  Fill: $tone_ink_faint
}
// What the host knows of live components: one InlineLive child a thing (src/app/chat/peek.rs keeps them).
live {
}
// The marks a live component's state picks after its label: a pull request's head commit's checks, a small dot in their
// ink on the chip (oct-dot-fill), and on its hover card (`card`) the check, the cross or the dot.
marks {
  success {
    InlineRef: {glyph: ""}
    Fill: $tone_gh_ci_success
    // oct-check
    card { InlineRef: {glyph: ""} }
  }
  failure {
    InlineRef: {glyph: ""}
    Fill: $tone_gh_ci_failure
    // oct-x
    card { InlineRef: {glyph: ""} }
  }
  pending {
    InlineRef: {glyph: ""}
    Fill: $tone_gh_ci_pending
    card { InlineRef: {glyph: ""} }
  }
}

// A file or a folder: its kind's icon (IntelliJ's, in its own colours: harness-native-ui-inline files.rs); a press opens
// it (at `line`), an Option-press shows it in the Finder. Whether it is a folder the host finds out once a chat shows it
// (the `fs` feed, src/app/chat/peek.rs), so /Volumes/Projects/blaze is a folder's icon though its name has no slash; a
// place that is not there keeps its name's icon and says so as its tooltip.
Path {
  InlineRef: {target: "loc", line: "line", file_icon: true, key: "path:\{loc}", feed: "fs"}
  folder { InlineRef: {file_icon: true, folder: true} }
  file { InlineRef: {file_icon: true} }
  unknown { InlineRef: {file_icon: true} }
}
// A cited phrase, `<Cite loc="/abs/AGENTS.md" line={96}>four at once is a lot</Cite>`: the words themselves, in the face
// of the words around them, with a dotted underline; under the pointer the underline is solid and the card shows the
// file from that line (the part cited, not the whole file); a press opens it there. Not a chip: no icon, no plate.
Cite {
  InlineRef: {target: "loc", line: "line", file_icon: false, plain: true}
}
// A cell's FileRef, by the same name and props as in a ts cell's UI.
FileRef {
  InlineRef: {target: "path", line: "line", file_icon: true, key: "path:\{path}", feed: "fs"}
  folder { InlineRef: {file_icon: true, folder: true} }
  file { InlineRef: {file_icon: true} }
  unknown { InlineRef: {file_icon: true} }
}
// A symbol in code (a type, a function): a press opens the file it is in, at its line.
Symbol {
  // cod-symbol-method
  InlineRef: {target: "loc", line: "line", file_icon: false, glyph: ""}
}
// A web page: its favicon (the host fetches it with the page's card: InlineLive.picture), else the globe, then its words
// and its host, quiet; a press opens it in the browser. A link to what another component is becomes that component.
Link {
  // cod-globe
  InlineRef: {target: "href", line: "", file_icon: false, glyph: "", url: "href", key: "page:\{href}", feed: "page"}
  // Its page not fetched yet, fetched with no favicon, or not fetched at all: the globe, quiet.
  unknown {
    InlineRef: {glyph: ""}
    Fill: $tone_ink_muted
  }
}
// A GitHub pull request, `<PR repo="indexable-inc/ix" n={7652}/>`: `#7652` after its icon in its state's ink (open
// green, draft grey, merged purple, closed red, as GitHub draws them), then its head commit's checks; its title on hover,
// a card after a dwell; a press opens it on GitHub. One batched query a chat asks after all of them (harness's github.rs).
PR {
  // oct-git-pull-request
  InlineRef: {target: "", line: "", file_icon: false, glyph: "", label: "#\{n}", href: "https://github.com/\{repo}/pull/\{n}", key: "pr:\{repo}#\{n}", feed: "github.pr", mark: true}
  open {
    InlineRef: {glyph: ""}
    Fill: $tone_gh_open
  }
  draft {
    // oct-git-pull-request-draft
    InlineRef: {glyph: ""}
    Fill: $tone_gh_draft
  }
  merged {
    // oct-git-merge
    InlineRef: {glyph: ""}
    Fill: $tone_gh_merged
  }
  closed {
    // oct-git-pull-request-closed
    InlineRef: {glyph: ""}
    Fill: $tone_gh_closed
  }
  // Not asked yet, or the fetch failed (its error is the tooltip): the plain icon, quiet, no mark.
  unknown {
    InlineRef: {glyph: ""}
    Fill: $tone_ink_muted
  }
}
// A GitHub issue, `<Issue repo="indexable-inc/ix" n={812}/>`: open green, closed (completed) purple, closed as not
// planned grey, as GitHub draws them.
Issue {
  // oct-issue-opened
  InlineRef: {target: "", line: "", file_icon: false, glyph: "", label: "#\{n}", href: "https://github.com/\{repo}/issues/\{n}", key: "issue:\{repo}#\{n}", feed: "github.issue", mark: false}
  open {
    InlineRef: {glyph: ""}
    Fill: $tone_gh_open
  }
  closed {
    // oct-issue-closed
    InlineRef: {glyph: ""}
    Fill: $tone_gh_merged
  }
  not_planned {
    // oct-circle-slash
    InlineRef: {glyph: ""}
    Fill: $tone_gh_draft
  }
  unknown {
    InlineRef: {glyph: ""}
    Fill: $tone_ink_muted
  }
}
// A tag with no entity here, or whose target is not a place: a warning icon, the error as its tooltip, no press.
unknown {
  // cod-warning
  InlineRef: {target: "", line: "", file_icon: false, glyph: ""}
}
