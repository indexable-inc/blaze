// Inline components: the vocabulary of chips an agent writes in its words, `<Path loc="/Volumes/Projects/blaze">blaze</Path>`
// (harness-native-ui-inline is the tag grammar; this module is what each name means). One entity per name: its icon
// (`glyph`, or the file kind of where it points with `file_icon`), the prop that says where a press opens (`target`) and
// the one with a line in it (`line`). A chip is the label in the UI face, medium, after its icon, on the plate the text's
// MarkdownText gives code (`chip`), so each host tints both alike. A new component is an entity here; nothing in Rust
// lists them. Depends on the primitives (prims.flecs: MarkdownText's chips) and the tokens.
//
// A self-closing tag's words and where it opens can be formats over its props (InlineRef `label`, `href`: `#{n}`), and a
// component can have live state the host keeps (`key`, `feed`; harness-native-render inline.rs): a child per state it
// can be in, each its icon (InlineRef.glyph) and its ink (Fill), with `unknown` for while nothing is known, and with
// `mark` a small mark after its label from `marks` (a pull request's CI). The host keeps what it knows under `live`.
module ui.inline

@tree ChildOf
// What every chip shares: its icon's ink (quiet: the label carries the meaning) and its corners.
look {
  Fill: $tone_ink_3
  Shape: {radius: $radius_control, n: 4, border: 0, feather: 0}
}
// The chip under the pointer (a brighter plate, its label underlined) and held down (brighter still); the pointer is
// the pointing hand over any chip that opens.
hover {
  Fill: $tone_inline_hover
}
pressed {
  Fill: $tone_inline_pressed
}
underline {
  Fill: $tone_inline_underline
}
// What the host knows of live components: one InlineLive child a thing (src/app/chat/peek.rs keeps them).
live {
}
// The marks a live component's state picks after its label: a pull request's head commit's checks.
marks {
  success {
    // oct-check
    InlineRef: {glyph: ""}
    Fill: $tone_gh_ci_success
  }
  failure {
    // oct-x
    InlineRef: {glyph: ""}
    Fill: $tone_gh_ci_failure
  }
  pending {
    // oct-dot-fill
    InlineRef: {glyph: ""}
    Fill: $tone_gh_ci_pending
  }
}

// A file or a folder: its kind's icon; a press opens it (at `line`), an Option-press shows it in the Finder.
Path {
  InlineRef: {target: "loc", line: "line", file_icon: true}
}
// A cell's FileRef, by the same name and props as in a ts cell's UI.
FileRef {
  InlineRef: {target: "path", line: "line", file_icon: true}
}
// A symbol in code (a type, a function): a press opens the file it is in, at its line.
Symbol {
  // cod-symbol-method
  InlineRef: {target: "loc", line: "line", file_icon: false, glyph: ""}
}
// A web page: a press opens it in the browser.
Link {
  // cod-link
  InlineRef: {target: "href", line: "", file_icon: false, glyph: ""}
}
// A GitHub pull request, `<PR repo="indexable-inc/ix" n={7652}/>`: `#7652` after its icon in its state's ink (open
// green, draft grey, merged purple, closed red, as GitHub draws them), then its head commit's checks; its title on hover,
// a card after a dwell; a press opens it on GitHub. One batched query a chat asks after all of them (harness's github.rs).
PR {
  // oct-git-pull-request
  InlineRef: {target: "", line: "", file_icon: false, glyph: "", label: "#\{n}", href: "https://github.com/\{repo}/pull/\{n}", key: "pr:\{repo}#\{n}", feed: "github.pr", mark: true}
  open {
    InlineRef: {glyph: ""}
    Fill: $tone_gh_open
  }
  draft {
    // oct-git-pull-request-draft
    InlineRef: {glyph: ""}
    Fill: $tone_gh_draft
  }
  merged {
    // oct-git-merge
    InlineRef: {glyph: ""}
    Fill: $tone_gh_merged
  }
  closed {
    // oct-git-pull-request-closed
    InlineRef: {glyph: ""}
    Fill: $tone_gh_closed
  }
  // Not asked yet, or the fetch failed (its error is the tooltip): the plain icon, quiet, no mark.
  unknown {
    InlineRef: {glyph: ""}
    Fill: $tone_ink_3
  }
}
// A GitHub issue, `<Issue repo="indexable-inc/ix" n={812}/>`: open green, closed (completed) purple, closed as not
// planned grey, as GitHub draws them.
Issue {
  // oct-issue-opened
  InlineRef: {target: "", line: "", file_icon: false, glyph: "", label: "#\{n}", href: "https://github.com/\{repo}/issues/\{n}", key: "issue:\{repo}#\{n}", feed: "github.issue", mark: false}
  open {
    InlineRef: {glyph: ""}
    Fill: $tone_gh_open
  }
  closed {
    // oct-issue-closed
    InlineRef: {glyph: ""}
    Fill: $tone_gh_merged
  }
  not_planned {
    // oct-circle-slash
    InlineRef: {glyph: ""}
    Fill: $tone_gh_draft
  }
  unknown {
    InlineRef: {glyph: ""}
    Fill: $tone_ink_3
  }
}
// A tag with no entity here, or whose target is not a place: a warning icon, the error as its tooltip, no press.
unknown {
  // cod-warning
  InlineRef: {target: "", line: "", file_icon: false, glyph: ""}
}
