##[group]Run # On the disk with the most room: /mnt on x86-64, the root on AArch64, which has no /mnt.
# On the disk with the most room: /mnt on x86-64, the root on AArch64, which has no /mnt.
disk=$(df --output=avail,target / /mnt 2>/dev/null | tail -n +2 | sort -n | tail -n 1 | awk '{ print $2 }')
swap="${disk%/}/blaze.swap"
sudo fallocate -l 20G "$swap"
sudo chmod 600 "$swap"
sudo mkswap "$swap" > /dev/null
sudo swapon "$swap"
free -g
