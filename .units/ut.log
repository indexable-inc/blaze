##[start-action display=blaze remote pull;id=blaze.__self.__run]
##[group]Run set -o pipefail
set -o pipefail
refuse() {
  echo "::error::blaze remote $MODE: $1"
  echo "### blaze remote $MODE: refused: $1" >> "$GITHUB_STEP_SUMMARY"
  exit 1
}
[ -n "${BLAZE_CACHE:-}" ] || refuse "BLAZE_CACHE is not set: run .github/actions/blaze first"
PROJECT=${PROJECT:-blaze-$RUNNER_OS-$RUNNER_ARCH}
case "$MODE" in
  pull)
    export BLAZE_REMOTE_READONLY=1
    ;;
  push)
    if [ "$GITHUB_REF" != refs/heads/main ]; then
      refuse "push runs on main only, not $GITHUB_REF"
    fi
    if [ -z "$TOKEN" ] || [ -z "$SIGN_KEY" ]; then
      refuse "push needs token and sign-key (the cache-writer environment)"
    fi
    export BLAZE_REMOTE_TOKEN="$TOKEN"
    key="$RUNNER_TEMP/blaze-remote-sign.key"
    (umask 077 && printf '%s\n' "$SIGN_KEY" > "$key")
    trap 'rm -f "$key"' EXIT
    export BLAZE_REMOTE_SIGN="$key"
    ;;
  *)
    refuse "the mode is pull or push, not $MODE"
    ;;
esac
log="$RUNNER_TEMP/blaze-remote-$MODE.log"
start=$(date +%s.%N)
# The exit status is said too: a blaze killed by a signal (137 for SIGKILL) says nothing.
if blaze-engine cache "$MODE" "$REMOTE" "$PROJECT" 2>&1 | tee "$log"; then
  status=ok
else
  status="failed (blaze-engine exit status ${PIPESTATUS[0]})"
fi
took=$(awk -v a="$start" -v b="$(date +%s.%N)" 'BEGIN { printf "%.1f", b - a }')
{
  echo "### blaze remote $MODE: $status (${took} s)"
  echo
  echo '```'
  tail -n 20 "$log"
  echo '```'
} >> "$GITHUB_STEP_SUMMARY"
if [ "$status" != ok ]; then
  echo "::error::blaze remote $MODE $status: see the job summary"
  exit 1
fi
