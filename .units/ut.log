##[start-action display=blaze (the release .github/blaze-version names);id=blaze.install]
##[group]Run # Without --no-toolchain: install.sh has blaze fetch its toolchain now (`blaze toolchain`),
# Without --no-toolchain: install.sh has blaze fetch its toolchain now (`blaze toolchain`),
# as a user's install does, rather than at the first build.
sh install.sh --version "$(cat .github/blaze-version)" --verbose
said=$(blaze-engine --version)
version=$(echo "$said" | awk '$1 == "blaze" { print $2 }')
[ -n "$version" ] || { echo "::error::blaze-engine --version said no version: $said"; exit 1; }
echo "BLAZE_CACHE=$RUNNER_TEMP/blaze-store" >> "$GITHUB_ENV"
# No limit on the store: its default, a tenth of the free disk (about 3 GB on a hosted
# runner), left a third of main's packs unpulled ("318 left that do not fit under
# BLAZE_CACHE_MAX"), so a warm run still rebuilt what they held. A runner's disk lives
# for one job, so nothing needs collecting.
echo "BLAZE_CACHE_MAX=off" >> "$GITHUB_ENV"
echo "project=blaze-$RUNNER_OS-$RUNNER_ARCH-$JOB-$version" | tee -a "$GITHUB_OUTPUT"
