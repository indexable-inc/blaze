-            diagnostics.report(&self.message_interface.bare(MessageLevel::Note, msg.as_str()));
-        }
-    }
-
-    pub fn iter(&self) -> impl Iterator<Item = &QuantCost> + '_ {
-        self.quantifier_stats.iter()
-    }
-}
