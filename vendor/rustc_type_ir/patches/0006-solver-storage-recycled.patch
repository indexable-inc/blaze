+        assert!(graph.is_empty());
+        assert_eq!(graph.debug_current_depth(), 0);
+        assert_eq!(solve(&mut graph, 0), 0);
+        assert!(graph.is_empty());
+        assert_eq!(graph.into_storage().held(), held);
+    }
