    "src/handlers/hunk_header.rs"
   ],
   [
    "--no-gitconfig",
    "--color-only",
    "src/cli.rs",
    "src/config.rs"
   ],
   [
    "--no-gitconfig",
    "--show-syntax-themes"
   ],
   [
    "--no-gitconfig",
    "--list-languages"
   ],
   [
    "--no-gitconfig",
    "--show-config"
   ],
   [
    "--no-gitconfig",
    "--paging=never",
    "--diff-so-fancy",
    "src/align.rs",
    "src/edits.rs"
   ],
   [
    "--no-gitconfig",
    "no-such-a",
    "no-such-b"
   ],
   [
    "--no-such-flag"
   ]
  ],
  "bench": [
   "--no-gitconfig",
   "--side-by-side",
   "--width=160",
   "--line-numbers",
   "src/delta.rs",
   "src/paint.rs"
  ]
