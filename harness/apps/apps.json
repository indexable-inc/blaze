{
 "ripgrep": {
  "repo": "https://github.com/BurntSushi/ripgrep",
  "rev": "3fce3b5bb0236da2df6d99672afb8a719642eca7",
  "package": "ripgrep",
  "bin": "rg",
  "scrub": [
   "\"nanos\":\\d+",
   "[0-9.]+s\\b",
   "[0-9.]+ seconds"
  ],
  "runs": [
   [
    "--version"
   ],
   [
    "--help"
   ],
   [
    "-n",
    "fn main",
    "crates/core"
   ],
   [
    "-c",
    "-i",
    "regex",
    "crates",
    "--sort",
    "path"
   ],
   [
    "--json",
    "Searcher",
    "crates/searcher/src/lib.rs"
   ],
   [
    "-o",
    "-w",
    "[A-Z][a-z]+Builder",
    "crates/printer/src",
    "--sort",
    "path"
   ],
   [
    "--files",
    "crates/globset",
    "--sort",
    "path"
   ],
   [
    "-U",
    "-C",
    "1",
    "impl Default[^{]*\\{\\n",
    "crates/matcher/src/lib.rs"
   ],
   [
    "--stats",
    "-q",
    "unsafe",
    "crates",
    "-j",
    "1"
   ],
   [
    "-t",
    "toml",
    "-F",
    "version",
    "--sort",
    "path"
   ],
   [
    "-c",
    "\\w+ing\\b",
    "../ripgrep-vendor",
    "--sort",
    "path"
   ],
   [
    "-i",
    "-o",
    "fn \\w+<",
    "../ripgrep-vendor",
    "--sort",
    "path"
   ],
   [
    "--no-such-flag"
   ],
   [
    "-e",
    "(unclosed",
    "crates"
   ]
  ],
  "bench": [
   "-c",
   "\\w+ing\\b",
   "../ripgrep-vendor",
   "-j",
   "1"
  ],
  "edit_check": [
   "--stats",
   "-n",
   "-C",
   "1",
   "--trim",
   "fn main",
   "crates/core",
   "--sort",
   "path"
  ],
  "edits": [
   {
    "file": "crates/core/main.rs",
    "old": "{matches} matches\n",
    "new": "{matches} matches found\n",
    "what": "a word in the statistics"
   },
   {
    "file": "crates/printer/src/stats.rs",
    "old": "self.matches += n;",
    "new": "self.matches += n * 2;",
    "what": "matches counted twice"
   },
   {
    "file": "crates/printer/src/standard.rs",
    "old": "separator_context: Arc::new(Some(b\"--\".to_vec())),",
    "new": "separator_context: Arc::new(Some(b\"~~\".to_vec())),",
    "what": "the default context separator"
   },
   {
    "file": "crates/printer/src/util.rs",
    "old": "b'\\t' | b'\\n' | b'\\x0B' | b'\\x0C' | b'\\r' | b' ' => true,",
    "new": "b'\\n' | b'\\x0B' | b'\\x0C' | b'\\r' | b' ' => true,",
    "what": "a tab is not trimmed"
   },
   {
    "file": "crates/core/main.rs",
    "old": "{searches} files searched\n",
    "new": "{searches} files looked at\n",
    "what": "another word in the statistics"
   },
   {
    "file": "crates/printer/src/standard.rs",
    "old": "        let n = DecimalFormatter::new(line_number);\n        self.std.write_spec(self.config().colors.line(), n.as_bytes())?;",
    "new": "        let n = DecimalFormatter::new(line_number + 1000);\n        self.std.write_spec(self.config().colors.line(), n.as_bytes())?;",
    "what": "line numbers offset"
   },
   {
    "file": "crates/printer/src/stats.rs",
    "old": "    /// Add to the total number of matches.\n",
    "new": "    /// Half of what was counted, rounded up.\n    fn halved(n: u64) -> u64 {\n        n.div_ceil(2)\n    }\n\n    /// Add to the total number of matches.\n",
    "what": "a new function"
   },
   {
    "file": "crates/printer/src/stats.rs",
    "old": "self.matches += n * 2;",
    "new": "self.matches += Self::halved(n * 2);",
    "what": "a call of the new function"
   },
   {
    "file": "crates/printer/src/summary.rs",
    "old": "count.max(1)",
    "new": "count.max(2)",
    "what": "a floor of a count"
   },
   {
    "file": "crates/core/main.rs",
    "old": "{bytes_printed} bytes printed\n",
    "new": "{bytes_printed} bytes printed ({matches} matches)\n",
    "what": "a format argument used twice"
   }
  ],
  "tests": {
   "program": [
    "--test",
    "integration"
   ]
  }
 },
 "fd": {
