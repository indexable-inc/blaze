    "-t",
    "d",
    ".",
    "src",
    "-j",
    "1"
   ],
   [
    "-g",
    "*.toml",
    "-j",
    "1"
   ],
   [
    "walk",
    "src",
    "-x",
    "echo",
    "found",
    "-j",
    "1"
   ],
   [
    "-S",
    "+10k",
    ".",
    "src",
    "-j",
    "1"
   ],
   [
    "-d",
    "1",
    "-a",
    "-0",
    "main",
    "src"
   ],
   [
    "-e",
    "rs",
    "-j",
    "1",
    "--base-directory",
    "../fd-vendor",
    "-c",
    "never"
   ],
   [
    "-t",
    "f",
    "-g",
    "*.md",
    "../fd-vendor",
    "-j",
    "1",
    "-X",
    "wc",
    "-c"
   ],
   [
    "--bad-flag"
   ],
   [
    "[invalid",
    "src"
   ]
  ],
  "bench": [
   "-e",
   "rs",
   "-j",
   "1",
   "--base-directory",
   "../fd-vendor"
  ],
  "tests": {
   "program": [
    "--test",
    "tests"
   ]
  }
