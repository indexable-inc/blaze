{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/claude/hooks/check.py"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
